#: sed/sed.c:97
#, c-format
msgid ""
"Usage: %s [OPTION]... {script-only-if-no-other-script} [input-file]...\n"
"\n"
"  -n, --quiet, --silent\n"
"                 suppress automatic printing of pattern space\n"
"  -e script, --expression=script\n"
"                 add the script to the commands to be executed\n"
"  -f script-file, --file=script-file\n"
"                 add the contents of script-file to the commands to be executed\n"
"  -l N, --line-length=N\n"
"                 specify the desired line-wrap length for the `l' command\n"
"  -u, --unbuffered\n"
"\n"
"      --help     display this help and exit\n"
"  -V, --version  output version information and exit\n"
"\n"
"If no -e, --expression, -f, or --file option is given, then the first\n"
"non-option argument is taken as the sed script to interpret.  All\n"
"remaining arguments are names of input files; if no input files are\n"
"specified, then the standard input is read.\n"
"\n"
msgstr ""
"Pou¾ití: %s [PØEPÍNAÈ]... {skript-pouze-není-li-jiný-skript} [vst.-soubor]...\n"
"\n"
"  -n, --quiet, --silent\n"
"                 potlaèí automatické vypisování vzorového úlo¾i¹tì (pattern\n"
"                 space)\n"
"  -e script, --expression=SKRIPT\n"
"                 pøidá seznam pøíkazù z øetìzce SKRIPT k seznamu pøíkazù,\n"
"                 které mají být vykonány\n"
"  -f script-file, --file=SKRIPT-SOUBOR\n"
"                 pøidá obsah SKRIPT-SOUBORu k seznamu pøíkazù, které mají\n"
"                 být vykonány\n"
"  -l N, --line-length=N\n"
"                 zadání pozice, na které má být øádek zalamován, pro pøíkaz `l'\n"
"  -u, --unbuffered\n"
"                 nebufferovaný výstup\n"
"      --help     vypí¹e tuto nápovìdu a skonèí\n"
"  -V, --version  vypí¹e oznaèení verze a skonèí\n"
"\n"
"  Nebude-li ¾ádný z pøepínaèù -e, --expression, -f, nebo --file zadán, pak\n"
"první argument, který není pøepínaèem, bude pova¾ován za sed skript, který má\n"
"být interpretován. V¹echny zbylé argumenty pøedstavují jména vstupních souborù.\n"
"Nebudou-li vstupní soubory zadány, bude èten standardní vstup.\n"
"\n"

