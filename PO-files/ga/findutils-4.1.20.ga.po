#: find/parser.c:557
msgid ""
"default path is the current directory; default expression is -print\n"
"expression may consist of:\n"
"operators (decreasing precedence; -and is implicit where no others are given):\n"
"      ( EXPR ) ! EXPR -not EXPR EXPR1 -a EXPR2 EXPR1 -and EXPR2\n"
msgstr ""
"Tá an chomhadlann láithreach an cosán loicthe; tá `-print' an slonn loicthe\n"
"is éard is féidir a bheith sa shlonn:\n"
"oibreoirí (tosaíocht laghdaitheach; tá `-and' intuigthe mura bhfuil eile ann):\n"
"      ( SLONN ) | SLONN -not SLONN SLONN1 -a SLONN2 SLONN1 -and SLONN2\n"

#: find/parser.c:562
msgid ""
"      EXPR1 -o EXPR2 EXPR1 -or EXPR2 EXPR1 , EXPR2\n"
"options (always true): -daystart -depth -follow --help\n"
"      -maxdepth LEVELS -mindepth LEVELS -mount -noleaf --version -xdev\n"
"tests (N can be +N or -N or N): -amin N -anewer FILE -atime N -cmin N\n"
msgstr ""
"      SLONN1 -o SLONN2 SLONN1 -or SLONN2 SLONN1 , SLONN2\n"
"roghanna (fíor i gcónaí): -daystart -depth -follow --help\n"
"      -maxdepth UIMHIR -mindepth UIMHIR -mount -noleaf --version -xdev\n"
"trialacha (N = +N, -N, nó N): -amin N -anewer COMHAD -atime N -cmin N\n"

#: find/parser.c:567
msgid ""
"      -cnewer FILE -ctime N -empty -false -fstype TYPE -gid N -group NAME\n"
"      -ilname PATTERN -iname PATTERN -inum N -ipath PATTERN -iregex PATTERN\n"
"      -links N -lname PATTERN -mmin N -mtime N -name PATTERN -newer FILE\n"
msgstr ""
"      -cnewer COMHAD -ctime N -empty -false -fstype SÓRT -gid N -group AINM\n"
"      -ilname PATRÚN -iname PATRÚN -inum N -ipath PATRÚN -iregex PATRÚN\n"
"      -links N -lname PATRÚN -mmin N -mtime N -name PATRÚN -newer COMHAD\n"

#: find/parser.c:571
msgid ""
"      -nouser -nogroup -path PATTERN -perm [+-]MODE -regex PATTERN\n"
"      -size N[bckw] -true -type [bcdpfls] -uid N -used N -user NAME\n"
"      -xtype [bcdpfls]\n"
msgstr ""
"      -nouser -nogroup -path PATRÚN -perm [+-]MODH -regex PATRÚN\n"
"      -size N[bckw] -true -type [bcdpfls] -uid N -used N -user AINM\n"
"      -xtype [bcdpfls]\n"

#: find/parser.c:575
msgid ""
"actions: -exec COMMAND ; -fprint FILE -fprint0 FILE -fprintf FILE FORMAT\n"
"      -ok COMMAND ; -print -print0 -printf FORMAT -prune -ls\n"
msgstr ""
"gníomhartha: -exec ORDÚ; -fprint COMHAD -fprint0 COMHAD -fprintf COMHAD FORMÁID\n"
"      -ok ORDÚ ; -print -print0 -printf FORMÁID -prune -ls\n"

