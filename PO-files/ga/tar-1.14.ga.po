msgstr[1] "%s: Lipéad imleabhair ró-fhada (%lu bheart ar a mhéad)"
msgstr[2] "%s: Lipéad imleabhair ró-fhada (%lu mbeart ar a mhéad)"
msgstr[3] "%s: Lipéad imleabhair ró-fhada (%lu beart ar a mhéad)"

#: src/tar.c:1394
msgid "Cannot verify multi-volume archives"
msgstr "Ní féidir cartlanna le hiliomad imleabhair a dheimhniú"

#: src/tar.c:1396
msgid "Cannot verify compressed archives"
msgstr "Ní féidir cartlanna comhdhlúite a dheimhniú"

#: src/tar.c:1402
msgid "Cannot use multi-volume compressed archives"
msgstr "Ní féidir úsáid a bhaint as cartlanna il-ranna comhdhlúite"

#: src/tar.c:1404
msgid "Cannot update compressed archives"
msgstr "Ní féidir cartlanna comhdhlúite a nuashonrú"

#: src/tar.c:1416
