#: find/parser.c:702
#, c-format
msgid "Usage: %s [path...] [expression]\n"
msgstr "Úsáid: %s [cosán...] [slonn]\n"

#: find/parser.c:704
msgid ""
"default path is the current directory; default expression is -print\n"
"expression may consist of:\n"
"operators (decreasing precedence; -and is implicit where no others are given):\n"
"      ( EXPR ) ! EXPR -not EXPR EXPR1 -a EXPR2 EXPR1 -and EXPR2"
msgstr ""
"Tá an chomhadlann reatha ina cosán réamhshocraithe;\n"
"tá `-print' ina slonn réamhshocraithe\n"
"is éard is féidir a bheith sa shlonn:\n"
"oibreoirí (tosaíocht laghdaitheach; tá `-and' intuigthe mura bhfuil eile ann):\n"
"      ( SLONN ) | SLONN -not SLONN SLONN1 -a SLONN2 SLONN1 -and SLONN2"

#: find/parser.c:709
msgid ""
"      EXPR1 -o EXPR2 EXPR1 -or EXPR2 EXPR1 , EXPR2\n"
"positional options (always true): -daystart -follow\n"
"normal options (always true, specified before other expressions): -depth\n"
"      --help -maxdepth LEVELS -mindepth LEVELS -mount -noleaf --version -xdev\n"
"      -ignore_readdir_race -noignore_readdir_race\n"
"tests (N can be +N or -N or N): -amin N -anewer FILE -atime N -cmin N"
msgstr ""
"      SLONN1 -o SLONN2 SLONN1 -or SLONN2 SLONN1 , SLONN2\n"
"roghanna ionaid (fíor i gcónaí): -daystart -follow\n"
"gnáthroghanna (fíor i gcónaí, tugtha roimh sloinn eile): -depth\n"
"      --help -maxdepth UIMHIR -mindepth UIMHIR -mount -noleaf --version -xdev\n"
"      -ignore_readdir_race -noignore_readdir_race\n"
"trialacha (N = +N, -N, nó N): -amin N -anewer COMHAD -atime N -cmin N"

#: find/parser.c:715
msgid ""
"      -cnewer FILE -ctime N -empty -false -fstype TYPE -gid N -group NAME\n"
"      -ilname PATTERN -iname PATTERN -inum N -iwholename PATTERN -iregex PATTERN\n"
"      -links N -lname PATTERN -mmin N -mtime N -name PATTERN -newer FILE"
msgstr ""
"      -cnewer COMHAD -ctime N -empty -false -fstype SÓRT -gid N -group AINM\n"
"      -ilname PATRÚN -iname PATRÚN -inum N -ipath PATRÚN -iregex PATRÚN\n"
"      -links N -lname PATRÚN -mmin N -mtime N -name PATRÚN -newer COMHAD"

#: find/parser.c:719
msgid ""
"      -nouser -nogroup -path PATTERN -perm [+-]MODE -regex PATTERN\n"
"      -wholename PATTERN -size N[bcwkMG] -true -type [bcdpflsD] -uid N\n"
"      -used N -user NAME -xtype [bcdpfls]"
msgstr ""
"      -nouser -nogroup -path PATRÚN -perm [+-]MODH -regex PATRÚN\n"
"      -wholename PATRÚN -size N[bcwkMG] -true -type [bcdpflsD] -uid N\n"
"      -used N -user AINM -xtype [bcdpfls]"

#: find/parser.c:723
msgid ""
"actions: -exec COMMAND ; -fprint FILE -fprint0 FILE -fprintf FILE FORMAT\n"
"      -fls FILE -ok COMMAND ; -print -print0 -printf FORMAT -prune -ls -delete\n"
"      -quit\n"
msgstr ""
"gníomhartha: -exec ORDÚ; -fprint COMHAD -fprint0 COMHAD -fprintf COMHAD FORMÁID\n"
"      -fls COMHAD -ok ORDÚ ; -print -print0 -printf FORMÁID -prune -ls -delete\n"
"      -quit\n"

