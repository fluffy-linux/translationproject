msgid ""
"FEATURES is a list of comma separated words that can include:\n"
"  'caret', 'diagnostics-show-caret'\n"
"    show errors with carets\n"
"  'fixit', 'diagnostics-parseable-fixits'\n"
"    show machine-readable fixes\n"
"  'syntax-only'\n"
