msgid "  -j [N], --jobs[=N]          Allow N jobs at once; infinite jobs with no arg.\n"
msgstr ""
"  -j [N], --jobs[=N]          Dozvoli N istovremenih poslova; bez argumenta\n"
"                              ih dozvoli beskonačno.\n"

