#: src/grep.c:1974 src/grep.c:1981
#, c-format
msgid "Usage: %s [OPTION]... PATTERNS [FILE]...\n"
msgstr "Uporaba: %s [OPCIJA]... UZORCI [DATOTEKA]...\n"

#: src/grep.c:1976
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Pokušajte s '%s --help' za više informacija.\n"

#: src/grep.c:1982
#, c-format
msgid "Search for PATTERNS in each FILE.\n"
msgstr "Traži UZORKE u svakoj DATOTECI.\n"

#: src/grep.c:1983
#, c-format
msgid ""
"Example: %s -i 'hello world' menu.h main.c\n"
"PATTERNS can contain multiple patterns separated by newlines.\n"
"\n"
"Pattern selection and interpretation:\n"
msgstr ""
"Primjer: %s -i 'hello world' menu.h main.c\n"
"\n"
"Odabir i tumačenje UZORAKA:\n"

#: src/grep.c:1988
#, c-format
msgid ""
"  -E, --extended-regexp     PATTERNS are extended regular expressions\n"
"  -F, --fixed-strings       PATTERNS are strings\n"
"  -G, --basic-regexp        PATTERNS are basic regular expressions\n"
"  -P, --perl-regexp         PATTERNS are Perl regular expressions\n"
msgstr ""
"  -E, --extended-regexp     UZORCI su prošireni regularni izrazi\n"
"  -F, --fixed-strings       UZORCI su stringovi\n"
"  -G, --basic-regexp        UZORCI su osnovni regularni izrazi\n"
"  -P, --perl-regexp         UZORCI su Perl regularni izrazi\n"

#: src/grep.c:1994
#, c-format
msgid ""
"  -e, --regexp=PATTERNS     use PATTERNS for matching\n"
"  -f, --file=FILE           take PATTERNS from FILE\n"
"  -i, --ignore-case         ignore case distinctions in patterns and data\n"
"      --no-ignore-case      do not ignore case distinctions (default)\n"
"  -w, --word-regexp         match only whole words\n"
"  -x, --line-regexp         match only whole lines\n"
"  -z, --null-data           a data line ends in 0 byte, not newline\n"
msgstr ""
"  -e, --regexp=UZORCI       koristi UZORKE za podudaranje\n"
"  -f, --file=DATOTEKA       uzima UZORKE iz DATOTEKE\n"
"  -i, --ignore-case         zanemaruje razlike u veličini slova u uzorcima i podacima\n"
"      --no-ignore-case      ne zanemaruje razlike u veličini slova (zadano)\n"
"  -w, --word-regexp         podudara samo cijele riječi\n"
"  -x, --line-regexp         podudara samo cijele retke\n"
"  -z, --null-data           redak podataka završava nultim bajtom, a ne znakom novog retka\n"

#: src/grep.c:2002
#, c-format
msgid ""
"\n"
"Miscellaneous:\n"
"  -s, --no-messages         suppress error messages\n"
"  -v, --invert-match        select non-matching lines\n"
"  -V, --version             display version information and exit\n"
"      --help                display this help text and exit\n"
msgstr ""
"\n"
"Razno:\n"
"  -s, --no-messages         potiskuje poruke o greškama\n"
"  -v, --invert-match        odabire retke koji se ne podudaraju\n"
"  -V, --version             prikazuje podatke o inačici i izlazi\n"
"      --help                prikazuje ovaj tekst pomoći i izlazi\n"

#: src/grep.c:2009
#, c-format
msgid ""
"\n"
"Output control:\n"
"  -m, --max-count=NUM       stop after NUM selected lines\n"
"  -b, --byte-offset         print the byte offset with output lines\n"
"  -n, --line-number         print line number with output lines\n"
"      --line-buffered       flush output on every line\n"
"  -H, --with-filename       print file name with output lines\n"
"  -h, --no-filename         suppress the file name prefix on output\n"
"      --label=LABEL         use LABEL as the standard input file name prefix\n"
msgstr ""
"\n"
"Upravljanje izlazom:\n"
"  -m, --max-count=BROJ      zaustavlja se nakon BROJ odabranih redaka\n"
"  -b, --byte-offset         ispisuje pomak u bajtovima uz izlazne retke\n"
"  -n, --line-number         ispisuje broj retka uz izlazne retke\n"
"      --line-buffered       prazni izlaz nakon svakog retka\n"
"  -H, --with-filename       ispisuje ime datoteke uz izlazne retke\n"
"  -h, --no-filename         potiskuje prefiks s imenom datoteke u izlazu\n"
"      --label=OZNAKA        koristi OZNAKU kao prefiks imena datoteke za standardni ulaz\n"

#: src/grep.c:2020
#, c-format
msgid ""
"  -o, --only-matching       show only nonempty parts of lines that match\n"
"  -q, --quiet, --silent     suppress all normal output\n"
"      --binary-files=TYPE   assume that binary files are TYPE;\n"
"                            TYPE is 'binary', 'text', or 'without-match'\n"
"  -a, --text                equivalent to --binary-files=text\n"
msgstr ""
"  -o, --only-matching       prikazuje samo neprazne dijelove redaka koji se podudaraju\n"
"  -q, --quiet, --silent     potiskuje sav uobičajeni izlaz\n"
"      --binary-files=VRSTA  pretpostavlja da su binarne datoteke vrste VRSTA;\n"
"                            VRSTA je 'binary', 'text' ili 'without-match'\n"
"  -a, --text                isto je kao '--binary-files=text'\n"

#: src/grep.c:2027
#, c-format
msgid ""
"  -I                        equivalent to --binary-files=without-match\n"
"  -d, --directories=ACTION  how to handle directories;\n"
"                            ACTION is 'read', 'recurse', or 'skip'\n"
"  -D, --devices=ACTION      how to handle devices, FIFOs and sockets;\n"
"                            ACTION is 'read' or 'skip'\n"
"  -r, --recursive           like --directories=recurse\n"
"  -R, --dereference-recursive  likewise, but follow all symlinks\n"
msgstr ""
"  -I                        isto je kao '--binary-files=without-match'\n"
"  -d, --directories=AKCIJA  kako obrađuje direktorije;\n"
"                            AKCIJA je 'read', 'recurse' ili 'skip'\n"
"  -D, --devices=AKCIJA      kako obrađuje uređaje, FIFO-ove i utičnice;\n"
"                            AKCIJA je 'read' ili 'skip'\n"
"  -r, --recursive           isto je kao '--directories=recurse'\n"
"  -R, --dereference-recursive  jednako, ali slijedi sve simboličke poveznice\n"

#: src/grep.c:2036
#, c-format
msgid ""
"      --include=GLOB        search only files that match GLOB (a file pattern)\n"
"      --exclude=GLOB        skip files that match GLOB\n"
"      --exclude-from=FILE   skip files that match any file pattern from FILE\n"
"      --exclude-dir=GLOB    skip directories that match GLOB\n"
msgstr ""
"      --include=GLOB        pretražuje samo datoteke koje se podudaraju s\n"
"                            GLOB-om (uzorkom datoteke)\n"
"      --exclude=GLOB        preskače datoteke koje se podudaraju s GLOB-om\n"
"      --exclude-from=DATOTEKA  preskače datoteke koje se podudaraju s bilo\n"
"                               kojim uzorkom datoteke iz DATOTEKE\n"
"      --exclude-dir=GLOB    preskače direktorije koji se podudaraju s GLOB-om\n"

#: src/grep.c:2043
#, c-format
msgid ""
"  -L, --files-without-match  print only names of FILEs with no selected lines\n"
"  -l, --files-with-matches  print only names of FILEs with selected lines\n"
"  -c, --count               print only a count of selected lines per FILE\n"
"  -T, --initial-tab         make tabs line up (if needed)\n"
"  -Z, --null                print 0 byte after FILE name\n"
msgstr ""
"  -L, --files-without-match  ispisuje samo imena DATOTEKA bez odabranih redaka\n"
"  -l, --files-with-matches  ispisuje samo imena DATOTEKA s odabranim recima\n"
"  -c, --count               ispisuje samo broj odabranih redaka po DATOTECI\n"
"  -T, --initial-tab         poravnava tabove (ako je potrebno)\n"
"  -Z, --null                ispisuje nulti bajt nakon imena DATOTEKE\n"

#: src/grep.c:2049
#, c-format
msgid ""
"\n"
"Context control:\n"
"  -B, --before-context=NUM  print NUM lines of leading context\n"
"  -A, --after-context=NUM   print NUM lines of trailing context\n"
"  -C, --context=NUM         print NUM lines of output context\n"
msgstr ""
"\n"
"Upravljanje kontekstom:\n"
"  -B, --before-context=BROJ  ispisuje BROJ prethodnih redaka konteksta\n"
"  -A, --after-context=BROJ  ispisuje BROJ sljedećih redaka konteksta\n"
"  -C, --context=BROJ        ispisuje BROJ redaka izlaznog konteksta\n"

#: src/grep.c:2056
#, c-format
msgid ""
"  -NUM                      same as --context=NUM\n"
"      --group-separator=SEP  print SEP on line between matches with context\n"
"      --no-group-separator  do not print separator for matches with context\n"
"      --color[=WHEN],\n"
"      --colour[=WHEN]       use markers to highlight the matching strings;\n"
"                            WHEN is 'always', 'never', or 'auto'\n"
"  -U, --binary              do not strip CR characters at EOL (MSDOS/Windows)\n"
"\n"
msgstr ""
"  -BROJ                     isto je kao '--context=BROJ'\n"
"      --group-separator=SEP  ispisuje SEP u retku između podudaranja s\n"
"      --no-group-separator  ne ispisuje razdjelnik između podudaranja s\n"
"      --color[=KAD],\n"
"      --colour[=KAD]       koristi oznake za isticanje stringova koji se\n"
"                            podudaraju; KAD je 'always', 'never' ili 'auto'\n"
"  -U, --binary              ne uklanja znakove CR na kraju retka\n"
"                            (MSDOS/Windows)\n"
"\n"

#: src/grep.c:2065
#, c-format
msgid ""
"When FILE is '-', read standard input.  If no FILE is given, read standard\n"
"input, but with -r, recursively search the working directory instead.  With\n"
"fewer than two FILEs, assume -h.  Exit status is 0 if any line is selected,\n"
"1 otherwise; if any error occurs and -q is not given, the exit status is 2.\n"
msgstr ""
"Ako je DATOTEKA '-', čita standardni ulaz. Ako DATOTEKA nije zadana,\n"
"također čita standardni ulaz, ali s '-r' umjesto toga rekurzivno\n"
"pretražuje radni direktorij. S manje od dvije DATOTEKE pretpostavlja\n"
"opciju -h. Izlazno stanje je 0 ako je odabran barem jedan redak,\n"
"inače 1; ako dođe do greške, a '-q' nije zadana, izlazno stanje je 2.\n"

