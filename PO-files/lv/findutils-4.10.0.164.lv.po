#: find/tree.c:837
#, c-format
msgid "oops -- invalid expression type!  This is probably a bug."
msgstr "ups — nederīgs izteiksmes tips!  Droši vien tā ir kļūda."

#: find/tree.c:1092
#, c-format
msgid "failed to sort the costlookup array"
msgstr "neizdevās sakārtot costlookup masīvu"

