#: find/tree.c:196
#, c-format
msgid "invalid expression; empty parentheses are not allowed."
msgstr "nederīga izteiksme; tukšas iekavas nav atļautas."

#: find/tree.c:202
#, c-format
msgid "invalid expression; I was expecting to find a ')' somewhere but did not see one."
msgstr "nederīga izteiksme; netika atrasta noslēdzošā iekava ')'."

#: find/tree.c:209
#, c-format
