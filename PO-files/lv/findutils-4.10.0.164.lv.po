msgstr "nederīgs lietotājvārds vai UID arguments opcijai -user: %s"

#: find/parser.c:2433
#, c-format
msgid "Features enabled: "
msgstr "Iespējotās funkcijas: "

#: find/parser.c:2479
#, c-format
msgid "invalid predicate -context: SELinux is not enabled."
msgstr "nederīgs predikāts -context: SELinux nav iespējots."

#: find/parser.c:2547
#, c-format
msgid "Arguments to %s should contain at least one letter"
msgstr "Argumentos %s jābūt vismaz vienam burtam"

#: find/parser.c:2612
#, c-format
msgid "%s %c is not supported because symbolic links are not supported on the platform find was compiled on."
msgstr "%s %c nav atbalstīts, jo simboliskās saites nav atbalstītas platformā, kurā tika kompilēts find."

#: find/parser.c:2624
#, c-format
msgid "%s %c is not supported because FIFOs are not supported on the platform find was compiled on."
msgstr "%s %c nav atbalstīts, jo FIFO nav atbalstīti platformā, kurā tika kompilēts find."

#: find/parser.c:2636
#, c-format
msgid "%s %c is not supported because named sockets are not supported on the platform find was compiled on."
msgstr "%s %c nav atbalstīts, jo nosauktās ligzdas nav atbalstītas platformā, kurā tika kompilēts find."

#: find/parser.c:2652
#, c-format
msgid "%s %c is not supported because Solaris doors are not supported on the platform find was compiled on."
msgstr "%s %c nav atbalstīts, jo Solaris durvis nav atbalstītas platformā, kurā tika kompilēts find."

#: find/parser.c:2660
#, c-format
msgid "Unknown argument to %s: %c"
msgstr "Nezināms arguments opcijai %s: %c"

#: find/parser.c:2668
#, c-format
msgid "Duplicate file type '%c' in the argument list to %s."
msgstr "Dublēts faila tips '%c' %s argumentu sarakstā."

