msgstr "Nederīgs arguments `%s%s` opcijai -size"

#: find/parser.c:2378
#, c-format
msgid "Invalid argument %s to -used"
msgstr "Nederīgs arguments %s opcijai -used"

#: find/parser.c:2411
#, c-format
