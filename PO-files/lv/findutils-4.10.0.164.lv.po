"      -ctime N -empty -false -fstype TYPE -gid N -group NAME -ilname ŠABLONS\n"
"      -iname ŠABLONS -inum N -iwholename ŠABLONS -iregex ŠABLONS\n"
"      -links N -lname ŠABLONS -mmin N -mtime N -name ŠABLONS -newer FAILS\n"
"      -newerXY ATSAUCE -nouser -nogroup -path ŠABLONS -perm [-/]REŽĪMS\n"
"      -regex ŠABLONS -readable -writable -executable\n"
"      -wholename ŠABLONS -size N[bcwkMG] -true -type [bcdpflsD] -uid N\n"
"      -used N -user NAME -xtype [bcdpfls]\n"

#: find/util.c:195
