msgid "Valid arguments for -D:\n"
msgstr "Derīgie argumenti opcijai -D:\n"

#: find/util.c:161 locate/frcode.c:138 locate/locate.c:1361 xargs/xargs.c:1767
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Izmēģiniet '%s --help', lai iegūtu vairāk informācijas.\n"

#: find/util.c:167
#, c-format
msgid "Usage: %s [-H] [-L] [-P] [-Olevel] [-D debugopts] [path...] [expression]\n"
msgstr "Lietošana: %s [-H] [-L] [-P] [-Olevel] [-D debugopts] [ceļš...] [izteiksme]\n"

#: find/util.c:171
msgid ""
"\n"
"Default path is the current directory; default expression is -print.\n"
"Expression may consist of: operators, options, tests, and actions.\n"
msgstr ""
"\n"
"Noklusējuma ceļš ir pašreizējā direktorija; noklusējuma izteiksme ir -print.\n"
"Izteiksme var sastāvēt no: operatoriem, opcijām, pārbaudēm un darbībām.\n"

#: find/util.c:174
msgid ""
"\n"
"Operators (decreasing precedence; -and is implicit where no others are given):\n"
"      ( EXPR )   ! EXPR   -not EXPR   EXPR1 -a EXPR2   EXPR1 -and EXPR2\n"
"      EXPR1 -o EXPR2   EXPR1 -or EXPR2   EXPR1 , EXPR2\n"
msgstr ""
"\n"
