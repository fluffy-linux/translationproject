msgstr "Neizdevās inicializēt koplietojamo failu haštabulu"

#: find/ftsfind.c:752 locate/frcode.c:218 locate/locate.c:1564
#: xargs/xargs.c:433
#, c-format
msgid "The atexit library function failed"
msgstr "Neizdevās izsaukt atexit bibliotēkas funkciju"

#: find/parser.c:440
#, c-format
msgid "The -delete action automatically turns on -depth, but -prune does nothing when -depth is in effect.  If you want to carry on anyway, just explicitly use the -depth option."
msgstr "Darbība -delete automātiski ieslēdz -depth, bet -prune neko nedara, ja ir aktīvs -depth.  Ja tomēr vēlaties turpināt, skaidri norādiet opciju -depth."

#: find/parser.c:598
#, c-format
msgid "warning: you have specified the global option %s after the argument %s, but global options are not positional, i.e., %s affects tests specified before it as well as those specified after it.  Please specify global options before other arguments."
msgstr "brīdinājums: esat norādījis globālo opciju %s pēc argumenta %s, taču globālās opcijas nav pozicionālas, t.i., %s ietekmē gan testus, kas norādīti pirms tās, gan arī tos, kas norādīti pēc tās. Lūdzu, norādiet globālās opcijas pirms citiem argumentiem."

#: find/parser.c:658
#, c-format
msgid "warning: operator '%s' (with leading dash '-') will no longer be accepted in future findutils releases!"
msgstr "brīdinājums: operators '%s' (ar sākuma domuzīmi '-') nākotnē vairs netiks pieņemts findutils laidienos!"

#: find/parser.c:915
#, c-format
msgid "warning: the -d option is deprecated; please use -depth instead, because the latter is a POSIX-compliant feature."
msgstr "brīdinājums: opcija -d ir novecojusi; lūdzu, izmantojiet -depth, jo tā ir atbilstoša POSIX standartam."

#: find/parser.c:1159
#, c-format
msgid "invalid group name or GID argument to -group: %s"
msgstr "nederīgs grupas nosaukuma vai GID arguments opcijai -group: %s"

#: find/parser.c:1232
#, c-format
msgid "basic correctness check of the fnmatch() library function failed."
msgstr "neizdevās veikt fnmatch() bibliotēkas funkcijas pamatpārbaudi."

#: find/parser.c:1247
#, c-format
msgid "warning: %s matches against basenames only, but the given pattern contains a directory separator (%s), thus the expression will evaluate to false all the time.  Did you mean %s?"
msgstr "brīdinājums: %s atbilst tikai pamatnosaukumiem, bet norādītais paraugs satur direktorijas atdalītāju (%s), tāpēc izteiksme vienmēr tiks novērtēta kā nepatiesa.  Vai jūs domājāt %s?"

#: find/parser.c:1361
#, c-format
msgid "Expected a positive decimal integer argument to %s, but got %s"
msgstr "Opcijai %s nepieciešams pozitīvs decimāls vesels skaitlis, bet saņemts %s"

#: find/parser.c:1520
#, c-format
msgid "This system does not provide a way to find the birth time of a file."
msgstr "Šī sistēma nenodrošina iespēju noteikt faila izveides laiku."

#: find/parser.c:1541
#, c-format
msgid "The %s test needs to be followed by an argument"
msgstr "Pēc %s testa ir jānorāda arguments"

#: find/parser.c:1578
#, c-format
msgid "I cannot figure out how to interpret %s as a date or time"
msgstr "Neizdevās saprast, kā interpretēt %s kā datumu vai laiku"

#: find/parser.c:1595
#, c-format
msgid "Cannot obtain birth time of file %s"
msgstr "Neizdevās iegūt faila %s izveides laiku"

#. TRANSLATORS: the first argument here (-%s) expands to the a test
#. * which the user specified on the command line. The second is the
#. * argument they gave for it.   These might be, for example:
#. *
#. * warning: -ipath foo/ will not match anything...
#. * warning: -path z/q/ will not match anything...
#.
#: find/parser.c:1746
#, c-format
msgid "warning: -%s %s will not match anything because it ends with /."
msgstr "brīdinājums: -%s %s neatradīs nevienu atbilstību, jo beidzas ar /."

#. TRANSLATORS: "mode" here is used in the same sense as we use
#. * for the "chmod" program.
#.
#: find/parser.c:1845
#, c-format
msgid "invalid file mode %s"
msgstr "nederīgs faila režīms %s"

#: find/parser.c:1864
#, c-format
msgid "warning: you have specified a mode pattern %s (which is equivalent to /000). The meaning of -perm /000 was changed in 2007 to be consistent with -perm -000; that is, while it used to match no files, it now matches all files. This warning message will be removed in a future findutils release."
msgstr "brīdinājums: esat norādījis režīma paraugu %s (kas ir līdzvērtīgs /000). Opcijas -perm /000 nozīme tika mainīta 2007. gadā, lai tā būtu saskaņota ar -perm -000; proti, ja iepriekš tā neatbilda nevienam failam, tad tagad tā atbilst visiem failiem. Šis brīdinājums tiks noņemts kādā no nākamajiem findutils laidieniem."

#: find/parser.c:2039
#, c-format
msgid "failed to compile regular expression '%s': %s"
msgstr "neizdevās kompilēt regulāro izteiksmi '%s': %s"

#: find/parser.c:2069
#, c-format
msgid "invalid null argument to -size"
msgstr "nederīgs tukšs arguments opcijai -size"

#: find/parser.c:2119
#, c-format
msgid "invalid -size type `%c'"
msgstr "nederīgs -size veids `%c`"

#: find/parser.c:2129
#, c-format
