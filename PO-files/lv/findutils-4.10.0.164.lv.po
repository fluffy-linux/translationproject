#, c-format
msgid "Must separate multiple arguments to %s using: ','"
msgstr "Vairāki argumenti opcijai %s jāatdala ar ','"

#: find/parser.c:2693
#, c-format
msgid "Last file type in list argument to %s is missing, i.e., list is ending on: ','"
msgstr "Trūkst pēdējā faila tipa opcijas %s saraksta argumentā, t.i., saraksts beidzas ar ','"

#: find/parser.c:2752
#, c-format
msgid "The current directory is included in the PATH environment variable, which is insecure in combination with the %s action of find.  Please remove the current directory from your $PATH (that is, remove \".\", doubled colons, or leading or trailing colons)"
msgstr "Pašreizējā direktorija ir iekļauta PATH vides mainīgajā, kas kombinācijā ar find darbību %s ir nedroši.  Lūdzu, noņemiet pašreizējo direktoriju no sava $PATH (t.i., noņemiet \".\", dubultkolus vai kolus sākumā vai beigās)."

#: find/parser.c:2764
#, c-format
msgid "The relative path %s is included in the PATH environment variable, which is insecure in combination with the %s action of find.  Please remove that entry from $PATH"
msgstr "Relatīvais ceļš %s ir iekļauts PATH vides mainīgajā, kas kombinācijā ar find darbību %s ir nedroši. Lūdzu, noņemiet šo ierakstu no $PATH"

#: find/parser.c:2883
#, c-format
msgid "You may not use {} within the utility name for -execdir and -okdir, because this is a potential security problem."
msgstr "Nedrīkst izmantot {} utilītas nosaukumā opcijām -execdir un -okdir, jo tā ir potenciāla drošības problēma."

#: find/parser.c:2909
#, c-format
msgid "Only one instance of {} is supported with -exec%s ... +"
msgstr "Ar -exec%s ... + tiek atbalstīts tikai viens {} eksemplārs"

#: find/parser.c:2919
#, c-format
msgid "In %s the %s must appear by itself, but you specified %s"
msgstr "Opcijā %s arguments %s jānorāda atsevišķi, bet jūs norādījāt %s"

#: find/parser.c:2938
#, c-format
msgid "The environment is too large for exec()."
msgstr "Vide ir pārāk liela funkcijai exec()."

#: find/parser.c:3048
#, c-format
