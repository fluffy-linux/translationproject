#, c-format
msgid "POSIX smallest allowable upper limit on argument length (all systems): %<PRIuMAX>\n"
msgstr "POSIX mazākā pieļaujamā argumenta garuma augšējā robeža (visās sistēmās): %<PRIuMAX>\n"

#: xargs/xargs.c:794
#, c-format
msgid "Maximum length of command we could actually use: %<PRIuMAX>\n"
msgstr "Maksimālais komandas garums, ko varētu izmantot: %<PRIuMAX>\n"

#: xargs/xargs.c:797
#, c-format
msgid "Size of command buffer we are actually using: %<PRIuMAX>\n"
msgstr "Faktiski izmantotā komandu bufera izmērs: %<PRIuMAX>\n"

#: xargs/xargs.c:800
#, c-format
msgid "Maximum parallelism (--max-procs must be no greater): %<PRIuMAX>\n"
msgstr "Maksimālais paralēlisms (--max-procs nedrīkst pārsniegt): %<PRIuMAX>\n"

#: xargs/xargs.c:806
#, c-format
msgid ""
"\n"
"Execution of xargs will continue now, and it will try to read its input and run commands; if this is not what you wanted to happen, please type the end-of-file keystroke.\n"
msgstr ""
"\n"
"xargs izpilde turpināsies tagad, un tas mēģinās nolasīt savu ievadi un palaist komandas; ja tas nav tas, ko vēlējāties, lūdzu, ievadiet faila beigu taustiņu.\n"

#: xargs/xargs.c:814
#, c-format
msgid "Warning: %s will be run at least once.  If you do not want that to happen, then press the interrupt keystroke.\n"
msgstr "Brīdinājums: %s tiks izpildīts vismaz vienu reizi.  Ja nevēlaties, lai tas notiktu, nospiediet pārtraukšanas taustiņu.\n"

#: xargs/xargs.c:946 xargs/xargs.c:1042
#, c-format
msgid "unmatched %s quote; by default quotes are special to xargs unless you use the -0 option"
msgstr "nesaskaņota %s pēdiņa; pēc noklusējuma pēdiņas xargs uzskata par īpašām, ja vien neizmanto opciju -0"

#: xargs/xargs.c:948 xargs/xargs.c:1044
msgid "double"
msgstr "dubultās"

#: xargs/xargs.c:948 xargs/xargs.c:1044
msgid "single"
msgstr "vienas"

#: xargs/xargs.c:1063
#, c-format
msgid "WARNING: a NUL character occurred in the input.  It cannot be passed through in the argument list.  Did you mean to use the --null option?"
msgstr "BRĪDINĀJUMS: ievadē atrasta NUL rakstzīme.  To nevar nodot tālāk argumentu sarakstā.  Vai domājāt izmantot opciju --null?"

#: xargs/xargs.c:1073 xargs/xargs.c:1140
#, c-format
msgid "argument line too long"
msgstr "argumentu rinda ir pārāk gara"

#: xargs/xargs.c:1168 xargs/xargs.c:1192
#, c-format
msgid "Failed to write to standard error"
msgstr "Neizdevās rakstīt standarta kļūdu izvadē"

#: xargs/xargs.c:1182
#, c-format
msgid "failed to open /dev/tty for reading"
msgstr "neizdevās atvērt /dev/tty lasīšanai"

#: xargs/xargs.c:1199
#, c-format
msgid "Failed to read from standard input"
msgstr "Neizdevās nolasīt no standarta ievades"

#: xargs/xargs.c:1235
#, c-format
msgid "failed to set environment variable %s"
msgstr "neizdevās iestatīt vides mainīgo %s"

#: xargs/xargs.c:1289
#, c-format
msgid "failed to redirect standard input of the child process"
msgstr "neizdevās novirzīt apakšprocesa standarta ievadi"

#. TRANSLATORS: The pipe being referred to is an
#. * operating-system object for communicating between
#. * processes (created by the "pipe" system call), not a
#. * piece of plumbing.  These just happen to have the same
#. * name in English.  Similarly, fork is also the name of a
#. * specific system call (named by analogy to English idioms
#. * such as "fork in the road") not a thing you might eat
#. * with.
#.
#: xargs/xargs.c:1351
#, c-format
msgid "could not create pipe before fork"
msgstr "neizdevās izveidot cauruļvadu pirms atzarojuma"

#: xargs/xargs.c:1405
#, c-format
msgid "failed to run command %s"
msgstr "neizdevās palaist komandu %s"

#: xargs/xargs.c:1435
#, c-format
msgid "errno-buffer safe_read failed in xargs_do_exec (this is probably a bug, please report it)"
msgstr "errno-buffer safe_read neizdevās xargs_do_exec (iespējams, šī ir kļūda, lūdzu, ziņojiet par to)"

#: xargs/xargs.c:1566
#, c-format
msgid "error waiting for child process"
msgstr "kļūda, gaidot pakārtoto procesu"

#: xargs/xargs.c:1599
#, c-format
msgid "WARNING: Lost track of %lu child processes"
msgstr "BRĪDINĀJUMS: zaudēta uzskaite par %lu pakārtotajiem procesiem"

#: xargs/xargs.c:1627
#, c-format
msgid "%s: exited with status 255; aborting"
msgstr "%s: izgāja ar statusu 255; darbība tiek pārtraukta"

#: xargs/xargs.c:1632
#, c-format
msgid "%s: stopped by signal %d"
msgstr "%s: apturēts ar signālu %d"

#: xargs/xargs.c:1638
#, c-format
msgid "%s: terminated by signal %d"
msgstr "%s: pārtraukts ar signālu %d"

#: xargs/xargs.c:1736
#, c-format
msgid "%s: invalid number \"%s\" for -%c option\n"
msgstr "%s: nederīgs skaitlis \"%s\" opcijai -%c\n"

#: xargs/xargs.c:1743
#, c-format
msgid "%s: value %s for -%c option should be >= %ld\n"
msgstr "%s: vērtībai %s opcijai -%c ir jābūt >= %ld\n"

#: xargs/xargs.c:1752
#, c-format
msgid "%s: value %s for -%c option should be <= %ld\n"
msgstr "%s: vērtībai %s opcijai -%c jābūt <= %ld\n"

#: xargs/xargs.c:1772
#, c-format
msgid "Usage: %s [OPTION]... [COMMAND [INITIAL-ARGS]...]\n"
msgstr "Lietošana: %s [OPCIJA]... [KOMANDA [SĀKOTNĒJIE-ARGUMENTI]...]\n"

#: xargs/xargs.c:1777
msgid ""
"Run COMMAND with arguments INITIAL-ARGS and more arguments read from input.\n"
"\n"
msgstr ""
"Palaist KOMANDU ar argumentiem SĀKTONĒJIE-ARGUMENTI un papildu argumentiem, kas nolasīti no ievades.\n"
"\n"

#: xargs/xargs.c:1779
msgid ""
"Mandatory and optional arguments to long options are also\n"
"mandatory or optional for the corresponding short option.\n"
msgstr ""
"Obligātie un neobligātie argumenti garajām opcijām ir arī\n"
"obligāti vai neobligāti attiecīgajām īsajām opcijām.\n"

#: xargs/xargs.c:1781
msgid ""
"  -0, --null                   items are separated by a null, not whitespace;\n"
"                                 disables quote and backslash processing and\n"
"                                 logical EOF processing\n"
msgstr ""
"  -0, --null                   elementi ir atdalīti ar nulles rakstzīmi, nevis tukšumzīmēm;\n"
"                                 atspējo pēdiņu un atpakaļsvītras apstrādi un\n"
"                                 loģiskās EOF apstrādi\n"

#: xargs/xargs.c:1784
msgid "  -a, --arg-file=FILE          read arguments from FILE, not standard input\n"
msgstr "  -a, --arg-file=FAILS          nolasīt argumentus no FAILA, nevis no standarta ievades\n"

#: xargs/xargs.c:1785
msgid ""
"  -d, --delimiter=CHARACTER    items in input stream are separated by CHARACTER,\n"
"                                 not by whitespace; disables quote and backslash\n"
"                                 processing and logical EOF processing\n"
msgstr ""
"  -d, --delimiter=RAKSTZĪME    ievades straumes elementi tiek atdalīti ar RAKSTZĪMI,\n"
"                                 nevis ar tukšumzīmēm; atspējo pēdiņu un atpakaļsvītras\n"
"                                 apstrādi un loģiskās EOF apstrādi\n"

#: xargs/xargs.c:1788
msgid ""
"  -E END                       set logical EOF string; if END occurs as a line\n"
"                                 of input, the rest of the input is ignored\n"
"                                 (ignored if -0 or -d was specified)\n"
msgstr ""
"  -E END                       iestatīt loģisko EOF virkni; ja END parādās kā ievades rindiņa,\n"
"                                 pārējā ievade tiek ignorēta\n"
"                                 (tiek ignorēts, ja norādīts -0 vai -d)\n"

#: xargs/xargs.c:1791
msgid ""
"  -e, --eof[=END]              equivalent to -E END if END is specified;\n"
"                                 otherwise, there is no end-of-file string\n"
msgstr ""
"  -e, --eof[=END]              ekvivalents -E END, ja ir norādīts END;\n"
"                                 pretējā gadījumā faila beigu virknes nav\n"

#: xargs/xargs.c:1793
msgid "  -I R                         same as --replace=R\n"
msgstr "  -I R                         tas pats, kas --replace=R\n"

#: xargs/xargs.c:1794
msgid ""
"  -i, --replace[=R]            replace R in INITIAL-ARGS with names read\n"
"                                 from standard input, split at newlines;\n"
"                                 if R is unspecified, assume {}\n"
msgstr ""
"  -i, --replace[=R]            aizstāt R sākotnējos argumentos ar nosaukumiem, kas nolasīti\n"
"                                 no standarta ievades, sadalot pēc jaunām rindām;\n"
"                                 ja R nav norādīts, tiek pieņemts {}\n"

#: xargs/xargs.c:1797
msgid ""
"  -L, --max-lines=MAX-LINES    use at most MAX-LINES non-blank input lines per\n"
"                                 command line\n"
msgstr ""
"  -L, --max-lines=MAX-RINDAS    izmantot ne vairāk kā MAX-RINDAS netukšas ievades rindas katrā\n"
"                                 komandrindā\n"

#: xargs/xargs.c:1799
msgid ""
"  -l[MAX-LINES]                similar to -L but defaults to at most one non-\n"
"                                 blank input line if MAX-LINES is not specified\n"
msgstr ""
"  -l[MAX-RINDAS]                līdzīgs -L, bet pēc noklusējuma izmanto ne vairāk kā vienu netukšu\n"
"                                 ievades rindu, ja MAX-RINDAS nav norādīts\n"

#: xargs/xargs.c:1801
msgid "  -n, --max-args=MAX-ARGS      use at most MAX-ARGS arguments per command line\n"
msgstr "  -n, --max-args=MAX-ARGS      izmantot ne vairāk kā MAX-ARGS argumentus katrā komandrindā\n"

#: xargs/xargs.c:1802
msgid ""
"  -o, --open-tty               Reopen standard input as /dev/tty in the child\n"
"                                 process before executing the command; useful to\n"
"                                 run an interactive application.\n"
msgstr ""
"  -o, --open-tty               Atkārtoti atvērt standarta ievadi kā /dev/tty pakārtotajā\n"
"                                 procesā pirms komandas izpildes; noderīgi, lai\n"
"                                 palaistu interaktīvu lietotni.\n"

#: xargs/xargs.c:1805
msgid "  -P, --max-procs=MAX-PROCS    run at most MAX-PROCS processes at a time\n"
msgstr "  -P, --max-procs=MAX-PROCS    vienlaicīgi palaist ne vairāk kā MAX-PROCS procesus\n"

#: xargs/xargs.c:1806
msgid "  -p, --interactive            prompt before running commands\n"
msgstr "  -p, --interactive            vaicāt pirms komandu izpildes\n"

#: xargs/xargs.c:1807
msgid "      --process-slot-var=VAR   set environment variable VAR in child processes\n"
msgstr "      --process-slot-var=VAR   iestatīt vides mainīgo VAR pakārtotajos procesos\n"

#: xargs/xargs.c:1808
msgid ""
"  -r, --no-run-if-empty        if there are no arguments, then do not run COMMAND;\n"
"                                 if this option is not given, COMMAND will be\n"
"                                 run at least once\n"
msgstr ""
"  -r, --no-run-if-empty        ja nav argumentu, tad neizpildīt KOMANDU;\n"
"                                 ja šī opcija nav norādīta, KOMANDA tiks\n"
"                                 izpildīta vismaz vienu reizi\n"

#: xargs/xargs.c:1811
msgid "  -s, --max-chars=MAX-CHARS    limit length of command line to MAX-CHARS\n"
msgstr "  -s, --max-chars=MAX-RAKSTZĪMES    ierobežot komandrindas garumu līdz MAX-RAKSTZĪMĒM\n"

#: xargs/xargs.c:1812
msgid "      --show-limits            show limits on command-line length\n"
msgstr "      --show-limits            parādīt komandrindas garuma ierobežojumus\n"

#: xargs/xargs.c:1813
msgid "  -t, --verbose                print commands before executing them\n"
msgstr "  -t, --verbose                izdrukāt komandas pirms to izpildes\n"

#: xargs/xargs.c:1814
msgid "  -x, --exit                   exit if the size (see -s) is exceeded\n"
msgstr "  -x, --exit                   iziet, ja tiek pārsniegts izmērs (skat. -s)\n"

#: xargs/xargs.c:1818
msgid ""
"If COMMAND is omitted, the default is 'echo'.\n"
"\n"
msgstr ""
"Ja KOMANDA nav norādīta, noklusējuma vērtība ir 'echo'.\n"
"\n"
