#: src/main.c:319
msgid "Options:\n"
msgstr "Opcijas:\n"

#: src/main.c:320
msgid "  -b, -m                      Ignored for compatibility.\n"
msgstr "  -b, -m                      Ignorēts saderības dēļ.\n"

#: src/main.c:322
msgid "  -B, --always-make           Unconditionally make all targets.\n"
msgstr "  -B, --always-make           Beznosacījumu veidot visus mērķus.\n"

#: src/main.c:324
msgid ""
"  -C DIRECTORY, --directory=DIRECTORY\n"
"                              Change to DIRECTORY before doing anything.\n"
msgstr ""
"  -C DIREKTORIJA, --directory=DIREKTORIJA\n"
"                              Pirms jebkādām darbībām pāriet uz DIREKTORIJU.\n"

#: src/main.c:327
msgid "  -d                          Print lots of debugging information.\n"
msgstr "  -d                          Izvadīt daudz atkļūdošanas informācijas.\n"

#: src/main.c:329
msgid "  --debug[=FLAGS]             Print various types of debugging information.\n"
msgstr "  --debug[=FLAGS]             Izvadīt dažāda veida atkļūdošanas informāciju.\n"

#: src/main.c:331
msgid ""
"  -e, --environment-overrides\n"
"                              Environment variables override makefiles.\n"
msgstr ""
"  -e, --environment-overrides\n"
"                              Vides mainīgie ignorē makefile.\n"

#: src/main.c:334
msgid "  -E STRING, --eval=STRING    Evaluate STRING as a makefile statement.\n"
msgstr "  -E VIRKNE, --eval=VIRKNE    Novērtēt VIRKNI kā makefile priekšrakstu.\n"

#: src/main.c:336
msgid ""
"  -f FILE, --file=FILE, --makefile=FILE\n"
"                              Read FILE as a makefile.\n"
msgstr ""
"  -f FAILS, --file=FAILS, --makefile=FAILS\n"
"                              Lasīt FAILU kā makefile.\n"

#: src/main.c:339
msgid "  -h, --help                  Print this message and exit.\n"
msgstr "  -h, --help                  Izvadīt šo ziņojumu un iziet.\n"

#: src/main.c:341
msgid "  -i, --ignore-errors         Ignore errors from recipes.\n"
msgstr "  -i, --ignore-errors         Ignorēt recepšu kļūdas.\n"

#: src/main.c:343
msgid ""
"  -I DIRECTORY, --include-dir=DIRECTORY\n"
"                              Search DIRECTORY for included makefiles.\n"
msgstr ""
"  -I DIREKTORIJA, --include-dir=DIREKTORIJA\n"
"                              Meklēt iekļautos makefile DIREKTORIJĀ.\n"

#: src/main.c:346
msgid "  -j [N], --jobs[=N]          Allow N jobs at once; infinite jobs with no arg.\n"
msgstr "  -j [N], --jobs[=N]          Atļaut vienlaikus N darbus; bez N — neierobežoti.\n"

#: src/main.c:348
msgid "  --jobserver-style=STYLE     Select the style of jobserver to use.\n"
msgstr "  --jobserver-style=STILS     Izvēlēties izmantojamo darbu servera stilu.\n"

#: src/main.c:350
msgid "  -k, --keep-going            Keep going when some targets can't be made.\n"
msgstr "  -k, --keep-going            Turpināt, ja dažus mērķus nevar izveidot.\n"

#: src/main.c:352
msgid ""
"  -l [N], --load-average[=N], --max-load[=N]\n"
"                              Don't start multiple jobs unless load is below N.\n"
msgstr ""
"  -l [N], --load-average[=N], --max-load[=N]\n"
"                              Nesākt vairākus darbus, ja noslodze nav zem N.\n"

#: src/main.c:355
msgid "  -L, --check-symlink-times   Use the latest mtime between symlinks and target.\n"
msgstr "  -L, --check-symlink-times   Izmantot jaunāko mtime no simb. saites un mērķa.\n"

#: src/main.c:357
msgid ""
"  -n, --just-print, --dry-run, --recon\n"
"                              Don't actually run any recipe; just print them.\n"
msgstr ""
"  -n, --just-print, --dry-run, --recon\n"
"                              Faktiski nepalaist nevienu recepti; tikai izvadīt.\n"

#: src/main.c:360
msgid ""
"  -o FILE, --old-file=FILE, --assume-old=FILE\n"
"                              Consider FILE to be very old and don't remake it.\n"
msgstr ""
"  -o FAILS, --old-file=FAILS, --assume-old=FAILS\n"
"                              Uzskatīt FAILU par ļoti vecu; neveidot no jauna.\n"

#: src/main.c:363
msgid ""
"  -O[TYPE], --output-sync[=TYPE]\n"
"                              Synchronize output of parallel jobs by TYPE.\n"
msgstr ""
"  -O[TIPS], --output-sync[=TIPS]\n"
"                              Sinhronizēt paralēlo darbu izvadi pēc TIPA.\n"

#: src/main.c:366
msgid "  -p, --print-data-base       Print make's internal database.\n"
msgstr "  -p, --print-data-base       Izvadīt make iekšējo datubāzi.\n"

#: src/main.c:368
msgid "  -q, --question              Run no recipe; exit status says if up to date.\n"
msgstr "  -q, --question              Nepalaist receptes; izejas kods rāda, vai aktuāls.\n"

#: src/main.c:370
msgid "  -r, --no-builtin-rules      Disable the built-in implicit rules.\n"
msgstr "  -r, --no-builtin-rules      Atspējot iebūvētās netiešās kārtulas.\n"

#: src/main.c:372
msgid "  -R, --no-builtin-variables  Disable the built-in variable settings.\n"
msgstr "  -R, --no-builtin-variables  Atspējot iebūvētos mainīgo iestatījumus.\n"

#: src/main.c:374
msgid ""
"  --shuffle[={SEED|random|reverse|none}]\n"
"                              Perform shuffle of prerequisites and goals.\n"
msgstr ""
"  --shuffle[={SEED|random|reverse|none}]\n"
"                              Sajaukt priekšnoteikumus un mērķus.\n"

#: src/main.c:377
msgid "  -s, --silent, --quiet       Don't echo recipes.\n"
msgstr "  -s, --silent, --quiet       Neatbalsot receptes.\n"

#: src/main.c:379
msgid "  --no-silent                 Echo recipes (disable --silent mode).\n"
msgstr "  --no-silent                 Atbalsot receptes (atspējot --silent režīmu).\n"

#: src/main.c:381
msgid ""
"  -S, --no-keep-going, --stop\n"
"                              Turns off -k.\n"
msgstr ""
"  -S, --no-keep-going, --stop\n"
"                              Izslēdz -k.\n"

#: src/main.c:384
msgid "  -t, --touch                 Touch targets instead of remaking them.\n"
msgstr "  -t, --touch                 Pieskarties mērķiem, nevis veidot tos no jauna.\n"

#: src/main.c:386
msgid "  --trace                     Print tracing information.\n"
msgstr "  --trace                     Izvadīt trasēšanas informāciju.\n"

#: src/main.c:388
msgid "  -v, --version               Print the version number of make and exit.\n"
msgstr "  -v, --version               Izvadīt make versijas numuru un iziet.\n"

#: src/main.c:390
msgid "  -w, --print-directory       Print the current directory.\n"
msgstr "  -w, --print-directory       Izvadīt pašreizējo direktoriju.\n"

#: src/main.c:392
msgid "  --no-print-directory        Turn off -w, even if it was turned on implicitly.\n"
msgstr "  --no-print-directory        Izslēgt -w, pat ja tas ieslēgts netieši.\n"

#: src/main.c:394
msgid ""
"  -W FILE, --what-if=FILE, --new-file=FILE, --assume-new=FILE\n"
"                              Consider FILE to be infinitely new.\n"
msgstr ""
"  -W FAILS, --what-if=FAILS, --new-file=FAILS, --assume-new=FAILS\n"
"                              Uzskatīt FAILU par bezgalīgi jaunu.\n"

#: src/main.c:397
msgid "  --warn-undefined-variables  Warn when an undefined variable is referenced.\n"
msgstr "  --warn-undefined-variables  Brīdināt, ja atsaucas uz nedefinētu mainīgo.\n"

