#: src/comm.c:106 src/join.c:195
#, c-format
msgid "Usage: %s [OPTION]... FILE1 FILE2\n"
msgstr "Lietošana: %s [OPCIJA]... FAILS1 FAILS2\n"

#: src/comm.c:110
msgid "Compare sorted files FILE1 and FILE2 line by line.\n"
msgstr "Salīdzināt sakārtotus failus FAILS1 un FAILS2 pa rindām.\n"

#: src/comm.c:113
msgid ""
"\n"
"When FILE1 or FILE2 is -, read standard input.\n"
msgstr ""
"\n"
"Ja FAILS1 vai FAILS2 ir -, lasīt standarta ievadi.\n"

#: src/comm.c:117
msgid ""
"\n"
"With no options, produce three-column output.  Column one contains\n"
"lines unique to FILE1, column two contains lines unique to FILE2,\n"
"and column three contains lines common to both files.\n"
msgstr ""
"\n"
"Bez opcijām veidot trīs kolonnu izvadi. Pirmajā kolonnā ir\n"
"rindas, kas ir unikālas FAILS1, otrajā kolonnā ir rindas, kas ir unikālas FAILS2,\n"
"un trešajā kolonnā ir rindas, kas ir kopīgas abiem failiem.\n"

#: src/comm.c:123
msgid "  -1     suppress column 1 (lines unique to FILE1)\n"
msgstr "  -1     neizvadīt 1. kolonnu (rindas, kas ir unikālas FAILS1)\n"

#: src/comm.c:126
msgid "  -2     suppress column 2 (lines unique to FILE2)\n"
msgstr "  -2     neizvadīt 2. kolonnu (rindas, kas ir unikālas FAILS2)\n"

#: src/comm.c:129
msgid "  -3     suppress column 3 (lines that appear in both files)\n"
msgstr "  -3     neizvadīt 3. kolonnu (rindas, kas ir abos failos)\n"

#: src/comm.c:132
msgid ""
"      --check-order\n"
"         check that the input is correctly sorted,\n"
"         even if all input lines are pairable\n"
msgstr ""
"      --check-order\n"
"         pārbaudīt, vai ievade ir pareizi sakārtota,\n"
"         pat ja visas ievades rindas ir sapārojamas\n"

#: src/comm.c:137 src/join.c:252
msgid ""
"      --nocheck-order\n"
"         do not check that the input is correctly sorted\n"
msgstr ""
"      --nocheck-order\n"
"         nepārbaudīt, vai ievade ir pareizi sakārtota\n"

#: src/comm.c:141
msgid ""
"      --output-delimiter=STR\n"
"         separate columns with STR\n"
msgstr ""
"      --output-delimiter=VIRKNE\n"
"         atdalīt kolonnas ar VIRKNI\n"

#: src/comm.c:145
msgid ""
"      --total\n"
"         output a summary\n"
msgstr ""
"      --total\n"
"         izvadīt kopsavilkumu\n"

