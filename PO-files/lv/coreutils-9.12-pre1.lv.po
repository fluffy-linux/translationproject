#: src/stty.c:876
msgid ""
"   [-]isig       enable interrupt, quit, and suspend special characters\n"
"   [-]noflsh     disable flushing after interrupt and quit special characters\n"
msgstr ""
"   [-]isig       ieslēgt pārtraukuma, iziešanas un apturēšanas īpašās rakstzīmes\n"
"   [-]noflsh     atslēgt iztukšošanu pēc pārtraukuma un iziešanas īpašajām rakstzīmēm\n"

#: src/stty.c:881
msgid " * [-]prterase   same as [-]echoprt\n"
msgstr " * [-]prterase   tas pats, kas [-]echoprt\n"

#: src/stty.c:886
msgid " * [-]tostop     stop background jobs that try to write to the terminal\n"
msgstr " * [-]tostop     apturēt fona darbus, kas mēģina rakstīt terminālī\n"

