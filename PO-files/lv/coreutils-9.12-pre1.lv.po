#: src/chroot.c:184
#, c-format
msgid "Usage: %s [OPTION]... NEWROOT [COMMAND [ARG]...]\n"
msgstr "Lietojums: %s [OPCIJA]... JAUNĀ_SAKNE [KOMANDA [ARG]...]\n"

#: src/chroot.c:187
msgid ""
"Run COMMAND with root directory set to NEWROOT.\n"
"\n"
msgstr ""
"Palaist KOMANDU, iestatot saknes direktoriju uz JAUNO_SAKNI.\n"
"\n"

#: src/chroot.c:192
msgid ""
"      --groups=G_LIST\n"
"         specify supplementary groups as g1,g2,..,gN\n"
msgstr ""
"      --groups=G_LIST\n"
"         norādīt papildu grupas kā g1,g2,..,gN\n"

#: src/chroot.c:196
msgid ""
"      --userspec=USER:GROUP\n"
"         specify user and group (ID or name) to use\n"
msgstr ""
"      --userspec=LIETOTĀJS:GRUPA\n"
"         norādīt lietotāju un grupu (ID vai nosaukumu), ko izmantot\n"

#: src/chroot.c:200
#, c-format
msgid ""
"      --skip-chdir\n"
"         do not change working directory to %s\n"
msgstr ""
"      --skip-chdir\n"
"         nemainīt darba direktoriju uz %s\n"

#: src/chroot.c:207
msgid ""
"\n"
"If no command is given, run '\"$SHELL\" -i' (default: '/bin/sh -i').\n"
msgstr ""
"\n"
"Ja komanda nav norādīta, palaist '\"$SHELL\" -i' (noklusējums: '/bin/sh -i').\n"

#: src/chroot.c:287
#, c-format
msgid "option --skip-chdir only permitted if NEWROOT is old %s"
msgstr "opcija --skip-chdir ir atļauta tikai tad, ja JAUNĀ_SAKNE ir vecā %s"

