msgstr "standarta ievade ir aizvērta"

#: src/paste.c:457
msgid ""
"Write lines consisting of the sequentially corresponding lines from\n"
"each FILE, separated by TABs, to standard output.\n"
"The newline of every line except the line from the last file\n"
"is replaced with a TAB.\n"
msgstr ""
"Standarta izvadē rakstīt rindas, kas sastāv no secīgi atbilstošām rindām no\n"
"katra FAILA, atdalot tās ar tabulācijām (TAB).\n"
"Katras rindas rindpārnese, izņemot rindu no pēdējā faila,\n"
"tiek aizstāta ar TAB.\n"

#: src/paste.c:467
msgid ""
"  -d, --delimiters=LIST\n"
"         reuse characters from LIST instead of TABs;\n"
"         backslash escapes are supported\n"
msgstr ""
"  -d, --delimiters=SARAKSTS\n"
"         TAB vietā izmantot rakstzīmes no SARAKSTA;\n"
"         tiek atbalstītas atpakaļvērstās slīpsvītras atsoļa sekvences\n"

#: src/paste.c:472
msgid ""
"  -s, --serial\n"
"         paste one file at a time instead of in parallel; the newline of\n"
"         every line except the last line in each file is replaced with a TAB\n"
msgstr ""
"  -s, --serial\n"
"         apstrādāt pa vienam failam secīgi, nevis paralēli; katras rindas\n"
"         rindpārnese, izņemot pēdējo rindu katrā failā, tiek aizstāta ar TAB\n"

#: src/paste.c:542
#, c-format
msgid "delimiter list ends with an unescaped backslash: %s"
msgstr "atdalītāju saraksts beidzas ar neatsoļotu atpakaļvērsto slīpsvītru: %s"

#: src/pathchk.c:88
msgid ""
"Diagnose invalid or non-portable file names.\n"
"\n"
msgstr ""
"Noteikt nederīgus vai neportatīvus failu nosaukumus.\n"
"\n"

#: src/pathchk.c:92
msgid "  -p     check for most POSIX systems\n"
msgstr "  -p     pārbaudīt lielākajai daļai POSIX sistēmu\n"

#: src/pathchk.c:95
msgid "  -P     check for empty names and leading \"-\"\n"
msgstr "  -P     pārbaudīt, vai nav tukšu nosaukumu un sākuma \"-\"\n"

#: src/pathchk.c:98
msgid ""
"      --portability\n"
"         check for all POSIX systems (equivalent to -p -P)\n"
msgstr ""
"      --portability\n"
"         pārbaudīt visām POSIX sistēmām (ekvivalents -p -P)\n"

#: src/pathchk.c:173
#, c-format
msgid "leading '-' in a component of file name %s"
msgstr "faila nosaukuma %s komponentes sākumā ir '-'"

#: src/pathchk.c:199
