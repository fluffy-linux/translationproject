#: src/shuf.c:56
#, c-format
msgid ""
"Usage: %s [OPTION]... [FILE]\n"
"  or:  %s -e [OPTION]... [ARG]...\n"
"  or:  %s -i LO-HI [OPTION]...\n"
msgstr ""
"Lietojums: %s [OPCIJA]... [FAILS]\n"
"  vai:  %s -e [OPCIJA]... [ARG]...\n"
"  vai:  %s -i LO-HI [OPCIJA]...\n"

#: src/shuf.c:62
msgid "Write a random permutation of the input lines to standard output.\n"
msgstr "Izvadīt nejaušu ievades rindu permutāciju standarta izvadē.\n"

#: src/shuf.c:69
msgid "  -e, --echo                treat each ARG as an input line\n"
msgstr "  -e, --echo                uzskatīt katru ARG par ievades rindu\n"

#: src/shuf.c:72
msgid "  -i, --input-range=LO-HI   treat each number LO through HI as an input line\n"
msgstr "  -i, --input-range=LO-HI   uzskatīt katru skaitli no LO līdz HI par ievades rindu\n"

#: src/shuf.c:75
msgid "  -n, --head-count=COUNT    output at most COUNT lines\n"
msgstr "  -n, --head-count=SKAITS    izvadīt ne vairāk kā SKAITA rindas\n"

#: src/shuf.c:78
msgid "  -o, --output=FILE         write result to FILE instead of standard output\n"
msgstr "  -o, --output=FAILS         ierakstīt rezultātu failā FAILS, nevis standarta izvadē\n"

#: src/shuf.c:81
msgid "      --random-source=FILE  get random bytes from FILE\n"
msgstr "      --random-source=FAILS  iegūt nejaušus baitus no faila FAILS\n"

#: src/shuf.c:84
msgid "  -r, --repeat              output lines can be repeated\n"
msgstr "  -r, --repeat              izvades rindas var atkārtoties\n"

#: src/shuf.c:87
msgid "  -z, --zero-terminated     line delimiter is NUL, not newline\n"
msgstr "  -z, --zero-terminated     rindu atdalītājs ir NUL, nevis jauna rinda\n"

#: src/shuf.c:227
#, c-format
msgid "too many input lines"
msgstr "pārāk daudz ievades rindu"

#: src/shuf.c:431
#, c-format
msgid "multiple -i options specified"
msgstr "norādītas vairākas -i opcijas"

#: src/shuf.c:460
msgid "invalid input range"
msgstr "nederīgs ievades diapazons"

#: src/shuf.c:472
#, c-format
msgid "invalid line count: %s"
msgstr "nederīgs rindu skaits: %s"

#: src/shuf.c:479 src/sort.c:4877
#, c-format
