#: src/test.c:661
msgid ""
"Usage: test EXPRESSION\n"
"  or:  test\n"
"  or:  [ EXPRESSION ]\n"
"  or:  [ ]\n"
"  or:  [ OPTION\n"
msgstr ""
"Lietošana: test IZTEIKSME\n"
"  vai:  test\n"
"  vai:  [ IZTEIKSME ]\n"
"  vai:  [ ]\n"
"  vai:  [ OPCIJA\n"

#: src/test.c:668
msgid ""
"Exit with the status determined by EXPRESSION.\n"
"\n"
msgstr ""
"Iziet ar statusu, ko nosaka IZTEIKSME.\n"
"\n"

#: src/test.c:674
msgid ""
"\n"
"An omitted EXPRESSION defaults to false.  Otherwise,\n"
"EXPRESSION is true or false and sets exit status.  It is one of:\n"
msgstr ""
"\n"
"Izlaista IZTEIKSME pēc noklusējuma ir nepatiesa. Pretējā gadījumā,\n"
"IZTEIKSME ir patiesa vai nepatiesa un nosaka iziešanas statusu. Tā ir viena no:\n"

#: src/test.c:679
msgid ""
"\n"
"  ( EXPRESSION )               EXPRESSION is true\n"
"  ! EXPRESSION                 EXPRESSION is false\n"
"  EXPRESSION1 -a EXPRESSION2   both EXPRESSION1 and EXPRESSION2 are true\n"
"  EXPRESSION1 -o EXPRESSION2   either EXPRESSION1 or EXPRESSION2 is true\n"
msgstr ""
"\n"
"  ( IZTEIKSME )               IZTEIKSME ir patiesa\n"
"  ! IZTEIKSME                 IZTEIKSME ir nepatiesa\n"
"  IZTEIKSME1 -a IZTEIKSME2    gan IZTEIKSME1, gan IZTEIKSME2 ir patiesa\n"
"  IZTEIKSME1 -o IZTEIKSME2    vai nu IZTEIKSME1, vai IZTEIKSME2 ir patiesa\n"

#: src/test.c:689
msgid "  -n STRING            the length of STRING is nonzero\n"
msgstr "  -n VIRKNE            VIRKNES garums nav nulle\n"

#: src/test.c:692
msgid "  STRING               equivalent to -n STRING\n"
msgstr "  VIRKNE               ekvivalents -n VIRKNE\n"

#: src/test.c:695
msgid "  -z STRING            the length of STRING is zero\n"
msgstr "  -z VIRKNE            VIRKNES garums ir nulle\n"

#: src/test.c:698
msgid ""
"  STRING1 = STRING2    the strings are equal\n"
"  STRING1 != STRING2   the strings are not equal\n"
"  STRING1 > STRING2    STRING1 is greater than STRING2 in the current locale\n"
"  STRING1 < STRING2    STRING1 is less than STRING2 in the current locale\n"
msgstr ""
"  VIRKNE1 = VIRKNE2    virknes ir vienādas\n"
"  VIRKNE1 != VIRKNE2   virknes nav vienādas\n"
"  VIRKNE1 > VIRKNE2    VIRKNE1 ir lielāka par VIRKNE2 pašreizējā lokālē\n"
"  VIRKNE1 < VIRKNE2    VIRKNE1 ir mazāka par VIRKNE2 pašreizējā lokālē\n"

#: src/test.c:707
msgid "  INTEGER1 -eq INTEGER2   INTEGER1 is equal to INTEGER2\n"
msgstr "  SKAITLIS1 -eq SKAITLIS2   SKAITLIS1 ir vienāds ar SKAITLIS2\n"

#: src/test.c:710
msgid "  INTEGER1 -ge INTEGER2   INTEGER1 is greater than or equal to INTEGER2\n"
msgstr "  SKAITLIS1 -ge SKAITLIS2   SKAITLIS1 ir lielāks vai vienāds ar SKAITLIS2\n"

#: src/test.c:713
msgid "  INTEGER1 -gt INTEGER2   INTEGER1 is greater than INTEGER2\n"
msgstr "  SKAITLIS1 -gt SKAITLIS2   SKAITLIS1 ir lielāks par SKAITLIS2\n"

#: src/test.c:716
msgid "  INTEGER1 -le INTEGER2   INTEGER1 is less than or equal to INTEGER2\n"
msgstr "  SKAITLIS1 -le SKAITLIS2   SKAITLIS1 ir mazāks vai vienāds ar SKAITLIS2\n"

#: src/test.c:719
msgid "  INTEGER1 -lt INTEGER2   INTEGER1 is less than INTEGER2\n"
msgstr "  SKAITLIS1 -lt SKAITLIS2   SKAITLIS1 ir mazāks par SKAITLIS2\n"

#: src/test.c:722
msgid "  INTEGER1 -ne INTEGER2   INTEGER1 is not equal to INTEGER2\n"
msgstr "  SKAITLIS1 -ne SKAITLIS2   SKAITLIS1 nav vienāds ar SKAITLIS2\n"

#: src/test.c:728
msgid "  FILE1 -ef FILE2   FILE1 and FILE2 have the same device and inode numbers\n"
msgstr "  FAILS1 -ef FAILS2   FAILS1 un FAILS2 ir vienādi ierīces un i-mezgla numuri\n"

#: src/test.c:731
msgid "  FILE1 -nt FILE2   FILE1 is newer (modification date) than FILE2\n"
msgstr "  FAILS1 -nt FAILS2   FAILS1 ir jaunāks (modifikācijas datums) par FAILS2\n"

#: src/test.c:734
msgid "  FILE1 -ot FILE2   FILE1 is older than FILE2\n"
msgstr "  FAILS1 -ot FAILS2   FAILS1 ir vecāks par FAILS2\n"

#: src/test.c:740
msgid "  -b FILE     FILE exists and is block special\n"
msgstr "  -b FAILS    FAILS eksistē un ir bloka speciālais fails\n"

#: src/test.c:743
msgid "  -c FILE     FILE exists and is character special\n"
msgstr "  -c FAILS    FAILS eksistē un ir rakstzīmju speciālais fails\n"

#: src/test.c:746
msgid "  -d FILE     FILE exists and is a directory\n"
msgstr "  -d FAILS    FAILS eksistē un ir direktorija\n"

#: src/test.c:749
msgid "  -e FILE     FILE exists\n"
msgstr "  -e FAILS    FAILS eksistē\n"

#: src/test.c:752
msgid "  -f FILE     FILE exists and is a regular file\n"
msgstr "  -f FAILS    FAILS eksistē un ir parasts fails\n"

#: src/test.c:755
msgid "  -g FILE     FILE exists and its set-group-ID bit is set\n"
msgstr "  -g FAILS    FAILS eksistē un tam ir iestatīts set-group-ID bits\n"

#: src/test.c:758
msgid "  -G FILE     FILE exists and is owned by the effective group ID\n"
msgstr "  -G FAILS    FAILS eksistē un pieder efektīvās grupas ID\n"

#: src/test.c:761
msgid "  -h FILE     FILE exists and is a symbolic link (same as -L)\n"
msgstr "  -h FAILS     FAILS eksistē un ir simboliskā saite (tāpat kā -L)\n"

#: src/test.c:764
msgid "  -k FILE     FILE exists and has its sticky bit set\n"
msgstr "  -k FAILS     FAILS eksistē un tam ir iestatīts fiksācijas bits\n"

#: src/test.c:767
msgid "  -L FILE     FILE exists and is a symbolic link (same as -h)\n"
msgstr "  -L FAILS     FAILS eksistē un ir simboliskā saite (tāpat kā -h)\n"

#: src/test.c:770
msgid "  -N FILE     FILE exists and has been modified since it was last read\n"
msgstr "  -N FAILS     FAILS eksistē un ir modificēts kopš pēdējās nolasīšanas\n"

#: src/test.c:773
msgid "  -O FILE     FILE exists and is owned by the effective user ID\n"
msgstr "  -O FAILS     FAILS eksistē un tas pieder efektīvajam lietotāja ID\n"

#: src/test.c:776
msgid "  -p FILE     FILE exists and is a named pipe\n"
msgstr "  -p FAILS     FAILS eksistē un ir vārdots kanāls\n"

#: src/test.c:779
msgid "  -r FILE     FILE exists and the user has read access\n"
msgstr "  -r FAILS     FAILS eksistē un lietotājam ir lasīšanas piekļuve\n"

#: src/test.c:782
msgid "  -s FILE     FILE exists and has a size greater than zero\n"
msgstr "  -s FAILS     FAILS eksistē un tā izmērs ir lielāks par nulli\n"

#: src/test.c:785
msgid "  -S FILE     FILE exists and is a socket\n"
msgstr "  -S FAILS     FAILS eksistē un ir ligzda\n"

#: src/test.c:788
msgid "  -t FD       file descriptor FD is opened on a terminal\n"
msgstr "  -t FD       faila deskriptors FD ir atvērts terminālī\n"

#: src/test.c:791
msgid "  -u FILE     FILE exists and its set-user-ID bit is set\n"
msgstr "  -u FAILS     FAILS eksistē un tam ir iestatīts set-user-ID bits\n"

#: src/test.c:794
msgid "  -w FILE     FILE exists and the user has write access\n"
msgstr "  -w FAILS     FAILS eksistē un lietotājam ir rakstīšanas piekļuve\n"

#: src/test.c:797
msgid "  -x FILE     FILE exists and the user has execute (or search) access\n"
msgstr "  -x FAILS     FAILS eksistē un lietotājam ir izpildes (vai meklēšanas) piekļuve\n"

#: src/test.c:800
msgid ""
"\n"
"Except for -h and -L, all FILE-related tests dereference symbolic links.\n"
"Beware that parentheses need to be escaped (e.g., by backslashes) for shells.\n"
"INTEGER may also be -l STRING, which evaluates to the length of STRING.\n"
msgstr ""
"\n"
"Izņemot -h un -L, visi ar FAILU saistītie testi seko simboliskajām saitēm.\n"
"Ņemiet vērā, ka čaulās iekavas ir jāekranē (piemēram, ar atpakaļvērstajām slīpsvītrām).\n"
"VESALAIS_SKAITLIS var būt arī -l VIRKNE, kas dod VIRKNES garumu.\n"

#: src/test.c:806
msgid ""
"\n"
"Binary -a and -o are ambiguous.  Use 'test EXPR1 && test EXPR2'\n"
"or 'test EXPR1 || test EXPR2' instead.\n"
msgstr ""
"\n"
"Binārie -a un -o ir neviennozīmīgi. Tā vietā lietojiet 'test EXPR1 && test EXPR2'\n"
"vai 'test EXPR1 || test EXPR2'.\n"

#: src/test.c:811
msgid ""
"\n"
"'[' honors --help and --version, but 'test' treats them as STRINGs.\n"
msgstr ""
"\n"
"'[' respektē --help un --version, bet 'test' tos uztver kā VIRKNI.\n"

#: src/test.c:815
msgid "test and/or ["
msgstr "test un/vai ["

