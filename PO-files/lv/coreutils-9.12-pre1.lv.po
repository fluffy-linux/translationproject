#: src/tail.c:74
msgid "Ian Lance Taylor"
msgstr "Ians Lenss Teilors"

#: src/tail.c:287
#, c-format
msgid ""
"Print the last %d lines of each FILE to standard output.\n"
"With more than one FILE, precede each with a header giving the file name.\n"
msgstr ""
"Izvadīt katra FAILA pēdējās %d rindas standarta izvadē.\n"
"Ja norādīts vairāk nekā viens FAILS, pirms katra pievienot galveni ar faila nosaukumu.\n"

#: src/tail.c:295
msgid ""
"  -c, --bytes=[+]NUM\n"
"         output the last NUM bytes;\n"
"         or use -c +NUM to output starting with byte NUM of each file\n"
msgstr ""
"  -c, --bytes=[+]SKAITLIS\n"
"         izvadīt pēdējos SKAITĻA baitus;\n"
"         vai izmantot -c +SKAITLIS, lai izvadītu, sākot ar katra faila SKAITĻU baitu\n"

#: src/tail.c:300
msgid ""
"      --debug\n"
"         indicate which --follow implementation is used\n"
msgstr ""
"      --debug\n"
"         norādīt, kura --follow implementācija tiek izmantota\n"

#: src/tail.c:304
msgid ""
"  -f, --follow[={name|descriptor}]\n"
"         output appended data as the file grows;\n"
"         an absent option argument means 'descriptor'\n"
msgstr ""
"  -f, --follow[={name|descriptor}]\n"
"         izvadīt pievienotos datus, failam augot;\n"
"         nenorādīts opcijas arguments nozīmē 'descriptor'\n"

#: src/tail.c:309
msgid ""
"  -F\n"
"         same as --follow=name --retry\n"
msgstr ""
"  -F\n"
"         tas pats, kas --follow=name --retry\n"

#: src/tail.c:313
#, c-format
msgid ""
"  -n, --lines=[+]NUM\n"
"         output the last NUM lines, instead of the last %d;\n"
"         or use -n +NUM to skip NUM-1 lines at the start\n"
msgstr ""
"  -n, --lines=[+]SKAITLIS\n"
"         izvadīt pēdējās SKAITĻA rindas, nevis pēdējās %d;\n"
"         vai izmantot -n +SKAITLIS, lai sākumā izlaistu SKAITLIS-1 rindas\n"

#: src/tail.c:318
#, c-format
msgid ""
"      --max-unchanged-stats=N\n"
"         with --follow=name, reopen a FILE which has not\n"
"         changed size after N (default %d) iterations\n"
"         to see if it has been unlinked or renamed\n"
"         (this is the usual case of rotated log files);\n"
"         with inotify, this option is rarely useful\n"
msgstr ""
"      --max-unchanged-stats=N\n"
"         ar --follow=name atkārtoti atvērt FAILU, kura izmērs\n"
"         nav mainījies pēc N (noklusējumā %d) iterācijām,\n"
"         lai pārbaudītu, vai tas nav dzēsts vai pārdēvēts\n"
"         (tas ir parasts gadījums rotētiem žurnālfailiem);\n"
"         lietojot inotify, šī opcija reti ir noderīga\n"

#: src/tail.c:326
msgid ""
"      --pid=PID\n"
"         with -f, exit after PID no longer exists;\n"
"         can be repeated to watch multiple processes\n"
msgstr ""
"      --pid=PID\n"
"         ar -f iziet, kad PID vairs neeksistē;\n"
"         var atkārtot, lai uzraudzītu vairākus procesus\n"

#: src/tail.c:331
msgid ""
"  -q, --quiet, --silent\n"
"         never output headers giving file names\n"
msgstr ""
"  -q, --quiet, --silent\n"
"         nekad neizvadīt galvenes ar failu nosaukumiem\n"

#: src/tail.c:335
msgid ""
"      --retry\n"
"         keep trying to open a file if it is inaccessible\n"
msgstr ""
"      --retry\n"
"         turpināt mēģināt atvērt failu, ja tas nav pieejams\n"

#: src/tail.c:339
msgid ""
"  -s, --sleep-interval=N\n"
"         with -f, sleep for approximately N seconds\n"
"         (default 1.0) between iterations;\n"
"         with inotify and --pid=P,\n"
"         check process P at least once every N seconds\n"
msgstr ""
"  -s, --sleep-interval=N\n"
"         ar -f gaidīt aptuveni N sekundes\n"
"         (noklusējumā 1.0) starp iterācijām;\n"
"         ar inotify un --pid=P,\n"
"         pārbaudīt procesu P vismaz reizi N sekundēs\n"

#: src/tail.c:346
msgid ""
"  -v, --verbose\n"
"         always output headers giving file names\n"
msgstr ""
"  -v, --verbose\n"
"         vienmēr izvadīt galvenes ar failu nosaukumiem\n"

#: src/tail.c:356
msgid ""
"\n"
"NUM may have a multiplier suffix:\n"
"b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n"
"GB 1000*1000*1000, G 1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n"
"Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n"
"\n"
msgstr ""
"\n"
"NUM var saturēt reizinātāja sufiksu:\n"
"b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n"
"GB 1000*1000*1000, G 1024*1024*1024 un tā tālāk: T, P, E, Z, Y, R, Q.\n"
"Var izmantot arī bināros prefiksus: KiB=K, MiB=M un tā tālāk.\n"

#: src/tail.c:364
msgid ""
"With --follow (-f), tail defaults to following the file descriptor, which\n"
"means that even if a tail'ed file is renamed, tail will continue to track\n"
"its end.  This default behavior is not desirable when you really want to\n"
"track the actual name of the file, not the file descriptor (e.g., log\n"
"rotation).  Use --follow=name in that case.  That causes tail to track the\n"
"named file in a way that accommodates renaming, removal and creation.\n"
msgstr ""
"Izmantojot --follow (-f), tail pēc noklusējuma seko faila deskriptoram, kas\n"
"nozīmē, ka pat tad, ja izsekotais fails tiek pārdēvēts, tail turpinās izsekot\n"
"tā beigām. Šāda noklusējuma rīcība nav vēlama, ja patiešām vēlaties\n"
"izsekot faila faktiskajam nosaukumam, nevis faila deskriptoram (piemēram, žurnālu\n"
"rotācijā). Šādā gadījumā izmantojiet --follow=name. Tas liek tail izsekot\n"
"norādītajam failam tā, lai pielāgotos pārdēvēšanai, dzēšanai un izveidošanai.\n"

