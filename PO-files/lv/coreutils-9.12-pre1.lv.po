#: src/split.c:226
#, c-format
msgid "Usage: %s [OPTION]... [FILE [PREFIX]]\n"
msgstr "Lietošana: %s [OPCIJA]... [FAILS [PREFIKSS]]\n"

#: src/split.c:230
msgid ""
"Output pieces of FILE to PREFIXaa, PREFIXab, ...;\n"
"default size is 1000 lines, and default PREFIX is 'x'.\n"
msgstr ""
"Izvadīt FAILS fragmentus failos PREFIKSSaa, PREFIKSSab, ...;\n"
"noklusējuma izmērs ir 1000 rindas, un noklusētais PREFIKSS ir 'x'.\n"

#: src/split.c:238
#, c-format
msgid ""
"  -a, --suffix-length=N\n"
"         generate suffixes of length N (default %d)\n"
msgstr ""
"  -a, --suffix-length=N\n"
"         ģenerēt N garuma sufiksus (noklusējums: %d)\n"

#: src/split.c:242
msgid ""
"      --additional-suffix=SUFFIX\n"
"         append an additional SUFFIX to file names\n"
msgstr ""
"      --additional-suffix=SUFIKS\n"
"         pievienot papildu SUFIKSU failu nosaukumiem\n"

#: src/split.c:246
msgid ""
"  -b, --bytes=SIZE\n"
"         put SIZE bytes per output file\n"
msgstr ""
"  -b, --bytes=IZMĒRS\n"
"         ierakstīt IZMĒRS baitus katrā izvades failā\n"

#: src/split.c:250
msgid ""
"  -C, --line-bytes=SIZE\n"
"         put at most SIZE bytes of records per output file\n"
msgstr ""
"  -C, --line-bytes=IZMĒRS\n"
"         ierakstīt ne vairāk kā IZMĒRU ierakstu baitu katrā izvades failā\n"

#: src/split.c:254
msgid ""
"  -d\n"
"         use numeric suffixes starting at 0, not alphabetic\n"
msgstr ""
"  -d\n"
"         lietot ciparu sufiksus, sākot ar 0, nevis burtu\n"

#: src/split.c:258
msgid ""
"      --numeric-suffixes[=FROM]\n"
"         same as -d, but allow setting the start value\n"
msgstr ""
"      --numeric-suffixes[=NO]\n"
"         tāpat kā -d, bet ļauj iestatīt sākuma vērtību\n"

#: src/split.c:262
msgid ""
"  -x\n"
"         use hex suffixes starting at 0, not alphabetic\n"
msgstr ""
"  -x\n"
"         lietot heksadecimālos sufiksus, sākot ar 0, nevis burtu\n"

#: src/split.c:266
msgid ""
"      --hex-suffixes[=FROM]\n"
"         same as -x, but allow setting the start value\n"
msgstr ""
"      --hex-suffixes[=NO]\n"
"         tāpat kā -x, bet ļauj iestatīt sākuma vērtību\n"

#: src/split.c:270
msgid ""
"  -e, --elide-empty-files\n"
"         do not generate empty output files with '-n'\n"
msgstr ""
"  -e, --elide-empty-files\n"
"         neģenerēt tukšus izvades failus ar '-n'\n"

#: src/split.c:274
msgid ""
"      --filter=COMMAND\n"
"         write to shell COMMAND; file name is $FILE\n"
msgstr ""
"      --filter=KOMMANDA\n"
"         rakstīt čaulas komandā KOMMANDU; faila nosaukums ir $FILE\n"

#: src/split.c:278
msgid ""
"  -l, --lines=NUMBER\n"
"         put NUMBER lines/records per output file\n"
msgstr ""
"  -l, --lines=SKAITLIS\n"
"         ierakstīt SKAITLI rindas/ierakstus katrā izvades failā\n"

#: src/split.c:282
msgid ""
"  -n, --number=CHUNKS\n"
"         generate CHUNKS output files; see explanation below\n"
msgstr ""
"  -n, --number=GABALI\n"
"         ģenerēt GABALUS izvades failus; skatīt paskaidrojumu zemāk\n"

#: src/split.c:286
msgid ""
"  -t, --separator=SEP\n"
"         use SEP instead of newline as the record separator;\n"
"         '\\0' (zero) specifies the NUL character\n"
msgstr ""
"  -t, --separator=SEP\n"
"         izmantot SEP jaunas rindas vietā kā ierakstu atdalītāju;\n"
"         '\\0' (nulle) norāda NUL rakstzīmi\n"

#: src/split.c:291
msgid ""
"  -u, --unbuffered\n"
"         immediately copy input to output with '-n r/...'\n"
msgstr ""
"  -u, --unbuffered\n"
"         nekavējoties kopēt ievadi uz izvadi ar '-n r/...'\n"

#: src/split.c:295
msgid ""
"      --verbose\n"
"         print a diagnostic just before each output file is opened\n"
msgstr ""
"      --verbose\n"
"         izvadīt diagnostiku tieši pirms katra izvades faila atvēršanas\n"

#: src/split.c:302
msgid ""
"\n"
"CHUNKS may be:\n"
"  N       split into N files based on size of input\n"
"  K/N     output Kth of N to standard output\n"
"  l/N     split into N files without splitting lines/records\n"
"  l/K/N   output Kth of N to standard output without splitting lines/records\n"
"  r/N     like 'l' but use round robin distribution\n"
"  r/K/N   likewise but only output Kth of N to standard output\n"
msgstr ""
"\n"
"GABALI var būt:\n"
"  N       sadalīt N failos, balstoties uz ievades lielumu\n"
"  K/N     izvadīt K-to no N uz standarta izvadi\n"
"  l/N     sadalīt N failos, nesadalot rindas/ierakstus\n"
"  l/K/N   izvadīt K-to no N uz standarta izvadi, nesadalot rindas/ierakstus\n"
"  r/N     kā 'l', bet izmantot riņķveida sadalījumu\n"
"  r/K/N   līdzīgi, bet izvadīt tikai K-to no N uz standarta izvadi\n"

#: src/split.c:311
msgid ""
"\n"
"-n (except -nr) will buffer to $TMPDIR, defaulting to /tmp,\n"
"if the input size cannot easily be determined.\n"
msgstr ""
"\n"
"-n (izņemot -nr) buferēs uz $TMPDIR, pēc noklusējuma /tmp,\n"
"ja ievades izmēru nav viegli noteikt.\n"

