msgid "Arnold Robbins"
msgstr "Arnolds Robins"

#: src/id.c:94 src/pinky.c:482
#, c-format
msgid "Usage: %s [OPTION]... [USER]...\n"
msgstr "Lietošana: %s [OPCIJA]... [LIETOTĀJS]...\n"

#: src/id.c:95
msgid ""
"Print user and group information for each specified USER,\n"
"or (when USER omitted) for the current process.\n"
"\n"
msgstr ""
"Izvadīt lietotāja un grupas informāciju katram norādītajam LIETOTĀJAM\n"
"vai (ja LIETOTĀJS nav norādīts) pašreizējam procesam.\n"
"\n"

#: src/id.c:100
msgid ""
"  -a\n"
"         ignore, for compatibility with other versions\n"
msgstr ""
"  -a\n"
"         ignorēt, saderībai ar citām versijām\n"

#: src/id.c:104
msgid ""
"  -Z, --context\n"
"         print only the security context of the process\n"
msgstr ""
"  -Z, --context\n"
"         izvadīt tikai procesa drošības kontekstu\n"

#: src/id.c:108
msgid ""
"  -g, --group\n"
"         print only the effective group ID\n"
msgstr ""
"  -g, --group\n"
"         izvadīt tikai efektīvo grupas ID\n"

#: src/id.c:112
msgid ""
"  -G, --groups\n"
"         print all group IDs\n"
msgstr ""
"  -G, --groups\n"
"         izvadīt visus grupu ID\n"

#: src/id.c:116
msgid ""
"  -n, --name\n"
"         print a name instead of a number, for -u, -g, -G\n"
msgstr ""
"  -n, --name\n"
"         izvadīt nosaukumu, nevis skaitli, opcijām -u, -g, -G\n"

#: src/id.c:120
msgid ""
"  -r, --real\n"
"         print the real ID instead of the effective ID, with -u, -g, -G\n"
msgstr ""
"  -r, --real\n"
"         izvadīt reālo ID, nevis efektīvo ID, ar -u, -g, -G\n"

#: src/id.c:124
msgid ""
"  -u, --user\n"
"         print only the effective user ID\n"
msgstr ""
"  -u, --user\n"
"         izvadīt tikai efektīvo lietotāja ID\n"

#: src/id.c:128
msgid ""
"  -z, --zero\n"
"         delimit entries with NUL characters, not whitespace;\n"
"         not permitted in default format\n"
msgstr ""
"  -z, --zero\n"
"         atdalīt ierakstus ar NUL rakstzīmēm, nevis atstarpi;\n"
"         noklusējuma formātā nav atļauts\n"

#: src/id.c:135
msgid ""
"\n"
"Without any OPTION, print some useful set of identified information.\n"
msgstr ""
"\n"
"Bez jebkādas OPCIJAS izvadīt noderīgu identificētās informācijas kopumu.\n"

#: src/id.c:172
