#: src/tac.c:123
msgid "Write each FILE to standard output, last line first.\n"
msgstr "Izvadīt katru FAILU standarta izvadē, sākot ar pēdējo rindu.\n"

#: src/tac.c:130
msgid "  -b, --before             attach the separator before instead of after\n"
msgstr "  -b, --before             pievienot atdalītāju pirms, nevis pēc\n"

#: src/tac.c:133
msgid "  -r, --regex              interpret the separator as a regular expression\n"
msgstr "  -r, --regex              interpretēt atdalītāju kā regulāro izteiksmi\n"

#: src/tac.c:136
msgid "  -s, --separator=STRING   use STRING as the separator instead of newline\n"
msgstr "  -s, --separator=VIRKNE   izmantot VIRKNI kā atdalītāju jaunas rindas vietā\n"

#: src/tac.c:141
msgid ""
"\n"
"Non-seekable input is buffered to $TMPDIR, defaulting to /tmp.\n"
msgstr ""
"\n"
"Nepozicionējama ievade tiek buferēta $TMPDIR, pēc noklusējuma /tmp.\n"

#: src/tac.c:220 src/tac.c:230 src/tac.c:338
#, c-format
msgid "%s: seek failed"
msgstr "%s: pozicionēšana neizdevās"

#: src/tac.c:273
#, c-format
msgid "record too large"
msgstr "ieraksts ir pārāk liels"

#: src/tac.c:409 src/tac.c:421
#, c-format
msgid "%s: write error"
msgstr "%s: rakstīšanas kļūda"

#: src/tac.c:470
#, c-format
msgid "failed to open %s for reading"
msgstr "neizdevās atvērt %s lasīšanai"

#: src/tac.c:534
#, c-format
msgid "separator cannot be empty"
msgstr "atdalītājs nevar būt tukšs"

