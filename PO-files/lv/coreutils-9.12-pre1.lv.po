#: src/ls.c:5472
msgid ""
"      --group-directories-first\n"
"         group directories before files\n"
msgstr ""
"      --group-directories-first\n"
"         grupēt direktorijas pirms failiem\n"

#: src/ls.c:5476
msgid ""
"  -G, --no-group\n"
"         in a long listing, don't print group names\n"
msgstr ""
"  -G, --no-group\n"
"         garajā sarakstā neizvadīt grupu nosaukumus\n"

#: src/ls.c:5480
msgid ""
"  -h, --human-readable\n"
"         with -l and -s, print sizes like 1K 234M 2G etc.\n"
msgstr ""
"  -h, --human-readable\n"
"         kopā ar -l un -s izvadīt izmērus kā 1K 234M 2G utt.\n"

#: src/ls.c:5484
msgid ""
"      --si\n"
"         likewise, but use powers of 1000 not 1024\n"
msgstr ""
"      --si\n"
"         līdzīgi, bet izmantot 1000 pakāpes, nevis 1024\n"

#: src/ls.c:5488
msgid ""
"  -H, --dereference-command-line\n"
"         follow symbolic links listed on the command line\n"
msgstr ""
"  -H, --dereference-command-line\n"
"         sekot simboliskajām saitēm, kas norādītas komandrindā\n"

#: src/ls.c:5492
msgid ""
"      --dereference-command-line-symlink-to-dir\n"
"         follow each command line symbolic link that points to a directory\n"
msgstr ""
"      --dereference-command-line-symlink-to-dir\n"
"         sekot katrai komandrindas simboliskajai saitei, kas norāda uz direktoriju\n"

#: src/ls.c:5496
msgid ""
"      --hide=PATTERN\n"
"         do not list implied entries matching shell PATTERN\n"
"         (overridden by -a or -A)\n"
msgstr ""
"      --hide=ŠABLONS\n"
"         nerādīt netiešos ierakstus, kas atbilst čaulas ŠABLONS\n"
"         (atceļ ar -a vai -A)\n"

#: src/ls.c:5501
msgid ""
"      --hyperlink[=WHEN]\n"
"         hyperlink file names WHEN\n"
msgstr ""
"      --hyperlink[=KAD]\n"
"         veidot hipersaites failu nosaukumiem KAD\n"

#: src/ls.c:5505
msgid ""
"      --indicator-style=WORD\n"
"         append indicator with style WORD to entry names:\n"
"           none (default), slash (-p), file-type (--file-type), classify (-F)\n"
msgstr ""
"      --indicator-style=VĀRDS\n"
"         pievienot indikatoru ar stilu VĀRDU ierakstu nosaukumiem:\n"
"           none (noklusējums), slash (-p), file-type (--file-type), classify (-F)\n"

#: src/ls.c:5510
msgid ""
"  -i, --inode\n"
"         print the index number of each file\n"
msgstr ""
"  -i, --inode\n"
"         izvadīt katra faila indeksa numuru\n"

#: src/ls.c:5514
msgid ""
"  -I, --ignore=PATTERN\n"
"         do not list implied entries matching shell PATTERN\n"
msgstr ""
"  -I, --ignore=ŠABLONS\n"
"         nerādīt netiešos ierakstus, kas atbilst čaulas ŠABLONS\n"

#: src/ls.c:5518
msgid ""
"  -k, --kibibytes\n"
"         default to 1024-byte blocks for file system usage;\n"
"         used only with -s and per directory totals\n"
msgstr ""
"  -k, --kibibytes\n"
"         pēc noklusējuma izmantot 1024 baitu blokus failu sistēmas lietojumam;\n"
"         izmanto tikai ar -s un katras direktorijas kopsummām\n"

#: src/ls.c:5523
msgid ""
"  -l\n"
"         use a long listing format\n"
msgstr ""
"  -l\n"
"         izmantot garā saraksta formātu\n"

#: src/ls.c:5527
msgid ""
"  -L, --dereference\n"
"         when showing file information for a symbolic link,\n"
"         show information for the file the link references\n"
"         rather than for the link itself\n"
msgstr ""
"  -L, --dereference\n"
"         rādot faila informāciju simboliskajai saitei,\n"
"         rādīt informāciju par failu, uz kuru saite norāda,\n"
"         nevis par pašu saiti\n"

#: src/ls.c:5533
msgid ""
"  -m\n"
"         fill width with a comma separated list of entries\n"
msgstr ""
"  -m\n"
"         aizpildīt platumu ar komatiem atdalītu ierakstu sarakstu\n"

#: src/ls.c:5537
msgid ""
"  -n, --numeric-uid-gid\n"
"         like -l, but list numeric user and group IDs\n"
msgstr ""
"  -n, --numeric-uid-gid\n"
"         kā -l, bet rādīt skaitliskos lietotāja un grupas ID\n"

#: src/ls.c:5541
msgid ""
"  -N, --literal\n"
"         print entry names without quoting\n"
msgstr ""
"  -N, --literal\n"
"         izvadīt ierakstu nosaukumus bez pēdiņām\n"

#: src/ls.c:5545
msgid ""
"  -o\n"
"         like -l, but do not list group information\n"
msgstr ""
"  -o\n"
"         kā -l, bet nerādīt grupas informāciju\n"

#: src/ls.c:5549
msgid ""
"  -p, --indicator-style=slash\n"
"         append / indicator to directories\n"
msgstr ""
"  -p, --indicator-style=slash\n"
"         pievienot / indikatoru direktorijām\n"

#: src/ls.c:5553
msgid ""
"  -q, --hide-control-chars\n"
"         print ? instead of nongraphic characters\n"
msgstr ""
"  -q, --hide-control-chars\n"
"         izvadīt ? nevis negrafiskās rakstzīmes\n"

#: src/ls.c:5557
msgid ""
"      --show-control-chars\n"
"         show nongraphic characters as-is;\n"
"         the default, unless program is 'ls' and output is a terminal\n"
msgstr ""
"      --show-control-chars\n"
"         rādīt negrafiskās rakstzīmes nemainītas;\n"
"         noklusējums, ja vien programma nav 'ls' un izvade ir terminālis\n"

#: src/ls.c:5562
msgid ""
"  -Q, --quote-name\n"
"         enclose entry names in double quotes\n"
msgstr ""
"  -Q, --quote-name\n"
"         ietvert ierakstu nosaukumus dubultpēdiņās\n"

#: src/ls.c:5566
msgid ""
"      --quoting-style=WORD\n"
"         use quoting style WORD for entry names:\n"
"           literal, locale, shell, shell-always,\n"
"           shell-escape, shell-escape-always, c, escape\n"
"         (overrides QUOTING_STYLE environment variable)\n"
msgstr ""
"      --quoting-style=VĀRDS\n"
"         izmantot citēšanas stilu VĀRDS ierakstu nosaukumiem:\n"
"           literal, locale, shell, shell-always,\n"
"           shell-escape, shell-escape-always, c, escape\n"
"         (aizstāj QUOTING_STYLE vides mainīgo)\n"

#: src/ls.c:5573
msgid ""
"  -r, --reverse\n"
"         reverse order while sorting\n"
msgstr ""
"  -r, --reverse\n"
"         kārtojot apgriezt secību\n"

#: src/ls.c:5577
msgid ""
"  -R, --recursive\n"
"         list subdirectories recursively\n"
msgstr ""
"  -R, --recursive\n"
"         rekursīvi uzskaita apakšdirektorijas\n"

#: src/ls.c:5581
msgid ""
"  -s, --size\n"
"         print the allocated size of each file, in blocks\n"
msgstr ""
"  -s, --size\n"
"         izvada katra faila piešķirto izmēru blokos\n"

#: src/ls.c:5585
msgid ""
"  -S\n"
"         sort by file size, largest first\n"
msgstr ""
"  -S\n"
"         sakārto pēc faila izmēra, vispirms lielākos\n"

#: src/ls.c:5589
msgid ""
"      --sort=WORD\n"
"         change default 'name' sort to WORD:\n"
"           none (-U), size (-S), time (-t),\n"
"           version (-v), extension (-X), name, width\n"
msgstr ""
"      --sort=VĀRDS\n"
"         maina noklusēto 'name' kārtošanu uz VĀRDS:\n"
"           none (-U), size (-S), time (-t),\n"
"           version (-v), extension (-X), name, width\n"

#: src/ls.c:5595
msgid ""
"      --time=WORD\n"
"         select which timestamp used to display or sort;\n"
"           access time (-u): atime, access, use;\n"
"           metadata change time (-c): ctime, status;\n"
"           modified time (default): mtime, modification;\n"
"           birth time: birth, creation;\n"
"         with -l, WORD determines which time to show;\n"
"         with --sort=time, sort by WORD (newest first)\n"
msgstr ""
"      --time=VĀRDS\n"
"         izvēlas, kuru laika zīmogu rādīt vai kārtot;\n"
"           piekļuves laiks (-u): atime, access, use;\n"
"           metadatu izmaiņu laiks (-c): ctime, status;\n"
"           modificēšanas laiks (noklusējums): mtime, modification;\n"
"           izveides laiks: birth, creation;\n"
"         ar -l VĀRDS nosaka, kuru laiku rādīt;\n"
"         ar --sort=time kārto pēc VĀRDS (vispirms jaunākos)\n"

#: src/ls.c:5605
msgid ""
"      --time-style=TIME_STYLE\n"
"         time/date format with -l; see TIME_STYLE below\n"
msgstr ""
"      --time-style=LAIKA_STILS\n"
"         laika/datuma formāts ar -l; skatīt TIME_STYLE zemāk\n"

#: src/ls.c:5609
msgid ""
"  -t\n"
"         sort by time, newest first; see --time\n"
msgstr ""
"  -t\n"
"         kārto pēc laika, vispirms jaunākos; skatīt --time\n"

#: src/ls.c:5613
msgid ""
"  -T, --tabsize=COLS\n"
"         assume tab stops at each COLS instead of 8\n"
msgstr ""
"  -T, --tabsize=COLS\n"
"         pieņem, ka tabulācijas pieturas ir ik pēc COLS, nevis 8\n"

#: src/ls.c:5617
msgid ""
"  -u\n"
"         with -lt: sort by, and show, access time;\n"
"         with -l: show access time and sort by name;\n"
"         otherwise: sort by access time, newest first\n"
msgstr ""
"  -u\n"
"         ar -lt: kārto un rāda piekļuves laiku;\n"
"         ar -l: rāda piekļuves laiku un kārto pēc nosaukuma;\n"
"         citādi: kārto pēc piekļuves laika, vispirms jaunākos\n"

#: src/ls.c:5623
msgid ""
"  -U\n"
"         do not sort directory entries\n"
msgstr ""
"  -U\n"
"         nesakārto direktorijas ierakstus\n"

#: src/ls.c:5627
msgid ""
"  -v\n"
"         natural sort of (version) numbers within text\n"
msgstr ""
"  -v\n"
"         dabiska (versiju) skaitļu kārtošana tekstā\n"

#: src/ls.c:5631
msgid ""
"  -w, --width=COLS\n"
"         set output width to COLS.  0 means no limit\n"
msgstr ""
"  -w, --width=COLS\n"
"         iestata izvades platumu uz COLS.  0 nozīmē bez ierobežojuma\n"

#: src/ls.c:5635
msgid ""
"  -x\n"
"         list entries by lines instead of by columns\n"
msgstr ""
"  -x\n"
"         uzskaita ierakstus pa rindām, nevis pa kolonnām\n"

#: src/ls.c:5639
msgid ""
"  -X\n"
"         sort alphabetically by entry extension\n"
msgstr ""
"  -X\n"
"         alfabētiski kārto pēc ieraksta paplašinājuma\n"

#: src/ls.c:5643
msgid ""
"  -Z, --context\n"
"         print any security context of each file\n"
msgstr ""
"  -Z, --context\n"
"         izvada katra faila drošības kontekstu\n"

#: src/ls.c:5647
msgid ""
"      --zero\n"
"         end each output line with NUL, not newline\n"
msgstr ""
"      --zero\n"
"         noslēdz katru izvades rindu ar NUL, nevis jaunu rindu\n"

#: src/ls.c:5651
msgid ""
"  -1\n"
"         list one file per line\n"
msgstr ""
"  -1\n"
"         uzskaita vienu failu katrā rindā\n"

#: src/ls.c:5658
msgid ""
"\n"
"The TIME_STYLE argument can be full-iso, long-iso, iso, locale, or +FORMAT.\n"
"FORMAT is interpreted like in date(1).  If FORMAT is FORMAT1<newline>FORMAT2,\n"
"then FORMAT1 applies to non-recent files and FORMAT2 to recent files.\n"
"TIME_STYLE prefixed with 'posix-' takes effect only outside the POSIX locale.\n"
"Also the TIME_STYLE environment variable sets the default style to use.\n"
msgstr ""
"\n"
"TIME_STYLE arguments var būt full-iso, long-iso, iso, locale vai +FORMĀTS.\n"
"FORMĀTS tiek interpretēts tāpat kā date(1). Ja FORMĀTS ir FORMĀTS1<newline>FORMĀTS2,\n"
"tad FORMĀTS1 attiecas uz senākiem failiem un FORMĀTS2 uz nesenajiem failiem.\n"
"TIME_STYLE ar prefiksu 'posix-' darbojas tikai ārpus POSIX lokāles.\n"
"Arī TIME_STYLE vides mainīgais nosaka noklusēto stilu, ko izmantot.\n"

#: src/ls.c:5666
msgid ""
"\n"
"The WHEN argument defaults to 'always' and can also be 'auto' or 'never'.\n"
msgstr ""
"\n"
"KAD arguments pēc noklusējuma ir 'always' un var būt arī 'auto' vai 'never'.\n"

#: src/ls.c:5670
msgid ""
"\n"
"Using color to distinguish file types is disabled both by default and\n"
"with --color=never.  With --color=auto, ls emits color codes only when\n"
"standard output is connected to a terminal.  The LS_COLORS environment\n"
"variable can change the settings.  Use the dircolors(1) command to set it.\n"
msgstr ""
"\n"
"Krāsu izmantošana failu tipu atšķiršanai ir atspējota gan pēc noklusējuma,\n"
"gan ar --color=never. Ar --color=auto ls izvada krāsu kodus tikai tad,\n"
"kad standarta izvade ir savienota ar termināli. LS_COLORS vides mainīgais\n"
"var mainīt iestatījumus. Lai to iestatītu, izmantojiet dircolors(1) komandu.\n"

#: src/ls.c:5677
msgid ""
"\n"
"Exit status:\n"
" 0  if OK,\n"
" 1  if minor problems (e.g., cannot access subdirectory),\n"
" 2  if serious trouble (e.g., cannot access command-line argument).\n"
msgstr ""
"\n"
"Iziešanas statuss:\n"
" 0  ja viss kārtībā,\n"
" 1  ja nelielas problēmas (piem., nevar piekļūt apakšdirektorijai),\n"
" 2  ja nopietnas problēmas (piem., nevar piekļūt komandrindas argumentam).\n"

#: src/mkdir.c:57 src/rmdir.c:172
#, c-format
msgid "Usage: %s [OPTION]... DIRECTORY...\n"
msgstr "Lietošana: %s [OPCIJA]... DIREKTORIJA...\n"

#: src/mkdir.c:58
msgid "Create the DIRECTORY(ies), if they do not already exist.\n"
msgstr "Izveidot DIREKTORIJU(-as), ja tā(-s) vēl neeksistē.\n"

#: src/mkdir.c:64
msgid ""
"  -m, --mode=MODE\n"
"         set file mode (as in chmod), not a=rwx - umask\n"
msgstr ""
"  -m, --mode=MODE\n"
"         iestatīt faila režīmu (kā chmod), nevis a=rwx - umask\n"

#: src/mkdir.c:68
msgid ""
"  -p, --parents\n"
"         no error if existing, make parent directories as needed,\n"
"         with their file modes unaffected by any -m option\n"
msgstr ""
"  -p, --parents\n"
"         neziņot par kļūdu, ja eksistē; izveidot vecākdirektorijas pēc vajadzības,\n"
"         to failu režīmus neietekmē opcija -m\n"

#: src/mkdir.c:73
msgid ""
"  -v, --verbose\n"
"         print a message for each created directory\n"
msgstr ""
"  -v, --verbose\n"
"         izvadīt paziņojumu par katru izveidoto direktoriju\n"

#: src/mkdir.c:77
msgid ""
"  -Z\n"
"         set SELinux security context of each created directory\n"
"         to the default type\n"
msgstr ""
"  -Z\n"
"         iestatīt katras izveidotās direktorijas SELinux drošības kontekstu\n"
"         uz noklusējuma tipu\n"

#: src/mkdir.c:234
#, c-format
msgid "created directory %s"
msgstr "izveidota direktorija %s"

#: src/mkdir.c:257 src/mkfifo.c:123 src/mknod.c:139
#, c-format
msgid "warning: ignoring --context; it requires an SELinux/SMACK-enabled kernel"
msgstr "brīdinājums: ignorē --context; tam nepieciešams kodols ar SELinux/SMACK atbalstu"

#: src/mkfifo.c:52 src/pathchk.c:87
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Lietošana: %s [OPCIJA]... NOSAUKUMS...\n"

#: src/mkfifo.c:53
msgid "Create named pipes (FIFOs) with the given NAMEs.\n"
msgstr "Izveidot nosauktos cauruļvadus (FIFO) ar norādītajiem NOSAUKUMIEM.\n"

#: src/mkfifo.c:59 src/mknod.c:61
msgid ""
"  -m, --mode=MODE\n"
"         set file permission bits to MODE, not a=rw - umask\n"
msgstr ""
"  -m, --mode=MODE\n"
"         iestatīt faila piekļuves bitus uz MODE, nevis a=rw - umask\n"

#: src/mkfifo.c:63 src/mknod.c:65
msgid ""
"  -Z\n"
"         set the SELinux security context to default type\n"
msgstr ""
"  -Z\n"
"         iestatīt SELinux drošības kontekstu uz noklusējuma tipu\n"

#: src/mkfifo.c:159 src/mknod.c:155
#, c-format
msgid "invalid mode"
msgstr "nederīgs režīms"

#: src/mkfifo.c:166 src/mknod.c:162
#, c-format
msgid "mode must specify only file permission bits"
msgstr "režīmā jānorāda tikai faila piekļuves biti"

#: src/mkfifo.c:181 src/mknod.c:275
#, c-format
msgid "cannot set permissions of %s"
msgstr "neizdevās iestatīt %s piekļuves tiesības"

#: src/mknod.c:53
#, c-format
msgid "Usage: %s [OPTION]... NAME TYPE [MAJOR MINOR]\n"
msgstr "Lietojums: %s [OPCIJA]... NOSAUKUMS TIPS [MAJORAIS MINORAIS]\n"

#: src/mknod.c:55
msgid "Create the special file NAME of the given TYPE.\n"
msgstr "Izveidot īpašo failu NOSAUKUMS ar norādīto TIPU.\n"

#: src/mknod.c:76
msgid ""
"\n"
"Both MAJOR and MINOR must be specified when TYPE is b, c, or u, and they\n"
"must be omitted when TYPE is p.  If MAJOR or MINOR begins with 0x or 0X,\n"
"it is interpreted as hexadecimal; otherwise, if it begins with 0, as octal;\n"
"otherwise, as decimal.  TYPE may be:\n"
msgstr ""
"\n"
"Jānorāda gan MAJORAIS, gan MINORAIS, ja TIPS ir b, c vai u, un tie\n"
"jāizlaiž, ja TIPS ir p. Ja MAJORAIS vai MINORAIS sākas ar 0x vai 0X,\n"
"tas tiek interpretēts kā heksadecimāls; citādi, ja tas sākas ar 0, kā oktāls;\n"
"citādi — kā decimāls. TIPS var būt:\n"

#: src/mknod.c:83
msgid ""
"\n"
"  b      create a block (buffered) special file\n"
"  c, u   create a character (unbuffered) special file\n"
"  p      create a FIFO\n"
msgstr ""
"\n"
"  b      izveidot bloka (buferizētu) īpašo failu\n"
"  c, u   izveidot rakstzīmju (nebuferizētu) īpašo failu\n"
"  p      izveidot FIFO\n"

#: src/mknod.c:180
msgid "Special files require major and minor device numbers."
msgstr "Īpašajiem failiem nepieciešams galvenais un pakārtotais ierīces numurs."

#: src/mknod.c:190
msgid "Fifos do not have major and minor device numbers."
msgstr "FIFO nav galvenā un pakārtotā ierīces numura."

#: src/mknod.c:216
#, c-format
msgid "block special files not supported"
msgstr "bloku īpašie faili netiek atbalstīti"

#: src/mknod.c:225
#, c-format
msgid "character special files not supported"
msgstr "rakstzīmju īpašie faili netiek atbalstīti"

#: src/mknod.c:238
#, c-format
msgid "invalid major device number %s"
msgstr "nederīgs galvenais ierīces numurs %s"

#: src/mknod.c:245
#, c-format
msgid "invalid minor device number %s"
msgstr "nederīgs pakārtotais ierīces numurs %s"

#: src/mknod.c:250
#, c-format
msgid "invalid device %s %s"
msgstr "nederīga ierīce %s %s"

#: src/mknod.c:270
#, c-format
msgid "invalid device type %s"
msgstr "nederīgs ierīces tips %s"

#. This is a proper name. See the gettext manual, section Names.
#: src/mktemp.c:35
msgid "Eric Blake"
msgstr "Ēriks Bleiks"

#: src/mktemp.c:65
#, c-format
msgid "Usage: %s [OPTION]... [TEMPLATE]\n"
msgstr "Lietošana: %s [OPCIJA]... [VEIDNE]\n"

#: src/mktemp.c:66
msgid ""
"Create a temporary file or directory, safely, and print its name.\n"
"TEMPLATE must contain at least 3 consecutive 'X's in last component.\n"
"If TEMPLATE is not specified, use tmp.XXXXXXXXXX, and --tmpdir is implied.\n"
msgstr ""
"Droši izveidot pagaidu failu vai direktoriju un izvadīt tā nosaukumu.\n"
"VEIDNEI pēdējā komponentā jāsatur vismaz 3 secīgi 'X'.\n"
"Ja VEIDNE nav norādīta, izmantot tmp.XXXXXXXXXX, un tiek pieņemts --tmpdir.\n"

#: src/mktemp.c:71
msgid "Files are created u+rw, and directories u+rwx, minus umask restrictions.\n"
msgstr "Faili tiek izveidoti ar u+rw un direktorijas ar u+rwx, atskaitot umask ierobežojumus.\n"

#: src/mktemp.c:75
msgid ""
"  -d, --directory\n"
"         create a directory, not a file\n"
msgstr ""
"  -d, --directory\n"
"         izveidot direktoriju, nevis failu\n"

#: src/mktemp.c:79
msgid ""
"  -u, --dry-run\n"
"         do not create anything; merely print a name (unsafe)\n"
msgstr ""
"  -u, --dry-run\n"
"         neko neizveidot; tikai izvadīt nosaukumu (nedroši)\n"

#: src/mktemp.c:83
msgid ""
"  -q, --quiet\n"
"         suppress diagnostics about file/dir-creation failure\n"
msgstr ""
"  -q, --quiet\n"
"         nomākt diagnostiku par faila/direktorijas izveides kļūmēm\n"

#: src/mktemp.c:87
msgid ""
"      --suffix=SUFF\n"
"         append SUFF to TEMPLATE; SUFF must not contain a slash.\n"
"         This option is implied if TEMPLATE does not end in X\n"
msgstr ""
"      --suffix=SUFF\n"
"         pievienot SUFF pie VEIDNES; SUFF nedrīkst saturēt slīpsvītru.\n"
"         Šī opcija tiek pieņemta automātiski, ja VEIDNE nebeidzas ar X\n"

#: src/mktemp.c:92
msgid ""
"  -p DIR, --tmpdir[=DIR]\n"
"         interpret TEMPLATE relative to DIR;\n"
"         if DIR is not specified, use $TMPDIR if set, else /tmp.\n"
"         With this option, TEMPLATE must not be an absolute name;\n"
"         unlike with -t, TEMPLATE may contain slashes,\n"
"         but mktemp creates only the final component\n"
msgstr ""
"  -p DIR, --tmpdir[=DIR]\n"
"         interpretēt VEIDNI attiecībā pret DIR;\n"
"         ja DIR nav norādīts, izmantot $TMPDIR, ja tas ir iestatīts, citādi /tmp.\n"
"         Ar šo opciju VEIDNE nedrīkst būt absolūts nosaukums;\n"
"         atšķirībā no -t VEIDNE var saturēt slīpsvītras,\n"
"         bet mktemp izveido tikai pēdējo komponentu\n"

#: src/mktemp.c:100
msgid ""
"  -t\n"
"         interpret TEMPLATE as a single file name component,\n"
"         relative to a directory: $TMPDIR, if set;\n"
"         else the directory specified via -p; else /tmp [deprecated]\n"
msgstr ""
"  -t\n"
"         interpretēt VEIDNI kā vienu faila nosaukuma komponentu,\n"
"         attiecībā pret direktoriju: $TMPDIR, ja tas ir iestatīts;\n"
"         citādi direktoriju, kas norādīta ar -p; citādi /tmp [novecojis]\n"

#: src/mktemp.c:218
#, c-format
msgid "too many templates"
msgstr "pārāk daudz veidņu"

#: src/mktemp.c:238
#, c-format
msgid "with --suffix, template %s must end in X"
msgstr "ar --suffix veidnei %s jābeidzas ar X"

#: src/mktemp.c:263 src/split.c:1454
#, c-format
msgid "invalid suffix %s, contains directory separator"
msgstr "nederīgs sufikss %s, satur direktoriju atdalītāju"

#: src/mktemp.c:272
#, c-format
msgid "too few X's in template %s"
msgstr "veidnē %s ir pārāk maz 'X'"

#: src/mktemp.c:290
#, c-format
msgid "invalid template, %s, contains directory separator"
msgstr "nederīga veidne, %s, satur direktoriju atdalītāju"

#: src/mktemp.c:304
#, c-format
msgid "invalid template, %s; with --tmpdir, it may not be absolute"
msgstr "nederīga veidne, %s; ar --tmpdir tā nedrīkst būt absolūta"

#: src/mktemp.c:325
#, c-format
msgid "failed to create directory via template %s"
msgstr "neizdevās izveidot direktoriju pēc veidnes %s"

#: src/mktemp.c:336
#, c-format
msgid "failed to create file via template %s"
msgstr "neizdevās izveidot failu pēc veidnes %s"

#: src/mv.c:259
msgid "Rename SOURCE to DEST, or move SOURCE(s) to DIRECTORY.\n"
msgstr "Pārdēvēt AVOTU uz MĒRĶI vai pārvietot AVOTU(s) uz DIREKTORIJU.\n"

#: src/mv.c:277
msgid ""
"      --exchange\n"
"         exchange source and destination\n"
msgstr ""
"      --exchange\n"
"         apmainīt avotu un mērķi vietām\n"

#: src/mv.c:281
msgid ""
"  -f, --force\n"
"         do not prompt before overwriting\n"
msgstr ""
"  -f, --force\n"
"         neprasīt apstiprinājumu pirms pārrakstīšanas\n"

#: src/mv.c:285
msgid ""
"  -i, --interactive\n"
"         prompt before overwrite\n"
msgstr ""
"  -i, --interactive\n"
"         prasīt apstiprinājumu pirms pārrakstīšanas\n"

#: src/mv.c:293
msgid "If you specify more than one of -i, -f, -n, only the final one takes effect.\n"
msgstr "Ja norāda vairāk nekā vienu no -i, -f, -n, spēkā ir tikai pēdējā.\n"

#: src/mv.c:296
msgid ""
"      --no-copy\n"
"         do not copy if renaming fails\n"
msgstr ""
"      --no-copy\n"
"         nekopēt, ja pārdēvēšana neizdodas\n"

#: src/mv.c:308
msgid ""
"  -t, --target-directory=DIRECTORY\n"
"         move all SOURCE arguments into DIRECTORY\n"
msgstr ""
"  -t, --target-directory=DIREKTORIJA\n"
"         pārvietot visus AVOTS argumentus uz DIREKTORIJU\n"

#: src/mv.c:329
msgid ""
"  -Z, --context\n"
"         set SELinux security context of destination file to default type\n"
msgstr ""
"  -Z, --context\n"
"         iestatīt mērķa faila SELinux drošības kontekstu uz noklusējuma tipu\n"

#: src/mv.c:530
#, c-format
msgid "cannot combine --backup with --exchange, -n, or --update=none-fail"
msgstr "nevar kombinēt --backup ar --exchange, -n vai --update=none-fail"

#: src/nice.c:72
#, c-format
msgid "Usage: %s [OPTION] [COMMAND [ARG]...]\n"
msgstr "Lietojums: %s [OPCIJA] [KOMANDA [ARG]...]\n"

#: src/nice.c:73
#, c-format
msgid ""
"Run COMMAND with an adjusted niceness, which affects process scheduling.\n"
"With no COMMAND, print the current niceness.  Niceness values range from\n"
"%d (most favorable to the process) to %d (least favorable to the process).\n"
msgstr ""
"Palaist KOMANDU ar pielāgotu prioritāti, kas ietekmē procesu plānošanu.\n"
"Ja KOMANDA nav norādīta, izvadīt pašreizējo prioritāti.  Prioritātes vērtības ir no\n"
"%d (vislabvēlīgākā procesam) līdz %d (visnelabvēlīgākā procesam).\n"

#: src/nice.c:82
msgid ""
"  -n, --adjustment=N\n"
"         add integer N to the niceness (default 10)\n"
msgstr ""
"  -n, --adjustment=N\n"
"         pievienot veselu skaitli N prioritātei (noklusējumā 10)\n"

#: src/nice.c:181
#, c-format
msgid "invalid adjustment %s"
msgstr "nederīgs pielāgojums %s"

#: src/nice.c:191 src/nice.c:224 src/nice.c:235
#, c-format
msgid "cannot get niceness"
msgstr "neizdevās iegūt prioritāti"

#: src/nice.c:217
#, c-format
msgid "a command must be given with an adjustment"
msgstr "kopā ar prioritātes korekciju jānorāda komanda"

#: src/nice.c:241
#, c-format
msgid "cannot set niceness"
msgstr "neizdevās iestatīt prioritāti"

#. This is a proper name. See the gettext manual, section Names.
#: src/nl.c:40
msgid "Scott Bartram"
msgstr "Scott Bartram"

#: src/nl.c:185
msgid "Write each FILE to standard output, with line numbers added.\n"
msgstr "Izvadīt katru FAILU standarta izvadē, pievienojot rindu numurus.\n"

#: src/nl.c:192
msgid "  -b, --body-numbering=STYLE      use STYLE for numbering body lines\n"
msgstr "  -b, --body-numbering=STILS      izmantot STILU pamatteksta rindu numerācijai\n"

#: src/nl.c:195
msgid "  -d, --section-delimiter=CC      use CC for logical page delimiters\n"
msgstr "  -d, --section-delimiter=CC      izmantot CC loģisko lapu atdalītājiem\n"

#: src/nl.c:198
msgid "  -f, --footer-numbering=STYLE    use STYLE for numbering footer lines\n"
msgstr "  -f, --footer-numbering=STILS    izmantot STILU kājenes rindu numerācijai\n"

#: src/nl.c:201
msgid "  -h, --header-numbering=STYLE    use STYLE for numbering header lines\n"
msgstr "  -h, --header-numbering=STILS    izmantot STILU galvenes rindu numerācijai\n"

#: src/nl.c:204
msgid "  -i, --line-increment=NUMBER     line number increment at each line\n"
msgstr "  -i, --line-increment=CIPARS     rindas numura pieaugums katrā rindā\n"

#: src/nl.c:207
msgid "  -l, --join-blank-lines=NUMBER   group of NUMBER empty lines counted as one\n"
msgstr "  -l, --join-blank-lines=CIPARS   CIPARS tukšu rindu grupu skaitīt kā vienu\n"

#: src/nl.c:210
msgid "  -n, --number-format=FORMAT      insert line numbers according to FORMAT\n"
msgstr "  -n, --number-format=FORMĀTS      ievietot rindu numurus saskaņā ar FORMĀTU\n"

#: src/nl.c:213
msgid "  -p, --no-renumber               do not reset line numbers for each section\n"
msgstr "  -p, --no-renumber               neatstatīt rindu numurus katrā sadaļā\n"

#: src/nl.c:216
msgid "  -s, --number-separator=STRING   add STRING after (possible) line number\n"
msgstr "  -s, --number-separator=VIRKNE   pievienot VIRKNI pēc (iespējamā) rindas numura\n"

#: src/nl.c:219
msgid "  -v, --starting-line-number=NUMBER  first line number for each section\n"
msgstr "  -v, --starting-line-number=CIPARS  pirmās rindas numurs katrā sadaļā\n"

#: src/nl.c:222
msgid "  -w, --number-width=NUMBER       use NUMBER columns for line numbers\n"
msgstr "  -w, --number-width=CIPARS       izmantot CIPARU kolonnas rindu numuriem\n"

#: src/nl.c:227
msgid ""
"\n"
"Default options are: -bt -d'\\:' -fn -hn -i1 -l1 -n'rn' -s<TAB> -v1 -w6\n"
"\n"
"CC are two delimiter characters used to construct logical page delimiters;\n"
"a missing second character implies ':'.  As a GNU extension one can specify\n"
"more than two characters, and also specifying the empty string (-d '')\n"
"disables section matching.\n"
msgstr ""
"\n"
"Noklusējuma opcijas ir: -bt -d'\\:' -fn -hn -i1 -l1 -n'rn' -s<TAB> -v1 -w6\n"
"\n"
"CC ir divas atdalītājrakstzīmes, ko izmanto loģisko lapu atdalītāju veidošanai;\n"
"trūkstoša otrā rakstzīme nozīmē ':'. Kā GNU paplašinājumu var norādīt\n"
"vairāk nekā divas rakstzīmes, kā arī tukšas virknes norādīšana (-d '')\n"
"atspējo sadaļu atbilstības pārbaudi.\n"

#: src/nl.c:236
msgid ""
"\n"
"STYLE is one of:\n"
"\n"
"  a      number all lines\n"
"  t      number only nonempty lines\n"
"  n      number no lines\n"
"  pBRE   number only lines that contain a match for the basic regular\n"
"         expression, BRE\n"
msgstr ""
"\n"
"STILS ir viens no:\n"
"\n"
"  a      numurēt visas rindas\n"
"  t      numurēt tikai netukšās rindas\n"
"  n      nenumurēt nevienu rindu\n"
"  pBRE   numurēt tikai rindas, kas satur atbilstību pamata regulārajai\n"
"         izteiksmei BRE\n"

#: src/nl.c:246
msgid ""
"\n"
"FORMAT is one of:\n"
"\n"
"  ln     left justified, no leading zeros\n"
"  rn     right justified, no leading zeros\n"
"  rz     right justified, leading zeros\n"
"\n"
msgstr ""
"\n"
"FORMĀTS ir viens no:\n"
"\n"
"  ln     līdzināts pa kreisi, bez vadošajām nullēm\n"
"  rn     līdzināts pa labi, bez vadošajām nullēm\n"
"  rz     līdzināts pa labi, ar vadošajām nullēm\n"
"\n"

#: src/nl.c:302
#, c-format
msgid "line number overflow"
msgstr "rindas numura pārpilde"

#: src/nl.c:521
#, c-format
msgid "invalid header numbering style: %s"
msgstr "nederīgs galvenes numerācijas stils: %s"

#: src/nl.c:529
#, c-format
msgid "invalid body numbering style: %s"
msgstr "nederīgs pamatteksta numurēšanas stils: %s"

#: src/nl.c:537
#, c-format
msgid "invalid footer numbering style: %s"
msgstr "nederīgs kājenes numurēšanas stils: %s"

#: src/nl.c:544
