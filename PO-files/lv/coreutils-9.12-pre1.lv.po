msgstr "nederīgs konvertēšanas specifikators piedēklī: \\%.3o"

#: src/csplit.c:1242
#, c-format
msgid "invalid flags in conversion specification: %%%c%c"
msgstr "nederīgi karogi konvertēšanas specifikācijā: %%%c%c"

#: src/csplit.c:1259
#, c-format
msgid "too many %% conversion specifications in suffix"
msgstr "pārāk daudz %% konvertēšanas specifikāciju piedēklī"

#: src/csplit.c:1273
#, c-format
msgid "missing %% conversion specification in suffix"
msgstr "trūkst %% konvertēšanas specifikācijas piedēklī"

#: src/csplit.c:1314 src/dd.c:1605 src/nproc.c:113
msgid "invalid number"
msgstr "nederīgs skaitlis"

#: src/csplit.c:1401
#, c-format
msgid "Usage: %s [OPTION]... FILE PATTERN...\n"
msgstr "Lietošana: %s [OPCIJA]... FAILS ŠABLONS...\n"

#: src/csplit.c:1405
msgid ""
"Output pieces of FILE separated by PATTERN(s) to files 'xx00', 'xx01', ...,\n"
"and output byte counts of each piece to standard output.\n"
msgstr ""
"Izvadīt FAILA daļas, kas atdalītas ar ŠABLONU(-iem), failos 'xx00', 'xx01', ...,\n"
"un izvadīt katras daļas baitu skaitu standarta izvadē.\n"

#: src/csplit.c:1409
msgid ""
"\n"
"Read standard input if FILE is -\n"
msgstr ""
"\n"
"Lasīt standarta ievadi, ja FAILS ir -\n"

#: src/csplit.c:1416
#, c-format
msgid ""
"  -b, --suffix-format=FORMAT\n"
"         use sprintf FORMAT instead of %02d\n"
msgstr ""
"  -b, --suffix-format=FORMĀTS\n"
"         izmantot sprintf FORMĀTU %02d vietā\n"

#: src/csplit.c:1420
msgid ""
"  -f, --prefix=PREFIX\n"
"         use PREFIX instead of 'xx'\n"
msgstr ""
"  -f, --prefix=PREFIKSS\n"
"         izmantot PREFIKSU 'xx' vietā\n"

#: src/csplit.c:1424
msgid ""
"  -k, --keep-files\n"
"         do not remove output files on errors\n"
msgstr ""
"  -k, --keep-files\n"
"         nedzēst izvades failus kļūdu gadījumā\n"

#: src/csplit.c:1428
msgid ""
"      --suppress-matched\n"
"         suppress the lines matching PATTERN\n"
msgstr ""
"      --suppress-matched\n"
"         neizvadīt rindas, kas atbilst ŠABLONAM\n"

#: src/csplit.c:1432
msgid ""
"  -n, --digits=DIGITS\n"
"         use specified number of digits instead of 2\n"
msgstr ""
"  -n, --digits=CIPARI\n"
"         izmantot norādīto ciparu skaitu 2 vietā\n"

#: src/csplit.c:1436
msgid ""
"  -s, --quiet, --silent\n"
"         do not print counts of output file sizes\n"
msgstr ""
"  -s, --quiet, --silent\n"
"         neizvadīt izvades failu izmēru skaitu\n"

#: src/csplit.c:1440
msgid ""
"  -z, --elide-empty-files\n"
"         suppress empty output files\n"
msgstr ""
"  -z, --elide-empty-files\n"
"         neveidot tukšus izvades failus\n"

#: src/csplit.c:1446
msgid ""
"\n"
"Each PATTERN may be:\n"
"  INTEGER            copy up to but not including specified line number\n"
"  /REGEXP/[OFFSET]   copy up to but not including a matching line\n"
"  %REGEXP%[OFFSET]   skip to, but not including a matching line\n"
"  {INTEGER}          repeat the previous pattern specified number of times\n"
"  {*}                repeat the previous pattern as many times as possible\n"
"\n"
"A line OFFSET is an integer optionally preceded by '+' or '-'\n"
msgstr ""
"\n"
"Katrs ŠABLONS var būt:\n"
"  INTEGER           kopēt līdz norādītajam rindas numuram (neieskaitot)\n"
"  /REGEXP/[NOBĪDE]   kopēt līdz atbilstošajai rindai (neieskaitot)\n"
"  %REGEXP%[NOBĪDE]   izlaist līdz atbilstošajai rindai (neieskaitot)\n"
"  {INTEGER}         atkārtot iepriekšējo šablonu norādīto reižu skaitu\n"
"  {*}                atkārtot iepriekšējo šablonu pēc iespējas vairāk reižu\n"
"\n"
"Rindas NOBĪDE ir vesels skaitlis, pirms kura var būt '+' vai '-'\n"

#. This is a proper name. See the gettext manual, section Names.
#: src/cut.c:46 src/paste.c:51
msgid "David M. Ihnat"
msgstr "Deivids M. Inats"

#: src/cut.c:181
#, c-format
msgid "Usage: %s OPTION... [FILE]...\n"
msgstr "Lietošana: %s OPCIJA... [FAILS]...\n"

#: src/cut.c:185
msgid "Print selected parts of lines from each FILE to standard output.\n"
msgstr "Izvadīt atlasītās rindu daļas no katra FAILA standarta izvadē.\n"

#: src/cut.c:192
msgid ""
"  -b, --bytes=LIST\n"
"         select only these byte positions\n"
msgstr ""
"  -b, --bytes=SARAKSTS\n"
"         atlasīt tikai šīs baitu pozīcijas\n"

#: src/cut.c:196
msgid ""
"  -c, --characters=LIST\n"
"         select only these character positions\n"
msgstr ""
"  -c, --characters=SARAKSTS\n"
"         atlasīt tikai šīs rakstzīmju pozīcijas\n"

#: src/cut.c:200
msgid ""
"      --complement\n"
"         complement the set of selected bytes, characters or fields\n"
msgstr ""
"      --complement\n"
"         veidot atlasīto baitu, rakstzīmju vai lauku kopas papildinājumu\n"

#: src/cut.c:204
msgid ""
"  -d, --delimiter=DELIM\n"
"         use DELIM instead of TAB for field delimiter\n"
msgstr ""
"  -d, --delimiter=ATDALĪTĀJS\n"
"         izmantot ATDALĪTĀJU TAB vietā kā lauka atdalītāju\n"

#: src/cut.c:208
msgid ""
"  -f, --fields=LIST\n"
"         select only these fields;  also print any line that contains\n"
"         no delimiter character, unless the -s option is specified\n"
msgstr ""
"  -f, --fields=SARAKSTS\n"
"         atlasīt tikai šos laukus; arī izvadīt jebkuru rindu, kas nesatur\n"
"         atdalītāja rakstzīmi, ja vien nav norādīta opcija -s\n"

#: src/cut.c:213
msgid ""
"  -F LIST\n"
"         like -f, but also implies -w and -O ' '\n"
msgstr ""
"  -F SARAKSTS\n"
"         tāpat kā -f, bet ietver arī -w un -O ' '\n"

#: src/cut.c:217
msgid ""
"  -n, --no-partial\n"
"         with -b, don't output partial multi-byte characters\n"
msgstr ""
"  -n, --no-partial\n"
"         kopā ar -b neizvadīt nepilnīgas daudzbaitu rakstzīmes\n"

#: src/cut.c:221
msgid ""
"  -O, --output-delimiter=STRING\n"
"         use STRING as the output delimiter;\n"
"         the default is to use the input delimiter\n"
msgstr ""
"  -O, --output-delimiter=VIRKNE\n"
"         izmantot VIRKNI kā izvades atdalītāju;\n"
"         pēc noklusējuma tiek izmantots ievades atdalītājs\n"

#: src/cut.c:226
msgid ""
"  -s, --only-delimited\n"
"         do not print lines not containing delimiters\n"
msgstr ""
"  -s, --only-delimited\n"
"         neizvadīt rindas, kas nesatur atdalītājus\n"

#: src/cut.c:230
msgid ""
"  -w, --whitespace-delimited[=trimmed]\n"
"         use a run of blank characters as the field delimiter;\n"
"         with 'trimmed', ignore leading and trailing blanks\n"
msgstr ""
"  -w, --whitespace-delimited[=trimmed]\n"
"         kā lauku atdalītāju izmantot tukšumzīmju virkni;\n"
"         ar 'trimmed' ignorēt sākuma un beigu tukšumzīmes\n"

#: src/cut.c:241
msgid ""
"\n"
"Use one, and only one of -b, -c, -f or -F.  Each LIST is made up of one\n"
"range, or many ranges separated by commas.  Selected input is written\n"
"in the same order that it is read, and is written exactly once.\n"
msgstr ""
"\n"
"Izmantot tikai vienu no opcijām -b, -c, -f vai -F.  Katrs SARAKSTS sastāv no viena\n"
"diapazona vai vairākiem ar komatiem atdalītiem diapazoniem.  Atlasītā ievade tiek izvadīta\n"
"tādā pašā secībā, kādā nolasīta, un tieši vienu reizi.\n"

#: src/cut.c:247
msgid ""
"Each range is one of:\n"
"\n"
"  N     N'th byte, character or field, counted from 1\n"
"  N-    from N'th byte, character or field, to end of line\n"
"  N-M   from N'th to M'th (included) byte, character or field\n"
"  -M    from first to M'th (included) byte, character or field\n"
msgstr ""
"Katrs diapazons ir viens no šiem:\n"
"\n"
"  N     N-tais baits, rakstzīme vai lauks, skaitot no 1\n"
"  N-    no N-tā baita, rakstzīmes vai lauka līdz rindas beigām\n"
"  N-M   no N-tā līdz M-tajam (ieskaitot) baitam, rakstzīmei vai laukam\n"
"  -M    no pirmā līdz M-tajam (ieskaitot) baitam, rakstzīmei vai laukam\n"

#: src/cut.c:1332
msgid "only one list may be specified"
msgstr "var norādīt tikai vienu sarakstu"

#: src/cut.c:1342 src/numfmt.c:1623
#, c-format
msgid "the delimiter must be a single character"
msgstr "atdalītājam jābūt vienai rakstzīmei"

#: src/cut.c:1392
msgid "you must specify a list of bytes, characters, or fields"
msgstr "jānorāda baitu, rakstzīmju vai lauku saraksts"

#: src/cut.c:1397
msgid ""
"an input delimiter makes sense\n"
"\tonly when operating on fields"
msgstr ""
"ievades atdalītājam ir jēga\n"
"\ttikai strādājot ar laukiem"

#: src/cut.c:1401
msgid ""
"suppressing non-delimited lines makes sense\n"
"\tonly when operating on fields"
msgstr ""
"neatdalīto rindu slāpēšanai ir jēga\n"
"\ttikai strādājot ar laukiem"

#: src/cut.c:1406
msgid "-d and -w are mutually exclusive"
msgstr "-d un -w ir savstarpēji izslēdzošas"

#: src/date.c:123
#, c-format
msgid ""
"Usage: %s [OPTION]... [+FORMAT]\n"
"  or:  %s [OPTION]... MMDDhhmm[[CC]YY][.ss]\n"
msgstr ""
"Lietošana: %s [OPCIJA]... [+FORMĀTS]\n"
"  vai:  %s [OPCIJA]... MMDDhhmm[[GS]GG][.ss]\n"

#: src/date.c:128
msgid ""
"Display date and time in the given FORMAT.\n"
"With -s, or with MMDDhhmm[[CC]YY][.ss], set the date and time first.\n"
msgstr ""
"Parādīt datumu un laiku norādītajā FORMĀTĀ.\n"
"Ar -s vai ar MMDDhhmm[[GS]GG][.ss] vispirms iestatīt datumu un laiku.\n"

#: src/date.c:135
msgid ""
"  -d, --date=STRING\n"
"         display time described by STRING, not 'now'\n"
msgstr ""
"  -d, --date=TEKSTS\n"
"         parādīt laiku, ko apraksta TEKSTS, nevis 'now'\n"

#: src/date.c:139
msgid ""
"      --debug\n"
"         annotate the parsed date,\n"
"         and warn about questionable usage to standard error\n"
msgstr ""
"      --debug\n"
"         anotēt parsēto datumu,\n"
"         un brīdināt par apšaubāmu lietojumu standarta kļūdu izvadē\n"

#: src/date.c:144
msgid ""
"  -f, --file=DATEFILE\n"
"         like --date; once for each line of DATEFILE;\n"
"         if DATEFILE is -, read names from standard input\n"
msgstr ""
"  -f, --file=DATUMFAILS\n"
"         tāpat kā --date; vienreiz katrai DATUMFAILA rindai;\n"
"         ja DATUMFAILS ir -, nolasīt nosaukumus no standarta ievades\n"

#: src/date.c:149
msgid ""
"  -I[FMT], --iso-8601[=FMT]\n"
"         output date/time in ISO 8601 format.\n"
"         FMT='date' (default), 'hours', 'minutes', 'seconds', or 'ns'\n"
"         for date and time to the indicated precision.\n"
"         Example: 2006-08-14T02:34:56-06:00\n"
msgstr ""
"  -I[FORMĀTS], --iso-8601[=FORMĀTS]\n"
"         izvadīt datumu/laiku ISO 8601 formātā.\n"
"         FORMĀTS='date' (noklusējums), 'hours', 'minutes', 'seconds' vai 'ns'\n"
"         datuma un laika norādītajai precizitātei.\n"
"         Piemērs: 2006-08-14T02:34:56-06:00\n"

#: src/date.c:156
msgid ""
"      --resolution\n"
"         output the available resolution of timestamps.\n"
"         Example: 0.000000001\n"
msgstr ""
"      --resolution\n"
"         izvadīt pieejamo laikspiedolu izšķirtspēju.\n"
"         Piemērs: 0.000000001\n"

#: src/date.c:161
msgid ""
"  -R, --rfc-email\n"
"         output date and time in RFC 5322 format.\n"
"         Example: Mon, 14 Aug 2006 02:34:56 +0000\n"
msgstr ""
"  -R, --rfc-email\n"
"         izvadīt datumu un laiku RFC 5322 formātā.\n"
"         Piemērs: Mon, 14 Aug 2006 02:34:56 +0000\n"

#: src/date.c:166
msgid ""
"      --rfc-3339=FMT\n"
"         output date/time in RFC 3339 format.\n"
"         FMT='date', 'seconds', or 'ns'\n"
"         for date and time to the indicated precision.\n"
"         Example: 2006-08-14 02:34:56-06:00\n"
msgstr ""
"      --rfc-3339=FORMĀTS\n"
"         izvadīt datumu/laiku RFC 3339 formātā.\n"
"         FORMĀTS='date', 'seconds' vai 'ns'\n"
"         datuma un laika norādītajai precizitātei.\n"
"         Piemērs: 2006-08-14 02:34:56-06:00\n"

#: src/date.c:173
msgid ""
"  -r, --reference=FILE\n"
"         display the last modification time of FILE\n"
msgstr ""
"  -r, --reference=FAILS\n"
"         parādīt FAILA pēdējās modifikācijas laiku\n"

#: src/date.c:177
msgid ""
"  -s, --set=STRING\n"
"         set time described by STRING\n"
msgstr ""
"  -s, --set=TEKSTS\n"
"         iestatīt laiku, ko apraksta TEKSTS\n"

#: src/date.c:181
msgid ""
"  -u, --utc, --universal\n"
"         print or set Coordinated Universal Time (UTC)\n"
msgstr ""
"  -u, --utc, --universal\n"
"         parādīt vai iestatīt koordinēto universālo laiku (UTC)\n"

#: src/date.c:187
msgid ""
"\n"
"All options that specify the date to display are mutually exclusive.\n"
"I.e.: --date, --file, --reference, --resolution.\n"
msgstr ""
"\n"
"Visas opcijas, kas norāda parādāmo datumu, ir savstarpēji izslēdzošas.\n"
"T.i.: --date, --file, --reference, --resolution.\n"

#: src/date.c:192
msgid ""
"\n"
"FORMAT controls the output.  Interpreted sequences are:\n"
"\n"
msgstr ""
"\n"
"FORMĀTS kontrolē izvadi. Interpretētās sekvences ir:\n"
"\n"

#: src/date.c:197
msgid ""
"FORMAT  Example    Description\n"
"\n"
msgstr ""
"FORMĀTS  Piemērs    Apraksts\n"
"\n"

#: src/date.c:201
msgid "  %%    %           a literal %\n"
msgstr "  %%    %           literāls %\n"

#: src/date.c:204
#, c-format
msgid "  %n    \\n          a newline\n"
msgstr "  %n    \\n          jauna rinda\n"

#: src/date.c:207
msgid "  %t    \\t          a tab\n"
msgstr "  %t    \\t          tabulācija\n"

#: src/date.c:213
msgid "  %C    20          century; like %Y, except omit last two digits\n"
msgstr "  %C    20          gadsimts; līdzīgs %Y, izņemot pēdējos divus ciparus\n"

#: src/date.c:216
msgid "  %y    99          year (last two digits; 00..99)\n"
msgstr "  %y    99          gads (pēdējie divi cipari; 00..99)\n"

#: src/date.c:219
msgid "  %Y    1999        year\n"
msgstr "  %Y    1999        gads\n"

#: src/date.c:222
#, c-format
msgid "  %g    99          year of ISO week number (last 2 digits; 00-99); see %G\n"
msgstr "  %g    99          ISO nedēļas numura gads (pēdējie 2 cipari; 00-99); skatīt %G\n"

#: src/date.c:225
msgid "  %G    1999        year of ISO week number; normally useful only with %V\n"
msgstr "  %G    1999        ISO nedēļas numura gads; parasti noderīgs tikai ar %V\n"

#: src/date.c:231
#, c-format
msgid "  %a    Sun         locale's abbreviated weekday name\n"
msgstr "  %a    Sv          lokāles saīsinātais nedēļas dienas nosaukums\n"

#: src/date.c:234
#, c-format
msgid "  %A    Sunday      locale's full weekday name\n"
msgstr "  %A    Svētdiena   lokāles pilnais nedēļas dienas nosaukums\n"

#: src/date.c:237
#, c-format
msgid "  %b    Mar         locale's abbreviated month name\n"
msgstr "  %b    Okt         lokāles saīsinātais mēneša nosaukums\n"

#: src/date.c:240
msgid "  %h    Mar         same as %b\n"
msgstr "  %h    Okt         tāds pats kā %b\n"

#: src/date.c:243
msgid "  %B    March       locale's full month name\n"
msgstr "  %B    Oktobris     lokāles pilnais mēneša nosaukums\n"

#: src/date.c:246
#, c-format
msgid "  %m    12          month (01..12)\n"
msgstr "  %m    12          mēnesis (01..12)\n"

#: src/date.c:249
#, c-format
msgid "  %d    31          day of month (01..31)\n"
msgstr "  %d    31          mēneša diena (01..31)\n"

#: src/date.c:252
msgid "  %e     1          day of month, space padded; same as %_d\n"
msgstr "  %e     1          mēneša diena, papildināta ar atstarpi; tāds pats kā %_d\n"

#: src/date.c:255
msgid "  %D    12/31/99    date (ambiguous); same as %m/%d/%y\n"
msgstr "  %D    12/31/99    datums (neviennozīmīgs); tāds pats kā %m/%d/%y\n"

#: src/date.c:258
msgid "  %F    1999-12-31  full date; like %+4Y-%m-%d\n"
msgstr "  %F    1999-12-31  pilns datums; līdzīgs %+4Y-%m-%d\n"

#: src/date.c:261
#, c-format
msgid "  %x    12/31/99    locale's date (can be ambiguous)\n"
msgstr "  %x    12/31/99    lokāles datums (var būt neviennozīmīgs)\n"

#: src/date.c:264
#, c-format
msgid "  %c    ...         locale's date and time (e.g., Thu Mar  3 23:05 2005)\n"
msgstr "  %c    ...         lokāles datums un laiks (piem., Thu Mar  3 23:05 2005)\n"

#: src/date.c:270
msgid "  %H    23          hour (00..23)\n"
msgstr "  %H    23          stunda (00..23)\n"

#: src/date.c:273
msgid "  %I    01          hour (01..12)\n"
msgstr "  %I    01          stunda (01..12)\n"

#: src/date.c:276
msgid "  %k     8          hour, space padded ( 0..23); same as %_H\n"
msgstr "  %k     8          stunda, papildināta ar atstarpi ( 0..23); tas pats, kas %_H\n"

#: src/date.c:279
msgid "  %l     9          hour, space padded ( 1..12); same as %_I\n"
msgstr "  %l     9          stunda, papildināta ar atstarpi ( 1..12); tas pats, kas %_I\n"

#: src/date.c:282
msgid "  %M    59          minute (00..59)\n"
msgstr "  %M    59          minūte (00..59)\n"

#: src/date.c:285
#, c-format
msgid "  %S    60          second (00..60)\n"
msgstr "  %S    60          sekunde (00..60)\n"

#: src/date.c:288
msgid "  %N    123456789   nanoseconds (000000000..999999999)\n"
msgstr "  %N    123456789   nanosekundes (000000000..999999999)\n"

#: src/date.c:291
#, c-format
msgid "  %s    1970010100  seconds since the Epoch (1970-01-01 00:00 UTC)\n"
msgstr "  %s    1970010100  sekundes kopš epohas (1970-01-01 00:00 UTC)\n"

#: src/date.c:294
#, c-format
msgid "  %p    PM          locale's equivalent of AM or PM; blank if not known\n"
msgstr "  %p    PM          lokāles AM vai PM ekvivalents; tukšs, ja nav zināms\n"

#: src/date.c:297
msgid "  %P    am          like %p, but lower case\n"
msgstr "  %P    am          kā %p, bet ar mazajiem burtiem\n"

#: src/date.c:300
msgid "  %r    1:11:04 PM  locale's 12-hour clock time\n"
msgstr "  %r    1:11:04 PM  lokāles 12 stundu pulksteņa laiks\n"

#: src/date.c:303
msgid "  %R    23:59       24-hour hour and minute; same as %H:%M\n"
msgstr "  %R    23:59       stunda un minūte 24 stundu formātā; tas pats, kas %H:%M\n"

#: src/date.c:306
msgid "  %T    23:59:59    time; same as %H:%M:%S\n"
msgstr "  %T    23:59:59    laiks; tas pats, kas %H:%M:%S\n"

#: src/date.c:309
#, c-format
msgid "  %X    23:59:59    locale's time representation\n"
msgstr "  %X    23:59:59    lokāles laika attēlojums\n"

#: src/date.c:315
msgid "  %j    365         day of year (001..366)\n"
msgstr "  %j    365         gada diena (001..366)\n"

#: src/date.c:318
msgid "  %q    4           quarter of year (1..4)\n"
msgstr "  %q    4           gada ceturksnis (1..4)\n"

#: src/date.c:321
#, c-format
msgid "  %u    7           day of week (1..7); 1 is Monday\n"
msgstr "  %u    7           nedēļas diena (1..7); 1 ir pirmdiena\n"

#: src/date.c:324
msgid "  %w    6           day of week (0..6); 0 is Sunday\n"
msgstr "  %w    6           nedēļas diena (0..6); 0 ir svētdiena\n"

#: src/date.c:327
msgid "  %U    52          week of year; Sunday as first day of week (00..53)\n"
msgstr "  %U    52          gada nedēļa; svētdiena kā nedēļas pirmā diena (00..53)\n"

#: src/date.c:330
msgid "  %V    52          ISO week number; Monday as first day of week (01..53)\n"
msgstr "  %V    52          ISO nedēļas numurs; pirmdiena kā nedēļas pirmā diena (01..53)\n"

#: src/date.c:333
msgid "  %W    52          week of year; Monday as first day of week (00..53)\n"
msgstr "  %W    52          gada nedēļa; pirmdiena kā nedēļas pirmā diena (00..53)\n"

#: src/date.c:339
msgid "  %z     +0400      +hhmm numeric time zone\n"
msgstr "  %z     +0400      +hhmm skaitliskā laika josla\n"

#: src/date.c:342
msgid "  %:z    +04:00     +hh:mm numeric time zone\n"
msgstr "  %:z    +04:00     +hh:mm skaitliskā laika josla\n"

#: src/date.c:345
msgid "  %::z   +04:00:00  +hh:mm:ss numeric time zone\n"
msgstr "  %::z   +04:00:00  +hh:mm:ss skaitliskā laika josla\n"

#: src/date.c:348
msgid "  %:::z  +04        numeric time zone to necessary precision; with :\n"
msgstr "  %:::z  +04        skaitliskā laika josla ar nepieciešamo precizitāti; ar :\n"

#: src/date.c:351
msgid "  %Z     EDT        alphabetic time zone abbreviation\n"
msgstr "  %Z     EDT        alfabētisks laika joslas saīsinājums\n"

#: src/date.c:354
msgid ""
"\n"
"By default, date pads numeric fields with zeroes.\n"
msgstr ""
"\n"
"Pēc noklusējuma date papildina skaitliskos laukus ar nullēm.\n"

#: src/date.c:358
msgid ""
"The following optional flags may follow '%':\n"
"\n"
"  -  (hyphen) do not pad the field\n"
"  _  (underscore) pad with spaces\n"
"  0  (zero) pad with zeros\n"
"  +  pad with zeros, and put '+' before future years with >4 digits\n"
"  ^  use upper case if possible\n"
"  #  use opposite case if possible\n"
msgstr ""
"Pēc '%' var sekot šādi neobligāti karogi:\n"
"\n"
"  -  (defise) neaizpildīt lauku\n"
"  _  (pasvītra) aizpildīt ar atstarpēm\n"
"  0  (nulle) aizpildīt ar nullēm\n"
"  +  aizpildīt ar nullēm un ievietot '+' pirms nākotnes gadiem ar >4 cipariem\n"
"  ^  ja iespējams, lietot lielos burtus\n"
"  #  ja iespējams, lietot pretējo reģistru\n"

#: src/date.c:368
msgid ""
"\n"
"After any flags comes an optional field width, as a decimal number;\n"
"then an optional modifier, which is either\n"
"E to use the locale's alternate representations if available, or\n"
"O to use the locale's alternate numeric symbols if available.\n"
msgstr ""
"\n"
"Pēc karogiem var sekot neobligāts lauka platums decimālskaitļa formā;\n"
"pēc tam neobligāts modifikators, kas ir vai nu\n"
"E, lai izmantotu lokāles alternatīvos attēlojumus, ja pieejami, vai\n"
"O, lai izmantotu lokāles alternatīvos skaitliskos simbolus, ja pieejami.\n"

#: src/date.c:375
msgid ""
"\n"
"Examples:\n"
"Convert seconds since the Epoch (1970-01-01 UTC) to a date\n"
"  $ date --date='@2147483647'\n"
"\n"
"Show the time on the west coast of the US (use tzselect(1) to find TZ)\n"
"  $ TZ='America/Los_Angeles' date\n"
"\n"
"Show the local time for 9AM next Friday on the west coast of the US\n"
"  $ date --date='TZ=\"America/Los_Angeles\" 09:00 next Fri'\n"
msgstr ""
"\n"
"Piemēri:\n"
"Pārvērst sekundes kopš epohas sākuma (1970-01-01 UTC) par datumu\n"
"  $ date --date='@2147483647'\n"
"\n"
"Parādīt laiku ASV rietumu piekrastē (izmantojiet tzselect(1), lai atrastu TZ)\n"
"  $ TZ='America/Los_Angeles' date\n"
"\n"
"Parādīt vietējo laiku nākamās piektdienas 9.00 ASV rietumu piekrastē\n"
"  $ date --date='TZ=\"America/Los_Angeles\" 09:00 next Fri'\n"

#: src/date.c:478
#, c-format
msgid "output format: %s"
msgstr "izvades formāts: %s"

#: src/date.c:540 src/date.c:789
#, c-format
msgid "invalid date %s"
msgstr "nederīgs datums %s"

#: src/date.c:665
#, c-format
msgid "the options to specify dates for printing are mutually exclusive"
msgstr "opcijas datumu norādīšanai izvadē ir savstarpēji izslēdzošas"

#: src/date.c:672
#, c-format
msgid "the options to print and set the time may not be used together"
msgstr "laika izvadīšanas un iestatīšanas opcijas nedrīkst lietot kopā"

#: src/date.c:677
#, c-format
msgid "only using last of multiple -d options"
msgstr "tiek izmantota tikai pēdējā no vairākām -d opcijām"

#: src/date.c:680
#, c-format
msgid "only using last of multiple -s options"
msgstr "tiek izmantota tikai pēdējā no vairākām -s opcijām"

#: src/date.c:693
#, c-format
msgid "multiple output formats specified"
msgstr "norādīti vairāki izvades formāti"

#: src/date.c:699
#, c-format
msgid ""
"the argument %s lacks a leading '+';\n"
"when using an option to specify date(s), any non-option\n"
"argument must be a format string beginning with '+'"
msgstr ""
"argumentam %s trūkst sākuma '+';\n"
"izmantojot opciju datuma(-u) norādīšanai, jebkuram argumentam, kas nav opcija,\n"
"jābūt formāta virknei, kas sākas ar '+'"

#: src/date.c:797
#, c-format
msgid "cannot set date"
msgstr "neizdevās iestatīt datumu"

#. This is a proper name. See the gettext manual, section Names.
#: src/dd.c:40 src/factor.c:97 src/rm.c:38 src/tail.c:72 src/touch.c:40
#: src/wc.c:49
msgid "Paul Rubin"
msgstr "Paul Rubin"

#: src/dd.c:526
#, c-format
msgid ""
"Usage: %s [OPERAND]...\n"
"  or:  %s OPTION\n"
msgstr ""
"Lietošana: %s [OPERANDS]...\n"
"  vai:  %s OPCIJA\n"

#: src/dd.c:531
msgid ""
"Copy a file, converting and formatting according to the operands.\n"
"\n"
msgstr ""
"Kopēt failu, konvertējot un formatējot atbilstoši operandiem.\n"
"\n"

#: src/dd.c:535
msgid ""
"  bs=BYTES        read and write up to BYTES bytes at a time (default: 512);\n"
"                  overrides ibs and obs\n"
msgstr ""
"  bs=BAITI        lasīt un rakstīt līdz BAITI baitiem vienlaikus (noklusējums: 512);\n"
"                  aizstāj ibs un obs\n"

#: src/dd.c:539
msgid "  cbs=BYTES       convert BYTES bytes at a time\n"
msgstr "  cbs=BAITI       konvertēt BAITI baitus vienlaikus\n"

#: src/dd.c:542
msgid "  conv=CONVS      convert the file as per the comma separated symbol list\n"
msgstr "  conv=CONVS      konvertēt failu atbilstoši ar komatiem atdalītajam simbolu sarakstam\n"

#: src/dd.c:545
msgid "  count=N         copy only N input blocks\n"
msgstr "  count=N         kopēt tikai N ievades blokus\n"

#: src/dd.c:548
msgid "  ibs=BYTES       read up to BYTES bytes at a time (default: 512)\n"
msgstr "  ibs=BAITI       lasīt līdz BAITI baitiem vienlaikus (noklusējums: 512)\n"

#: src/dd.c:551
msgid "  if=FILE         read from FILE instead of standard input\n"
msgstr "  if=FAILS        lasīt no FAILA, nevis standarta ievades\n"

#: src/dd.c:554
msgid "  iflag=FLAGS     read as per the comma separated symbol list\n"
msgstr "  iflag=FLAGS     lasīt atbilstoši ar komatiem atdalītajam simbolu sarakstam\n"

#: src/dd.c:557
msgid "  obs=BYTES       write BYTES bytes at a time (default: 512)\n"
msgstr "  obs=BAITI       rakstīt BAITI baitus vienlaikus (noklusējums: 512)\n"

#: src/dd.c:560
msgid "  of=FILE         write to FILE instead of standard output\n"
msgstr "  of=FAILS        rakstīt FAILĀ, nevis standarta izvadē\n"

#: src/dd.c:563
msgid "  oflag=FLAGS     write as per the comma separated symbol list\n"
msgstr "  oflag=FLAGS     rakstīt atbilstoši ar komatiem atdalītajam simbolu sarakstam\n"

#: src/dd.c:566
msgid "  seek=N          (or oseek=N) skip N obs sized output blocks\n"
msgstr "  seek=N          (vai oseek=N) izlaist N obs izmēra izvades blokus\n"

#: src/dd.c:569
msgid "  skip=N          (or iseek=N) skip N ibs sized input blocks\n"
msgstr "  skip=N          (vai iseek=N) izlaist N ibs izmēra ievades blokus\n"

#: src/dd.c:572
msgid ""
"  status=LEVEL    The LEVEL of information to print to standard error;\n"
"                  'none' suppresses everything but error messages,\n"
"                  'noxfer' suppresses the final transfer statistics,\n"
"                  'progress' shows periodic transfer statistics\n"
msgstr ""
"  status=LĪMENIS    informācijas līmenis LĪMENIS, ko izvadīt standarta kļūdu izvadē;\n"
"                  'none' paslēpj visu, izņemot kļūdu ziņojumus,\n"
"                  'noxfer' paslēpj nobeiguma pārsūtīšanas statistiku,\n"
"                  'progress' rāda periodisku pārsūtīšanas statistiku\n"

#: src/dd.c:578
msgid ""
"\n"
"N and BYTES may be followed by the following multiplicative suffixes:\n"
"c=1, w=2, b=512, kB=1000, K=1024, MB=1000*1000, M=1024*1024, xM=M,\n"
"GB=1000*1000*1000, G=1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n"
"Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n"
"If N ends in 'B', it counts bytes not blocks.\n"
"\n"
"Each CONV symbol may be:\n"
"\n"
msgstr ""
"\n"
"Aiz N un BAITI var sekot šādi reizinātāju sufiksi:\n"
"c=1, w=2, b=512, kB=1000, K=1024, MB=1000*1000, M=1024*1024, xM=M,\n"
"GB=1000*1000*1000, G=1024*1024*1024, un tā tālāk: T, P, E, Z, Y, R, Q.\n"
"Var izmantot arī bināros prefiksus: KiB=K, MiB=M un tā tālāk.\n"
"Ja N beidzas ar 'B', tas skaita baitus, nevis blokus.\n"
"\n"
"Katrs CONV simbols var būt:\n"
"\n"

#: src/dd.c:589
msgid ""
"  ascii     from EBCDIC to ASCII\n"
"  ebcdic    from ASCII to EBCDIC\n"
"  ibm       from ASCII to alternate EBCDIC\n"
"  block     pad newline-terminated records with spaces to cbs-size\n"
"  unblock   replace trailing spaces in cbs-size records with newline\n"
"  lcase     change upper case to lower case\n"
"  ucase     change lower case to upper case\n"
"  sparse    try to seek rather than write all-NUL output blocks\n"
"  swab      swap every pair of input bytes\n"
"  sync      pad every input block with NULs to ibs-size; when used\n"
"            with block or unblock, pad with spaces rather than NULs\n"
msgstr ""
"  ascii     no EBCDIC uz ASCII\n"
"  ebcdic    no ASCII uz EBCDIC\n"
"  ibm       no ASCII uz alternatīvo EBCDIC\n"
"  block     papildināt ar jaunrindas rakstzīmi noslēgtus ierakstus ar atstarpēm līdz cbs izmēram\n"
"  unblock   aizstāt beigu atstarpes cbs izmēra ierakstos ar jaunu rindu\n"
"  lcase     pārveidot lielos burtus par mazajiem\n"
"  ucase     pārveidot mazos burtus par lielajiem\n"
"  sparse    mēģināt pozicionēt, nevis rakstīt tikai NUL saturošus izvades blokus\n"
"  swab      samainīt vietām katru ievades baitu pāri\n"
"  sync      papildināt katru ievades bloku ar NUL līdz ibs izmēram; ja izmanto\n"
"  swab          ar block vai unblock, papildināt ar atstarpēm, nevis NUL\n"

#: src/dd.c:602
msgid ""
"  excl      fail if the output file already exists\n"
"  nocreat   do not create the output file\n"
"  notrunc   do not truncate the output file\n"
"  noerror   continue after read errors\n"
"  fdatasync  physically write output file data before finishing\n"
"  fsync     likewise, but also write metadata\n"
msgstr ""
"  excl      pārtraukt ar kļūdu, ja izvades fails jau pastāv\n"
"  nocreat   neveidot izvades failu\n"
"  notrunc   nesaīsināt izvades failu\n"
"  noerror   turpināt pēc lasīšanas kļūdām\n"
"  fdatasync  fiziski ierakstīt izvades faila datus pirms pabeigšanas\n"
"  fsync     tāpat, bet arī ierakstīt metadatus\n"

#: src/dd.c:610
msgid ""
"\n"
"Each FLAG symbol may be:\n"
"\n"
"  append    append mode (makes sense only for output; conv=notrunc suggested)\n"
msgstr ""
"\n"
"Katrs KAROGA simbols var būt:\n"
"\n"
"  append    pievienošanas režīms (ir jēga tikai izvadei; ieteicams conv=notrunc)\n"

#: src/dd.c:617
msgid "  cio       use concurrent I/O for data\n"
msgstr "  cio       izmantot paralēlo I/O datiem\n"

#: src/dd.c:619
msgid "  direct    use direct I/O for data\n"
msgstr "  direct    izmantot tiešo I/O datiem\n"

#: src/dd.c:620
msgid "  directory  fail unless a directory\n"
msgstr "  directory  neizdoties, ja nav direktorija\n"

#: src/dd.c:622
msgid "  dsync     use synchronized I/O for data\n"
msgstr "  dsync     izmantot sinhronizētu I/O datiem\n"

#: src/dd.c:624
msgid "  sync      likewise, but also for metadata\n"
msgstr "  sync      tāpat, bet arī metadatiem\n"

#: src/dd.c:625
msgid "  fullblock  accumulate full blocks of input (iflag only)\n"
msgstr "  fullblock  uzkrāt pilnus ievades blokus (tikai iflag)\n"

#: src/dd.c:628
msgid "  nonblock  use non-blocking I/O\n"
msgstr "  nonblock  izmantot nebloķējošu I/O\n"

#: src/dd.c:630
msgid "  noatime   do not update access time\n"
msgstr "  noatime   neatjaunināt piekļuves laiku\n"

#: src/dd.c:633
msgid "  nocache   Request to drop cache.  See also oflag=sync\n"
msgstr "  nocache   pieprasīt atbrīvot kešatmiņu.  Skatīt arī oflag=sync\n"

#: src/dd.c:637
msgid "  noctty    do not assign controlling terminal from file\n"
msgstr "  noctty    nepiešķirt vadības termināli no faila\n"

#: src/dd.c:640
msgid "  nofollow  do not follow symlinks\n"
msgstr "  nofollow  nesekot simboliskajām saitēm\n"

#: src/dd.c:642
msgid "  nolinks   fail if multiply-linked\n"
msgstr "  nolinks   neizdoties, ja ir vairākas saites\n"

#: src/dd.c:644
msgid "  binary    use binary I/O for data\n"
msgstr "  binary    izmantot bināru I/O datiem\n"

#: src/dd.c:646
msgid "  text      use text I/O for data\n"
msgstr "  text      izmantot teksta I/O datiem\n"

