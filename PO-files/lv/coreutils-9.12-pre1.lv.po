#: src/stat.c:1761
msgid "Display file or file system status.\n"
msgstr "Parādīt faila vai failu sistēmas statusu.\n"

#: src/stat.c:1767
msgid ""
"  -L, --dereference\n"
"         follow links\n"
msgstr ""
"  -L, --dereference\n"
"         sekot saitēm\n"

#: src/stat.c:1771
msgid ""
"  -f, --file-system\n"
"         display file system status instead of file status\n"
msgstr ""
"  -f, --file-system\n"
"         parādīt failu sistēmas statusu, nevis faila statusu\n"

#: src/stat.c:1775
msgid ""
"      --cached=MODE\n"
"         specify how to use cached attributes;\n"
"         useful on remote file systems. See MODE below\n"
msgstr ""
"      --cached=REŽĪMS\n"
"         norādīt, kā izmantot kešotos atribūtus;\n"
"         noderīgi attālajās failu sistēmās. Skatīt REŽĪMS zemāk\n"

#: src/stat.c:1780
msgid ""
"  -c, --format=FORMAT\n"
"         use the specified FORMAT instead of the default;\n"
"         output a newline after each use of FORMAT\n"
msgstr ""
"  -c, --format=FORMĀTS\n"
"         izmantot norādīto FORMĀTU, nevis noklusēto;\n"
"         izvadīt jaunu rindu pēc katras FORMĀTA izmantošanas\n"

#: src/stat.c:1785
msgid ""
"      --printf=FORMAT\n"
"         like --format, but interpret backslash escapes,\n"
"         and do not output a mandatory trailing newline;\n"
"         if you want a newline, include \\n in FORMAT\n"
msgstr ""
"      --printf=FORMĀTS\n"
"         tāpat kā --format, bet interpretēt apgrieztās slīpsvītras vadības virknes,\n"
"         un neizvadīt obligātu jaunu rindu beigās;\n"
"         ja vēlaties jaunu rindu, iekļaujiet \\n parametrā FORMĀTS\n"

#: src/stat.c:1791
msgid ""
"  -t, --terse\n"
"         print the information in terse form\n"
msgstr ""
"  -t, --terse\n"
"         izvadīt informāciju īsā formā\n"

#: src/stat.c:1798
msgid ""
"\n"
"The MODE argument of --cached can be: always, never, or default.\n"
"'always' will use cached attributes if available, while\n"
"'never' will try to synchronize with the latest attributes, and\n"
"'default' will leave it up to the underlying file system.\n"
msgstr ""
"\n"
"Opcijas --cached arguments REŽĪMS var būt: always, never vai default.\n"
"'always' izmantos kešotos atribūtus, ja tie ir pieejami, kamēr\n"
"'never' mēģinās sinhronizēt ar jaunākajiem atribūtiem, un\n"
"'default' atstās to pamatā esošās failu sistēmas ziņā.\n"

#: src/stat.c:1805
msgid ""
"\n"
"The valid format sequences for files (without --file-system):\n"
"\n"
"  %a   permission bits in octal (see '#' and '0' printf flags)\n"
"  %A   permission bits and file type in human readable form\n"
"  %b   number of blocks allocated (see %B)\n"
"  %B   the size in bytes of each block reported by %b\n"
"  %C   SELinux security context string\n"
msgstr ""
"\n"
"Derīgās formāta virknes failiem (bez --file-system):\n"
"\n"
"  %a   tiesību biti oktālajā sistēmā (skatīt '#' un '0' printf karogus)\n"
"  %A   tiesību biti un faila tips cilvēkam lasāmā formā\n"
"  %b   piešķirto bloku skaits (skatīt %B)\n"
"  %B   katra bloka izmērs baitos, par ko ziņo %b\n"
"  %C   SELinux drošības konteksta virkne\n"

#: src/stat.c:1814
msgid ""
"  %d   device number in decimal (st_dev)\n"
"  %D   device number in hex (st_dev)\n"
"  %Hd  major device number in decimal\n"
"  %Ld  minor device number in decimal\n"
"  %f   raw mode in hex\n"
"  %F   file type\n"
"  %g   group ID of owner\n"
"  %G   group name of owner\n"
msgstr ""
"  %d   ierīces numurs decimālajā sistēmā (st_dev)\n"
"  %D   ierīces numurs heksadecimālajā sistēmā (st_dev)\n"
"  %Hd  galvenais ierīces numurs decimālajā sistēmā\n"
"  %Ld  pakārtotais ierīces numurs decimālajā sistēmā\n"
"  %f   neapstrādātais režīms heksadecimālajā sistēmā\n"
"  %F   faila tips\n"
"  %g   īpašnieka grupas ID\n"
"  %G   īpašnieka grupas nosaukums\n"

#: src/stat.c:1824
msgid ""
"  %h   number of hard links\n"
"  %i   inode number\n"
"  %m   mount point\n"
"  %n   file name\n"
"  %Qn  quoted file name\n"
"  %N   quoted file name with dereference if symbolic link\n"
"  %o   optimal I/O transfer size hint\n"
"  %s   total size, in bytes\n"
"  %r   device type in decimal (st_rdev)\n"
"  %R   device type in hex (st_rdev)\n"
"  %Hr  major device type in decimal, for character/block device special files\n"
"  %Lr  minor device type in decimal, for character/block device special files\n"
"  %t   major device type in hex, for character/block device special files\n"
"  %T   minor device type in hex, for character/block device special files\n"
msgstr ""
"  %h   cieto saišu skaits\n"
"  %i   i-mezgla numurs\n"
"  %m   montēšanas punkts\n"
"  %n   faila nosaukums\n"
"  %Qn  pēdiņās ievietots faila nosaukums\n"
"  %N   pēdiņās ievietots faila nosaukums ar atsauces atrisināšanu, ja simboliskā saite\n"
"  %o   optimālā I/O pārsūtīšanas lieluma ieteikums\n"
"  %s   kopējais izmērs baitos\n"
"  %r   ierīces tips decimālajā sistēmā (st_rdev)\n"
"  %R   ierīces tips heksadecimālajā sistēmā (st_rdev)\n"
"  %Hr  galvenais ierīces tips decimālajā sistēmā, rakstzīmju/bloku ierīču speciālajiem failiem\n"
"  %Lr  pakārtotais ierīces tips decimālajā sistēmā, rakstzīmju/bloku ierīču speciālajiem failiem\n"
"  %t   galvenais ierīces tips heksadecimālajā sistēmā, rakstzīmju/bloku ierīču speciālajiem failiem\n"
"  %T   pakārtotais ierīces tips heksadecimālajā sistēmā, rakstzīmju/bloku ierīču speciālajiem failiem\n"

#: src/stat.c:1840
msgid ""
"  %u   user ID of owner\n"
"  %U   user name of owner\n"
"  %w   time of file birth, human-readable; - if unknown\n"
"  %W   time of file birth, seconds since Epoch; 0 if unknown\n"
"  %x   time of last access, human-readable\n"
"  %X   time of last access, seconds since Epoch\n"
"  %y   time of last data modification, human-readable\n"
"  %Y   time of last data modification, seconds since Epoch\n"
"  %z   time of last status change, human-readable\n"
"  %Z   time of last status change, seconds since Epoch\n"
"\n"
msgstr ""
"  %u   īpašnieka lietotāja ID\n"
"  %U   īpašnieka lietotājvārds\n"
"  %w   faila dzimšanas laiks, cilvēkam lasāms; -, ja nav zināms\n"
"  %W   faila dzimšanas laiks, sekundes kopš Epoch; 0, ja nav zināms\n"
"  %x   pēdējās piekļuves laiks, cilvēkam lasāms\n"
"  %X   pēdējās piekļuves laiks, sekundes kopš Epoch\n"
"  %y   pēdējās datu modifikācijas laiks, cilvēkam lasāms\n"
"  %Y   pēdējās datu modifikācijas laiks, sekundes kopš Epoch\n"
"  %z   pēdējās statusa maiņas laiks, cilvēkam lasāms\n"
"  %Z   pēdējās statusa maiņas laiks, sekundes kopš Epoch\n"

#: src/stat.c:1854
#, c-format
msgid ""
"Valid format sequences for file systems:\n"
"\n"
"  %a   free blocks available to non-superuser\n"
"  %b   total data blocks in file system\n"
"  %c   total file nodes in file system\n"
"  %d   free file nodes in file system\n"
"  %f   free blocks in file system\n"
msgstr ""
"Derīgās formāta virknes failu sistēmām:\n"
"\n"
"  %a   brīvie bloki, kas pieejami ne-superlietotājam\n"
"  %b   kopējais datu bloku skaits failu sistēmā\n"
"  %c   kopējais failu mezglu skaits failu sistēmā\n"
"  %d   brīvie failu mezgli failu sistēmā\n"
"  %f   brīvie bloki failu sistēmā\n"

#: src/stat.c:1863
msgid ""
"  %i   file system ID in hex\n"
"  %l   maximum length of filenames\n"
"  %n   file name\n"
"  %Qn  quoted file name\n"
"  %s   block size (for faster transfers)\n"
"  %S   fundamental block size (for block counts)\n"
"  %t   file system type in hex\n"
"  %T   file system type in human readable form\n"
msgstr ""
"  %i   failu sistēmas ID heksadecimālajā formā\n"
"  %l   maksimālais failu nosaukumu garums\n"
"  %n   faila nosaukums\n"
"  %Qn  pēdiņās ievietots faila nosaukums\n"
"  %s   bloka izmērs (ātrākai pārsūtīšanai)\n"
"  %S   pamatbloka izmērs (bloku skaitīšanai)\n"
"  %t   failu sistēmas tips heksadecimālajā formā\n"
"  %T   failu sistēmas tips cilvēkam lasāmā formā\n"

#: src/stat.c:1874
#, c-format
msgid ""
"\n"
"--terse is equivalent to the following FORMAT:\n"
"    %s"
msgstr ""
"\n"
"--terse ir ekvivalents šādam FORMĀTAM:\n"
"    %s"

#: src/stat.c:1885
#, c-format
msgid ""
"--terse --file-system is equivalent to the following FORMAT:\n"
"    %s"
msgstr ""
"--terse --file-system ir ekvivalents šādam FORMĀTAM:\n"
"    %s"

#: src/stdbuf.c:83
#, c-format
msgid "Usage: %s OPTION... COMMAND\n"
msgstr "Lietošana: %s OPCIJA... KOMANDA\n"

#: src/stdbuf.c:84
msgid "Run COMMAND, with modified buffering operations for its standard streams.\n"
msgstr "Palaist KOMANDU ar modificētu tās standarta straumju buferizāciju.\n"

#: src/stdbuf.c:90
msgid "  -i, --input=MODE   adjust standard input stream buffering\n"
msgstr "  -i, --input=REŽĪMS   pielāgot standarta ievades straumes buferizāciju\n"

#: src/stdbuf.c:93
msgid "  -o, --output=MODE  adjust standard output stream buffering\n"
msgstr "  -o, --output=REŽĪMS  pielāgot standarta izvades straumes buferizāciju\n"

#: src/stdbuf.c:96
msgid "  -e, --error=MODE   adjust standard error stream buffering\n"
msgstr "  -e, --error=REŽĪMS   pielāgot standarta kļūdu straumes buferizāciju\n"

#: src/stdbuf.c:101
msgid ""
"\n"
"If MODE is 'L' the corresponding stream will be line buffered.\n"
"This option is invalid with standard input.\n"
msgstr ""
"\n"
"Ja REŽĪMS ir 'L', attiecīgā straume tiks buferizēta pa rindām.\n"
"Šī opcija nav derīga standarta ievadei.\n"

#: src/stdbuf.c:104
msgid ""
"\n"
"If MODE is '0' the corresponding stream will be unbuffered.\n"
msgstr ""
"\n"
"Ja REŽĪMS ir '0', attiecīgā straume netiks buferizēta.\n"

#: src/stdbuf.c:107
msgid ""
"\n"
"Otherwise MODE is a number which may be followed by one of the following:\n"
"KB 1000, K 1024, MB 1000*1000, M 1024*1024, and so on for G,T,P,E,Z,Y,R,Q.\n"
"Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n"
"In this case the corresponding stream will be fully buffered with the buffer\n"
"size set to MODE bytes.\n"
msgstr ""
"\n"
"Citādi REŽĪMS ir skaitlis, kuram var sekot viens no šiem:\n"
"KB 1000, K 1024, MB 1000*1000, M 1024*1024, un tā tālāk ar G,T,P,E,Z,Y,R,Q.\n"
"Var izmantot arī bināros prefiksus: KiB=K, MiB=M un tā tālāk.\n"
"Šajā gadījumā attiecīgā straume tiks pilnībā buferizēta ar bufera\n"
"izmēru, kas iestatīts uz REŽĪMA baitiem.\n"

#: src/stdbuf.c:114
msgid ""
"\n"
"NOTE: If COMMAND adjusts the buffering of its standard streams ('tee' does\n"
"for example) then that will override corresponding changes by 'stdbuf'.\n"
"Also some filters (like 'dd' and 'cat' etc.) don't use streams for I/O,\n"
"and are thus unaffected by 'stdbuf' settings.\n"
msgstr ""
"\n"
"PIEZĪME: Ja KOMANDA pielāgo savu standarta straumju buferizāciju (kā, piemēram, 'tee'),\n"
"tas aizstās attiecīgās 'stdbuf' izmaiņas.\n"
"Arī daži filtri (piemēram, 'dd' un 'cat' utt.) neizmanto straumes I/O,\n"
"un tāpēc 'stdbuf' iestatījumi tos neietekmē.\n"

#: src/stdbuf.c:245
#, c-format
msgid "failed to find %s"
msgstr "neizdevās atrast %s"

#: src/stdbuf.c:268 src/stdbuf.c:299
#, c-format
msgid "failed to update the environment with %s"
msgstr "neizdevās atjaunināt vidi ar %s"

#: src/stdbuf.c:345
#, c-format
msgid "line buffering standard input is meaningless"
msgstr "standarta ievades buferizācija pa rindām ir bezjēdzīga"

#: src/stdbuf.c:380
#, c-format
msgid "you must specify a buffering mode option"
msgstr "jānorāda buferēšanas režīma opcija"

#: src/stty.c:545
#, c-format
msgid ""
"Usage: %s [-F DEVICE | --file=DEVICE] [SETTING]...\n"
"  or:  %s [-F DEVICE | --file=DEVICE] [-a|--all]\n"
"  or:  %s [-F DEVICE | --file=DEVICE] [-g|--save]\n"
msgstr ""
"Lietošana: %s [-F IERĪCE | --file=IERĪCE] [IESTATĪJUMS]...\n"
"  vai:  %s [-F IERĪCE | --file=IERĪCE] [-a|--all]\n"
"  vai:  %s [-F IERĪCE | --file=IERĪCE] [-g|--save]\n"

#: src/stty.c:551
msgid "Print or change terminal characteristics.\n"
msgstr "Izvadīt vai mainīt termināļa raksturlielumus.\n"

#: src/stty.c:557
msgid "  -a, --all          print all current settings in human-readable form\n"
msgstr "  -a, --all          izvadīt visus pašreizējos iestatījumus cilvēkam lasāmā formā\n"

#: src/stty.c:560
msgid "  -g, --save         print all current settings in a stty-readable form\n"
msgstr "  -g, --save         izvadīt visus pašreizējos iestatījumus stty lasāmā formā\n"

#: src/stty.c:563
msgid "  -F, --file=DEVICE  open and use DEVICE instead of standard input\n"
msgstr "  -F, --file=IERĪCE  atvērt un izmantot IERĪCI standarta ievades vietā\n"

#: src/stty.c:568
msgid ""
"\n"
"Optional - before SETTING indicates negation.  An * marks non-POSIX\n"
"settings.  The underlying system defines which settings are available.\n"
msgstr ""
"\n"
"Neobligāts \"-\" pirms IESTATĪJUMA norāda noliegumu.  Ar * atzīmēti ne-POSIX\n"
"iestatījumi.  Pamatsistēma nosaka, kādi iestatījumi ir pieejami.\n"

#: src/stty.c:573
msgid ""
"\n"
"Special characters:\n"
msgstr ""
"\n"
"Īpašās rakstzīmes:\n"

#: src/stty.c:577
msgid " * discard CHAR  CHAR will toggle discarding of output\n"
msgstr " * discard RAKSTZĪME  RAKSTZĪME pārslēgs izvades atmešanu\n"

#: src/stty.c:582
msgid " * dsusp CHAR    CHAR will send a terminal stop signal once input flushed\n"
msgstr " * dsusp RAKSTZĪME    RAKSTZĪME nosūtīs termināļa apturēšanas signālu pēc ievades iztukšošanas\n"

#: src/stty.c:586
msgid ""
"   eof CHAR      CHAR will send an end of file (terminate the input)\n"
"   eol CHAR      CHAR will end the line\n"
msgstr ""
"   eof RAKSTZĪME      RAKSTZĪME nosūtīs faila beigas (pārtrauks ievadi)\n"
"   eol RAKSTZĪME      RAKSTZĪME noslēgs rindu\n"

#: src/stty.c:591
msgid " * eol2 CHAR     alternate CHAR for ending the line\n"
msgstr " * eol2 RAKSTZĪME     alternatīva RAKSTZĪME rindas noslēgšanai\n"

#: src/stty.c:595
msgid ""
"   erase CHAR    CHAR will erase the last character typed\n"
"   intr CHAR     CHAR will send an interrupt signal\n"
"   kill CHAR     CHAR will erase the current line\n"
msgstr ""
"   erase RAKSTZĪME    RAKSTZĪME dzēsīs pēdējo ievadīto rakstzīmi\n"
"   intr RAKSTZĪME     RAKSTZĪME nosūtīs pārtraukuma signālu\n"
"   kill RAKSTZĪME     RAKSTZĪME dzēsīs pašreizējo rindu\n"

#: src/stty.c:601
msgid " * lnext CHAR    CHAR will enter the next character quoted\n"
msgstr " * lnext RAKSTZĪME    RAKSTZĪME ievadīs nākamo rakstzīmi burtiski\n"

#: src/stty.c:606
msgid " * status CHAR   CHAR will send an info signal\n"
msgstr " * status RAKSTZĪME   RAKSTZĪME nosūtīs informācijas signālu\n"

#: src/stty.c:610
msgid "   quit CHAR     CHAR will send a quit signal\n"
msgstr "    quit RAKSTZĪME     RAKSTZĪME nosūtīs iziešanas signālu\n"

#: src/stty.c:614
msgid " * rprnt CHAR    CHAR will redraw the current line\n"
msgstr " * rprnt RAKSTZĪME    RAKSTZĪME pārzīmēs pašreizējo rindu\n"

#: src/stty.c:618
msgid ""
"   start CHAR    CHAR will restart the output after stopping it\n"
"   stop CHAR     CHAR will stop the output\n"
"   susp CHAR     CHAR will send a terminal stop signal\n"
msgstr ""
"   start RAKSTZĪME    RAKSTZĪME atsāks izvadi pēc tās apturēšanas\n"
"   stop RAKSTZĪME     RAKSTZĪME apturēs izvadi\n"
"   susp RAKSTZĪME     RAKSTZĪME nosūtīs termināļa apturēšanas signālu\n"

#: src/stty.c:624
msgid " * swtch CHAR    CHAR will switch to a different shell layer\n"
msgstr " * swtch RAKSTZĪME    RAKSTZĪME pārslēgs uz citu čaulas slāni\n"

#: src/stty.c:629
msgid " * werase CHAR   CHAR will erase the last word typed\n"
msgstr " * werase RAKSTZĪME   RAKSTZĪME dzēsīs pēdējo ievadīto vārdu\n"

#: src/stty.c:633
msgid ""
"\n"
"Special settings:\n"
"   N             set the input and output speeds to N bauds\n"
msgstr ""
"\n"
"Īpašie iestatījumi:\n"
"   N             iestatīt ievades un izvades ātrumu uz N bodiem\n"

#: src/stty.c:639
msgid ""
"   cols N        tell the kernel that the terminal has N columns\n"
" * columns N     same as cols N\n"
msgstr ""
"   cols N        paziņot kodolam, ka terminālim ir N kolonnas\n"
" * columns N     tas pats, kas cols N\n"

#: src/stty.c:644
#, c-format
msgid " * [-]drain      wait for transmission before applying settings (%s by default)\n"
msgstr " * [-]drain      gaidīt pārraidi pirms iestatījumu piemērošanas (%s pēc noklusējuma)\n"

#: src/stty.c:646
msgid "on"
msgstr "ieslēgts"

#: src/stty.c:646
msgid "off"
msgstr "izslēgts"

#: src/stty.c:647
msgid "   ispeed N      set the input speed to N\n"
msgstr "   ispeed N      iestatīt ievades ātrumu uz N\n"

#: src/stty.c:651
msgid " * line N        use line discipline N\n"
msgstr " * line N        izmantot līnijas disciplīnu N\n"

#: src/stty.c:655
msgid ""
"   min N         with -icanon, set N characters minimum for a completed read\n"
"   ospeed N      set the output speed to N\n"
msgstr ""
"   min N         ar -icanon, iestatīt vismaz N rakstzīmes pabeigtai nolasīšanai\n"
"   ospeed N      iestatīt izvades ātrumu uz N\n"

#: src/stty.c:660
msgid ""
"   rows N        tell the kernel that the terminal has N rows\n"
"   size          print the number of rows and columns according to the kernel\n"
msgstr ""
"   rows N        paziņot kodolam, ka terminālim ir N rindas\n"
"   size          izvadīt rindu un kolonnu skaitu saskaņā ar kodolu\n"

#: src/stty.c:665
msgid ""
"   speed         print the terminal speed\n"
"   time N        with -icanon, set read timeout of N tenths of a second\n"
msgstr ""
"    speed         izvadīt termināļa ātrumu\n"
"   time N        ar -icanon, iestatīt nolasīšanas noildzi uz N sekundes desmitdaļām\n"

#: src/stty.c:669
msgid ""
"\n"
"Control settings:\n"
"   [-]clocal     disable modem control signals\n"
"   [-]cread      allow input to be received\n"
msgstr ""
"\n"
"Vadības iestatījumi:\n"
"   [-]clocal     atspējot modema vadības signālus\n"
"   [-]cread      atļaut ievades saņemšanu\n"

#: src/stty.c:676
msgid " * [-]crtscts    enable RTS/CTS handshaking\n"
msgstr " * [-]crtscts    iespējot RTS/CTS signālu apmaiņu\n"

#: src/stty.c:681
msgid " * [-]cdtrdsr    enable DTR/DSR handshaking\n"
msgstr " * [-]cdtrdsr    iespējot DTR/DSR signālu apmaiņu\n"

#: src/stty.c:685
msgid "   csN           set character size to N bits, N in [5..8]\n"
msgstr "   csN           iestatīt rakstzīmes izmēru uz N bitiem, N diapazonā [5..8]\n"

#: src/stty.c:688
msgid ""
"   [-]cstopb     use two stop bits per character (one with '-')\n"
"   [-]hup        send a hangup signal when the last process closes the tty\n"
"   [-]hupcl      same as [-]hup\n"
"   [-]parenb     generate parity bit in output and expect parity bit in input\n"
"   [-]parodd     set odd parity (or even parity with '-')\n"
msgstr ""
"   [-]cstopb     izmantot divus stopbitus katrai rakstzīmei (vienu ar '-')\n"
"   [-]hup        nosūtīt savienojuma pārtraukšanas signālu, kad pēdējais process aizver tty\n"
"   [-]hupcl      tas pats, kas [-]hup\n"
"   [-]parenb     ģenerēt paritātes bitu izvadē un sagaidīt paritātes bitu ievadē\n"
"   [-]parodd     iestatīt nepāra paritāti (vai pāra paritāti ar '-')\n"

#: src/stty.c:696
msgid " * [-]cmspar     use \"stick\" (mark/space) parity\n"
msgstr " * [-]cmspar     izmantot \"stick\" (mark/space) paritāti\n"

#: src/stty.c:700
msgid ""
"\n"
"Input settings:\n"
"   [-]brkint     breaks cause an interrupt signal\n"
"   [-]icrnl      translate carriage return to newline\n"
"   [-]ignbrk     ignore break characters\n"
"   [-]igncr      ignore carriage return\n"
"   [-]ignpar     ignore characters with parity errors\n"
msgstr ""
"\n"
"Ievades iestatījumi:\n"
"   [-]brkint     pārtraukumi izraisa pārtraukuma signālu\n"
"   [-]icrnl      pārvērst karietes atgriešanu jaunā rindā\n"
"   [-]ignbrk     ignorēt pārtraukuma rakstzīmes\n"
"   [-]igncr      ignorēt karietes atgriešanu\n"
"   [-]ignpar     ignorēt rakstzīmes ar paritātes kļūdām\n"

#: src/stty.c:710
msgid " * [-]imaxbel    beep and do not flush a full input buffer on a character\n"
msgstr " * [-]imaxbel    pīkstēt un neiztukšot pilnu ievades buferi, saņemot rakstzīmi\n"

#: src/stty.c:714
msgid ""
"   [-]inlcr      translate newline to carriage return\n"
"   [-]inpck      enable input parity checking\n"
"   [-]istrip     clear high (8th) bit of input characters\n"
msgstr ""
"   [-]inlcr      pārvērst jauno rindu par karietes atgriešanu\n"
"   [-]inpck      iespējot ievades paritātes pārbaudi\n"
"   [-]istrip     notīrīt ievades rakstzīmju augstāko (8.) bitu\n"

#: src/stty.c:720
msgid " * [-]iutf8      assume input characters are UTF-8 encoded\n"
msgstr " * [-]iutf8      pieņemt, ka ievades rakstzīmes ir UTF-8 kodētas\n"

#: src/stty.c:725
msgid " * [-]iuclc      translate uppercase characters to lowercase\n"
msgstr " * [-]iuclc      pārvērst lielos burtus mazajos\n"

#: src/stty.c:730
msgid " * [-]ixany      let any character restart output, not only start character\n"
msgstr " * [-]ixany      ļaut jebkurai rakstzīmei atsākt izvadi, ne tikai sākuma rakstzīmei\n"

#: src/stty.c:734
msgid ""
"   [-]ixoff      enable sending of start/stop characters\n"
"   [-]ixon       enable XON/XOFF flow control\n"
"   [-]parmrk     mark parity errors (with a 255-0-character sequence)\n"
"   [-]tandem     same as [-]ixoff\n"
msgstr ""
"   [-]ixoff      iespējot sākuma/apturēšanas rakstzīmju sūtīšanu\n"
"   [-]ixon       iespējot XON/XOFF plūsmas kontroli\n"
"   [-]parmrk     atzīmēt paritātes kļūdas (ar 255-0 rakstzīmju secību)\n"
"   [-]tandem     tas pats, kas [-]ixoff\n"

#: src/stty.c:740
msgid ""
"\n"
"Output settings:\n"
msgstr ""
"\n"
"Izvades iestatījumi:\n"

#: src/stty.c:745
msgid " * bsN           backspace delay style, N in [0..1]\n"
msgstr " * bsN           atpakaļatkāpes aizkaves stils, N diapazonā [0..1]\n"

#: src/stty.c:750
msgid " * crN           carriage return delay style, N in [0..3]\n"
msgstr " * crN           karietes atgriešanas aizkaves stils, N diapazonā [0..3]\n"

#: src/stty.c:755
msgid " * ffN           form feed delay style, N in [0..1]\n"
msgstr " * ffN           lapas padeves aizkaves stils, N diapazonā [0..1]\n"

#: src/stty.c:760
msgid " * nlN           newline delay style, N in [0..1]\n"
msgstr " * nlN           jaunas rindas aizkaves stils, N diapazonā [0..1]\n"

#: src/stty.c:765
msgid " * [-]ocrnl      translate carriage return to newline\n"
msgstr " * [-]ocrnl      pārvērst karietes atgriešanu par jaunu rindu\n"

#: src/stty.c:770
msgid " * [-]ofdel      use delete characters for fill instead of NUL characters\n"
msgstr " * [-]ofdel      izmantot dzēšanas rakstzīmes aizpildīšanai, nevis NUL rakstzīmes\n"

#: src/stty.c:775
msgid " * [-]ofill      use fill (padding) characters instead of timing for delays\n"
msgstr " * [-]ofill      izmantot aizpildīšanas (papildināšanas) rakstzīmes, nevis laika aizkaves\n"

#: src/stty.c:780
msgid " * [-]olcuc      translate lowercase characters to uppercase\n"
msgstr " * [-]olcuc      pārvērst mazos burtus lielajos\n"

#: src/stty.c:785
msgid " * [-]onlcr      translate newline to carriage return-newline\n"
msgstr " * [-]onlcr      pārvērst jauno rindu par karietes atgriešanu un jauno rindu\n"

#: src/stty.c:790
msgid " * [-]onlret     newline performs a carriage return\n"
msgstr " * [-]onlret     jauna rinda veic karietes atgriešanu\n"

#: src/stty.c:795
msgid " * [-]onocr      do not print carriage returns in the first column\n"
msgstr " * [-]onocr      nedrukāt karietes atgriešanas pirmajā kolonnā\n"

#: src/stty.c:799
msgid "   [-]opost      postprocess output\n"
