#: src/uname.c:121
msgid ""
"Print certain system information.  With no OPTION, same as -s.\n"
"\n"
msgstr ""
"Izvadīt noteiktu sistēmas informāciju.  Bez OPCIJAS tas pats kas -s.\n"
"\n"

#: src/uname.c:125
msgid ""
"  -a, --all                print all information, in the following order,\n"
"                             except omit -p and -i if unknown\n"
msgstr ""
"  -a, --all                izvadīt visu informāciju šādā secībā,\n"
"                             izņemot -p un -i, ja tie nav zināmi\n"

#: src/uname.c:129
msgid ""
"  -A, --all-labeled        print all information, one labeled field per line,\n"
"                             except omit -p and -i if unknown\n"
msgstr ""
"  -A, --all-labeled        izvadīt visu informāciju, vienu marķētu lauku katrā rindā,\n"
"                             izņemot -p un -i, ja tie nav zināmi\n"

#: src/uname.c:133
msgid "  -s, --kernel-name        print the kernel name\n"
msgstr "  -s, --kernel-name        izvadīt kodola nosaukumu\n"

#: src/uname.c:136
msgid "  -n, --nodename           print the network node hostname\n"
msgstr "  -n, --nodename           izvadīt tīkla mezgla resursdatora nosaukumu\n"

#: src/uname.c:139
msgid "  -r, --kernel-release     print the kernel release\n"
msgstr "  -r, --kernel-release     izvadīt kodola laidienu\n"

#: src/uname.c:142
msgid "  -v, --kernel-version     print the kernel version\n"
msgstr "  -v, --kernel-version     izvadīt kodola versiju\n"

#: src/uname.c:145
msgid "  -m, --machine            print the machine hardware name\n"
msgstr "  -m, --machine            izvadīt mašīnas aparatūras nosaukumu\n"

#: src/uname.c:148
msgid "  -p, --processor          print the processor type (non-portable)\n"
msgstr "  -p, --processor          izvadīt procesora tipu (nepārnesams)\n"

#: src/uname.c:151
msgid "  -i, --hardware-platform  print the hardware platform (non-portable)\n"
msgstr "  -i, --hardware-platform  izvadīt aparatūras platformu (nepārnesams)\n"

#: src/uname.c:154
msgid "  -o, --operating-system   print the operating system\n"
msgstr "  -o, --operating-system   izvadīt operētājsistēmu\n"

#: src/uname.c:160
msgid ""
"Print machine architecture.\n"
"\n"
msgstr ""
"Izvadīt mašīnas arhitektūru.\n"
"\n"

