#: src/pinky.c:486
msgid "  -l     produce long format output for the specified USERs\n"
msgstr "  -l     veidot detalizēta formāta izvadi norādītajiem LIETOTĀJIEM\n"

#: src/pinky.c:489
msgid "  -b     omit the user's home directory and shell in long format\n"
msgstr "  -b     izlaist lietotāja mājas direktoriju un čaulu detalizētajā formātā\n"

#: src/pinky.c:492
msgid "  -h     omit the user's project file in long format\n"
msgstr "  -h     izlaist lietotāja projekta failu detalizētajā formātā\n"

#: src/pinky.c:495
msgid "  -p     omit the user's plan file in long format\n"
msgstr "  -p     izlaist lietotāja plāna failu detalizētajā formātā\n"

#: src/pinky.c:498
msgid "  -s     do short format output, this is the default\n"
msgstr "  -s     veidot īsā formāta izvadi; tas ir noklusējums\n"

#: src/pinky.c:501
msgid "  -f     omit the line of column headings in short format\n"
msgstr "  -f     izlaist kolonnu virsrakstu rindu īsajā formātā\n"

#: src/pinky.c:504
msgid "  -w     omit the user's full name in short format\n"
msgstr "  -w     izlaist lietotāja pilno vārdu īsajā formātā\n"

#: src/pinky.c:507
msgid "  -i     omit the user's full name and remote host in short format\n"
msgstr "  -i     izlaist lietotāja pilno vārdu un attālo resursdatoru īsajā formātā\n"

#: src/pinky.c:510
msgid "  -q     omit the user's full name, remote host and idle time in short format\n"
msgstr "  -q     izlaist lietotāja pilno vārdu, attālo resursdatoru un dīkstāves laiku īsajā formātā\n"

#: src/pinky.c:513
msgid ""
"      --lookup\n"
"         attempt to canonicalize hostnames via DNS\n"
msgstr ""
"      --lookup\n"
"         mēģināt kanonizēt resursdatoru nosaukumus, izmantojot DNS\n"

#: src/pinky.c:519
#, c-format
msgid ""
"\n"
"A lightweight 'finger' program;  print user information.\n"
"The utmp file will be %s.\n"
