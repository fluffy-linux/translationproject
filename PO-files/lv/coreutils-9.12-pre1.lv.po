"\n"
"Viegla 'finger' programma;  izvadīt lietotāja informāciju.\n"
"utmp fails būs %s.\n"

#: src/pinky.c:606
#, c-format
msgid "no username specified; at least one must be specified when using -l"
msgstr "nav norādīts lietotājvārds; izmantojot -l, jānorāda vismaz viens"

