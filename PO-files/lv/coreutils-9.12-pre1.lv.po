msgstr "izmanto neon aparatūras atbalstu"

#: src/wc.c:177
#, c-format
msgid "neon support not detected"
msgstr "neon atbalsts nav konstatēts"

#: src/wc.c:195
msgid ""
"Print newline, word, and byte counts for each FILE, and a total line if\n"
"more than one FILE is specified.  A word is a nonempty sequence of non white\n"
"space delimited by white space characters or by start or end of input.\n"
msgstr ""
"Izvada jauno rindu, vārdu un baitu skaitu katram FAILAM un kopsavilkuma rindu,\n"
"ja norādīts vairāk nekā viens FAILS. Vārds ir netukša rakstzīmju, kas nav atstarpes,\n"
"secība, ko atdala atstarpju rakstzīmes vai ievades sākums vai beigas.\n"

#: src/wc.c:203
msgid ""
"\n"
"The options below may be used to select which counts are printed, always in\n"
"the following order: newline, word, character, byte, maximum line length.\n"
msgstr ""
"\n"
"Zemāk norādītās opcijas var izmantot, lai izvēlētos, kuras vērtības tiek izvadītas, vienmēr\n"
"šādā secībā: jauna rinda, vārds, rakstzīme, baits, maksimālais rindas garums.\n"

#: src/wc.c:208
msgid ""
"  -c, --bytes\n"
"         print the byte counts\n"
msgstr ""
"  -c, --bytes\n"
"         izvada baitu skaitu\n"

#: src/wc.c:212
msgid ""
"  -m, --chars\n"
"         print the character counts\n"
msgstr ""
"  -m, --chars\n"
"         izvada rakstzīmju skaitu\n"

#: src/wc.c:216
msgid ""
"  -l, --lines\n"
"         print the newline counts\n"
msgstr ""
"  -l, --lines\n"
"         izvada jauno rindu skaitu\n"

#: src/wc.c:220
msgid ""
"      --debug\n"
"         indicate what line count acceleration is used\n"
msgstr ""
"      --debug\n"
"         norāda, kāds rindu skaitīšanas paātrinājums tiek izmantots\n"

#: src/wc.c:224
msgid ""
"      --files0-from=F\n"
"         read input from the files specified by\n"
"         NUL-terminated names in file F;\n"
"         If F is -, read names from standard input\n"
msgstr ""
"      --files0-from=F\n"
"         lasa ievadi no failiem, kas norādīti ar\n"
"         NUL noslēgtiem nosaukumiem failā F;\n"
"         ja F ir -, lasa nosaukumus no standarta ievades\n"

#: src/wc.c:230
msgid ""
"  -L, --max-line-length\n"
"         print the maximum display width\n"
msgstr ""
"  -L, --max-line-length\n"
"         izvada maksimālo attēlošanas platumu\n"

#: src/wc.c:234
msgid ""
"  -w, --words\n"
"         print the word counts\n"
msgstr ""
"  -w, --words\n"
"         izvada vārdu skaitu\n"

#: src/wc.c:238
msgid ""
"      --total=WHEN\n"
"         when to print a line with total counts;\n"
"         WHEN can be: auto, always, only, never\n"
msgstr ""
"      --total=KAD\n"
"         kad izvadīt rindu ar kopējo skaitu;\n"
"         KAD var būt: auto, always, only, never\n"

