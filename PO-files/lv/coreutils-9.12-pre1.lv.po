msgstr "'--pages=PIRMĀ_LAPPUSE[:PĒDĒJĀ_LAPPUSE]' trūkst argumenta"

#: src/pr.c:918
#, c-format
msgid "invalid page range %s"
msgstr "nederīgs lappušu diapazons %s"

#: src/pr.c:979
msgid "'-l PAGE_LENGTH' invalid number of lines"
msgstr "'-l LAPPUSES_GARUMS' nederīgs rindu skaits"

#: src/pr.c:995
msgid "'-N NUMBER' invalid starting line number"
msgstr "'-N CIPARS' nederīgs sākuma rindas numurs"

#: src/pr.c:999
msgid "'-o MARGIN' invalid line offset"
msgstr "'-o NOBĪDE' nederīga rindas nobīde"

#: src/pr.c:1036
msgid "'-w PAGE_WIDTH' invalid number of characters"
msgstr "'-w LAPPUSES_PLATUMS' nederīgs rakstzīmju skaits"

#: src/pr.c:1046
msgid "'-W PAGE_WIDTH' invalid number of characters"
msgstr "'-W LAPPUSES_PLATUMS' nederīgs rakstzīmju skaits"

#: src/pr.c:1075
#, c-format
msgid "cannot specify number of columns when printing in parallel"
msgstr "nevar norādīt kolonnu skaitu, drukājot paralēli"

#: src/pr.c:1079
#, c-format
msgid "cannot specify both printing across and printing in parallel"
msgstr "nevar norādīt gan drukāšanu šķērsām, gan drukāšanu paralēli"

#: src/pr.c:1174
#, c-format
msgid "'-%c': Invalid argument: %s"
msgstr "'-%c': Nederīgs arguments: %s"

#: src/pr.c:1194
#, c-format
msgid "'-%c' extra characters or invalid number in the argument: %s"
msgstr "'-%c' liekas rakstzīmes vai nederīgs skaitlis argumentā: %s"

#: src/pr.c:1298
#, c-format
msgid "page width too narrow"
msgstr "lappuses platums ir pārāk mazs"

#: src/pr.c:2368
#, c-format
msgid "starting page number %ju exceeds page count %ju"
msgstr "sākuma lappuses numurs %ju pārsniedz lappušu skaitu %ju"

#: src/pr.c:2394
#, c-format
msgid "page number overflow"
msgstr "lappuses numura pārpilde"

#: src/pr.c:2399
#, c-format
msgid "Page %ju"
msgstr "Lappuse %ju"

#: src/pr.c:2773
msgid "Paginate or columnate FILE(s) for printing.\n"
msgstr "Sadalīt lappusēs vai kolonnās FAILU(-s) drukāšanai.\n"

#: src/pr.c:2780
msgid ""
"\n"
"  +FIRST_PAGE[:LAST_PAGE], --pages=FIRST_PAGE[:LAST_PAGE]\n"
"         begin [stop] printing with page FIRST_[LAST_]PAGE\n"
msgstr ""
"\n"
"  +PIRMĀ_LAPPUSE[:PĒDĒJĀ_LAPPUSE], --pages=PIRMĀ_LAPPUSE[:PĒDĒJĀ_LAPPUSE]\n"
"         sākt [pārtraukt] drukāšanu ar lappusi PIRMĀ_[PĒDĒJĀ_]LAPPUSE\n"

#: src/pr.c:2784
msgid ""
"  -COLS, --columns=COLS\n"
"         output COLS columns and print columns down, unless -a is used.\n"
"         Balance number of lines in the columns on each page\n"
msgstr ""
"  -COLS, --columns=KOLONNAS\n"
"         izvadīt KOLONNAS kolonnas un drukāt kolonnas uz leju, ja vien netiek lietots -a.\n"
"         Līdzsvarot rindu skaitu kolonnās katrā lappusē\n"

#: src/pr.c:2789
msgid ""
"  -a, --across\n"
"         print columns across rather than down, used together with -COLS\n"
msgstr ""
"  -a, --across\n"
"         drukāt kolonnas horizontāli, nevis uz leju; lieto kopā ar -KOLONNAS\n"

#: src/pr.c:2793
msgid ""
"  -c, --show-control-chars\n"
"         use hat notation (^G) and octal backslash notation\n"
msgstr ""
"  -c, --show-control-chars\n"
"         lietot jumtiņa pierakstu (^G) un oktālo apgrieztās slīpsvītras pierakstu\n"

#: src/pr.c:2797
msgid ""
"  -d, --double-space\n"
"         double space the output\n"
msgstr ""
"  -d, --double-space\n"
"         lietot dubultu rindstarpu izvadē\n"

#: src/pr.c:2801
msgid ""
"  -D, --date-format=FORMAT\n"
"         use FORMAT for the header date\n"
msgstr ""
"  -D, --date-format=FORMĀTS\n"
"         lietot FORMĀTU galvenes datumam\n"

#: src/pr.c:2805
msgid ""
"  -e[CHAR[WIDTH]], --expand-tabs[=CHAR[WIDTH]]\n"
"         expand input CHARs (TABs) to tab WIDTH (8)\n"
msgstr ""
"  -e[RAKSTZĪME[PLATUMS]], --expand-tabs[=RAKSTZĪME[PLATUMS]]\n"
"         izvērst ievades RAKSTZĪMES (tabulācijas) līdz tabulācijas PLATUMAM (8)\n"

#: src/pr.c:2809
msgid ""
"  -F, -f, --form-feed\n"
"         use form feeds instead of newlines to separate pages\n"
"         (by a 3-line page header with -F or a 5-line header\n"
"         and trailer without -F)\n"
msgstr ""
"  -F, -f, --form-feed\n"
"         lietot lapas pārtraukumus, nevis jaunas rindas, lai atdalītu lappuses\n"
"         (ar 3 rindu lappuses galveni ar -F vai 5 rindu galveni\n"
"         un kājeni bez -F)\n"

#: src/pr.c:2815
msgid ""
"  -h, --header=HEADER\n"
"         use a centered HEADER instead of filename in page header,\n"
"         -h \"\" prints a blank line, don't use -h\"\"\n"
msgstr ""
"  -h, --header=GALVENE\n"
"         lietot centrētu GALVENI faila nosaukuma vietā lappuses galvenē,\n"
"         -h \"\" izdrukā tukšu rindu, nelietot -h\"\"\n"

#: src/pr.c:2820
msgid ""
"  -i[CHAR[WIDTH]], --output-tabs[=CHAR[WIDTH]]\n"
"         replace spaces with CHARs (TABs) to tab WIDTH (8)\n"
msgstr ""
"  -i[RAKSTZĪME[PLATUMS]], --output-tabs[=RAKSTZĪME[PLATUMS]]\n"
"         aizstāt atstarpes ar RAKSTZĪMĒM (tabulācijām) līdz tabulācijas PLATUMAM (8)\n"

#: src/pr.c:2824
msgid ""
"  -J, --join-lines\n"
"         merge full lines, turns off -W line truncation,\n"
"         no column alignment, --sep-string[=STRING] sets separators\n"
msgstr ""
"  -J, --join-lines\n"
"         apvienot pilnas rindas, izslēdz -W rindu saīsināšanu,\n"
"         bez kolonnu izlīdzināšanas, --sep-string[=VIRKNE] iestata atdalītājus\n"

#: src/pr.c:2829
msgid ""
"  -l, --length=PAGE_LENGTH\n"
"         set the page length to PAGE_LENGTH (66) lines\n"
"         (default number of lines of text 56, and with -F 63).\n"
"         implies -t if PAGE_LENGTH <= 10\n"
msgstr ""
"  -l, --length=LAPPUSES_GARUMS\n"
"         iestatīt lappuses garumu uz LAPPUSES_GARUMS (66) rindām\n"
"         (noklusētais teksta rindu skaits ir 56, un ar -F – 63).\n"
"         ietver -t, ja LAPPUSES_GARUMS <= 10\n"

#: src/pr.c:2835
msgid ""
"  -m, --merge\n"
"         print all files in parallel, one in each column,\n"
"         truncate lines, but join lines of full length with -J\n"
msgstr ""
"  -m, --merge\n"
"         drukāt visus failus paralēli, katru savā kolonnā,\n"
"         saīsināt rindas, bet apvienot pilna garuma rindas ar -J\n"

#: src/pr.c:2840
msgid ""
"  -n[SEP[DIGITS]], --number-lines[=SEP[DIGITS]]\n"
"         number lines, use DIGITS (5) digits, then SEP (TAB),\n"
"         default counting starts with 1st line of input file\n"
msgstr ""
"  -n[SEP[CIPARI]], --number-lines[=SEP[CIPARI]]\n"
"         numurēt rindas, izmantot CIPARUS (5) cipariem, tad SEP (TAB),\n"
"         pēc noklusējuma skaitīšana sākas no ievades faila 1. rindas\n"

#: src/pr.c:2845
msgid ""
"  -N, --first-line-number=NUMBER\n"
"         start counting with NUMBER at 1st line of first\n"
"         page printed (see +FIRST_PAGE)\n"
msgstr ""
"  -N, --first-line-number=SKAITLIS\n"
"         sākt skaitīšanu ar SKAITLI pirmās izdrukātās lappuses\n"
"         1. rindā (skatīt +PIRMĀ_LAPPUSE)\n"

#: src/pr.c:2850
msgid ""
"  -o, --indent=MARGIN\n"
"         offset each line with MARGIN (zero) spaces, do not\n"
"         affect -w or -W, MARGIN will be added to PAGE_WIDTH\n"
msgstr ""
"  -o, --indent=NOBĪDE\n"
"         nobīdīt katru rindu par NOBĪDI (nulle) atstarpēm; neietekmē\n"
"         -w vai -W, NOBĪDE tiks pieskaitīts pie LAPPUSES_PLATUMA\n"

#: src/pr.c:2855
msgid ""
"  -r, --no-file-warnings\n"
"         omit warning when a file cannot be opened\n"
msgstr ""
"  -r, --no-file-warnings\n"
"         nerādīt brīdinājumu, ja failu neizdodas atvērt\n"

#: src/pr.c:2859
msgid ""
"  -s[CHAR], --separator[=CHAR]\n"
"         separate columns by a single character, default for CHAR\n"
"         is the <TAB> character without -w and 'no char' with -w.\n"
"         -s[CHAR] turns off line truncation of all 3 column\n"
"         options (-COLS|-a -COLS|-m) except -w is set\n"
msgstr ""
"  -s[RAKSTZĪME], --separator[=RAKSTZĪME]\n"
"         atdalīt kolonnas ar vienu rakstzīmi; RAKSTZĪMES noklusējums\n"
"         ir <TAB> rakstzīme bez -w un 'nav rakstzīmes' ar -w.\n"
"         -s[RAKSTZĪME] izslēdz visu 3 kolonnu opciju (-COLS|-a -COLS|-m)\n"
"         rindu apgriešanu, izņemot, ja ir iestatīts -w\n"

#: src/pr.c:2866
msgid ""
"  -S[STRING], --sep-string[=STRING]\n"
"         separate columns by STRING,\n"
"         without -S: Default separator <TAB> with -J and <space>\n"
"         otherwise (same as -S\" \"), no effect on column options\n"
msgstr ""
"  -S[VIRKNE], --sep-string[=VIRKNE]\n"
"         atdalīt kolonnas ar VIRKNE,\n"
"         bez -S: noklusējuma atdalītājs ir <TAB> ar -J un <atstarpe>\n"
"         citādi (tāpat kā -S\" \"), neietekmē kolonnu opcijas\n"

#: src/pr.c:2872
msgid ""
"  -t, --omit-header\n"
"         omit page headers and trailers; implied if PAGE_LENGTH <= 10\n"
msgstr ""
"  -t, --omit-header\n"
"         izlaist lapas galvenes un kājenes; tiek pieņemts, ja LAPPUSE_GARUMS <= 10\n"

#: src/pr.c:2876
msgid ""
"  -T, --omit-pagination\n"
"         omit page headers and trailers,\n"
"         eliminate any pagination by form feeds set in input files\n"
msgstr ""
"  -T, --omit-pagination\n"
"         izlaist lapas galvenes un kājenes,\n"
"         novērst lappušu dalīšanu ar lapas padeves rakstzīmēm ievades failos\n"

#: src/pr.c:2881
msgid ""
"  -v, --show-nonprinting\n"
"         use octal backslash notation\n"
msgstr ""
"  -v, --show-nonprinting\n"
"         izmantot oktālo apgrieztās slīpsvītras apzīmējumu\n"

#: src/pr.c:2885
msgid ""
"  -w, --width=PAGE_WIDTH\n"
"         set page width to PAGE_WIDTH (72) characters for\n"
"         multiple text-column output only, -s[char] turns off (72)\n"
msgstr ""
"  -w, --width=LAPPUSES_PLATUMS\n"
"         iestatīt lapas platumu uz LAPPUSES_PLATUMS (72) rakstzīmēm tikai\n"
"         vairāku teksta kolonnu izvadei, -s[rakstzīme] izslēdz (72)\n"

#: src/pr.c:2890
msgid ""
"  -W, --page-width=PAGE_WIDTH\n"
"         set page width to PAGE_WIDTH (72) characters always,\n"
"         truncate lines, except -J option is set,\n"
"         no interference with -S or -s\n"
msgstr ""
"  -W, --page-width=LAPPUSES_PLATUMS\n"
"         iestatīt lapas platumu uz LAPPUSES_PLATUMS(72) rakstzīmēm vienmēr,\n"
"         apcirpt rindas, izņemot, ja ir iestatīta opcija -J,\n"
"         neietekmē -S vai -s\n"

#: src/printenv.c:65
#, c-format
msgid ""
"Usage: %s [OPTION] [VARIABLE]...\n"
"Print the values of the specified environment VARIABLE(s).\n"
"If no VARIABLE is specified, print name and value pairs for them all.\n"
"\n"
msgstr ""
"Lietošana: %s [OPCIJA] [MAINĪGAIS]...\n"
"Izvadīt norādīto vides MAINĪGO vērtības.\n"
"Ja nav norādīts neviens MAINĪGAIS, izvadīt nosaukumu un vērtību pārus visiem mainīgajiem.\n"
"\n"

#: src/printf.c:44
