#: src/cksum.c:501
#, c-format
msgid "Print or check %s checksums.\n"
msgstr "Izvadīt vai pārbaudīt %s kontrolsummas.\n"

#: src/cksum.c:504 src/cksum.c:519
msgid "Legacy interface to the cksum(1) utility.\n"
msgstr "Novecojusi saskarne cksum(1) utilītai.\n"

#: src/cksum.c:509
msgid ""
"Print or verify checksums.\n"
"By default use the 32 bit CRC algorithm.\n"
msgstr ""
"Izvadīt vai pārbaudīt kontrolsummas.\n"
"Pēc noklusējuma izmanto 32 bitu CRC algoritmu.\n"

#: src/cksum.c:514
#, c-format
msgid "Print or check %s (%d-bit) checksums.\n"
msgstr "Izvadīt vai pārbaudīt %s (%d bitu) kontrolsummas.\n"

#: src/cksum.c:526
msgid ""
"  -r\n"
"         use BSD sum algorithm (the default), use 1K blocks\n"
msgstr ""
"  -r\n"
"         izmantot BSD sum algoritmu (noklusējums), izmantot 1K blokus\n"

#: src/cksum.c:530
msgid ""
"  -s, --sysv\n"
"         use System V sum algorithm, use 512 bytes blocks\n"
msgstr ""
"  -s, --sysv\n"
"         izmantot System V kontrolsummas algoritmu, lietot 512 baitu blokus\n"

#: src/cksum.c:540
msgid ""
"  -a, --algorithm=TYPE\n"
"         select the digest type to use.  See DIGEST below\n"
msgstr ""
"  -a, --algorithm=VEIDS\n"
"         izvēlēties izmantojamo kontrolsummas VEIDU.  Skatīt DIGEST zemāk\n"

#: src/cksum.c:545
msgid ""
"      --base64\n"
"         emit base64-encoded digests, not hexadecimal\n"
msgstr ""
"      --base64\n"
"         izvadīt base64 kodētas kontrolsummas, nevis heksadecimālas\n"

#: src/cksum.c:556
msgid ""
"  -b, --binary\n"
"         read in binary mode (default unless reading tty stdin)\n"
msgstr ""
"  -b, --binary\n"
"         lasīt binārā režīmā (noklusējums, ja vien nelasa no tty standarta ievades)\n"

#: src/cksum.c:561
msgid ""
"  -b, --binary\n"
"         read in binary mode\n"
msgstr ""
"  -b, --binary\n"
"         lasīt binārā režīmā\n"

#: src/cksum.c:568
msgid ""
"  -c, --check\n"
"         read checksums from the FILEs and check them\n"
msgstr ""
"  -c, --check\n"
"         nolasīt kontrolsummas no norādītajiem FAILiem un pārbaudīt tās\n"

#: src/cksum.c:576
msgid ""
"  -l, --length=BITS\n"
"         digest length in bits; must not exceed the max size\n"
"         and must be a multiple of 8 for blake2b;\n"
"         must be 224, 256, 384, or 512 for sha2 or sha3\n"
msgstr ""
"  -l, --length=BITS\n"
"         kontrolsummas garums bitos; nedrīkst pārsniegt maksimālo izmēru\n"
"         un blake2b algoritmam jābūt 8 daudzkārtnim;\n"
"         sha2 vai sha3 gadījumā jābūt 224, 256, 384 vai 512\n"

#: src/cksum.c:585
msgid ""
"      --raw\n"
"         emit a raw binary digest, not hexadecimal\n"
msgstr ""
"      --raw\n"
"         izvadīt neapstrādātu bināro kontrolsummu, nevis heksadecimālu\n"

#: src/cksum.c:590 src/cksum.c:605
msgid ""
"      --tag\n"
"         create a BSD-style checksum\n"
msgstr ""
"      --tag\n"
"         izveidot BSD stila kontrolsummu\n"

#: src/cksum.c:595
msgid ""
"      --tag\n"
"         create a BSD-style checksum (the default)\n"
msgstr ""
"      --tag\n"
"         izveidot BSD stila kontrolsummu (noklusējums)\n"

#: src/cksum.c:600
msgid ""
"      --untagged\n"
"         create a reversed style checksum, without digest type\n"
msgstr ""
"      --untagged\n"
"         izveidot apgrieztā stila kontrolsummu bez kontrolsummas veida norādes\n"

#: src/cksum.c:615
msgid ""
"  -t, --text\n"
"         read in text mode (default if reading tty stdin)\n"
msgstr ""
"  -t, --text\n"
"         lasīt teksta režīmā (noklusējums, ja lasa no tty standarta ievades)\n"

#: src/cksum.c:620
msgid ""
"  -t, --text\n"
"         read in text mode (default)\n"
msgstr ""
"  -t, --text\n"
"         lasīt teksta režīmā (noklusējums)\n"

#: src/cksum.c:627
msgid ""
"  -z, --zero\n"
"         end each output line with NUL, not newline,\n"
"         and disable file name escaping\n"
msgstr ""
"  -z, --zero\n"
"         beigt katru izvades rindu ar NUL, nevis jaunu rindu rakstzīmi,\n"
"         un atspējot failu nosaukumu aizvietošanu\n"

#: src/cksum.c:632
msgid ""
"\n"
"The following five options are useful only when verifying checksums:\n"
msgstr ""
"\n"
"Šīs piecas opcijas ir noderīgas tikai kontrolsummu pārbaudei:\n"

#: src/cksum.c:636
msgid ""
"      --ignore-missing\n"
"         don't fail or report status for missing files\n"
msgstr ""
"      --ignore-missing\n"
"         nebeigt ar kļūdu un neziņot statusu par trūkstošiem failiem\n"

#: src/cksum.c:640
msgid ""
"      --quiet\n"
"         don't print OK for each successfully verified file\n"
msgstr ""
"      --quiet\n"
"         neizvadīt OK par katru veiksmīgi pārbaudītu failu\n"

#: src/cksum.c:644
msgid ""
"      --status\n"
"         don't output anything, status code shows success\n"
msgstr ""
"      --status\n"
"         neizvadīt neko, statusa kods norāda uz veiksmi\n"

#: src/cksum.c:648
msgid ""
"      --strict\n"
"         exit non-zero for improperly formatted checksum lines\n"
msgstr ""
"      --strict\n"
"         beigt darbību ar nenulles kodu, ja kontrolsummas rindas ir nepareizi formatētas\n"

#: src/cksum.c:652
msgid ""
"  -w, --warn\n"
"         warn about improperly formatted checksum lines\n"
msgstr ""
"  -w, --warn\n"
"         brīdināt par nepareizi formatētām kontrolsummas rindām\n"

#: src/cksum.c:659
msgid ""
"      --debug\n"
"         indicate which implementation used\n"
msgstr ""
"      --debug\n"
"         norādīt izmantoto implementāciju\n"

#: src/cksum.c:668
msgid ""
"\n"
"DIGEST determines the digest algorithm and default output format:\n"
"  sysv      (equivalent to sum -s)\n"
"  bsd       (equivalent to sum -r)\n"
"  crc       (equivalent to cksum)\n"
"  crc32b    (only available through cksum)\n"
"  md5       (equivalent to md5sum)\n"
"  sha1      (equivalent to sha1sum)\n"
"  sha2      (equivalent to sha{224,256,384,512}sum)\n"
"  sha3      (only available through cksum)\n"
"  blake2b   (equivalent to b2sum)\n"
"  sm3       (only available through cksum)\n"
"\n"
msgstr ""
"\n"
"DIGEST nosaka kontrolsummas algoritmu un noklusējuma izvades formātu:\n"
"  sysv      (līdzvērtīgs sum -s)\n"
"  bsd       (līdzvērtīgs sum -r)\n"
"  crc       (līdzvērtīgs cksum)\n"
"  crc32b    (pieejams tikai ar cksum)\n"
"  md5       (līdzvērtīgs md5sum)\n"
"  sha1      (līdzvērtīgs sha1sum)\n"
"  sha2      (līdzvērtīgs sha{224,256,384,512}sum)\n"
"  sha3      (pieejams tikai ar cksum)\n"
"  blake2b   (līdzvērtīgs b2sum)\n"
"  sm3       (pieejams tikai ar cksum)\n"

#: src/cksum.c:684
#, c-format
msgid ""
"\n"
"The sums are computed as described in %s.\n"
msgstr ""
"\n"
"Kontrolsummas aprēķina tā, kā aprakstīts %s.\n"

#: src/cksum.c:687
msgid ""
"When checking, the input should be a former output of this program.\n"
"The default mode is to print a line with: checksum, a space,\n"
"a character indicating input mode ('*' for binary, ' ' for text\n"
"or where binary is insignificant), and name for each FILE.\n"
"\n"
"There is no difference between binary mode and text mode on GNU systems.\n"
msgstr ""
"Veicot pārbaudi, ievadei jābūt šīs programmas iepriekšējai izvadei.\n"
"Noklusējuma režīmā tiek izvadīta rinda ar: kontrolsummu, atstarpi,\n"
"rakstzīmi, kas norāda ievades režīmu ('*' binārajam, ' ' tekstam\n"
"vai vietās, kur binārais nav būtisks), un katra FAILA nosaukumu.\n"
"\n"
"GNU sistēmās nav atšķirības starp bināro un teksta režīmu.\n"

#: src/cksum.c:697
msgid ""
"When checking, the input should be a former output of this program,\n"
"or equivalent standalone program.\n"
msgstr ""
"Veicot pārbaudi, ievadei jābūt šīs programmas vai līdzvērtīgas atsevišķas\n"
"programmas iepriekšējai izvadei.\n"

