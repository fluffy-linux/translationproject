#: src/who.c:630
#, c-format
msgid "Usage: %s [OPTION]... [ FILE | ARG1 ARG2 ]\n"
msgstr "Lietošana: %s [OPCIJA]... [ FAILS | ARG1 ARG2 ]\n"

#: src/who.c:631
msgid "Print information about users who are currently logged in.\n"
msgstr "Parādīt informāciju par lietotājiem, kuri pašlaik ir pierakstījušies.\n"

#: src/who.c:637
msgid "  -a, --all         same as -b -d --login -p -r -t -T -u\n"
msgstr "  -a, --all         tas pats, kas -b -d --login -p -r -t -T -u\n"

#: src/who.c:640
msgid "  -b, --boot        time of last system boot\n"
msgstr "  -b, --boot        pēdējās sistēmas ielādes laiks\n"

#: src/who.c:643
msgid "  -d, --dead        print dead processes\n"
msgstr "  -d, --dead        parādīt mirušos procesus\n"

#: src/who.c:646
msgid "  -H, --heading     print line of column headings\n"
msgstr "  -H, --heading     parādīt kolonnu virsrakstu rindu\n"

#: src/who.c:649
msgid "  -l, --login       print system login processes\n"
msgstr "  -l, --login       parādīt sistēmas pierakstīšanās procesus\n"

#: src/who.c:652
msgid "      --lookup      attempt to canonicalize hostnames via DNS\n"
msgstr "      --lookup      mēģināt kanonizēt resursdatoru nosaukumus, izmantojot DNS\n"

#: src/who.c:655
msgid "  -m                only hostname and user associated with standard input\n"
msgstr "  -m                tikai resursdatora nosaukums un lietotājs, kas saistīts ar standarta ievadi\n"

#: src/who.c:658
msgid "  -p, --process     print active processes spawned by init\n"
msgstr "  -p, --process     parādīt aktīvos procesus, ko palaidis init\n"

#: src/who.c:661
msgid "  -q, --count       all login names and number of users logged on\n"
msgstr "  -q, --count       visi pieteikvārdi un pieteikušos lietotāju skaits\n"

#: src/who.c:664
msgid "  -r, --runlevel    print current runlevel\n"
msgstr "  -r, --runlevel    parādīt pašreizējo darbības līmeni\n"

#: src/who.c:667
msgid "  -s, --short       print only name, line, and time (default)\n"
msgstr "  -s, --short       parādīt tikai vārdu, līniju un laiku (noklusējums)\n"

#: src/who.c:670
msgid "  -t, --time        print last system clock change\n"
msgstr "  -t, --time        parādīt pēdējo sistēmas pulksteņa maiņu\n"

#: src/who.c:673
msgid "  -T, -w, --mesg    add user's message status as +, - or ?\n"
msgstr "  -T, -w, --mesg    pievienot lietotāja ziņojumu statusu kā +, - vai ?\n"

#: src/who.c:676
msgid "  -u, --users       list users logged in, including idle time\n"
msgstr "  -u, --users       uzskaitīt pieteikušos lietotājus, tostarp dīkstāves laiku\n"

#: src/who.c:679
msgid "      --message     same as -T\n"
msgstr "      --message     tas pats, kas -T\n"

#: src/who.c:682
msgid "      --writable    same as -T\n"
msgstr "      --writable    tas pats, kas -T\n"

#: src/who.c:687
#, c-format
msgid ""
"\n"
"If FILE is not specified, use %s.  %s as FILE is common.\n"
"If ARG1 ARG2 given, -m presumed: 'am i' or 'mom likes' are usual.\n"
msgstr ""
"\n"
"Ja FAILS nav norādīts, izmanto %s.  %s kā FAILS ir izplatīta izvēle.\n"
"Ja norādīti ARG1 ARG2, tiek pieņemts -m: parasti izmanto 'am i' vai 'mom likes'.\n"

#: src/whoami.c:43
msgid ""
"Print the user name associated with the current effective user ID.\n"
"Same as id -un.\n"
"\n"
msgstr ""
"Izvada lietotājvārdu, kas saistīts ar pašreizējo efektīvo lietotāja ID.\n"
"Tas pats, kas id -un.\n"
"\n"

#: src/yes.c:45
#, c-format
msgid ""
"Usage: %s [STRING]...\n"
"  or:  %s OPTION\n"
msgstr ""
"Lietojums: %s [VIRKNE]...\n"
"  vai:  %s OPCIJA\n"

#: src/yes.c:51
msgid ""
"Repeatedly output a line with all specified STRING(s), or 'y'.\n"
"\n"
msgstr ""
"Atkārtoti izvada rindu ar visām norādītajām virknēm vai 'y'.\n"
"\n"
