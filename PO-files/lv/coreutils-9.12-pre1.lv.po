msgstr ""
"  -T, --no-target-directory\n"
"         vienmēr uzskatīt SAITES_NOSAUKUMU par parastu failu\n"

#: src/ln.c:495
msgid ""
"  -v, --verbose\n"
"         print name of each linked file\n"
msgstr ""
"  -v, --verbose\n"
"         izvadīt katra saistītā faila nosaukumu\n"

#: src/ln.c:502
