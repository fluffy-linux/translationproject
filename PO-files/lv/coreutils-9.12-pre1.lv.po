msgstr " * vtN           vertikālās tabulācijas aizkaves stils, N diapazonā [0..1]\n"

#: src/stty.c:814
msgid ""
"\n"
"Local settings:\n"
"   [-]crterase   echo erase characters as backspace-space-backspace\n"
msgstr ""
"\n"
"Lokālie iestatījumi:\n"
"   [-]crterase   atbalsot dzēšanas rakstzīmes kā atpakaļatkāpe-atstarpe-atpakaļatkāpe\n"

#: src/stty.c:820
msgid ""
" * crtkill       kill all line by obeying the echoprt and echoe settings\n"
" * -crtkill      kill all line by obeying the echoctl and echok settings\n"
msgstr ""
" * crtkill       izdzēst visu rindu, ievērojot echoprt un echoe iestatījumus\n"
" * -crtkill      izdzēst visu rindu, ievērojot echoctl un echok iestatījumus\n"

#: src/stty.c:826
msgid " * [-]ctlecho    echo control characters in hat notation ('^c')\n"
msgstr " * [-]ctlecho    atbalsot vadības rakstzīmes jumtiņa notācijā ('^c')\n"

#: src/stty.c:830
msgid "   [-]echo       echo input characters\n"
msgstr "   [-]echo       atbalsot ievades rakstzīmes\n"

#: src/stty.c:834
msgid " * [-]echoctl    same as [-]ctlecho\n"
msgstr " * [-]echoctl    tas pats, kas [-]ctlecho\n"

#: src/stty.c:838
msgid ""
"   [-]echoe      same as [-]crterase\n"
"   [-]echok      echo a newline after a kill character\n"
msgstr ""
"   [-]echoe      tas pats, kas [-]crterase\n"
"   [-]echok      atbalsot jaunu rindu pēc dzēšanas rakstzīmes\n"

#: src/stty.c:843
msgid " * [-]echoke     same as [-]crtkill\n"
msgstr " * [-]echoke     tas pats, kas [-]crtkill\n"

#: src/stty.c:847
msgid "   [-]echonl     echo newline even if not echoing other characters\n"
msgstr "   [-]echonl     atbalsot jaunu rindu, pat ja neatbalso citas rakstzīmes\n"

#: src/stty.c:851
msgid " * [-]echoprt    echo erased characters backward, between '\\' and '/'\n"
msgstr " * [-]echoprt    atbalsot dzēstās rakstzīmes atpakaļ, starp '\\' un '/'\n"

#: src/stty.c:856
msgid " * [-]extproc    enable \"LINEMODE\"; useful with high latency links\n"
msgstr " * [-]extproc    ieslēgt \"LINEMODE\"; noderīgi augstas aizkaves savienojumos\n"

#: src/stty.c:861
msgid " * [-]flusho     discard output\n"
msgstr " * [-]flusho     atmest izvadi\n"

#: src/stty.c:865
#, c-format
msgid ""
"   [-]icanon     enable special characters: %s\n"
"   [-]iexten     enable non-POSIX special characters\n"
msgstr ""
"   [-]icanon     ieslēgt īpašās rakstzīmes: %s\n"
