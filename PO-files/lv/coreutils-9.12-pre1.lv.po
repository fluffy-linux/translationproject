msgstr ""
"Izvadīt standarta ievadei pievienotā termināļa faila nosaukumu.\n"
"\n"

#: src/tty.c:70
msgid ""
"  -s, --silent, --quiet\n"
"         print nothing, only return an exit status\n"
msgstr ""
"  -s, --silent, --quiet\n"
"         neko neizvadīt, tikai atgriezt izejas statusu\n"

