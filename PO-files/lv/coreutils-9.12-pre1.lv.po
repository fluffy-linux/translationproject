msgstr "neportatīva rakstzīme %s faila nosaukumā %s"

#: src/pathchk.c:274
#, c-format
msgid "empty file name"
msgstr "tukšs faila nosaukums"

#: src/pathchk.c:316
#, c-format
msgid "%s: unable to determine maximum file name length"
msgstr "%s: neizdevās noteikt maksimālo faila nosaukuma garumu"

#: src/pathchk.c:325
#, c-format
msgid "limit %td exceeded by length %td of file name %s"
msgstr "limits %td pārsniegts ar garumu %td faila nosaukumam %s"

#: src/pathchk.c:409
#, c-format
msgid "limit %td exceeded by length %td of file name component %s"
msgstr "limits %td pārsniegts ar garumu %td faila nosaukuma komponentei %s"

