#: src/tee.c:88
msgid ""
"Copy standard input to each FILE, and also to standard output.\n"
"\n"
msgstr ""
"Kopē standarta ievadi katrā FAILĀ, kā arī uz standarta izvadi.\n"
"\n"

#: src/tee.c:92
msgid ""
"  -a, --append\n"
"         append to the given FILEs, do not overwrite\n"
msgstr ""
"  -a, --append\n"
"         pievienot norādītajiem FAILIEM, nepārrakstot\n"

#: src/tee.c:96
msgid ""
"  -i, --ignore-interrupts\n"
"         ignore interrupt signals\n"
msgstr ""
"  -i, --ignore-interrupts\n"
"         ignorēt pārtraukuma signālus\n"

#: src/tee.c:100
msgid ""
"  -p\n"
"         operate in a more appropriate MODE with pipes\n"
msgstr ""
"  -p\n"
"         darboties piemērotākā REŽĪMĀ ar cauruļvadiem\n"

#: src/tee.c:104
msgid ""
"      --output-error[=MODE]\n"
"         set behavior on write error.  See MODE below\n"
msgstr ""
"  --output-error[=REŽĪMS]\n"
"         iestatīt uzvedību rakstīšanas kļūdas gadījumā. Skatīt REŽĪMU zemāk\n"

#: src/tee.c:110
msgid ""
"\n"
"MODE determines behavior with write errors on the outputs:\n"
"  warn           diagnose errors writing to any output\n"
"  warn-nopipe    diagnose errors writing to any output not a pipe\n"
"  exit           exit on error writing to any output\n"
"  exit-nopipe    exit on error writing to any output not a pipe\n"
"The default MODE for the -p option is 'warn-nopipe'.\n"
"With \"nopipe\" MODEs, exit immediately if all outputs become broken pipes.\n"
"The default operation when --output-error is not specified, is to\n"
"exit immediately on error writing to a pipe, and diagnose errors\n"
"writing to non pipe outputs.\n"
msgstr ""
"\n"
"REŽĪMS nosaka uzvedību rakstīšanas kļūdu gadījumā izvadēs:\n"
"  warn           diagnosticēt kļūdas, rakstot jebkurā izvadē\n"
"  warn-nopipe    diagnosticēt kļūdas, rakstot izvadē, kas nav cauruļvads\n"
"  exit           iziet kļūdas gadījumā, rakstot jebkurā izvadē\n"
"  exit-nopipe    iziet kļūdas gadījumā, rakstot izvadē, kas nav cauruļvads\n"
"Noklusējuma REŽĪMS opcijai -p ir 'warn-nopipe'.\n"
"Ar \"nopipe\" REŽĪMIEM nekavējoties iziet, ja visas izvades kļūst par pārrautiem cauruļvadiem.\n"
"Noklusējuma darbība, ja --output-error nav norādīts, ir\n"
"nekavējoties iziet kļūdas gadījumā, rakstot cauruļvadā, un diagnosticēt\n"
"kļūdas, rakstot izvadēs, kas nav cauruļvadi.\n"

