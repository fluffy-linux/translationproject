#: src/cp.c:172
msgid ""
"  -a, --archive\n"
"         same as -dR --preserve=all\n"
msgstr ""
"  -a, --archive\n"
"         tas pats, kas -dR --preserve=all\n"

#: src/cp.c:176
msgid ""
"      --attributes-only\n"
"         don't copy the file data, just the attributes\n"
msgstr ""
"      --attributes-only\n"
"         nekopēt faila datus, tikai atribūtus\n"

#: src/cp.c:180 src/install.c:615 src/ln.c:441 src/mv.c:265
msgid ""
"      --backup[=CONTROL]\n"
"         make a backup of each existing destination file\n"
msgstr ""
"      --backup[=CONTROL]\n"
"         veidot rezerves kopiju katram esošajam mērķa failam\n"

#: src/cp.c:184 src/install.c:619 src/ln.c:445 src/mv.c:269
msgid ""
"  -b\n"
"         like --backup but does not accept an argument\n"
msgstr ""
"  -b\n"
"         tāpat kā --backup, bet nepieņem argumentu\n"

#: src/cp.c:188
msgid ""
"      --copy-contents\n"
"         copy contents of special files when recursive\n"
msgstr ""
"      --copy-contents\n"
"         rekursīvā režīmā kopēt speciālo failu saturu\n"

#: src/cp.c:192
msgid ""
"  -d\n"
"         same as --no-dereference --preserve=links\n"
msgstr ""
"  -d\n"
"         tas pats, kas --no-dereference --preserve=links\n"

#: src/cp.c:196 src/install.c:644 src/mv.c:273
msgid ""
"      --debug\n"
"         explain how a file is copied.  Implies -v\n"
msgstr ""
"      --debug\n"
"         paskaidrot, kā fails tiek kopēts.  Ietver -v\n"

#: src/cp.c:200
msgid ""
"  -f, --force\n"
"         if an existing destination file cannot be opened, remove it and try\n"
"         again (this option is ignored when the -n option is also used)\n"
msgstr ""
"  -f, --force\n"
"         ja esošo mērķa failu nevar atvērt, to dzēst un mēģināt\n"
"         vēlreiz (šī opcija tiek ignorēta, ja tiek izmantota arī -n opcija)\n"

#: src/cp.c:205
msgid ""
"  -i, --interactive\n"
"         prompt before overwrite (overrides a previous -n option)\n"
msgstr ""
"  -i, --interactive\n"
"         prasīt apstiprinājumu pirms pārrakstīšanas (atceļ iepriekšējo -n opciju)\n"

#: src/cp.c:209
msgid ""
"  -H\n"
"         follow command-line symbolic links in SOURCE\n"
msgstr ""
"  -H\n"
"         sekot komandrindas simboliskajām saitēm AVOTĀ\n"

#: src/cp.c:213
msgid ""
"  -L, --dereference\n"
"         always follow symbolic links in SOURCE\n"
msgstr ""
"  -L, --dereference\n"
"         vienmēr sekot simboliskajām saitēm AVOTĀ\n"

#: src/cp.c:217
msgid ""
"  -P, --no-dereference\n"
"         never follow symbolic links in SOURCE\n"
msgstr ""
"  -P, --no-dereference\n"
"         nekad nesekot simboliskajām saitēm AVOTĀ\n"

#: src/cp.c:221
msgid ""
"      --keep-directory-symlink\n"
"         follow existing symlinks to directories\n"
msgstr ""
"      --keep-directory-symlink\n"
"         sekot esošajām simboliskajām saitēm uz direktorijām\n"

#: src/cp.c:225
msgid ""
"  -l, --link\n"
"         hard link files instead of copying\n"
msgstr ""
"  -l, --link\n"
"         veidot cietās saites, nevis kopēt failus\n"

