#: src/df.c:1499
msgid ""
"Show information about the file system on which each FILE resides,\n"
"or all file systems by default.\n"
msgstr ""
"Parādīt informāciju par failu sistēmu, kurā atrodas katrs FAILS,\n"
"vai par visām failu sistēmām pēc noklusējuma.\n"

#. TRANSLATORS: The thousands and decimal separators are best
#. adjusted to an appropriate default for your locale.
#: src/df.c:1508
msgid ""
"  -a, --all\n"
"         include pseudo, duplicate, inaccessible file systems\n"
msgstr ""
"  -a, --all\n"
"         iekļaut pseido, dublētās, nepieejamās failu sistēmas\n"

#: src/df.c:1512
msgid ""
"  -B, --block-size=SIZE\n"
"         scale sizes by SIZE before printing them; see SIZE format below;\n"
"         E.g., '-BM' prints sizes in units of 1,048,576 bytes\n"
msgstr ""
"  -B, --block-size=IZMĒRS\n"
"         mērogot izmērus pēc IZMĒRA pirms to izvadīšanas; skatīt IZMĒRA formātu zemāk;\n"
"         Piem., '-BM' izvada izmērus 1 048 576 baitu vienībās\n"

#: src/df.c:1517
msgid ""
"  -h, --human-readable\n"
"         print sizes in powers of 1024 (e.g., 1023M)\n"
msgstr ""
"  -h, --human-readable\n"
"         izvadīt izmērus 1024 pakāpēs (piem., 1023M)\n"

#: src/df.c:1521
msgid ""
"  -H, --si\n"
"         print sizes in powers of 1000 (e.g., 1.1G)\n"
msgstr ""
"  -H, --si\n"
"         izvadīt izmērus 1000 pakāpēs (piem., 1.1G)\n"

#: src/df.c:1525
msgid ""
"  -i, --inodes\n"
"         list inode information instead of block usage\n"
msgstr ""
"  -i, --inodes\n"
"         parādīt i-mezglu informāciju, nevis bloku izmantošanu\n"

#: src/df.c:1529 src/du.c:348
msgid ""
"  -k\n"
"         like --block-size=1K\n"
msgstr ""
"  -k\n"
"         tāpat kā --block-size=1K\n"

#: src/df.c:1533
msgid ""
"  -l, --local\n"
"         limit listing to local file systems\n"
msgstr ""
"  -l, --local\n"
"         ierobežot sarakstu tikai ar lokālajām failu sistēmām\n"

#: src/df.c:1537
msgid ""
"      --no-sync\n"
"         do not invoke sync before getting usage info (default)\n"
msgstr ""
"      --no-sync\n"
"         neizsaukt sync pirms izmantošanas informācijas iegūšanas (noklusējums)\n"

#: src/df.c:1541
msgid ""
"      --output[=FIELD_LIST]\n"
"         use the output format defined by FIELD_LIST,\n"
"         or print all fields if FIELD_LIST is omitted\n"
msgstr ""
"      --output[=LAUKU_SARAKSTS]\n"
"         izmantot izvades formātu, ko definē LAUKU_SARAKSTS,\n"
"         vai izvadīt visus laukus, ja LAUKU_SARAKSTS ir izlaists\n"

#: src/df.c:1546
msgid ""
"  -P, --portability\n"
"         use the POSIX output format\n"
msgstr ""
"  -P, --portability\n"
"         izmantot POSIX izvades formātu\n"

#: src/df.c:1550
msgid ""
"      --sync\n"
"         invoke sync before getting usage info\n"
msgstr ""
"      --sync\n"
"         izsaukt sync pirms izmantošanas informācijas iegūšanas\n"

#: src/df.c:1554
msgid ""
"      --total\n"
"         elide all entries insignificant to available space,\n"
"         and produce a grand total\n"
msgstr ""
"      ----total\n"
"         izlaist visus ierakstus, kas nav būtiski pieejamajai vietai,\n"
"         un izvadīt kopsummu\n"

#: src/df.c:1559
msgid ""
"  -t, --type=TYPE\n"
"         limit listing to file systems of type TYPE\n"
msgstr ""
"  -t, --type=TIPS\n"
"         ierobežot sarakstu ar failu sistēmām, kuru tips ir TIPS\n"

#: src/df.c:1563
msgid ""
"  -T, --print-type\n"
"         print file system type\n"
msgstr ""
"  -T, --print-type\n"
"         izvadīt failu sistēmas tipu\n"

#: src/df.c:1567
msgid ""
"  -x, --exclude-type=TYPE\n"
"         limit listing to file systems not of type TYPE\n"
msgstr ""
"  -x, --exclude-type=TIPS\n"
"         ierobežot sarakstu ar failu sistēmām, kuru tips nav TIPS\n"

#: src/df.c:1571
msgid ""
"  -v\n"
"         (ignored)\n"
msgstr ""
"  -v\n"
"         (ignorēts)\n"

#: src/df.c:1579
msgid ""
"\n"
"FIELD_LIST is a comma-separated list of columns to be included.  Valid\n"
"field names are: 'source', 'fstype', 'itotal', 'iused', 'iavail', 'ipcent',\n"
"'size', 'used', 'avail', 'pcent', 'file' and 'target' (see info page).\n"
msgstr ""
"\n"
"LAUKU_SARAKSTS ir ar komatiem atdalīts kolonnu saraksts, kas jāiekļauj.  Derīgie\n"
"lauku nosaukumi ir: 'source', 'fstype', 'itotal', 'iused', 'iavail', 'ipcent',\n"
"'size', 'used', 'avail', 'pcent', 'file' un 'target' (skat. info lapu).\n"

