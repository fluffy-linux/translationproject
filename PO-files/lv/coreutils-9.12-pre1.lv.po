"Print value of a symbolic link or canonical file name\n"
"\n"
msgstr ""
"Izvadīt simboliskās saites vērtību vai kanonisko faila nosaukumu\n"
"\n"

#: src/readlink.c:68
msgid ""
"  -f, --canonicalize\n"
"         canonicalize by following every symlink\n"
"         in every component of the given name recursively;\n"
"         all but the last component must exist\n"
msgstr ""
"  -f, --canonicalize\n"
"         kanonizēt, sekojot katrai simboliskajai saitei\n"
"         katrā dotā nosaukuma komponentē rekursīvi;\n"
"         visām komponentēm, izņemot pēdējo, jāeksistē\n"

#: src/readlink.c:74
msgid ""
"  -e, --canonicalize-existing\n"
"         canonicalize by following every symlink\n"
"         in every component of the given name recursively;\n"
"         all components must exist\n"
msgstr ""
"  -e, --canonicalize-existing\n"
"         kanonizēt, sekojot katrai simboliskajai saitei\n"
"         katrā dotā nosaukuma komponentē rekursīvi;\n"
"         visām komponentēm jāeksistē\n"

#: src/readlink.c:80
msgid ""
"  -m, --canonicalize-missing\n"
"         canonicalize by following every symlink\n"
"         in every component of the given name recursively,\n"
"         without requirements on components existence\n"
msgstr ""
"  -m, --canonicalize-missing\n"
"         kanonizēt, sekojot katrai simboliskajai saitei\n"
"         katrā dotā nosaukuma komponentē rekursīvi,\n"
"         bez prasībām par komponenšu eksistenci\n"

