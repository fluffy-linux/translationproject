#: src/hostid.c:40
#, c-format
msgid ""
"Usage: %s [OPTION]\n"
"Print the numeric identifier (in hexadecimal) for the current host.\n"
"\n"
msgstr ""
"Lietošana: %s [OPCIJA]\n"
"Izvadīt pašreizējā resursdatora skaitlisko identifikatoru (heksadecimālā formā).\n"
"\n"

#: src/hostname.c:58
#, c-format
msgid ""
"Usage: %s [NAME]\n"
"  or:  %s OPTION\n"
"Print or set the hostname of the current system.\n"
"\n"
msgstr ""
"Lietošana: %s [NOSAUKUMS]\n"
"  vai:  %s OPCIJA\n"
"Izvadīt vai iestatīt pašreizējās sistēmas resursdatora nosaukumu.\n"
"\n"

#: src/hostname.c:100
#, c-format
msgid "cannot set name to %s"
msgstr "neizdevās iestatīt nosaukumu uz %s"

#: src/hostname.c:107
#, c-format
msgid "cannot determine hostname"
msgstr "neizdevās noteikt resursdatora nosaukumu"

