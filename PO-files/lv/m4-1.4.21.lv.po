#: src/m4.c:207
#, c-format
msgid "Try `%s --help' for more information."
msgstr "Plašākai informācijai mēģiniet `%s --help'."

#: src/m4.c:213
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Lietošana: %s [OPCIJA]... [FAILS]...\n"

#: src/m4.c:214
msgid ""
"Process macros in FILEs.  If no FILE or if FILE is `-', standard input\n"
"is read.\n"
msgstr ""
"Apstrādāt makro FAILOS.  Ja FAILS nav norādīts vai ir `-', tiek lasīta\n"
"standarta ievade.\n"

#: src/m4.c:219
msgid ""
"Mandatory or optional arguments to long options are mandatory or optional\n"
"for short options too.\n"
msgstr ""
"Garajām opcijām obligātie vai neobligātie argumenti ir obligāti vai\n"
"neobligāti arī īsajām opcijām.\n"

#: src/m4.c:224
msgid ""
"Operation modes:\n"
"      --help                   display this help and exit\n"
"      --version                output version information and exit\n"
msgstr ""
"Darbības režīmi:\n"
"      --help                   parādīt šo palīdzību un iziet\n"
"      --version                izvadīt versijas informāciju un iziet\n"

#: src/m4.c:229
msgid ""
"  -E, --fatal-warnings         once: warnings become errors, twice: stop\n"
"                                 execution at first error\n"
"  -i, --interactive            unbuffer output, ignore interrupts\n"
"  -P, --prefix-builtins        force a `m4_' prefix to all builtins\n"
"  -Q, --quiet, --silent        suppress some warnings for builtins\n"
msgstr ""
"  -E, --fatal-warnings         vienreiz: brīdinājumi kļūst par kļūdām, divreiz:\n"
"                                 apturēt izpildi pie pirmās kļūdas\n"
"  -i, --interactive            nebuferēt izvadi, ignorēt pārtraukumus\n"
"  -P, --prefix-builtins        piespiest visiem iebūvētajiem priedēkli `m4_'\n"
"  -Q, --quiet, --silent        apspiest dažus iebūvēto brīdinājumus\n"

#: src/m4.c:236
#, c-format
msgid ""
"      --warn-macro-sequence[=REGEXP]\n"
"                               warn if macro definition matches REGEXP,\n"
"                                 default %s\n"
msgstr ""
"      --warn-macro-sequence[=REGIZT]\n"
"                               brīdināt, ja makro definīcija atbilst REGIZT,\n"
"                                 noklusējums %s\n"

#: src/m4.c:242
msgid "  -W, --word-regexp=REGEXP     use REGEXP for macro name syntax\n"
msgstr "  -W, --word-regexp=REGIZT     izmantot REGIZT makro nosaukumu sintaksei\n"

#: src/m4.c:247
msgid ""
"Preprocessor features:\n"
"  -D, --define=NAME[=VALUE]    define NAME as having VALUE, or empty\n"
"  -I, --include=DIRECTORY      append DIRECTORY to include path\n"
"  -s, --synclines              generate `#line NUM \"FILE\"' lines\n"
"  -U, --undefine=NAME          undefine NAME\n"
msgstr ""
"Priekšapstrādātāja iespējas:\n"
"  -D, --define=NOSAUKUMS[=VĒRTĪBA]\n"
"                               definēt NOSAUKUMU ar VĒRTĪBU vai tukšu\n"
"  -I, --include=DIREKTORIJA    pievienot DIREKTORIJU iekļaušanas ceļam\n"
"  -s, --synclines              ģenerēt `#line NUM \"FILE\"' rindas\n"
"  -U, --undefine=NOSAUKUMS     atdefinēt NOSAUKUMU\n"

#: src/m4.c:255
#, c-format
msgid ""
"Limits control:\n"
"  -g, --gnu                    override -G to re-enable GNU extensions\n"
"  -G, --traditional            suppress all GNU extensions\n"
"  -H, --hashsize=PRIME         set symbol lookup hash table size [%d]\n"
"  -L, --nesting-limit=NUMBER   change nesting limit, 0 for unlimited [%d]\n"
msgstr ""
"Ierobežojumu vadība:\n"
"  -g, --gnu                    ignorēt -G, atkal iespējot GNU paplašinājumus\n"
"  -G, --traditional            apspiest visus GNU paplašinājumus\n"
"  -H, --hashsize=PIRMSKAITLIS  iestatīt simbolu jaucējtabulas izmēru [%d]\n"
"  -L, --nesting-limit=SKAITS   mainīt ligzdošanas robežu, 0 — bez robežas [%d]\n"

#: src/m4.c:263
msgid ""
"Frozen state files:\n"
"  -F, --freeze-state=FILE      produce a frozen state on FILE at end\n"
"  -R, --reload-state=FILE      reload a frozen state from FILE at start\n"
msgstr ""
"Iesaldētā stāvokļa faili:\n"
"  -F, --freeze-state=FAILS     beigās izveidot iesaldētu stāvokli FAILĀ\n"
"  -R, --reload-state=FAILS     sākumā ielādēt iesaldētu stāvokli no FAILA\n"

#: src/m4.c:269
msgid ""
"Debugging:\n"
"  -d, --debug[=FLAGS]          set debug level (no FLAGS implies `aeq')\n"
"      --debugfile[=FILE]       redirect debug and trace output to FILE\n"
"                                 (default stderr, discard if empty string)\n"
"  -l, --arglength=NUM          restrict macro tracing size\n"
"  -t, --trace=NAME             trace NAME when it is defined\n"
msgstr ""
"Atkļūdošana:\n"
"  -d, --debug[=KAROGI]         iestatīt atkļūdošanas līmeni (bez KAROGIEM: `aeq')\n"
"      --debugfile[=FAILS]      novirzīt atkļūdošanas un trasēšanas izvadi\n"
"                                 uz FAILU (noklusējums stderr; tukša\n"
"                                 virkne — atmest)\n"
"  -l, --arglength=SKAITS       ierobežot makro trasēšanas izmēru\n"
"  -t, --trace=NOSAUKUMS        trasēt NOSAUKUMU, kad tas ir definēts\n"

#: src/m4.c:278
msgid ""
"FLAGS is any of:\n"
"  a   show actual arguments\n"
"  c   show before collect, after collect and after call\n"
"  e   show expansion\n"
"  f   say current input file name\n"
"  i   show changes in input files\n"
msgstr ""
"KAROGI ir jebkuri no:\n"
"  a   rādīt faktiskos argumentus\n"
"  c   rādīt pirms savākšanas, pēc savākšanas un pēc izsaukuma\n"
"  e   rādīt izvēršanu\n"
"  f   norādīt pašreizējā ievades faila nosaukumu\n"
"  i   rādīt izmaiņas ievades failos\n"

#: src/m4.c:286
msgid ""
"  l   say current input line number\n"
"  p   show results of path searches\n"
"  q   quote values as necessary, with a or e flag\n"
"  t   trace for all macro calls, not only traceon'ed\n"
"  x   add a unique macro call id, useful with c flag\n"
"  V   shorthand for all of the above flags\n"
msgstr ""
"  l   norādīt pašreizējās ievades rindas numuru\n"
"  p   rādīt ceļa meklējumu rezultātus\n"
"  q   vajadzības gadījumā likt vērtības pēdiņās (ar karogu a vai e)\n"
"  t   trasēt visus makro izsaukumus, ne tikai ar traceon atzīmētos\n"
"  x   pievienot unikālu makro izsaukuma id (noder ar karogu c)\n"
"  V   saīsinājums visiem iepriekš minētajiem karogiem\n"

#: src/m4.c:295
msgid ""
"If defined, the environment variable `M4PATH' is a colon-separated list\n"
"of directories included after any specified by `-I'.\n"
msgstr ""
"Ja definēts, vides mainīgais `M4PATH' ir ar koliem atdalīts direktoriju\n"
"saraksts, kas tiek iekļauts pēc ar `-I' norādītajām.\n"

#: src/m4.c:300
msgid ""
"Exit status is 0 for success, 1 for failure, 63 for frozen file version\n"
"mismatch, or whatever value was passed to the m4exit macro.\n"
msgstr ""
"Izejas statuss ir 0 — veiksme, 1 — kļūme, 63 — iesaldētā faila versiju\n"
"neatbilstība, vai jebkura m4exit makro nodotā vērtība.\n"

#: src/m4.c:443
