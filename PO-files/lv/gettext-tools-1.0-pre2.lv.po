msgstr "Direktīvā %zu saliktais specifikators patērē %zu argumentus."

#: src/format-d.c:1659
msgid "Found '%|' outside of '%(...%)'."
msgstr "Atrasts '%|' ārpus '%(...%)'."

#: src/format-d.c:1662
msgid "The string ends in the middle of a compound specifier."
msgstr "Virkne beidzas salikta specifikatora vidū."

#: src/format-d.c:1665
#, c-format
