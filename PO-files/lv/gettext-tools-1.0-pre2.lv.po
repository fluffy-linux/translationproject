"  -C, --compendium=FILE       additional library of message translations,\n"
"                              may be specified more than once\n"
msgstr ""
"  -C, --compendium=FAILS      ziņojumu tulkojumu papildu bibliotēka,\n"
"                              var norādīt vairākas reizes\n"

#: src/msgmerge.c:512
#, c-format
