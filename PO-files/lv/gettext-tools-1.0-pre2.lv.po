msgstr "Lietojums: %s [OPCIJA] def.po ref.pot\n"

#: src/msgcmp.c:217
#, c-format, no-wrap
msgid ""
"Compare two Uniforum style .po files to check that both contain the same\n"
"set of msgid strings.  The def.po file is an existing PO file with the\n"
"translations.  The ref.pot file is the last created PO file, or a PO Template\n"
"file (generally created by xgettext).  This is useful for checking that\n"
"you have translated each and every message in your program.  Where an exact\n"
"match cannot be found, fuzzy matching is used to produce better diagnostics.\n"
msgstr ""
"Salīdzina divus Uniforum stila .po failus, lai pārbaudītu, vai abos ir\n"
"vienāda msgid virkņu kopa. Fails def.po ir PO fails ar tulkojumiem.\n"
"Fails ref.pot ir pēdējais izveidotais PO fails vai PO veidnes fails\n"
"(parasti izveidots ar xgettext). Tas ir noderīgi, lai pārbaudītu, vai\n"
"esat pārtulkojis katru programmas ziņojumu. Ja precīzu atbilstību\n"
"neizdodas atrast, tiek izmantota aptuvenā saskaņošana, lai iegūtu labāku\n"
"diagnostiku.\n"

#: src/msgcmp.c:231
#, c-format
msgid "  def.po                      translations\n"
msgstr "  def.po                      tulkojumi\n"

#: src/msgcmp.c:233
#, c-format
msgid "  ref.pot                     references to the sources\n"
msgstr "  ref.pot                     atsauces uz avotiem\n"

