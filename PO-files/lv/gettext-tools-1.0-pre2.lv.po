#: src/xgettext.c:1059
#, c-format
msgid "warning: ITS rule file '%s' does not exist; check your gettext installation"
msgstr "brīdinājums: ITS noteikumu fails '%s' neeksistē; pārbaudiet savu gettext instalāciju"

#: src/xgettext.c:1077
#, c-format
msgid "warning: file '%s' extension '%s' is unknown; will try C"
msgstr "brīdinājums: faila '%s' paplašinājums '%s' nav zināms; tiks mēģināts C"

#: src/xgettext.c:1168
#, c-format
msgid "Extract translatable strings from given input files.\n"
msgstr "Izvilkt tulkojamās virknes no norādītajiem ievades failiem.\n"

#: src/xgettext.c:1191
#, c-format
msgid "  -d, --default-domain=NAME   use NAME.po for output (instead of messages.po)\n"
msgstr "  -d, --default-domain=NOSAUKUMS   lietot NOSAUKUMS.po izvadei (ziņas.po vietā)\n"

#: src/xgettext.c:1193
#, c-format
msgid "  -o, --output=FILE           write output to specified file\n"
msgstr "  -o, --output=FAILS           rakstīt izvadi norādītajā failā\n"

#: src/xgettext.c:1195
#, c-format
msgid "  -p, --output-dir=DIR        output files will be placed in directory DIR\n"
msgstr "  -p, --output-dir=DIR        izvades faili tiks ievietoti direktorijā DIR\n"

#: src/xgettext.c:1200
#, c-format
msgid "Choice of input file language:\n"
msgstr "Ievades faila valodas izvēle:\n"

#: src/xgettext.c:1202
#, c-format
msgid ""
"  -L, --language=NAME         recognise the specified language\n"
"                                (C, C++, ObjectiveC, PO, Python, Java,\n"
"                                JavaProperties, C#, JavaScript, TypeScript, TSX,\n"
"                                Scheme, Guile, Lisp, EmacsLisp, librep, Rust,\n"
"                                Go, Ruby, Shell, awk, Lua, Modula-2, D, OCaml,\n"
"                                Smalltalk, Vala, Tcl, Perl, PHP, GCC-source,\n"
"                                YCP, NXStringTable, RST, RSJ, Glade, GSettings,\n"
"                                Desktop)\n"
msgstr ""
"  -L, --language=VALODA         atpazīt norādīto valodu\n"
"                                (C, C++, ObjectiveC, PO, Python, Java,\n"
"                                JavaProperties, C#, JavaScript, TypeScript, TSX,\n"
"                                Scheme, Guile, Lisp, EmacsLisp, librep, Rust,\n"
"                                Go, Ruby, Shell, awk, Lua, Modula-2, D, OCaml,\n"
"                                Smalltalk, Vala, Tcl, Perl, PHP, GCC-source,\n"
"                                YCP, NXStringTable, RST, RSJ, Glade, GSettings,\n"
"                                Desktop)\n"

#: src/xgettext.c:1211
#, c-format
msgid "  -C, --c++                   shorthand for --language=C++\n"
msgstr "  -C, --c++                   saīsinājums opcijai --language=C++\n"

#: src/xgettext.c:1213
#, c-format
msgid "By default the language is guessed depending on the input file name extension.\n"
msgstr "Pēc noklusējuma valoda tiek noteikta atkarībā no ievades faila paplašinājuma.\n"

#: src/xgettext.c:1218
#, c-format
msgid ""
"      --from-code=NAME        encoding of input files\n"
"                                (except for Python, Tcl, Glade)\n"
msgstr ""
"    --from-code=NOSAUKUMS        ievades failu kodējums\n"
"                                (izņemot Python, Tcl, Glade)\n"

#: src/xgettext.c:1221
#, c-format
msgid "By default the input files are assumed to be in ASCII.\n"
msgstr "Pēc noklusējuma tiek pieņemts, ka ievades faili ir ASCII formātā.\n"

#: src/xgettext.c:1226
#, c-format
msgid "  -j, --join-existing         join messages with existing file\n"
msgstr "  -j, --join-existing         pievienot ziņojumus esošam failam\n"

#: src/xgettext.c:1228
#, c-format
msgid "  -x, --exclude-file=FILE.po  entries from FILE.po are not extracted\n"
msgstr "  -x, --exclude-file=FAILS.po  ieraksti no FAILS.po netiek izvilkti\n"

#: src/xgettext.c:1230
#, c-format
msgid ""
"  -cTAG, --add-comments=TAG   place comment blocks starting with TAG and\n"
"                                preceding keyword lines in output file\n"
"  -c, --add-comments          place all comment blocks preceding keyword lines\n"
"                                in output file\n"
msgstr ""
"  -cTAG, --add-comments=TAG   ievietot komentāru blokus, kas sākas ar TAG un\n"
"                                atrodas pirms atslēgvārdu rindām izvades failā\n"
"  -c, --add-comments          ievietot visus komentāru blokus, kas atrodas pirms\n"
"                                atslēgvārdu rindām izvades failā\n"

#: src/xgettext.c:1235
#, c-format
msgid ""
"      --check=NAME            perform syntax check on messages\n"
"                                (ellipsis-unicode, space-ellipsis,\n"
"                                 quote-unicode, bullet-unicode)\n"
msgstr ""
"      --check=NOSAUKUMS            veikt sintakses pārbaudi ziņojumiem\n"
"                                (ellipsis-unicode, space-ellipsis,\n"
"                                 quote-unicode, bullet-unicode)\n"

#: src/xgettext.c:1239
#, c-format
msgid ""
"      --no-check=NAME         don't perform syntax check on messages\n"
"                                (url, email)\n"
msgstr ""
"      --no-check=NOSAUKUMS          neveikt sintakses pārbaudi ziņojumiem\n"
"                                (url, email)\n"

#: src/xgettext.c:1242
#, c-format
msgid ""
"      --sentence-end=TYPE     type describing the end of sentence\n"
"                                (single-space, which is the default, \n"
"                                 or double-space)\n"
msgstr ""
"      --sentence-end=TIPS     tips, kas nosaka teikuma beigas\n"
"                                (single-space, kas ir noklusējums, \n"
"                                 vai double-space)\n"

#: src/xgettext.c:1247
#, c-format
msgid "Language specific options:\n"
msgstr "Valodas specifiskās opcijas:\n"

#: src/xgettext.c:1249
#, c-format
msgid "  -a, --extract-all           extract all strings\n"
msgstr "  -a, --extract-all           izvilkt visas virknes\n"

#: src/xgettext.c:1251
#, c-format
msgid ""
"                                (only languages C, C++, ObjectiveC, Python,\n"
