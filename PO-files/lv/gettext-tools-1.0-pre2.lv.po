msgstr "      --clear-fuzzy           noņemt 'fuzzy' atzīmi visiem ziņojumiem\n"

#: src/msgattrib.c:465
#, c-format
msgid "      --set-obsolete          set all messages obsolete\n"
msgstr "      --set-obsolete          atzīmēt visus ziņojumus kā novecojušus\n"

#: src/msgattrib.c:467
#, c-format
