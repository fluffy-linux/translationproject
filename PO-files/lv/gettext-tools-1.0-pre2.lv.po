msgstr "      --boost                 atpazīt Boost formāta virknes\n"

#: src/xgettext.c:1300
#, c-format
msgid "      --debug                 more detailed formatstring recognition result\n"
msgstr "      --debug                 detalizētāks formāta virkņu atpazīšanas rezultāts\n"

#: src/xgettext.c:1325
#, c-format
msgid "      --properties-output     write out a Java .properties file\n"
msgstr "      --properties-output     izvadīt Java .properties failu\n"

#: src/xgettext.c:1329
#, c-format
msgid "      --itstool               write out itstool comments\n"
msgstr "      --tstool               izvadīt itstool komentārus\n"

#: src/xgettext.c:1342
#, c-format
msgid ""
"      --no-git                don't use the git program to produce a\n"
"                              reproducible 'POT-Creation-Date' field in the\n"
"                              output.\n"
msgstr ""
"      --no-git                neizmantot git programmu, lai izveidotu\n"
"                              reproducējamu 'POT-Creation-Date' lauku\n"
"                              izvadē.\n"

#: src/xgettext.c:1346
#, c-format
msgid "      --copyright-holder=STRING  set copyright holder in output\n"
msgstr "      --copyright-holder=VIRKNE  norādīt autortiesību turētāju izvadē\n"

#: src/xgettext.c:1348
#, c-format
msgid "      --foreign-user          omit FSF copyright in output for foreign user\n"
msgstr "      --foreign-user          izlaist FSF autortiesības izvadē ārpusprojekta lietotājiem\n"

#: src/xgettext.c:1350
#, c-format
msgid "      --package-name=PACKAGE  set package name in output\n"
msgstr "      --package-name=PAKOTNE  norādīt pakotnes nosaukumu izvadē\n"

#: src/xgettext.c:1352
#, c-format
msgid "      --package-version=VERSION  set package version in output\n"
msgstr "      ----package-version=VERSIJA  norādīt pakotnes versiju izvadē\n"

#: src/xgettext.c:1354
#, c-format
msgid "      --msgid-bugs-address=EMAIL@ADDRESS  set report address for msgid bugs\n"
msgstr "      --msgid-bugs-address=EMAIL@ADDRESS  norādīt adresi ziņošanai par msgid kļūdām\n"

#: src/xgettext.c:1356
#, c-format
msgid ""
"      --generated=FILE        Declares that the given FILE is generated and\n"
"                              therefore should not have an influence on the\n"
"                              'POT-Creation-Date' field in the output.\n"
msgstr ""
"      --generated=FAILS        Norāda, ka dotais fails ir ģenerēts un\n"
"                              tāpēc tam nevajadzētu ietekmēt\n"
"                              'POT-Creation-Date' lauku izvadē.\n"

#: src/xgettext.c:1360
#, c-format
msgid ""
"      --reference=FILE        Declares that the output depends on the contents\n"
"                              of the given FILE.  This has an influence on the\n"
"                              'POT-Creation-Date' field in the output.\n"
msgstr ""
"      ----reference=FAILS        Norāda, ka izvade ir atkarīga no dotā\n"
"                              faila satura. Tas ietekmē\n"
"                              'POT-Creation-Date' lauku izvadē.\n"

#: src/xgettext.c:1364
#, c-format
msgid ""
"  -m[STRING], --msgstr-prefix[=STRING]  use STRING or \"\" as prefix for msgstr\n"
"                                values\n"
msgstr ""
"  -m[VIRKNE], --msgstr-prefix[=VIRKNE]  izmantot VIRKNI vai \"\" kā prefiksu msgstr\n"
"                                vērtībām\n"

#: src/xgettext.c:1367
#, c-format
msgid ""
"  -M[STRING], --msgstr-suffix[=STRING]  use STRING or \"\" as suffix for msgstr\n"
"                                values\n"
msgstr ""
"  -M[VIRKNE], --msgstr-suffix[=VIRKNE]  izmantot VIRKNI vai \"\" kā sufiksu msgstr\n"
"                                vērtībām\n"

#: src/xgettext.c:1877
#, c-format
