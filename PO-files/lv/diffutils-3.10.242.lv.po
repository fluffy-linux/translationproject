#: src/cmp.c:167
msgid "-b, --print-bytes          print differing bytes"
msgstr "-b, --print-bytes          izdrukāt atšķirīgos baitus"

#: src/cmp.c:168
msgid "-i, --ignore-initial=SKIP         skip first SKIP bytes of both inputs"
msgstr "-i, --ignore-initial=IZLAIST      izlaist abu ievažu pirmos IZLAIST baitus"

#: src/cmp.c:169
msgid ""
"-i, --ignore-initial=SKIP1:SKIP2  skip first SKIP1 bytes of FILE1 and\n"
"                                      first SKIP2 bytes of FILE2"
msgstr ""
"-i, --ignore-initial=IZLAIST1:IZLAIST2\n"
"                                    izlaist FAILA1 pirmos IZLAIST1 baitus un\n"
"                                    FAILA2 pirmos IZLAIST2 baitus"

#: src/cmp.c:171
msgid "-l, --verbose              output byte numbers and differing byte values"
msgstr "-l, --verbose              izvadīt baitu numurus un atšķirīgo baitu vērtības"

#: src/cmp.c:172
msgid "-n, --bytes=LIMIT          compare at most LIMIT bytes"
msgstr "-n, --bytes=ROBEŽA         salīdzināt ne vairāk kā ROBEŽA baitus"

#: src/cmp.c:173
msgid "-s, --quiet, --silent      suppress all normal output"
msgstr "-s, --quiet, --silent      apslāpēt visu parasto izvadi"

#: src/cmp.c:174
msgid "    --help                 display this help and exit"
msgstr "    --help                 parādīt šo palīdzību un iziet"

#: src/cmp.c:175
msgid "-v, --version              output version information and exit"
msgstr "-v, --version              izvadīt versijas informāciju un iziet"

#: src/cmp.c:182
#, c-format
msgid "Usage: %s [OPTION]... FILE1 [FILE2 [SKIP1 [SKIP2]]]\n"
msgstr "Lietošana: %s [OPCIJA]... FAILS1 [FAILS2 [IZLAIST1 [IZLAIST2]]]\n"

#: src/cmp.c:184
msgid "Compare two files byte by byte."
msgstr "Salīdzināt divus failus baitu pa baitam."

#: src/cmp.c:186
msgid ""
"The optional SKIP1 and SKIP2 specify the number of bytes to skip\n"
"at the beginning of each file (zero by default)."
msgstr ""
"Neobligātie IZLAIST1 un IZLAIST2 norāda baitu skaitu, kas tiks izlaisti\n"
"katra faila sākumā (pēc noklusējuma nulle)."

#: src/cmp.c:189 src/diff.c:1070 src/diff3.c:459 src/sdiff.c:211
msgid "Mandatory arguments to long options are mandatory for short options too.\n"
msgstr "Obligātie argumenti garajām opcijām ir obligāti arī īsajām opcijām.\n"

#: src/cmp.c:195
msgid ""
"SKIP values may be followed by the following multiplicative suffixes:\n"
"kB 1000, K 1024, MB 1,000,000, M 1,048,576,\n"
"GB 1,000,000,000, G 1,073,741,824, and so on for T, P, E, Z, Y."
msgstr ""
"IZLAIST vērtībām var sekot šādi reizināšanas piedēkļi:\n"
"kB 1000, K 1024, MB 1 000 000, M 1 048 576,\n"
"GB 1 000 000 000, G 1 073 741 824 un tā tālāk ar T, P, E, Z, Y."

#: src/cmp.c:198
msgid "If a FILE is '-' or missing, read standard input."
msgstr "Ja FAILS ir '-' vai nav norādīts, tiek lasīta standarta ievade."

#: src/cmp.c:199 src/diff.c:1060 src/sdiff.c:221
msgid "Exit status is 0 if inputs are the same, 1 if different, 2 if trouble."
msgstr "Izpildes statuss ir 0, ja ievades ir vienādas, 1 — ja atšķiras, 2 — ja radās problēmas."

