msgid "    --normal                  output a normal diff (the default)"
msgstr "    --normal                  izvadīt parastu starpību (noklusējums)"

#: src/diff.c:967
msgid "-q, --brief                   report only when files differ"
msgstr "-q, --brief                   ziņot tikai tad, ja faili atšķiras"

#: src/diff.c:968
msgid "-s, --report-identical-files  report when two files are the same"
msgstr "-s, --report-identical-files  ziņot, ja divi faili ir vienādi"

#: src/diff.c:969
msgid "-c, -C NUM, --context[=NUM]   output NUM (default 3) lines of copied context"
msgstr ""
"-c, -C SK, --context[=SK]     izvadīt SK (noklusējums 3) kopētā konteksta\n"
"                              rindas"

#: src/diff.c:970
msgid "-u, -U NUM, --unified[=NUM]   output NUM (default 3) lines of unified context"
msgstr ""
"-u, -U SK, --unified[=SK]     izvadīt SK (noklusējums 3) apvienotā konteksta\n"
"                              rindas"

#: src/diff.c:971
msgid "-e, --ed                      output an ed script"
msgstr "-e, --ed                      izvadīt ed skriptu"

#: src/diff.c:972
msgid "-n, --rcs                     output an RCS format diff"
msgstr "-n, --rcs                     izvadīt RCS formāta starpību"

#: src/diff.c:973
msgid "-y, --side-by-side            output in two columns"
msgstr "-y, --side-by-side            izvadīt divās kolonnās"

#: src/diff.c:974
msgid "-W, --width=NUM               output at most NUM (default 130) print columns"
msgstr "-W, --width=SK                izvadīt līdz SK kolonnām (noklusējums 130)"

#: src/diff.c:975
msgid "    --left-column             output only the left column of common lines"
msgstr "    --left-column             kopīgajām rindām izvadīt tikai kreiso kolonnu"

#: src/diff.c:976
msgid "    --suppress-common-lines   do not output common lines"
msgstr "    --suppress-common-lines   neizvadīt kopīgās rindas"

#: src/diff.c:978
msgid "-p, --show-c-function         show which C function each change is in"
msgstr "-p, --show-c-function         rādīt, kurā C funkcijā ir katra izmaiņa"

#: src/diff.c:979
msgid "-F, --show-function-line=RE   show the most recent line matching RE"
msgstr "-F, --show-function-line=RI   rādīt pēdējo rindu, kas atbilst RI"

#: src/diff.c:980
msgid ""
"    --label LABEL             use LABEL instead of file name and timestamp\n"
"                                (can be repeated)"
msgstr ""
"    --label ETIĶETE           izmantot ETIĶETI faila nosaukuma un\n"
"                                laikspiedola vietā (var atkārtot)"

#: src/diff.c:983
msgid "-t, --expand-tabs             expand tabs to spaces in output"
msgstr "-t, --expand-tabs             izvadē izvērst tabulācijas atstarpēs"

#: src/diff.c:984
msgid "-T, --initial-tab             make tabs line up by prepending a tab"
msgstr "-T, --initial-tab             izlīdzināt tabulācijas ar sākuma tabulāciju"

#: src/diff.c:985
msgid "    --tabsize=NUM             tab stops every NUM (default 8) print columns"
msgstr "    --tabsize=SK              tabulācijas ik pēc SK kolonnām (noklusējums 8)"

#: src/diff.c:986
msgid "    --suppress-blank-empty    suppress space or tab before empty output lines"
msgstr ""
"    --suppress-blank-empty    neizvadīt atstarpi vai tabulāciju pirms\n"
"                              tukšām izvades rindām"

#: src/diff.c:987
msgid "-l, --paginate                pass output through 'pr' to paginate it"
msgstr "-l, --paginate                sadalīt izvadi lappusēs ar 'pr'"

#: src/diff.c:989
msgid "-r, --recursive                 recursively compare any subdirectories found"
msgstr "-r, --recursive                 rekursīvi salīdzināt apakšdirektorijas"

#: src/diff.c:990
msgid "    --no-dereference            don't follow symbolic links"
msgstr "    --no-dereference            nesekot simboliskajām saitēm"

#: src/diff.c:991
msgid "-N, --new-file                  treat absent files as empty"
msgstr "-N, --new-file                  uzskatīt neesošus failus par tukšiem"

#: src/diff.c:992
msgid "    --unidirectional-new-file   treat absent first files as empty"
msgstr "    --unidirectional-new-file   uzskatīt neesošus pirmos failus par tukšiem"

#: src/diff.c:993
msgid "    --ignore-file-name-case     ignore case when comparing file names"
msgstr "    --ignore-file-name-case     ignorēt reģistru failu nosaukumos"

#: src/diff.c:994
msgid "    --no-ignore-file-name-case  consider case when comparing file names"
msgstr "    --no-ignore-file-name-case  ņemt vērā reģistru failu nosaukumos"

#: src/diff.c:995
msgid "-x, --exclude=PAT               exclude files that match PAT"
msgstr "-x, --exclude=ŠABL              izslēgt failus, kas atbilst ŠABL"

#: src/diff.c:996
msgid "-X, --exclude-from=FILE         exclude files that match any pattern in FILE"
msgstr "-X, --exclude-from=FAILS        izslēgt failus, kas atbilst šablonam FAILĀ"

#: src/diff.c:997
msgid "-S, --starting-file=FILE        start with FILE when comparing directories"
msgstr "-S, --starting-file=FAILS       salīdzinot direktorijas, sākt ar FAILU"

#: src/diff.c:998
msgid ""
"    --from-file=FILE1           compare FILE1 to all operands;\n"
"                                  FILE1 can be a directory"
msgstr ""
"    --from-file=FAILS1          salīdzināt FAILU1 ar visiem operandiem;\n"
"                                  FAILS1 var būt direktorija"

#: src/diff.c:1000
msgid ""
"    --to-file=FILE2             compare all operands to FILE2;\n"
"                                  FILE2 can be a directory"
msgstr ""
"    --to-file=FAILS2            salīdzināt visus operandus ar FAILU2;\n"
"                                  FAILS2 var būt direktorija"

#: src/diff.c:1003
msgid "-i, --ignore-case               ignore case differences in file contents"
msgstr "-i, --ignore-case               ignorēt reģistra atšķirības failu saturā"

#: src/diff.c:1004
msgid "-E, --ignore-tab-expansion      ignore changes due to tab expansion"
msgstr "-E, --ignore-tab-expansion      ignorēt izmaiņas, ko rada tabulāciju izvēršana"

#: src/diff.c:1005
msgid "-Z, --ignore-trailing-space     ignore white space at line end"
msgstr "-Z, --ignore-trailing-space     ignorēt atstarpes rindu beigās"

#: src/diff.c:1006
msgid "-b, --ignore-space-change       ignore changes in the amount of white space"
msgstr "-b, --ignore-space-change       ignorēt atstarpju daudzuma izmaiņas"

#: src/diff.c:1007
msgid "-w, --ignore-all-space          ignore all white space"
msgstr "-w, --ignore-all-space          ignorēt visas atstarpes"

#: src/diff.c:1008
msgid "-B, --ignore-blank-lines        ignore changes where lines are all blank"
msgstr "-B, --ignore-blank-lines        ignorēt izmaiņas, kurās visas rindas ir tukšas"

#: src/diff.c:1009
msgid "-I, --ignore-matching-lines=RE  ignore changes where all lines match RE"
msgstr "-I, --ignore-matching-lines=RI  ignorēt izmaiņas, kur visas rindas atbilst RI"

#: src/diff.c:1011
msgid "-a, --text                      treat all files as text"
msgstr "-a, --text                      uzskatīt visus failus par teksta failiem"

#: src/diff.c:1012
msgid "    --strip-trailing-cr         strip trailing carriage return on input"
msgstr "    --strip-trailing-cr         ievadē noņemt rindu beigu CR rakstzīmes"

#: src/diff.c:1014
msgid "    --binary                    read and write data in binary mode"
msgstr "    --binary                    lasīt un rakstīt datus binārajā režīmā"

#: src/diff.c:1017
msgid "-D, --ifdef=NAME                output merged file with '#ifdef NAME' diffs"
msgstr ""
"-D, --ifdef=NOSAUKUMS           izvadīt apvienotu failu ar '#ifdef NOSAUKUMS'\n"
"                                atšķirībām"

#: src/diff.c:1018
msgid "    --GTYPE-group-format=GFMT   format GTYPE input groups with GFMT"
msgstr "    --GTYPE-group-format=GFMT   formatēt GTYPE ievades grupas ar GFMT"

#: src/diff.c:1019
msgid "    --line-format=LFMT          format all input lines with LFMT"
msgstr "    --line-format=LFMT          formatēt visas ievades rindas ar LFMT"

#: src/diff.c:1020
msgid "    --LTYPE-line-format=LFMT    format LTYPE input lines with LFMT"
msgstr "    --LTYPE-line-format=LFMT    formatēt LTYPE ievades rindas ar LFMT"

#: src/diff.c:1021
msgid ""
"  These format options provide fine-grained control over the output\n"
"    of diff, generalizing -D/--ifdef."
msgstr ""
"  Šīs formāta opcijas sniedz precīzu kontroli pār diff izvadi,\n"
"    vispārinot -D/--ifdef."

#: src/diff.c:1023
msgid "  LTYPE is 'old', 'new', or 'unchanged'.  GTYPE is LTYPE or 'changed'."
msgstr "  LTYPE ir 'old', 'new' vai 'unchanged'.  GTYPE ir LTYPE vai 'changed'."

#: src/diff.c:1024
msgid ""
"  GFMT (only) may contain:\n"
"    %<  lines from FILE1\n"
"    %>  lines from FILE2\n"
"    %=  lines common to FILE1 and FILE2\n"
"    %[-][WIDTH][.[PREC]]{doxX}LETTER  printf-style spec for LETTER\n"
"      LETTERs are as follows for new group, lower case for old group:\n"
"        F  first line number\n"
"        L  last line number\n"
"        N  number of lines = L-F+1\n"
"        E  F-1\n"
"        M  L+1\n"
"    %(A=B?T:E)  if A equals B then T else E"
msgstr ""
"  GFMT (tikai) var saturēt:\n"
"    %<  rindas no FAILA1\n"
"    %>  rindas no FAILA2\n"
"    %=  FAILAM1 un FAILAM2 kopīgās rindas\n"
"    %[-][PLATUMS][.[PREC]]{doxX}BURTS  printf stila specifikācija BURTAM\n"
"      BURTI ir šādi jaunajai grupai, mazie burti — vecajai grupai:\n"
"        F  pirmās rindas numurs\n"
"        L  pēdējās rindas numurs\n"
"        N  rindu skaits = L-F+1\n"
"        E  F-1\n"
"        M  L+1\n"
"    %(A=B?T:E)  ja A ir vienāds ar B, tad T, citādi E"

#: src/diff.c:1036
msgid ""
"  LFMT (only) may contain:\n"
"    %L  contents of line\n"
"    %l  contents of line, excluding any trailing newline\n"
"    %[-][WIDTH][.[PREC]]{doxX}n  printf-style spec for input line number"
msgstr ""
"  LFMT (tikai) var saturēt:\n"
"    %L  rindas saturs\n"
"    %l  rindas saturs bez beigu jaunās rindas rakstzīmes\n"
"    %[-][PLATUMS][.[PREC]]{doxX}n  printf stila ievades rindas numuram"

#: src/diff.c:1040
msgid ""
"  Both GFMT and LFMT may contain:\n"
"    %%  %\n"
"    %c'C'  the single character C\n"
"    %c'\\OOO'  the character with octal code OOO\n"
"    C    the character C (other characters represent themselves)"
msgstr ""
"  Gan GFMT, gan LFMT var saturēt:\n"
"    %%  %\n"
"    %c'C'  viena rakstzīme C\n"
"    %c'\\OOO'  rakstzīme ar astoņnieku kodu OOO\n"
"    C    rakstzīme C (citas rakstzīmes attēlo pašas sevi)"

#: src/diff.c:1046
msgid "-d, --minimal            try hard to find a smaller set of changes"
msgstr "-d, --minimal            censties atrast mazāku izmaiņu kopu"

#: src/diff.c:1047
msgid "    --horizon-lines=NUM  keep NUM lines of the common prefix and suffix"
msgstr "    --horizon-lines=SK   saglabāt SK kopīgā priedēkļa un piedēkļa rindas"

#: src/diff.c:1048
msgid "    --speed-large-files  assume large files and many scattered small changes"
msgstr ""
"    --speed-large-files  pieņemt, ka faili ir lieli ar daudzām izkaisītām\n"
"                         nelielām izmaiņām"

#: src/diff.c:1049
msgid ""
"    --color[=WHEN]       color output; WHEN is 'never', 'always', or 'auto';\n"
"                           plain --color means --color='auto'"
msgstr ""
"    --color[=KAD]        krāsaina izvade; KAD ir 'never', 'always' vai 'auto';\n"
"                           vienkārši --color nozīmē --color='auto'"

#: src/diff.c:1051
msgid ""
"    --palette=PALETTE    the colors to use when --color is active; PALETTE is\n"
"                           a colon-separated list of terminfo capabilities"
msgstr ""
"    --palette=PALETE     krāsas, ko izmantot, ja --color ir aktīvs; PALETE ir\n"
"                           ar koliem atdalīts terminfo iespēju saraksts"

#: src/diff.c:1054
msgid "    --help               display this help and exit"
msgstr "    --help               parādīt šo palīdzību un iziet"

#: src/diff.c:1055
msgid "-v, --version            output version information and exit"
msgstr "-v, --version            izvadīt versijas informāciju un iziet"

#: src/diff.c:1057
msgid "FILES are 'FILE1 FILE2' or 'DIR1 DIR2' or 'DIR FILE' or 'FILE DIR'."
msgstr "FAILI ir 'FAILS1 FAILS2', 'DIR1 DIR2', 'DIR FAILS' vai 'FAILS DIR'."

#: src/diff.c:1058
msgid "If --from-file or --to-file is given, there are no restrictions on FILE(s)."
msgstr "Ja ir norādīts --from-file vai --to-file, FAILIEM nav ierobežojumu."

#: src/diff.c:1059 src/diff3.c:478 src/sdiff.c:220
msgid "If a FILE is '-', read standard input."
msgstr "Ja FAILS ir '-', tiek lasīta standarta ievade."

#: src/diff.c:1067
#, c-format
msgid "Usage: %s [OPTION]... FILES\n"
msgstr "Lietošana: %s [OPCIJA]... FAILI\n"

#: src/diff.c:1068
msgid "Compare FILES line by line."
msgstr "Salīdzināt FAILUS rindu pa rindai."

#: src/diff.c:1102
#, c-format
msgid "conflicting %s option value %s"
msgstr "konfliktējoša %s opcijas vērtība %s"

#: src/diff.c:1115
#, c-format
msgid "conflicting output style options"
msgstr "konfliktējošas izvades stila opcijas"

#: src/diff.c:1131
#, c-format
msgid "invalid color %s"
msgstr "nederīga krāsa %s"

#: src/diff.c:1192
msgid "-D option not supported with directories"
msgstr "-D opcija netiek atbalstīta direktorijām"

#: src/diff.c:1199
#, c-format
msgid "Common subdirectories: %s and %s\n"
msgstr "Kopējās apakšdirektorijas: %s un %s\n"

#: src/diff.c:1216 src/diff.c:1402
#, c-format
msgid "Only in %s: %s\n"
msgstr "Tikai direktorijā %s: %s\n"

#: src/diff.c:1235
#, c-format
msgid "File %s is a %s while file %s is a %s\n"
msgstr "Fails %s ir %s, bet fails %s ir %s\n"

#: src/diff.c:1281
#, c-format
msgid "Symbolic links %s -> %s and %s -> %s differ\n"
msgstr "Simboliskās saites %s -> %s un %s -> %s atšķiras\n"

#: src/diff.c:1564
msgid "cannot compare '-' to a directory"
msgstr "nevar salīdzināt '-' ar direktoriju"

#: src/diff.c:1651
#, c-format
msgid "Files %s and %s are identical\n"
msgstr "Faili %s un %s ir identiski\n"

#: src/diff3.c:53
msgid "Randy Smith"
msgstr "Randy Smith"

#: src/diff3.c:323
#, c-format
msgid "incompatible options"
msgstr "nesaderīgas opcijas"

#: src/diff3.c:363
msgid "'-' specified for more than one input file"
msgstr "'-' norādīts vairāk nekā vienam ievades failam"

#: src/diff3.c:405 src/diff3.c:1183 src/diff3.c:1569 src/diff3.c:1625
#: src/sdiff.c:307 src/sdiff.c:831 src/sdiff.c:841
msgid "read failed"
msgstr "nolasīšana neizdevās"

#: src/diff3.c:427
msgid "-A, --show-all              output all changes, bracketing conflicts"
msgstr "-A, --show-all              izvadīt visas izmaiņas, konfliktus liekot iekavās"

#: src/diff3.c:429
msgid ""
"-e, --ed                    output ed script incorporating changes\n"
"                                from OLDFILE to YOURFILE into MYFILE"
msgstr ""
"-e, --ed                    izvadīt ed skriptu, kas iekļauj izmaiņas\n"
"                                no VECAISFAILS līdz JŪSUFAILS failā MANSFAILS"

#: src/diff3.c:431
msgid "-E, --show-overlap          like -e, but bracket conflicts"
msgstr "-E, --show-overlap          kā -e, bet konfliktus likt iekavās"

#: src/diff3.c:432
msgid "-3, --easy-only             like -e, but incorporate only nonoverlapping changes"
msgstr "-3, --easy-only             kā -e, bet iekļaut tikai nepārklājošās izmaiņas"

#: src/diff3.c:433
msgid "-x, --overlap-only          like -e, but incorporate only overlapping changes"
msgstr "-x, --overlap-only          kā -e, bet iekļaut tikai pārklājošās izmaiņas"

#: src/diff3.c:434
msgid "-X                          like -x, but bracket conflicts"
msgstr "-X                          kā -x, bet konfliktus likt iekavās"

#: src/diff3.c:435
msgid "-i                          append 'w' and 'q' commands to ed scripts"
msgstr "-i                          pievienot ed skriptiem komandas 'w' un 'q'"

#: src/diff3.c:437
msgid ""
"-m, --merge                 output actual merged file, according to\n"
"                                -A if no other options are given"
msgstr ""
"-m, --merge                 izvadīt faktisko apvienoto failu atbilstoši\n"
"                                -A, ja nav norādītas citas opcijas"

#: src/diff3.c:440
msgid "-a, --text                  treat all files as text"
msgstr "-a, --text                  uzskatīt visus failus par teksta failiem"

#: src/diff3.c:441
msgid "    --strip-trailing-cr     strip trailing carriage return on input"
msgstr "    --strip-trailing-cr     ievadē noņemt rindu beigu CR rakstzīmes"

#: src/diff3.c:442
msgid "-T, --initial-tab           make tabs line up by prepending a tab"
msgstr "-T, --initial-tab           izlīdzināt tabulācijas ar sākuma tabulāciju"

#: src/diff3.c:443
msgid "    --diff-program=PROGRAM  use PROGRAM to compare files"
msgstr "    --diff-program=PROGRAMMA  izmantot PROGRAMMU failu salīdzināšanai"

#: src/diff3.c:444
msgid ""
"-L, --label=LABEL           use LABEL instead of file name\n"
"                                (can be repeated up to three times)"
msgstr ""
"-L, --label=ETIĶETE         faila nosaukuma vietā izmantot ETIĶETI\n"
"                                (var atkārtot līdz trim reizēm)"

#: src/diff3.c:447
msgid "    --help                  display this help and exit"
msgstr "    --help                  parādīt šo palīdzību un iziet"

#: src/diff3.c:448
msgid "-v, --version               output version information and exit"
msgstr "-v, --version               izvadīt versijas informāciju un iziet"

#: src/diff3.c:455
#, c-format
msgid "Usage: %s [OPTION]... MYFILE OLDFILE YOURFILE\n"
msgstr "Lietošana: %s [OPCIJA]... MANSFAILS VECAISFAILS JŪSUFAILS\n"

#: src/diff3.c:457
msgid "Compare three files line by line."
msgstr "Salīdzināt trīs failus rindu pa rindai."

#: src/diff3.c:467
msgid ""
"\n"
"The default output format is a somewhat human-readable representation of\n"
"the changes.\n"
"\n"
"The -e, -E, -x, -X (and corresponding long) options cause an ed script\n"
"to be output instead of the default.\n"
"\n"
"Finally, the -m (--merge) option causes diff3 to do the merge internally\n"
"and output the actual merged file.  For unusual input, this is more\n"
"robust than using ed.\n"
msgstr ""
"\n"
"Noklusētais izvades formāts ir cilvēkam diezgan viegli lasāms izmaiņu\n"
"attēlojums.\n"
"\n"
"Opcijas -e, -E, -x, -X (un atbilstošās garās opcijas) liek noklusētā\n"
"formāta vietā izvadīt ed skriptu.\n"
"\n"
"Visbeidzot, opcija -m (--merge) liek diff3 veikt apvienošanu pašam\n"
"un izvadīt faktisko apvienoto failu.  Neparastai ievadei tas ir\n"
"uzticamāk nekā ed izmantošana.\n"

#: src/diff3.c:479
msgid "Exit status is 0 if successful, 1 if conflicts, 2 if trouble."
msgstr "Izpildes statuss ir 0, ja izdevās, 1 — ja ir konflikti, 2 — ja radās problēmas."

#: src/diff3.c:648
msgid "internal error: screwup in format of diff blocks"
msgstr "iekšējā kļūda: kļūme diff bloku formātā"

#: src/diff3.c:924
#, c-format
msgid "%s: diff failed: "
msgstr "%s: diff neizdevās: "

#: src/diff3.c:946
msgid "internal error: invalid diff type in process_diff"
msgstr "iekšējā kļūda: nederīgs diff tips funkcijā process_diff"

#: src/diff3.c:969
msgid "invalid diff format; invalid change separator"
msgstr "nederīgs diff formāts; nederīgs izmaiņu atdalītājs"

#: src/diff3.c:1190
msgid "invalid diff format; incomplete last line"
msgstr "nederīgs diff formāts; nepilnīga pēdējā rinda"

#: src/diff3.c:1217 src/sdiff.c:275 src/util.c:920
#, c-format
msgid "subsidiary program %s could not be invoked"
msgstr "palīgprogrammu %s nevarēja izsaukt"

#: src/diff3.c:1240
msgid "invalid diff format; incorrect leading line chars"
msgstr "nederīgs diff formāts; nepareizas rindu sākuma rakstzīmes"

#: src/diff3.c:1308
msgid "internal error: invalid diff type passed to output"
msgstr "iekšējā kļūda: izvadei nodots nederīgs diff tips"

#: src/diff3.c:1571 src/diff3.c:1629
msgid "input file shrank"
msgstr "ievades fails saruka"

#: src/dir.c:194
#, c-format
msgid "cannot compare file names %s and %s"
msgstr "neizdevās salīdzināt failu nosaukumus %s un %s"

#: src/dir.c:246
#, c-format
msgid "%s: recursive directory loop"
msgstr "%s: rekursīvs direktoriju cikls"

#: src/sdiff.c:46
msgid "Thomas Lord"
msgstr "Thomas Lord"

#: src/sdiff.c:176
msgid "-o, --output=FILE            operate interactively, sending output to FILE"
msgstr "-o, --output=FAILS           darboties interaktīvi, sūtot izvadi uz FAILU"

#: src/sdiff.c:178
msgid "-i, --ignore-case            consider upper- and lower-case to be the same"
msgstr "-i, --ignore-case            uzskatīt lielos un mazos burtus par vienādiem"

#: src/sdiff.c:179
msgid "-E, --ignore-tab-expansion   ignore changes due to tab expansion"
msgstr "-E, --ignore-tab-expansion   ignorēt izmaiņas, ko rada tabulāciju izvēršana"

#: src/sdiff.c:180
msgid "-Z, --ignore-trailing-space  ignore white space at line end"
msgstr "-Z, --ignore-trailing-space  ignorēt atstarpes rindu beigās"

#: src/sdiff.c:181
msgid "-b, --ignore-space-change    ignore changes in the amount of white space"
msgstr "-b, --ignore-space-change    ignorēt atstarpju daudzuma izmaiņas"

#: src/sdiff.c:182
msgid "-W, --ignore-all-space       ignore all white space"
msgstr "-W, --ignore-all-space       ignorēt visas atstarpes"

#: src/sdiff.c:183
msgid "-B, --ignore-blank-lines     ignore changes whose lines are all blank"
msgstr "-B, --ignore-blank-lines     ignorēt izmaiņas, kurās visas rindas ir tukšas"

#: src/sdiff.c:184
msgid "-I, --ignore-matching-lines=RE  ignore changes all whose lines match RE"
msgstr "-I, --ignore-matching-lines=RI  ignorēt izmaiņas, kur visas rindas atbilst RI"

#: src/sdiff.c:185
msgid "    --strip-trailing-cr      strip trailing carriage return on input"
msgstr "    --strip-trailing-cr      ievadē noņemt rindu beigu CR rakstzīmes"

#: src/sdiff.c:186
msgid "-a, --text                   treat all files as text"
msgstr "-a, --text                   uzskatīt visus failus par teksta failiem"

#: src/sdiff.c:188
msgid "-w, --width=NUM              output at most NUM (default 130) print columns"
msgstr "-w, --width=SK               izvadīt līdz SK kolonnām (noklusējums 130)"

#: src/sdiff.c:189
msgid "-l, --left-column            output only the left column of common lines"
msgstr "-l, --left-column            kopīgajām rindām izvadīt tikai kreiso kolonnu"

#: src/sdiff.c:190
msgid "-s, --suppress-common-lines  do not output common lines"
msgstr "-s, --suppress-common-lines  neizvadīt kopīgās rindas"

#: src/sdiff.c:192
msgid "-t, --expand-tabs            expand tabs to spaces in output"
msgstr "-t, --expand-tabs            izvadē izvērst tabulācijas atstarpēs"

#: src/sdiff.c:193
msgid "    --tabsize=NUM            tab stops at every NUM (default 8) print columns"
msgstr "    --tabsize=SK             tabulācijas ik pēc SK kolonnām (noklusējums 8)"

#: src/sdiff.c:195
msgid "-d, --minimal                try hard to find a smaller set of changes"
msgstr "-d, --minimal                censties atrast mazāku izmaiņu kopu"

#: src/sdiff.c:196
msgid "-H, --speed-large-files      assume large files, many scattered small changes"
msgstr "-H, --speed-large-files      pieņemt lielus failus ar daudzām sīkām izmaiņām"

#: src/sdiff.c:197
msgid "    --diff-program=PROGRAM   use PROGRAM to compare files"
msgstr "    --diff-program=PROGRAMMA  izmantot PROGRAMMU failu salīdzināšanai"

#: src/sdiff.c:199
msgid "    --help                   display this help and exit"
msgstr "    --help                   parādīt šo palīdzību un iziet"

#: src/sdiff.c:200
msgid "-v, --version                output version information and exit"
msgstr "-v, --version                izvadīt versijas informāciju un iziet"

#: src/sdiff.c:207
#, c-format
msgid "Usage: %s [OPTION]... FILE1 FILE2\n"
msgstr "Lietošana: %s [OPCIJA]... FAILS1 FAILS2\n"

#: src/sdiff.c:209
msgid "Side-by-side merge of differences between FILE1 and FILE2."
msgstr "FAILA1 un FAILA2 atšķirību apvienošana blakus kolonnās."

#: src/sdiff.c:329
msgid "cannot interactively merge standard input"
msgstr "nevar interaktīvi apvienot standarta ievadi"

#: src/sdiff.c:585
msgid "both files to be compared are directories"
msgstr "abi salīdzināmie faili ir direktorijas"

#: src/sdiff.c:805
msgid ""
"ed:\tEdit then use both versions, each decorated with a header.\n"
"eb:\tEdit then use both versions.\n"
"el or e1:\tEdit then use the left version.\n"
"er or e2:\tEdit then use the right version.\n"
"e:\tDiscard both versions then edit a new one.\n"
"l or 1:\tUse the left version.\n"
"r or 2:\tUse the right version.\n"
"s:\tSilently include common lines.\n"
"v:\tVerbosely include common lines.\n"
"q:\tQuit.\n"
msgstr ""
"ed:\tRediģēt, tad izmantot abas versijas, katru ar galveni.\n"
"eb:\tRediģēt, tad izmantot abas versijas.\n"
"el vai e1:\tRediģēt, tad izmantot kreiso versiju.\n"
"er vai e2:\tRediģēt, tad izmantot labo versiju.\n"
"e:\tAtmest abas versijas un rediģēt jaunu.\n"
"l vai 1:\tIzmantot kreiso versiju.\n"
"r vai 2:\tIzmantot labo versiju.\n"
"s:\tIekļaut kopīgās rindas klusi.\n"
"v:\tIekļaut kopīgās rindas, tās parādot.\n"
"q:\tIziet.\n"

#: src/util.c:727
#, c-format
msgid "unrecognized prefix: %s"
msgstr "neatpazīts priedēklis: %s"

#: src/util.c:748
#, c-format
msgid "unparsable value for --palette"
msgstr "neparsējama --palette vērtība"

