msgstr "Lietošana: %s [OPCIJA]... FAILS\n"

#: src/getargs.c:365
msgid ""
"Generate a deterministic LR or generalized LR (GLR) parser employing\n"
"LALR(1), IELR(1), or canonical LR(1) parser tables.\n"
"\n"
msgstr ""
"Ģenerēt deterministisku LR vai vispārināto LR (GLR) parsētāju, izmantojot\n"
"LALR(1), IELR(1) vai kanoniskās LR(1) parsētāja tabulas.\n"
"\n"

#: src/getargs.c:371
msgid "Mandatory arguments to long options are mandatory for short options too.\n"
msgstr "Obligātie argumenti garajām opcijām ir obligāti arī īsajām opcijām.\n"

#: src/getargs.c:374
msgid "The same is true for optional arguments.\n"
msgstr "Tas pats attiecas uz neobligātajiem argumentiem.\n"

#: src/getargs.c:379
msgid ""
"Operation Modes:\n"
"  -h, --help                 display this help and exit\n"
"  -V, --version              output version information and exit\n"
"      --print-localedir      output directory containing locale-dependent data\n"
"                             and exit\n"
"      --print-datadir        output directory containing skeletons and XSLT\n"
"                             and exit\n"
"  -u, --update               apply fixes to the source grammar file and exit\n"
"  -f, --feature[=FEATURES]   activate miscellaneous features\n"
"\n"
msgstr ""
"Darbības režīmi:\n"
"  -h, --help                 parādīt šo palīdzību un iziet\n"
"  -V, --version              izvadīt versijas informāciju un iziet\n"
"      --print-localedir      izvadīt direktoriju ar no lokāles atkarīgajiem\n"
"                             datiem un iziet\n"
"      --print-datadir        izvadīt direktoriju ar skeletiem un XSLT\n"
"                             un iziet\n"
"  -u, --update               veikt labojumus gramatikas avota failā un iziet\n"
"  -f, --feature[=LĪDZEKĻI]   aktivizēt dažādus līdzekļus\n"
"\n"

#: src/getargs.c:395
msgid ""
"Diagnostics:\n"
"  -W, --warnings[=CATEGORY]  report the warnings falling in CATEGORY\n"
"      --color[=WHEN]         whether to colorize the diagnostics\n"
"      --style=FILE           specify the CSS FILE for colorizer diagnostics\n"
"\n"
msgstr ""
"Diagnostika:\n"
"  -W, --warnings[=KATEGORIJA]\n"
"                             ziņot par KATEGORIJAS brīdinājumiem\n"
"      --color[=KAD]          vai iekrāsot diagnostiku\n"
"      --style=FAILS          norādīt CSS FAILU diagnostikas iekrāsošanai\n"
"\n"

#: src/getargs.c:409
#, c-format
msgid ""
"Tuning the Parser:\n"
"  -L, --language=LANGUAGE          specify the output programming language\n"
"  -S, --skeleton=FILE              specify the skeleton to use\n"
"  -t, --debug                      instrument the parser for tracing\n"
"                                   same as '-Dparse.trace'\n"
"      --locations                  enable location support\n"
"  -D, --define=NAME[=VALUE]        similar to '%define NAME VALUE'\n"
"  -F, --force-define=NAME[=VALUE]  override '%define NAME VALUE'\n"
"  -p, --name-prefix=PREFIX         prepend PREFIX to the external symbols\n"
"                                   deprecated by '-Dapi.prefix={PREFIX}'\n"
"  -l, --no-lines                   don't generate '#line' directives\n"
"  -k, --token-table                include a table of token names\n"
"  -y, --yacc                       emulate POSIX Yacc\n"
msgstr ""
"Parsētāja pielāgošana:\n"
"  -L, --language=VALODA            norādīt izvades programmēšanas valodu\n"
"  -S, --skeleton=FAILS             norādīt izmantojamo skeletu\n"
"  -t, --debug                      instrumentēt parsētāju izsekošanai,\n"
"                                   tas pats, kas '-Dparse.trace'\n"
"      --locations                  iespējot atrašanās vietu atbalstu\n"
"  -D, --define=NOSAUKUMS[=VĒRTĪBA]\n"
"                                   līdzīgi kā '%define NOSAUKUMS VĒRTĪBA'\n"
"  -F, --force-define=NOSAUKUMS[=VĒRTĪBA]\n"
"                                   aizstāt '%define NOSAUKUMS VĒRTĪBA'\n"
"  -p, --name-prefix=PRIEDĒKLIS     pievienot PRIEDĒKLI ārējo simbolu sākumā\n"
"                                   novecojis, lietot '-Dapi.prefix={PRIEDĒKLIS}'\n"
"  -l, --no-lines                   neģenerēt '#line' direktīvas\n"
"  -k, --token-table                iekļaut marķieru nosaukumu tabulu\n"
"  -y, --yacc                       emulēt POSIX Yacc\n"

#: src/getargs.c:426
msgid ""
"Output Files:\n"
"  -H, --header=[FILE]           also produce a header file\n"
"  -d                            likewise but cannot specify FILE (for POSIX Yacc)\n"
"  -r, --report=THINGS           also produce details on the automaton\n"
"      --report-file=FILE        write report to FILE\n"
"  -v, --verbose                 same as '--report=state'\n"
"  -b, --file-prefix=PREFIX      specify a PREFIX for output files\n"
"  -o, --output=FILE             leave output to FILE\n"
"  -g, --graph[=FILE]            also output a graph of the automaton\n"
"      --html[=FILE]             also output an HTML report of the automaton\n"
"  -x, --xml[=FILE]              also output an XML report of the automaton\n"
"  -M, --file-prefix-map=OLD=NEW replace prefix OLD with NEW when writing file paths\n"
"                                in output files\n"
msgstr ""
"Izvades faili:\n"
"  -H, --header=[FAILS]          izveidot arī galvenes failu\n"
"  -d                            tāpat, bet FAILU norādīt nevar (POSIX Yacc)\n"
"  -r, --report=LIETAS           izveidot arī automāta detalizētu aprakstu\n"
"      --report-file=FAILS       rakstīt atskaiti FAILĀ\n"
"  -v, --verbose                 tas pats, kas '--report=state'\n"
"  -b, --file-prefix=PRIEDĒKLIS  norādīt izvades failu PRIEDĒKLI\n"
"  -o, --output=FAILS            rakstīt izvadi FAILĀ\n"
"  -g, --graph[=FAILS]           izvadīt arī automāta grafu\n"
"      --html[=FAILS]            izvadīt arī automāta HTML atskaiti\n"
"  -x, --xml[=FAILS]             izvadīt arī automāta XML atskaiti\n"
"  -M, --file-prefix-map=VECAIS=JAUNAIS\n"
"                                aizstāt priedēkli VECAIS ar JAUNAIS, rakstot\n"
"                                failu ceļus izvades failos\n"

