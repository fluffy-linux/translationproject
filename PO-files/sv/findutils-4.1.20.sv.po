"            [-P max-processer] [--null] [--eof[=filslutssträng]]\n"
"            [--replace[=ersättningssträng]] [--max-lines[=max-rader]]\n"
"            [--interactive] [--max-chars=max-tecken] [--verbose] [--exit]\n"
