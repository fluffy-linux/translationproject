#: xargs/xargs.c:1456
#, c-format
msgid ""
"Usage: %s [-0prtx] [--interactive] [--null] [-d|--delimiter=delim]\n"
"       [-E eof-str] [-e[eof-str]]  [--eof[=eof-str]]\n"
"       [-L max-lines] [-l[max-lines]] [--max-lines[=max-lines]]\n"
"       [-I replace-str] [-i[replace-str]] [--replace[=replace-str]]\n"
"       [-n max-args] [--max-args=max-args]\n"
"       [-s max-chars] [--max-chars=max-chars]\n"
"       [-P max-procs]  [--max-procs=max-procs] [--show-limits]\n"
"       [--verbose] [--exit] [--no-run-if-empty] [--arg-file=file]\n"
"       [--version] [--help] [command [initial-arguments]]\n"
msgstr ""
"Употреба: %s [-0prtx]      [--interactive]  [--null]     [-d|--delimiter=раздвајач]\n"
"       [-E ниска краја дат.]  [-e[ниска краја дат.]]        [--eof[=ниска краја дат.]]\n"
"       [-L највише редова]    [-l[највише редова]]          [--max-lines[=највише редова]]\n"
"       [-I ниска замене]      [-i[ниска замене]]            [--replace[=ниска замене]]\n"
"       [-n највише аргумента] [--max-args=највише аргумента]\n"
"       [-s највише знакова]   [--max-chars=највише знакова]\n"
"       [-P највише процеса]   [--max-procs=највише процеса] [--show-limits]\n"
"       [--verbose]   [--exit] [--no-run-if-empty]           [--arg-file=датотека]\n"
"       [--version]   [--help] [наредба [почетни аргументи]]\n"

