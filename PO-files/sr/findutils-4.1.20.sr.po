"       [-n макс-арг] [-s макс-знакова] [-P макс-проц] [--null] \n"
"       [--eof[=ниска-краја]] [--replace[=ниска-замене]] \n"
"       [--max-lines[=макс-редова]] [--interactive] [--max-chars=макс-знакова] \n"
"       [--verbose] [--exit] [--max-procs=макс-проц] [--max-args=макс-арг] \n"
