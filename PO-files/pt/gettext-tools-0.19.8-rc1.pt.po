msgstr "  -P, --properties-input      ficheiros de entrada com sintaxe Java .properties\n"

#: src/msgcat.c:422 src/msgcmp.c:255 src/msgcomm.c:413 src/msgfmt.c:1034
#: src/msgmerge.c:578
#, c-format
