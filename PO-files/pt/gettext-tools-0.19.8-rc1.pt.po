#, c-format
msgid "Language specific options:\n"
msgstr "Opções específicas da linguagem:\n"

#: src/xgettext.c:1116
#, c-format
msgid "  -a, --extract-all           extract all strings\n"
msgstr "  -a, --extract-all           extrai todas as cadeias\n"

#: src/xgettext.c:1118
