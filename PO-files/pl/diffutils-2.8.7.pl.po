msgstr "Nie sparowany ) lub \\)"

#: lib/regex.c:7915
msgid "No previous regular expression"
msgstr "Brak poprzedniego wyrażenia regularnego"

#: lib/xmalloc.c:53
msgid "memory exhausted"
msgstr "brak pamięci"

