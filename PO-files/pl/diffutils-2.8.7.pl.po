msgstr "%s: opcja `-W %s' jest niejednoznaczna\n"

#: lib/getopt.c:997 lib/getopt.c:1018
#, c-format
msgid "%s: option `-W %s' doesn't allow an argument\n"
msgstr "%s: opcja `-W %s' nie może mieć argumentu\n"

