#: src/tar.c:411
msgid "FORMAT is one of the following:"
msgstr "ФОРМАТ будь-який з наступних:"

#: src/tar.c:412
msgid "old V7 tar format"
msgstr "старий формат V7"

#: src/tar.c:414
msgid "GNU format as per tar <= 1.12"
msgstr "формат GNU, сумісний з версією tar <= 1.12"

#: src/tar.c:416
msgid "GNU tar 1.13.x format"
msgstr "формат GNU, сумісний з версією tar 1.13.x"

#: src/tar.c:418
msgid "POSIX 1003.1-1988 (ustar) format"
msgstr "формат POSIX 1003.1-1988 (ustar)"

#: src/tar.c:420
msgid "POSIX 1003.1-2001 (pax) format"
msgstr "формат POSIX 1003.1-2001 (pax)"

#: src/tar.c:421
msgid "Same as pax"
msgstr "те ж, що і pax"

#: src/tar.c:424
msgid "same as --format=v7"
msgstr "те ж, що і --format=v7"

#: src/tar.c:427
msgid "same as --format=posix"
msgstr "те ж, що і --format=posix"

#: src/tar.c:428
msgid "keyword[[:]=value][,keyword[[:]=value], ...]"
msgstr "ключове_слово[[:]=значення][,ключове_слово[[:]=значення], ...]\""

#: src/tar.c:429
msgid "control pax keywords"
msgstr "керування ключовими словами pax"

#: src/tar.c:430
msgid "TEXT"
msgstr "ТЕКСТ"

#: src/tar.c:431
msgid "create archive with volume name NAME. At list/extract time, use TEXT as a globbing pattern"
msgstr "створити архів з назвою тому \"ТЕКСТ\". Під час виводу змісту або витягування, використовувати ТЕКСТ як шаблон пошуку тому"

#: src/tar.c:433
msgid "filter the archive through bzip2"
msgstr "використовувати bzip2 для стиснення/розтискання архіву"

#: src/tar.c:435
msgid "filter the archive through gzip"
msgstr "використовувати gzip для стиснення/розтискання архіву"

#: src/tar.c:439
msgid "filter the archive through compress"
msgstr "використовувати compress для стиснення/розтискання архіву"

#: src/tar.c:441
msgid "PROG"
msgstr "ПРОГРАМА"

#: src/tar.c:442
msgid "filter through PROG (must accept -d)"
msgstr "використовувати ПРОГРАМУ для стиснення/розтискання архіву"

#: src/tar.c:445
msgid "Local file selection:"
msgstr "Вибір файлів:"

#: src/tar.c:447
msgid "DIR"
msgstr "КАТАЛОГ"

#: src/tar.c:448
msgid "change to directory DIR"
msgstr "перейти до вказаного каталогу"

#: src/tar.c:449
msgid "FILE-OF-NAMES"
msgstr "ФАЙЛ-З-НАЗВАМИ"

#: src/tar.c:450
msgid "get names to extract or create from file NAME"
msgstr "вказаний файл містить перелік назв файлів для додання/витягування"

#: src/tar.c:452
msgid "-T reads null-terminated names, disable -C"
msgstr "файл, вказаний з опцією -T, містить назви, відокремлені нульовими символами. Ця опція вимикає -C"

#: src/tar.c:453
msgid "PATTERN"
msgstr "ШАБЛОН"

#: src/tar.c:454
msgid "exclude files, given as a PATTERN"
msgstr "не обробляти файли, назви яких відповідають вказаному шаблону"

#: src/tar.c:456
msgid "exclude patterns listed in FILE"
msgstr "виключити назви що відповідають шаблонам, вказаним у файлі"

#: src/tar.c:458
msgid "exclude directories containing a cache tag"
msgstr "виключити каталоги що містять помітку кешування"

#: src/tar.c:460
msgid "exclusion ignores case"
msgstr "шаблонах виключення ігнорують відмінності у регістрі символів"

#: src/tar.c:462
msgid "exclude patterns match file name start"
msgstr "порівнювати шаблон виключення з назвою файлу починаючи від початку назви"

#: src/tar.c:464
msgid "exclude patterns match after any / (default)"
msgstr "порівнювати шаблон виключення з назвою файлу починаючи від будь-якого / (типово)"

#: src/tar.c:466
msgid "exclusion is case sensitive (default)"
msgstr "шаблони виключення враховують регістр (типово)"

#: src/tar.c:468
msgid "exclude patterns are plain strings"
msgstr "шаблони виключення є простими символьними рядками"

#: src/tar.c:470
msgid "exclude pattern wildcards do not match '/'"
msgstr "шаблони виключення не стосуються до '/'"

#: src/tar.c:472
msgid "avoid descending automatically in directories"
msgstr "не заходити автоматично у каталоги"

#: src/tar.c:474
msgid "stay in local file system when creating archive"
msgstr "залишатися у локальної файлової системі під час створення архіву"

#: src/tar.c:477
msgid "recurse into directories (default)"
msgstr "рекурсивно проходити каталоги (типово)"

#: src/tar.c:479
msgid "don't strip leading `/'s from file names"
msgstr "не видаляти початкову косу риску `/' з назв файлів"

#: src/tar.c:481
msgid "dump instead the files symlinks point to"
msgstr "додавати файли на яки вказують символічні посилання"

#: src/tar.c:482
msgid "MEMBER-NAME"
msgstr "НАЗВА-ФАЙЛУ"

#: src/tar.c:483
msgid "begin at member MEMBER-NAME in the archive"
msgstr "починати обслуговування архіву з вказаного файлу"

#: src/tar.c:485
msgid "strip NUMBER leading components from file names"
msgstr "видаляти вказане ЧИСЛО компонентів з початку назв файлів"

#: src/tar.c:486
msgid "DATE-OR-FILE"
msgstr "ДАТА-АБО-ФАЙЛ"

#: src/tar.c:487
msgid "only store files newer than DATE-OR-FILE"
msgstr "додавати тільки такі файли, що є новіші за вказану дату або файл"

#: src/tar.c:488 src/tar.c:490
msgid "DATE"
msgstr "ДАТА"

#: src/tar.c:489
msgid "compare date and time when data changed only"
msgstr "порівнювати тільки дату і час зміни даних"

#: src/tar.c:491
msgid "same as -N"
msgstr "Те ж, що і -N"

#: src/tar.c:492
msgid "CONTROL"
msgstr "РЕЖИМ"

#: src/tar.c:493
msgid "backup before removal, choose version CONTROL"
msgstr "перед видаленням створювати резервні файли у вказаному режимі"

#: src/tar.c:494
msgid "STRING"
msgstr "РЯДОК"

#: src/tar.c:495
msgid "backup before removal, override usual suffix ('~' unless overridden by environment variable SIMPLE_BACKUP_SUFFIX"
msgstr "перед видаленням створювати резервні файли з вказаним суфіксом (типово '~', якщо він не перевизначений змінною середовища SIMPLE_BACKUP_SUFFIX)"

# FIXME
#: src/tar.c:497
msgid "exclude patterns use wildcards (default)"
msgstr "шаблони виключення містять мета-символи '*' і '?' (типово)"

#: src/tar.c:499
msgid "exclude pattern wildcards match '/' (default)"
msgstr "шаблони виключення стосуються до '/' (типово)"

#: src/tar.c:502
msgid "Informative output:"
msgstr "Інформативний вивід:"

#: src/tar.c:505
msgid "verbosely list files processed"
msgstr "виводити докладну інформацію про оброблені файли"

#: src/tar.c:507
msgid "display progress messages every 10th record"
msgstr "виводити контрольне повідомлення через кожні 10 записів"

#: src/tar.c:509
msgid "print a message if not all links are dumped"
msgstr "виводити повідомлення якщо до архіву було додано не всі посилання"

#: src/tar.c:511
msgid "print total bytes written while creating archive"
msgstr "друкувати загальну кількість байтів, записаних під час створення архіву"

#: src/tar.c:513
msgid "print file modification dates in UTC"
msgstr "друкувати час модифікації файлів у UTC"

#: src/tar.c:515
msgid "send verbose output to FILE"
msgstr "виводити детальну інформацію у ФАЙЛ"

#: src/tar.c:517
msgid "show block number within archive with each message"
msgstr "попереджувати кожне повідомлення номером блоку в архіві"

#: src/tar.c:519
msgid "ask for confirmation for every action"
msgstr "Запитувати підтвердження кожної дії"

#: src/tar.c:522
msgid "Show tar defaults"
msgstr "Вивести типові налаштування програми"

#: src/tar.c:524
msgid "When listing or extracting, list each directory that does not match search criteria"
msgstr "Під час виведення змісту або витягування файлів друкувати назви каталогів що не відповідають критеріям пошуку"

#: src/tar.c:527
msgid "Compatibility options:"
msgstr "Опції сумісності:"

#: src/tar.c:530
msgid "when creating, same as --old-archive. When extracting, same as --no-same-owner"
msgstr "під час створення архіву, те ж саме, що --old-archive. Під час витягування, те ж саме, що --no-same-owner"

#: src/tar.c:533
msgid "Other options:"
msgstr "Інші опції:"

#: src/tar.c:535
msgid "Give this help list"
msgstr "Показати цю довідку"

#: src/tar.c:536
msgid "Give a short usage message"
msgstr "Показати коротке повідомлення про використання"

#: src/tar.c:537
msgid "Print license and exit"
msgstr "Вивести текст ліцензії та вийти"

#: src/tar.c:538
msgid "Print program version"
msgstr "Вивести версію програми"

#: src/tar.c:575
msgid "You may not specify more than one `-Acdtrux' option"
msgstr "Не можна вказувати більш ніж одну з опцій `-Acdtrux'"

#: src/tar.c:585
msgid "Conflicting compression options"
msgstr "Опції стиснення конфліктують одна з другою"

#: src/tar.c:595
msgid ""
