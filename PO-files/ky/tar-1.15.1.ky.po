msgstr "ар маалыматка SIZE байт түшөт, 512 көбөйтүндүсү"

#: src/tar.c:401
msgid "ignore zeroed blocks in archive (means EOF)"
msgstr "архивдеги нөлдүү блокторду өтүп кетет (EOF жөнүндө)"

#: src/tar.c:403
msgid "reblock as we read (for 4.2BSD pipes)"
msgstr "окубатканда кайрадан блокторго бөлүп чык (4.2BSD каналдары үчүн)"

#: src/tar.c:406
msgid "Archive format selection:"
msgstr "Архивдин форматын тандоо:"

#: src/tar.c:408
msgid "FORMAT"
msgstr "ФОРМАТ"

#: src/tar.c:409
msgid "create archive of the given format."
msgstr "тандалган форматта архив жарат."

#: src/tar.c:411
msgid "FORMAT is one of the following:"
msgstr "ФОРМАТ булардан бири болот:"

#: src/tar.c:412
msgid "old V7 tar format"
msgstr "эски V7 tar форматы"

#: src/tar.c:414
msgid "GNU format as per tar <= 1.12"
msgstr "tar <= 1.12 версиясында болгондой GNU форматы"

#: src/tar.c:416
msgid "GNU tar 1.13.x format"
msgstr "GNU tar 1.13.x форматы"

#: src/tar.c:418
msgid "POSIX 1003.1-1988 (ustar) format"
msgstr "POSIX 1003.1-1988 (ustar) форматы"

#: src/tar.c:420
msgid "POSIX 1003.1-2001 (pax) format"
msgstr "POSIX 1003.1-2001 (pax) форматы"

#: src/tar.c:421
msgid "Same as pax"
msgstr "pax менен бирдей"

#: src/tar.c:424
msgid "same as --format=v7"
msgstr "--format=v7 менен бирдей"

#: src/tar.c:427
msgid "same as --format=posix"
msgstr "--format=posix менен бирдей"

#: src/tar.c:428
msgid "keyword[[:]=value][,keyword[[:]=value], ...]"
msgstr "keyword[[:]=мааниси][,keyword[[:]=мааниси], ...]"

#: src/tar.c:429
msgid "control pax keywords"
msgstr "контролдоо үчүн pax ачкыч сөздөрү"

#: src/tar.c:430
msgid "TEXT"
msgstr "ТЕКСТ"

#: src/tar.c:431
msgid "create archive with volume name NAME. At list/extract time, use TEXT as a globbing pattern"
msgstr "том аты АТЫ болгон архив жарат. Тизмелөө/чыгаруу учурунда, шаблон катары ТЕКСТ колдон"

#: src/tar.c:433
msgid "filter the archive through bzip2"
msgstr "архивди bzip2 менен ишке ал"

#: src/tar.c:435
msgid "filter the archive through gzip"
msgstr "архивди gzip менен ишке ал"

#: src/tar.c:439
msgid "filter the archive through compress"
msgstr "архивди compress менен ишке ал"

#: src/tar.c:441
msgid "PROG"
msgstr "ПРОГ"

#: src/tar.c:442
msgid "filter through PROG (must accept -d)"
msgstr "ПРОГ менен ишке ал (-d опциясы болушу керек)"

#: src/tar.c:445
msgid "Local file selection:"
msgstr "Локалдуу файлдарды тандоо:"

#: src/tar.c:447
msgid "DIR"
msgstr "ПАПКА"

#: src/tar.c:448
msgid "change to directory DIR"
msgstr "ПАПКА папкасына өт"

#: src/tar.c:449
msgid "FILE-OF-NAMES"
msgstr "АТТАРДЫН-ФАЙЛЫ"

#: src/tar.c:450
msgid "get names to extract or create from file NAME"
msgstr "чыгарыла турган же жаратыла турган файлдарды АТЫ файлынан ал"

#: src/tar.c:452
msgid "-T reads null-terminated names, disable -C"
msgstr "-T опциясы нөл менен бүткөн аттарды окуйт, -C опциясы өчүрүлөт"

#: src/tar.c:453
msgid "PATTERN"
msgstr "ШАБЛОН"

#: src/tar.c:454
msgid "exclude files, given as a PATTERN"
msgstr "ШАБЛОН түрүндөгү файлдар ишке алынбайт"

#: src/tar.c:456
msgid "exclude patterns listed in FILE"
msgstr "ишке алынбаган файлдардын шаблондору ФАЙЛда тизмеленген"

#: src/tar.c:458
msgid "exclude directories containing a cache tag"
msgstr "кэш тэги болгон папкалар ишке алынбайт"

#: src/tar.c:460
msgid "exclusion ignores case"
msgstr "ишке алынбаган файл шаблондорунда тамгалардын чоң-кичинеси каралбайт"

#: src/tar.c:462
msgid "exclude patterns match file name start"
msgstr "ишке алынбаган файл шаблондору файлдын атынын башталышы менен уйкаштырылат"

#: src/tar.c:464
msgid "exclude patterns match after any / (default)"
msgstr "ишке алынбаган файл шаблондору /'тен кийин келген ар жерде уйкашына каралат (алдынала тандалган)"

#: src/tar.c:466
msgid "exclusion is case sensitive (default)"
msgstr "ишке алынбаган файл же папкалар тандалыбатканда тамгалардын чоң-кичинесине каралат (алдынала тандалган)"

#: src/tar.c:468
msgid "exclude patterns are plain strings"
msgstr "ишке алынбаган файл шаблондору жөнөкөй сөздөр болот"

#: src/tar.c:470
msgid "exclude pattern wildcards do not match '/'"
msgstr "ишке алынбаган файл шаблонундагы маскалар '/' символун карабайт"

#: src/tar.c:472
msgid "avoid descending automatically in directories"
msgstr "папкалардын тереңине кирип кетүүнү токтот"

#: src/tar.c:474
msgid "stay in local file system when creating archive"
msgstr "архивди жасабатканда локалдуу файл системасында кал"

#: src/tar.c:477
msgid "recurse into directories (default)"
msgstr "папкалардын тереңине кирет (алдынала тандалган)"

#: src/tar.c:479
msgid "don't strip leading `/'s from file names"
msgstr "файл аттарынын башындагы '/'терди өчүрбө"

#: src/tar.c:481
msgid "dump instead the files symlinks point to"
msgstr "символикалык шилтемелердин ордуна алар көрсөтүп турган файлдарды кошот"

#: src/tar.c:482
msgid "MEMBER-NAME"
msgstr "МҮЧӨНҮН-АТЫ"

#: src/tar.c:483
msgid "begin at member MEMBER-NAME in the archive"
msgstr "архивдеги МҮЧӨНҮН-АТЫ мүчөсүнөн башта"

#: src/tar.c:485
msgid "strip NUMBER leading components from file names"
msgstr "файлдын аттарынын башындагы N нерсени өчүрүп сал"

#: src/tar.c:486
msgid "DATE-OR-FILE"
msgstr "ДАТА-ЖЕ-ФАЙЛ"

#: src/tar.c:487
msgid "only store files newer than DATE-OR-FILE"
msgstr "ДАТА-ЖЕ-ФАЙЛ'дан жаңы болгон файлдарды гана сакта"

#: src/tar.c:488 src/tar.c:490
msgid "DATE"
msgstr "ДАТА"

#: src/tar.c:489
msgid "compare date and time when data changed only"
msgstr "датасы гана алмашканда дата жана убактысын салыштыр"

#: src/tar.c:491
msgid "same as -N"
msgstr "-N менен бирдей"

#: src/tar.c:492
msgid "CONTROL"
msgstr "CONTROL"

#: src/tar.c:493
msgid "backup before removal, choose version CONTROL"
msgstr "өчүрөрдөн мурун копиясын сактап кал, CONTROL версиясын танда"

#: src/tar.c:494
msgid "STRING"
msgstr "STRING"

#: src/tar.c:495
msgid "backup before removal, override usual suffix ('~' unless overridden by environment variable SIMPLE_BACKUP_SUFFIX"
msgstr "өчүрөрдөн мурун копиясын сактайт, STRING суфикси кошулат (суфикс SIMPLE_BACKUP_SUFFIX жолу менен алмаштырылбаган болсо '~' болмок)"

#: src/tar.c:497
msgid "exclude patterns use wildcards (default)"
msgstr "ишке алынбаган файл шаблондорунда маскалар колдонулат (алдынала тандалган)"

#: src/tar.c:499
msgid "exclude pattern wildcards match '/' (default)"
msgstr "ишке алынбаган файл шаблонундагы маскалар '/' символун карайт (алдынала тандалган)"

#: src/tar.c:502
msgid "Informative output:"
msgstr "Маалыматтандыруу:"

#: src/tar.c:505
msgid "verbosely list files processed"
msgstr "ишке алынган файлдарды кеңири маалыматы менен тизмеле"

#  Ушы 'record' сөзүнө жакшы котормо табалбай койдум
#  'маалымат' деп жазыбаттым эле, бул жерде келишпей калаткен 
#: src/tar.c:507
#, fuzzy
msgid "display progress messages every 10th record"
msgstr "ар 10 записьтен кийин маалымат берип турат"

#: src/tar.c:509
msgid "print a message if not all links are dumped"
msgstr "баардык шилтемелер кошулбай калса билдирүү жазып чыгар"

#: src/tar.c:511
msgid "print total bytes written while creating archive"
msgstr "архив жасабатканда жалпы сакталган байт көлөмүн жазып чыгар"

#: src/tar.c:513
msgid "print file modification dates in UTC"
msgstr "файлды алмаштыруу датасын UTC түрүндө көрсөт"

#: src/tar.c:515
msgid "send verbose output to FILE"
msgstr "чыккан кеңири маалыматты ФАЙЛ файлына жибер"

#: src/tar.c:517
msgid "show block number within archive with each message"
msgstr "ар билдирүүдө архивдин ичиндеги блок номерин көрсөт"

#: src/tar.c:519
msgid "ask for confirmation for every action"
msgstr "ар ишти аткарууга макулдук сурап тур"

#: src/tar.c:522
msgid "Show tar defaults"
msgstr "tar'дын алдынала коюлган абалын көрсөт"

#: src/tar.c:524
msgid "When listing or extracting, list each directory that does not match search criteria"
msgstr "Тизмелебатканда же чыгарыбатканда издөө критериясына жатпаган ар папканы тизмеле"

#: src/tar.c:527
msgid "Compatibility options:"
msgstr "Келишүү опциялары:"

#: src/tar.c:530
msgid "when creating, same as --old-archive. When extracting, same as --no-same-owner"
msgstr "жаңы архив жасабатканда --old-archive менен бирдей. Чыгарыбатканда --no-same-owner менен бирдей"

#: src/tar.c:533
msgid "Other options:"
msgstr "Башка опциялар:"

#: src/tar.c:535
msgid "Give this help list"
msgstr "Бул жардам тизмесин көрсөт"

#: src/tar.c:536
msgid "Give a short usage message"
msgstr "Колдонуу жөнүндө кыска маалымат көрсөт"

#: src/tar.c:537
msgid "Print license and exit"
msgstr "Лицензияны көрсөтүп tar'дын ишин бүтүр"

#: src/tar.c:538
msgid "Print program version"
msgstr "Программанын версиясын көрсөт"

#: src/tar.c:575
msgid "You may not specify more than one `-Acdtrux' option"
msgstr "`-Acdtrux' опцияларынан бирөөнү гана колдоно аласыңар"

#: src/tar.c:585
msgid "Conflicting compression options"
msgstr "Бирбирине келишпеген кысыштыруу опциялары берилди"

