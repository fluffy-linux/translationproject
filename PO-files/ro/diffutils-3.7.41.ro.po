#: src/diff3.c:487
msgid "-X                          like -x, but bracket conflicts"
msgstr "-X                          ca -x, dar închide conflictele între paranteze"

#: src/diff3.c:488
msgid "-i                          append 'w' and 'q' commands to ed scripts"
msgstr "-i                          adaugă comenzile „w” și „q” la scripturile «ed»"

#: src/diff3.c:490
msgid ""
"-m, --merge                 output actual merged file, according to\n"
"                                -A if no other options are given"
msgstr ""
"-m, --merge                 afișează fișierul combinat, conform -A dacă nu sunt\n"
"                              date alte opțiuni"

#: src/diff3.c:493
msgid "-a, --text                  treat all files as text"
msgstr "-a, --text                  tratează toate fișierele ca text"

