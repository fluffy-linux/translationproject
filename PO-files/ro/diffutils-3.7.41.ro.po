msgstr ""
"-e, --ed                    afișează un script «ed» ce incorporează modificările\n"
"                              dintre FIȘIERUL_VECHI și FIȘIERUL_TĂU în FIȘIERUL_MEU"

#: src/diff3.c:484
msgid "-E, --show-overlap          like -e, but bracket conflicts"
msgstr "-E, --show-overlap          ca -e, dar închizînd conflictele între paranteze"

#: src/diff3.c:485
msgid "-3, --easy-only             like -e, but incorporate only nonoverlapping changes"
msgstr ""
"-3, --easy-only             ca -e, dar încorporează doar modificările ce nu se\n"
"                              suprapun"

#: src/diff3.c:486
msgid "-x, --overlap-only          like -e, but incorporate only overlapping changes"
msgstr ""
"-x, --overlap-only          ca -e, dar încorporează doar modificările ce se su-\n"
