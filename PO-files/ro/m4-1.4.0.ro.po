"      --version                output version information and exit\n"
"  -e, --interactive            unbuffer output, ignore interrupts\n"
"  -E, --fatal-warnings         stop execution after first warning\n"
"  -Q, --quiet, --silent        suppress some warnings for builtins\n"
"  -P, --prefix-builtins        force a `m4_' prefix to all builtins\n"
msgstr ""
"Argumentele obligatorii sau opþionale pentru opþiunile lungi sunt obligatorii sau opþionale ºi pentru opþiunile scurte.\n"
"\n"
"Moduri operare:\n"
"      --help                  afiºeazã acest mesaj ºi terminã\n"
"      --version               afiºeazã informaþie despre versiune ºi terminã\n"
"  -e, --interactive           ieºire fãrã buffer, ignorã întreruperi\n"
"  -E, --fatal-warnings        opreºte execuþia dupã primul avertisment\n"
"  -Q, --quiet, --silent       eliminã câteva avertismente pentru builtins\n"
"  -P, --prefix-builtins       forþeazã un prefix `m4_' pentru toate builtins\n"

#: src/m4.c:164
