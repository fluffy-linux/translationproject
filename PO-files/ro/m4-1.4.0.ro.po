"  -s, --synclines              genereazã `#linie NO \"FIªIER\"' linii\n"

#: src/m4.c:184
msgid ""
"\n"
"Limits control:\n"
"  -G, --traditional            suppress all GNU extensions\n"
"  -H, --hashsize=PRIME         set symbol lookup hash table size\n"
"  -L, --nesting-limit=NUMBER   change artificial nesting limit\n"
msgstr ""
"\n"
