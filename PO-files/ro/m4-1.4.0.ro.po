"  -G, --traditional           eliminã toate extensiile GNU\n"
"  -H, --hashsize=PRIM         seteazã dimensiunea tabel de cãutare simboluri\n"
"  -L, --nesting-limit=NUMÃR   schimbã limita artificialã de încuibare\n"

#: src/m4.c:191
