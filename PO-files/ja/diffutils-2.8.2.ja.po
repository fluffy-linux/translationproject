#: lib/regex.c:1376
msgid "Invalid collation character"
msgstr "無効な整列文字です"

#: lib/regex.c:1379
msgid "Invalid character class name"
msgstr "無効な文字クラス名です"

#: lib/regex.c:1382
msgid "Trailing backslash"
msgstr "後続する逆斜線"

#: lib/regex.c:1385
msgid "Invalid back reference"
msgstr "無効な逆参照"

#: lib/regex.c:1388
msgid "Unmatched [ or [^"
msgstr "釣り合わない[や[^"

#: lib/regex.c:1391
msgid "Unmatched ( or \\("
msgstr "釣り合わない(や\\("

#: lib/regex.c:1394
msgid "Unmatched \\{"
msgstr "釣り合わない\\{"

#: lib/regex.c:1397
msgid "Invalid content of \\{\\}"
msgstr "無効な\\{\\}の内容"

#: lib/regex.c:1400
msgid "Invalid range end"
msgstr "無効な範囲終了"

#: lib/regex.c:1403
msgid "Memory exhausted"
msgstr "仮想メモリを使い果たしました"

#: lib/regex.c:1406
