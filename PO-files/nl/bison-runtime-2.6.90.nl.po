#: data/glr.c:855 data/yacc.c:776
msgid "syntax error: cannot back up"
msgstr "syntaxfout: kan niet terugkeren"

#: data/glr.c:1729
msgid "syntax is ambiguous"
msgstr "syntax is niet eenduidig"

#: data/glr.c:2014 data/glr.c:2092 data/glr.c:2130 data/glr.c:2394
#: data/lalr1.cc:947 data/lalr1.cc:967 data/yacc.c:1350 data/yacc.c:1853
#: data/yacc.c:1859
msgid "syntax error"
msgstr "syntaxfout"

#: data/glr.c:2093 data/lalr1.cc:948 data/yacc.c:1351
#, c-format
msgid "syntax error, unexpected %s"
msgstr "syntaxfout, %s onverwacht"

#: data/glr.c:2094 data/lalr1.cc:949 data/yacc.c:1352
#, c-format
msgid "syntax error, unexpected %s, expecting %s"
