#: data/glr.c:840 data/yacc.c:533
msgid "syntax error: cannot back up"
msgstr "errore di sintassi: impossibile tornare indietro"

#: data/glr.c:1598
msgid "syntax is ambiguous"
msgstr ""

#: data/glr.c:1878 data/glr.c:1884 data/glr.c:2130 data/lalr1.cc:954
#: data/yacc.c:1258 data/yacc.c:1264
msgid "syntax error"
msgstr "errore di sintassi"

#: data/glr.c:2160 data/yacc.c:967 data/yacc.c:1379
msgid "memory exhausted"
msgstr "memoria esaurita"

#: data/yacc.c:1179
#, c-format
msgid "syntax error, unexpected %s"
msgstr "errore di sintassi, %s non atteso"

#: data/yacc.c:1180
#, c-format
msgid "syntax error, unexpected %s, expecting %s"
msgstr "errore di sintassi, atteso %2$s e non %1$s"

#: data/yacc.c:1181
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s"
msgstr "errore di sintassi, atteso %2$s o %3$s e non %1$s"

#: data/yacc.c:1182
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s"
msgstr "errore di sintassi, atteso %2$s o %3$s o %4$s e non %1$s"

#: data/yacc.c:1183
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s or %s"
msgstr "errore di sintassi, atteso %2$s o %3$s o %4$s o %5$s e non %1$s"
