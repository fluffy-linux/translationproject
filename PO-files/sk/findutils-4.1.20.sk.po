#: find/parser.c:557
msgid ""
"default path is the current directory; default expression is -print\n"
"expression may consist of:\n"
"operators (decreasing precedence; -and is implicit where no others are given):\n"
"      ( EXPR ) ! EXPR -not EXPR EXPR1 -a EXPR2 EXPR1 -and EXPR2\n"
msgstr ""
"implicitná cesta je aktuálny adresár; implicitný výraz je -print\n"
"výraz môže pozostávať z:\n"
"operátorov (klesajúca priorita; -and je implicitný, ak nie je zadaný iný):\n"
"      ( VÝRAZ ) ! VÝRAZ -not VÝRAZ VÝRAZ1 -a VÝRAZ2 VÝRAZ1 -and VÝRAZ2\n"

#: find/parser.c:562
msgid ""
"      EXPR1 -o EXPR2 EXPR1 -or EXPR2 EXPR1 , EXPR2\n"
"options (always true): -daystart -depth -follow --help\n"
"      -maxdepth LEVELS -mindepth LEVELS -mount -noleaf --version -xdev\n"
"tests (N can be +N or -N or N): -amin N -anewer FILE -atime N -cmin N\n"
msgstr ""
"      VÝRAZ1 -o VÝRAZ2 VÝRAZ1 -or VÝRAZ2 VÝRAZ1 , VÝRAZ2\n"
"volieb (vždy pravda): -daystart -depth -follow --help\n"
"testov (N môže byť +N, -N alebo N): -amin N -anewer SÚBOR -atime N -cmin N\n"

#: find/parser.c:567
msgid ""
"      -cnewer FILE -ctime N -empty -false -fstype TYPE -gid N -group NAME\n"
"      -ilname PATTERN -iname PATTERN -inum N -ipath PATTERN -iregex PATTERN\n"
"      -links N -lname PATTERN -mmin N -mtime N -name PATTERN -newer FILE\n"
msgstr ""
"      -cnewer SÚBOR -ctime N -empty -false -fstype TYP -gid N -group NÁZOV\n"
"      -ilname VZOR -iname VZOR -inum N -ipath VZOR -iregex VZOR\n"
"      -links N -lname VZOR -mmin N -mtime N -name VZOR -newer SÚBOR\n"

#: find/parser.c:571
msgid ""
"      -nouser -nogroup -path PATTERN -perm [+-]MODE -regex PATTERN\n"
"      -size N[bckw] -true -type [bcdpfls] -uid N -used N -user NAME\n"
"      -xtype [bcdpfls]\n"
msgstr ""
"      -nouser -nogroup -path VZOR -perm [+-]MÓD -regex VZOR\n"
"      -size N[bckw] -true -type [bcdpfls] -uid N -used N -user MENO\n"
"      -xtype [bcdpfls]\n"

#: find/parser.c:575
msgid ""
"actions: -exec COMMAND ; -fprint FILE -fprint0 FILE -fprintf FILE FORMAT\n"
"      -ok COMMAND ; -print -print0 -printf FORMAT -prune -ls\n"
msgstr ""
"akcie: -exec PRÍKAZ ; -fprint SÚBOR -fprint0 SÚBOR -fprintf SÚBOR FORMÁT\n"
"      -ok PRÍKAZ ; -print -print0 -printf FORMÁT -prune -ls\n"

