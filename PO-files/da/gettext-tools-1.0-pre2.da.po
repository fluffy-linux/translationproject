#: src/xgettext.c:1191
#, c-format
msgid "  -d, --default-domain=NAME   use NAME.po for output (instead of messages.po)\n"
msgstr "  -d, --default-domain=NAVN  brug NAVN.po som udfil (i st.f. messages.po) \n"

