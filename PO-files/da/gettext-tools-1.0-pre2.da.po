#: src/msggrep.c:552
#, fuzzy, c-format, no-wrap
#| msgid ""
#| "Message selection:\n"
#| "  [-N SOURCEFILE]... [-M DOMAINNAME]...\n"
#| "  [-J MSGCTXT-PATTERN] [-K MSGID-PATTERN] [-T MSGSTR-PATTERN]\n"
#| "  [-C COMMENT-PATTERN] [-X EXTRACTED-COMMENT-PATTERN]\n"
