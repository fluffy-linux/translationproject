#, c-format
msgid "write to stdout failed"
msgstr "kirjoittaminen vakiotulosteeseen epäonnistui"

#: src/msgexec.c:427
#, c-format
msgid "write to %s subprocess failed"
msgstr "kirjoittaminen %s-aliprosessiin epäonnistui"

