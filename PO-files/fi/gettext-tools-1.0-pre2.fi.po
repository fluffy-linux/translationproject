msgstr ""
"  -<, --less-than=MÄÄRÄ       tulosta viestit, jotka on määritelty alle\n"
"                              näin monta kertaa; oletus ääretön\n"

#: src/msgcat.c:404
#, c-format
msgid ""
"  ->, --more-than=NUMBER      print messages with more than this many\n"
