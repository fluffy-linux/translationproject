msgstr "استخدمت علامة اقتباس مزدوجة ASCII بدلاً من يونيكود"

#: src/xg-check.c:213
msgid "ASCII single quote used instead of Unicode"
msgstr "استخدمت علامة اقتباس مفردة ASCII بدلاً من يونيكود"

#: src/xg-check.c:333
#, c-format
msgid "ASCII bullet ('%c') instead of Unicode"
msgstr "نقطة ASCII ('%c') بدلاً من يونيكود"

#: src/xg-check.c:429
#, c-format
