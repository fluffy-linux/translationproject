"  %l   أقصى طول لأسماء الملفات\n"
"  %n   اسم الملف\n"
"  %s   حجم الكتلة (لنقل أسرع)\n"
"  %S   حجم الكتلة الأساسي (لعدّ الكتل)\n"
"  %t   نوع نظام الملفات بالست عشري\n"
"  %T   نوع نظام الملفات بصيغة بشرية مقروءة\n"

#: src/stat.c:1856
