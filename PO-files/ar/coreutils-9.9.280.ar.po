#: src/pinky.c:498
msgid ""
"  -l\n"
"         produce long format output for the specified USERs\n"
msgstr "  -l              إنتاج مخرج بتنسيق طويل للمستخدمين المحددين\n"

msgid ""
"  -b\n"
"         omit the user's home directory and shell in long format\n"
msgstr "  -b              حذف دليل المنزل والقشرة للمستخدم في التنسيق الطويل\n"

msgid ""
"  -h\n"
"         omit the user's project file in long format\n"
msgstr "  -h              حذف ملف مشروع المستخدم في التنسيق الطويل\n"

msgid ""
"  -p\n"
"         omit the user's plan file in long format\n"
msgstr "  -p              حذف ملف خطة المستخدم في التنسيق الطويل\n"

msgid ""
"  -s\n"
"         do short format output, this is the default\n"
msgstr "  -s              إنتاج مخرج بتنسيق قصير، وهذا هو المبدئي\n"

#: src/pinky.c:506
msgid ""
"  -f\n"
"         omit the line of column headings in short format\n"
msgstr "  -f              حذف سطر رؤوس الأعمدة في التنسيق القصير\n"

msgid ""
"  -w\n"
"         omit the user's full name in short format\n"
msgstr "  -w              حذف اسم المستخدم الكامل في التنسيق القصير\n"

msgid ""
"  -i\n"
"         omit the user's full name and remote host in short format\n"
msgstr "  -i              حذف اسم المستخدم الكامل والمضيف البعيد في التنسيق القصير\n"

msgid ""
"  -q\n"
"         omit the user's full name, remote host and idle time\n"
"                  in short format\n"
msgstr ""
"  -q              حذف اسم المستخدم الكامل والمضيف البعيد ووقت الخمول\n"
"                  في التنسيق القصير\n"

#: src/pinky.c:513
msgid "      --lookup    attempt to canonicalize hostnames via DNS\n"
msgstr "      --lookup    محاولة توحيد أسماء المضيفين عبر DNS\n"

#: src/pinky.c:518
#, c-format
msgid ""
"\n"
"A lightweight 'finger' program;  print user information.\n"
"The utmp file will be %s.\n"
msgstr ""
"\n"
"برنامج 'finger' خفيف؛ يطبع معلومات المستخدم.\n"
"سيكون ملف utmp هو %s.\n"

#: src/pinky.c:607
