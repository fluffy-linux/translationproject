#: src/csplit.c:1448
#, c-format
msgid ""
"  -b, --suffix-format=FORMAT\n"
"         use sprintf FORMAT instead of %02d\n"
msgstr "  -b, --suffix-format=تنسيق  استخدام تنسيق sprintf بدلاً من %02d\n"

msgid ""
"  -f, --prefix=PREFIX\n"
"         use PREFIX instead of 'xx'\n"
msgstr "  -f, --prefix=بادئة        استخدام البادئة بدلاً من 'xx'\n"

msgid ""
"  -k, --keep-files\n"
"         do not remove output files on errors\n"
msgstr "  -k, --keep-files           عدم إزالة ملفات المخرج عند حدوث أخطاء\n"

#: src/csplit.c:1453
msgid "      --suppress-matched     suppress the lines matching PATTERN\n"
msgstr "      --suppress-matched     كتم الأسطر التي تطابق النمط\n"

#: src/csplit.c:1456
msgid ""
"  -n, --digits=DIGITS\n"
"         use specified number of digits instead of 2\n"
msgstr "  -n, --digits=أرقام        استخدام عدد محدد من الأرقام بدلاً من 2\n"

msgid "  -s, --quiet, --silent      do not print counts of output file sizes\n"
msgstr "  -s, --quiet, --silent      عدم طباعة أحجام ملفات المخرج\n"

msgid ""
"  -z, --elide-empty-files\n"
"         suppress empty output files\n"
msgstr "  -z, --elide-empty-files    كتم ملفات المخرج الفارغة\n"

#: src/csplit.c:1463
msgid ""
"\n"
"Each PATTERN may be:\n"
"  INTEGER            copy up to but not including specified line number\n"
"  /REGEXP/[OFFSET]   copy up to but not including a matching line\n"
"  %REGEXP%[OFFSET]   skip to, but not including a matching line\n"
"  {INTEGER}          repeat the previous pattern specified number of times\n"
"  {*}                repeat the previous pattern as many times as possible\n"
"\n"
"A line OFFSET is an integer optionally preceded by '+' or '-'\n"
msgstr ""
"\n"
"كل نمط قد يكون:\n"
"  رقم صحيح            نسخ حتى رقم السطر المحدد (لا يشمله)\n"
"  /REGEXP/[إزاحة]     نسخ حتى السطر المطابق (لا يشمله)\n"
"  %REGEXP%[إزاحة]     تخطي حتى السطر المطابق (لا يشمله)\n"
"  {رقم صحيح}          تكرار النمط السابق عدداً محدداً من المرات\n"
"  {*}                تكرار النمط السابق قدر الإمكان\n"
"\n"
"إزاحة السطر هي رقم صحيح يسبقه اختياريًا '+' أو '-'\n"

