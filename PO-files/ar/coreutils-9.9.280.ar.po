msgstr "هذا النظام لا يوفر نوع فاصلة عائمة %s"

#: src/od.c:953
#, c-format
msgid "invalid character '%c' in type string %s"
msgstr "محرف غير صالح '%c' في سلسلة النوع %s"

#: src/od.c:1187
#, c-format
msgid "cannot skip past end of combined input"
msgstr "لا يمكن التجاوز بعد نهاية الإدخال المدمج"

#: src/od.c:1254
#, c-format
msgid "pseudo address too large for input"
msgstr "العنوان الوهمي كبير جداً بالنسبة للإدخال"

#: src/od.c:1699
#, c-format
msgid "invalid output address radix '%c'; it must be one character from [doxn]"
msgstr "أساس عنوان المخرج غير صالح '%c'؛ يجب أن يكون محرفاً واحداً من [doxn]"

#: src/od.c:1836
#, c-format
msgid "no type may be specified when dumping strings"
msgstr "لا يجوز تحديد نوع عند تفريغ السلاسل"

#: src/od.c:1911
msgid "compatibility mode supports at most one file"
msgstr "وضع التوافق يدعم ملفاً واحداً على الأكثر"

#: src/od.c:1930
#, c-format
msgid "skip-bytes + read-bytes is too large"
msgstr "skip-bytes + read-bytes كبيرة جداً"

#: src/od.c:1972
#, c-format
msgid "warning: invalid width %td; using %d instead"
msgstr "تحذير: عرض غير صالح %td؛ سيتم استخدام %d بدلاً منه"

#: src/od.c:1991
#, c-format
msgid "%td is too large"
msgstr "%td كبير جداً"

#: src/paste.c:211
#, c-format
msgid "standard input is closed"
msgstr "الإدخال القياسي مغلق"

#: src/paste.c:427
msgid ""
"Write lines consisting of the sequentially corresponding lines from\n"
"each FILE, separated by TABs, to standard output.\n"
msgstr ""
"اكتب أسطراً تتكون من الأسطر المتقابلة بتسلسل من\n"
"كل ملف، مفصولة بـ ألسنة (TABs)، إلى الإخراج القياسي.\n"

#: src/paste.c:435
msgid ""
"  -d, --delimiters=LIST\n"
"         reuse characters from LIST instead of TABs\n"
msgstr "  -d, --delimiters=قائمة   أعد استخدام المحارف من القائمة بدلاً من الألسنة\n"

msgid ""
"  -s, --serial\n"
"         paste one file at a time instead of in parallel\n"
msgstr "  -s, --serial            لصق ملف واحد في كل مرة بدلاً من التوازي\n"

#: src/paste.c:505
#, c-format
msgid "delimiter list ends with an unescaped backslash: %s"
msgstr "قائمة الفواصل تنتهي بشرطة مائلة خلفية غير مهربة: %s"

#: src/pathchk.c:88
msgid ""
"Diagnose invalid or non-portable file names.\n"
"\n"
msgstr ""
"تنقيح أسماء الملفات غير الصالحة أو غير المنقولة.\n"
"\n"

msgid ""
"  -p\n"
"         check for most POSIX systems\n"
msgstr "  -p                  تحقق لمعظم أنظمة POSIX\n"

msgid ""
"  -P\n"
"         check for empty names and leading \"-\"\n"
msgstr "  -P                  تحقق من الأسماء الفارغة والبدء بـ \"-\"\n"

msgid ""
"      --portability\n"
"         check for all POSIX systems (equivalent to -p -P)\n"
msgstr "      --portability   تحقق لكل أنظمة POSIX (يعادل -p -P)\n"

#: src/pathchk.c:168
#, c-format
msgid "leading '-' in a component of file name %s"
msgstr "البدء بـ '-' في مكون من اسم الملف %s"

#: src/pathchk.c:194
#, c-format
