msgstr "تستخدم الأرقام %s كنقطة عشرية في هذه المحلية"

#: src/sort.c:2715
#, c-format
msgid "the multi-byte number group separator in this locale is not supported"
msgstr "فاصل مجموعات الأرقام متعدد البايتات في هذه المحلية غير مدعوم"

#: src/sort.c:2731
#, c-format
