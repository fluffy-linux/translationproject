#: src/install.c:605
msgid ""
"\n"
"This install program copies files (often just compiled) into destination\n"
"locations you choose.  If you want to download and install a ready-to-use\n"
"package on a GNU/Linux system, you should instead be using a package manager\n"
"like yum(1) or apt-get(1).\n"
"\n"
"In the first three forms, copy SOURCE to DEST or multiple SOURCE(s) to\n"
"the existing DIRECTORY, while setting permission modes and owner/group.\n"
"In the 4th form, create all components of the given DIRECTORY(ies).\n"
msgstr ""
"\n"
"برنامج التثبيت هذا ينسخ الملفات (غالباً ما تكون برمجيات مجمعة للتو) إلى مواقع\n"
"الوجهة التي تختارها. إذا كنت ترغب في تنزيل وتثبيت حزمة جاهزة للاستخدام\n"
"على نظام GNU/Linux، فيجب عليك بدلاً من ذلك استخدام مدير حزم\n"
"مثل yum(1) أو apt-get(1).\n"
"\n"
"في النماذج الثلاثة الأولى، انسخ المصدر إلى الوجهة أو مصادر متعددة إلى\n"
"الدليل الموجود، مع ضبط أوضاع الأذونات والمالك/المجموعة.\n"
"في النموذج الرابع، أنشئ جميع مكونات الدليل (الأدلة) المعطاة.\n"

msgid ""
"  -c\n"
"         (ignored)\n"
msgstr "  -c                  (يتم تجاهله)\n"

msgid ""
"  -C, --compare\n"
"         compare content of source and destination files, and\n"
"                        if no change to content, ownership, and permissions,\n"
"                        do not modify the destination at all\n"
msgstr ""
"  -C, --compare       قارن محتوى ملفات المصدر والوجهة، و\n"
"                        إذا لم يتغير المحتوى والملكية والأذونات،\n"
"                        فلا تعدل الوجهة على الإطلاق\n"

msgid ""
"  -d, --directory\n"
"         treat all arguments as directory names; create all\n"
"                        components of the specified directories\n"
msgstr ""
"  -d, --directory     عامل جميع المعطيات كأسماء أدلة؛ أنشئ جميع\n"
"                        مكونات الأدلة المحددة\n"

#: src/install.c:629
msgid ""
"  -D\n"
"         create all leading components of DEST except the last,\n"
"                        or all components of --target-directory,\n"
"                        then copy SOURCE to DEST\n"
msgstr ""
"  -D                  أنشئ جميع المكونات الرائدة للوجهة باستثناء الأخيرة،\n"
"                        أو جميع مكونات --target-directory،\n"
"                        ثم انسخ المصدر إلى الوجهة\n"

#: src/install.c:634
msgid "      --debug         explain how a file is copied.  Implies -v\n"
msgstr "      --debug         اشرح كيفية نسخ الملف. يتضمن -v\n"

#: src/install.c:637
msgid ""
"  -g, --group=GROUP\n"
"         set group ownership, instead of process' current group\n"
msgstr "  -g, --group=GROUP   اضبط ملكية المجموعة، بدلاً من مجموعة العملية الحالية\n"

msgid ""
"  -m, --mode=MODE\n"
"         set permission mode (as in chmod), instead of rwxr-xr-x\n"
msgstr "  -m, --mode=MODE     اضبط وضع الأذونات (كما في chmod)، بدلاً من rwxr-xr-x\n"

msgid ""
"  -o, --owner=OWNER\n"
"         set ownership (super-user only)\n"
msgstr "  -o, --owner=OWNER   اضبط الملكية (للمستخدم الجذر فقط)\n"

#: src/install.c:642
msgid ""
"  -p, --preserve-timestamps\n"
"         apply access/modification times of SOURCE files\n"
"                        to corresponding destination files\n"
msgstr ""
"  -p, --preserve-timestamps   طبق أوقات الوصول/التعديل لملفات المصدر\n"
"                        على ملفات الوجهة المقابلة\n"

msgid ""
"  -s, --strip\n"
"         strip symbol tables\n"
msgstr "  -s, --strip         جرد جداول الرموز\n"

msgid ""
"      --strip-program=PROGRAM\n"
"         program used to strip binaries\n"
msgstr "      --strip-program=PROGRAM  البرنامج المستخدم لتجريد الملفات الثنائية\n"

#: src/install.c:651
msgid "  -v, --verbose       print the name of each created file or directory\n"
msgstr "  -v, --verbose       اطبع اسم كل ملف أو دليل منشأ\n"

#: src/install.c:654
msgid ""
"      --preserve-context\n"
"         preserve SELinux security context\n"
msgstr "      --preserve-context  حافظ على سياق أمان SELinux\n"

msgid ""
"  -Z\n"
"         set SELinux security context of destination\n"
"                            file and each created directory to default type\n"
msgstr ""
"  -Z                      اضبط سياق أمان SELinux لملف الوجهة\n"
"                            وكل دليل منشأ إلى النوع المبدئي\n"

msgid ""
"      --context[=CTX]\n"
"         like -Z, or if CTX is specified then set the\n"
"                            SELinux or SMACK security context to CTX\n"
msgstr ""
"      --context[=CTX]     مثل -Z، أو إذا تم تحديد CTX فاضبط\n"
"                            سياق أمان SELinux أو SMACK إلى CTX\n"

