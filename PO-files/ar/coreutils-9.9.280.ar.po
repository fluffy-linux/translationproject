msgstr[4] "الخيارات '-%s' تُتجاهل"
msgstr[5] "الخيارات '-%s' تُتجاهل"

#: src/sort.c:2737
#, c-format
msgid "option '-r' only applies to last-resort comparison"
msgstr "الخيار '-r' ينطبق فقط على مقارنة الملاذ الأخير"

#: src/sort.c:3014 src/sort.c:3023
msgid "write failed"
msgstr "فشلت الكتابة"

