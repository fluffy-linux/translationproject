msgstr "فشل إنشاء الارتباط الرمزي %s -> %s"

#: src/ln.c:387
#, c-format
msgid "failed to create hard link to %s"
msgstr "فشل إنشاء ارتباط صلب بـ %s"

#: src/ln.c:391
