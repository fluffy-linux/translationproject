#: data/glr.c:920 data/yacc.c:585
msgid "syntax error: cannot back up"
msgstr "ผิดวากยสัมพันธ์: ไม่สามารถสำรองข้อมูล"

#: data/glr.c:1803
msgid "syntax is ambiguous"
msgstr "วากยสัมพันธ์คลุมเครือไม่ชัดเจน"

#: data/glr.c:2170 data/glr.c:2176 data/glr.c:2428 data/lalr1.cc:875
#: data/yacc.c:1305 data/yacc.c:1333
msgid "syntax error"
msgstr "ผิดวากยสัมพันธ์"

#: data/glr.c:2488 data/yacc.c:1118 data/yacc.c:1454
msgid "memory exhausted"
msgstr "หน่วยความจำถูกใช้จนหมดสิ้น"

#: data/yacc.c:873
#, c-format
msgid "syntax error, unexpected %s"
msgstr "ผิดวากยสัมพันธ์, ไม่คาดคิดกับ %s"

#: data/yacc.c:874
#, c-format
msgid "syntax error, unexpected %s, expecting %s"
msgstr "ผิดวากยสัมพันธ์, ไม่คาดคิดกับ %s, คาดหวัง %s"

#: data/yacc.c:875
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s"
msgstr "ผิดวากยสัมพันธ์, ไม่คาดคิดกับ %s, คาดหวัง %s หรือ %s"

#: data/yacc.c:876
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s"
msgstr "ผิดวากยสัมพันธ์, ไม่คาดคิดกับ %s, คาดหวัง %s หรือ %s หรือ %s"

#: data/yacc.c:877
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s or %s"
msgstr "ผิดวากยสัมพันธ์, ไม่คาดคิดกับ %s, คาดหวัง %s หรือ %s หรือ %s หรือ %s"
