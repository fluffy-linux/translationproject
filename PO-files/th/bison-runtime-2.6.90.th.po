#: data/glr.c:855 data/yacc.c:776
msgid "syntax error: cannot back up"
msgstr "ข้อผิดพลาดวากยสัมพันธ์: ไม่สามารถสำรองข้อมูล"

#: data/glr.c:1729
msgid "syntax is ambiguous"
msgstr "วากยสัมพันธ์คลุมเครือไม่ชัดเจน"

#: data/glr.c:2014 data/glr.c:2092 data/glr.c:2130 data/glr.c:2394
#: data/lalr1.cc:947 data/lalr1.cc:967 data/yacc.c:1350 data/yacc.c:1853
#: data/yacc.c:1859
msgid "syntax error"
msgstr "ข้อผิดพลาดวากยสัมพันธ์"

#: data/glr.c:2093 data/lalr1.cc:948 data/yacc.c:1351
#, c-format
msgid "syntax error, unexpected %s"
msgstr "ข้อผิดพลาดวากยสัมพันธ์, ไม่คาดว่าจะเป็น %s"

#: data/glr.c:2094 data/lalr1.cc:949 data/yacc.c:1352
#, c-format
msgid "syntax error, unexpected %s, expecting %s"
msgstr "ข้อผิดพลาดวากยสัมพันธ์, ไม่คาดว่าจะเป็น %s, คาดว่าจะเป็น %s"

#: data/glr.c:2095 data/lalr1.cc:950 data/yacc.c:1353
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s"
msgstr "ข้อผิดพลาดวากยสัมพันธ์, ไม่คาดว่าจะเป็น %s, คาดว่าจะเป็น %s หรือ %s"

#: data/glr.c:2096 data/lalr1.cc:951 data/yacc.c:1354
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s"
msgstr "ข้อผิดพลาดวากยสัมพันธ์, ไม่คาดว่าจะเป็น %s, คาดว่าจะเป็น %s หรือ %s หรือ %s"

#: data/glr.c:2097 data/lalr1.cc:952 data/yacc.c:1355
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s or %s"
msgstr "ข้อผิดพลาดวากยสัมพันธ์, ไม่คาดว่าจะเป็น %s, คาดว่าจะเป็น %s หรือ %s หรือ %s หรือ %s"

#: data/glr.c:2454 data/yacc.c:1433 data/yacc.c:1435 data/yacc.c:1613
