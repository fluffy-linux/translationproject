#: src/analyze.c:810 src/diff.c:1259
#, c-format
msgid "Files %s and %s differ\n"
msgstr "Файлы %s и %s различаются\n"

#: src/analyze.c:813
#, c-format
msgid "Binary files %s and %s differ\n"
msgstr "Двоичные файлы %s и %s различаются\n"

