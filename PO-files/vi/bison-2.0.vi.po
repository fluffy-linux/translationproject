#: src/getargs.c:194
msgid "GNU bison generates parsers for LALR(1) grammars.\n"
msgstr "Trình GNU bison tạo ra bộ phân tích cho ngữ pháp loại LALR(1).\n"

#: src/getargs.c:198
#, c-format
msgid "Usage: %s [OPTION]... FILE\n"
msgstr "Cách sử dụng: %s [TÙY_CHỌN]... TẬP_TIN\n"

#: src/getargs.c:202
msgid ""
"If a long option shows an argument as mandatory, then it is mandatory\n"
"for the equivalent short option also.  Similarly for optional arguments.\n"
msgstr ""
"Nếu môt tùy chọn dài phải có một đối số nào đó,\n"
"thì tùy chọn ngắn tương đương cũng vậy.\n"
"Trường hợp này cũng áp dụng vào đối số tùy chọn.\n"

#: src/getargs.c:208
msgid ""
"Operation modes:\n"
"  -h, --help      display this help and exit\n"
"  -V, --version   output version information and exit\n"
"  -y, --yacc      emulate POSIX yacc\n"
msgstr ""
"Chế độ thao tác:\n"
"  -h, --help      hiển thị _trợ giúp_ này rồì thoát\n"
"  -V, --version   xuất thông tin _phiên bản_ rồi thoát\n"
"  -y, --yacc      mô phỏng POSIX yacc\n"

#: src/getargs.c:215
msgid ""
"Parser:\n"
"  -S, --skeleton=FILE        specify the skeleton to use\n"
"  -t, --debug                instrument the parser for debugging\n"
"      --locations            enable locations computation\n"
"  -p, --name-prefix=PREFIX   prepend PREFIX to the external symbols\n"
"  -l, --no-lines             don't generate `#line' directives\n"
"  -n, --no-parser            generate the tables only\n"
"  -k, --token-table          include a table of token names\n"
msgstr ""
"Parser:\n"
"  -S, --skeleton=TẬP_TIN        ghi rõ sử dụng _khung sườn_ nào\n"
"  -t, --debug                buộc bộ phán tích xuất thông tin _gỡ lỗi_ chi tiết\n"
"      --locations            hiệu lực tính _vị trí_ các phần bộ nhớ\n"
"  -p, --name-prefix=TIỀN_TỐ   thêm _tiền tố_ ấy trước đầu các ký tự bên ngoại\n"
"  -l, --no-lines             _không_ tạo ra chỉ thị loại`#line'\n"
"  -n, --no-parser            chỉ tạo ra bảng (_không phân tích_)\n"
"  -k, --token-table          ibao gồm _bảng_ tên _hiệu bài_\n"

#: src/getargs.c:227
msgid ""
"Output:\n"
"  -d, --defines              also produce a header file\n"
"  -r, --report=THINGS        also produce details on the automaton\n"
"  -v, --verbose              same as `--report=state'\n"
"  -b, --file-prefix=PREFIX   specify a PREFIX for output files\n"
"  -o, --output=FILE          leave output to FILE\n"
"  -g, --graph                also produce a VCG description of the automaton\n"
msgstr ""
"Dữ liệu xuất:\n"
"  -d, --defines              cũng xuất tập tin đầu (_định nghĩa_)\n"
"  -r, --report=ĐIỀU        cũng xuất chi tiết về bộ tự động (_thông báo_)\n"
"  -v, --verbose              bằng tùy chọn `--report=state' (state: tính trạng; verbose: chi tiết)\n"
"  -b, --file-prefix=TIỀN_TỐ   ghi rõ _tiền tố_ ấy cho _tập tin_ xuất\n"
"  -o, --output=TẬP_TIN       _xuất_ các dữ liệu vào tập tin ấy\n"
"  -g, --graph                cũng xuất mô tả VCG về bộ tự động\n"

#: src/getargs.c:238
msgid ""
"THINGS is a list of comma separated words that can include:\n"
"  `state'        describe the states\n"
"  `itemset'      complete the core item sets with their closure\n"
"  `look-ahead'   explicitly associate look-ahead tokens to items\n"
"  `solved'       describe shift/reduce conflicts solving\n"
"  `all'          include all the above information\n"
"  `none'         disable the report\n"
msgstr ""
"ĐIỀU là danh sách những từ định giới bằng dấu phẩy có thể bao gồm:\n"
"  `state'        diễn tả những _tính trạng_\n"
"  `itemset'      làm xong những _bộ mục_ lỗi với kết thức của chúng\n"
"  `look-ahead'   liên quan một cách dứt khoát hiệu bài _«nhìn trước»_ với mục\n"
"  `solved'       diễn tả cách _quyết định_ sự xung đột dịch/giảm\n"
"  `all'          bao gồm _tất cả_ thông tin ở trên\n"
"  `none'         vô hiệu hóa thông báo (_không có_)\n"

