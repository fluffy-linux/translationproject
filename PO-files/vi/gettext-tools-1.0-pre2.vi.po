msgstr "      --fuzzy                 tương đương với “--only-fuzzy --clear-fuzzy”\n"

#: src/msgattrib.c:482
#, c-format
msgid "      --obsolete              synonym for --only-obsolete --clear-obsolete\n"
msgstr "      --obsolete              tương đương với “--only-obsolete --clear-obsolete”\n"

