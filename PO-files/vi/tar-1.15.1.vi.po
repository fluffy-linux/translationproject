msgstr "định dạng POSIX 1003.1-2001 (pax)"

#: src/tar.c:421
msgid "Same as pax"
msgstr "Giống như pax"

#: src/tar.c:424
msgid "same as --format=v7"
msgstr "giống như --format=v7"

#: src/tar.c:427
msgid "same as --format=posix"
msgstr "giống như --format=posix"

#: src/tar.c:428
msgid "keyword[[:]=value][,keyword[[:]=value], ...]"
msgstr "từ khóa[[:]=giá trị][,từ khóa[[:]=giá trị], ...]"

#: src/tar.c:429
msgid "control pax keywords"
msgstr "từ khóa điều khiển pax"

#: src/tar.c:430
msgid "TEXT"
msgstr "VĂN BẢN"

#: src/tar.c:431
msgid "create archive with volume name NAME. At list/extract time, use TEXT as a globbing pattern"
msgstr "tạo lưu trữ với tên khối TÊN. Tại thời điểm liệt kê/giải phóng, sử dụng VĂN BẢN làm mẫu toàn cầu"

#: src/tar.c:433
msgid "filter the archive through bzip2"
msgstr "lọc lưu trữ qua bzip2"

#: src/tar.c:435
msgid "filter the archive through gzip"
msgstr "lọc lưu trữ qua gzip"

#: src/tar.c:439
msgid "filter the archive through compress"
msgstr "lọc lưu trữ qua compress"

#: src/tar.c:441
msgid "PROG"
msgstr "CHƯƠNG TRÌNH"

#: src/tar.c:442
msgid "filter through PROG (must accept -d)"
msgstr "lọc qua CHƯƠNG TRÌNH (phải chấp nhận -d)"

#: src/tar.c:445
msgid "Local file selection:"
msgstr "Lựa chọn tập tin nội bộ:"

#: src/tar.c:447
msgid "DIR"
msgstr "THƯ MỤC"

#: src/tar.c:448
msgid "change to directory DIR"
msgstr "thay đổi tới thư mục THƯ MỤC"

#: src/tar.c:449
msgid "FILE-OF-NAMES"
msgstr "TẬP-TIN-TÊN"

#: src/tar.c:450
msgid "get names to extract or create from file NAME"
msgstr "lấy tên tập tin cần giải phóng hay tạo từ tập tin TÊN"

#: src/tar.c:452
msgid "-T reads null-terminated names, disable -C"
msgstr "-T đọc tên kết thúc vô hiệu lực, tắt -C"

#: src/tar.c:453
msgid "PATTERN"
msgstr "MẪU"

#: src/tar.c:454
msgid "exclude files, given as a PATTERN"
msgstr "loại trừ những tập tin tương ứng với MẪU"

#: src/tar.c:456
msgid "exclude patterns listed in FILE"
msgstr "loại trừ những mẫu liệt kê trong TẬP TIN"

#: src/tar.c:458
msgid "exclude directories containing a cache tag"
msgstr "loại trữ những thư mục chứa một thẻ ghi nhớ tạm"

#: src/tar.c:460
msgid "exclusion ignores case"
msgstr "sự loại trừ không kể đến chữ hoa hay chữ thường"

#: src/tar.c:462
msgid "exclude patterns match file name start"
msgstr "loại trừ những mẫu tương ứng với bắt đầu tên tập tin"

#: src/tar.c:464
msgid "exclude patterns match after any / (default)"
msgstr "loại trừ những mẫu tương ứng sau bất kỳ / nào (mặc định)"

#: src/tar.c:466
msgid "exclusion is case sensitive (default)"
msgstr "sự loại trừ có phân biệt chữ hoa chữ thường (mặc định)"

#: src/tar.c:468
msgid "exclude patterns are plain strings"
msgstr "loại trừ những mẫu là chuỗi đơn giản"

#: src/tar.c:470
msgid "exclude pattern wildcards do not match '/'"
msgstr "loại trừ những mẫu wildcard không tương ứng '/'"

#: src/tar.c:472
msgid "avoid descending automatically in directories"
msgstr "tránh sự giảm dần một cách tự động trong các thư mục"

#: src/tar.c:474
msgid "stay in local file system when creating archive"
msgstr "nằm trong hệ thống tập tin nội bộ khi tạo lưu trữ"

#: src/tar.c:477
msgid "recurse into directories (default)"
msgstr "đệ quy vào các thư mục (mặc định)"

#: src/tar.c:479
msgid "don't strip leading `/'s from file names"
msgstr "đừng bỏ `/' ở đầu tên tập tin"

#: src/tar.c:481
msgid "dump instead the files symlinks point to"
msgstr "dump tập tin mà liên kết mềm chỉ đến"

#: src/tar.c:482
msgid "MEMBER-NAME"
msgstr "TÊN-THÀNH-VIÊN"

#: src/tar.c:483
msgid "begin at member MEMBER-NAME in the archive"
msgstr "bắt đầu tại thành viên TÊN-THÀNH-VIÊN trong lưu trữ"

#: src/tar.c:485
msgid "strip NUMBER leading components from file names"
msgstr "bỏ đi thành phần số SỐ đứng đầu từ tên tập tin"

#: src/tar.c:486
msgid "DATE-OR-FILE"
msgstr "NGÀY-CỦA-TẬP-TIN"

#: src/tar.c:487
msgid "only store files newer than DATE-OR-FILE"
msgstr "chỉ chứa những tập tin mới hơn NGÀY-CỦA-TẬP-TIN"

#: src/tar.c:488 src/tar.c:490
msgid "DATE"
msgstr "NGÀY"

#: src/tar.c:489
msgid "compare date and time when data changed only"
msgstr "so sánh ngày và thời gian chỉ khi dữ liệu thay đổi"

#: src/tar.c:491
msgid "same as -N"
msgstr "giống như -N"

#: src/tar.c:492
msgid "CONTROL"
msgstr "ĐIỀU KHIỂN"

#: src/tar.c:493
msgid "backup before removal, choose version CONTROL"
msgstr "sao lưu trước khi xóa, chọn phiên bản ĐIỀU KHIỂN"

#: src/tar.c:494
msgid "STRING"
msgstr "CHUỖI"

#: src/tar.c:495
msgid "backup before removal, override usual suffix ('~' unless overridden by environment variable SIMPLE_BACKUP_SUFFIX"
msgstr "sao lưu trước khi xóa, ghi đè hậu tố thông thường ('~' trừ khi ghi đè bằng biến môi trường SIMPLE_BACKUP_SUFFIX"

#: src/tar.c:497
msgid "exclude patterns use wildcards (default)"
msgstr "loại trừ mẫu sử dụng các ký tự đặc biệt wildcard (mặc định)"

#: src/tar.c:499
msgid "exclude pattern wildcards match '/' (default)"
msgstr "loại trừ mẫu wildcard tương ứng '/' (mặc định)"

#: src/tar.c:502
msgid "Informative output:"
msgstr "Dữ liệu kết quả có tính thông tin:"

#: src/tar.c:505
msgid "verbosely list files processed"
msgstr "liệt kê một cách tỉ mỉ những tập tin được tiến hành"

#: src/tar.c:507
msgid "display progress messages every 10th record"
msgstr "hiển thị thông báo về tiến triển sau mỗi bản ghi thứ 10"

#: src/tar.c:509
msgid "print a message if not all links are dumped"
msgstr "in ra một thông báo nếu không phải tất cả các liên kết được dump"

#: src/tar.c:511
msgid "print total bytes written while creating archive"
msgstr "in ra tổng số byte được ghi khi tạo lưu trữ"

#: src/tar.c:513
msgid "print file modification dates in UTC"
msgstr "in ra ngày sửa đổi tập tin theo UTC"

#: src/tar.c:515
msgid "send verbose output to FILE"
msgstr "gửi kết quả chi tiết tới TẬP TIN"

#: src/tar.c:517
msgid "show block number within archive with each message"
msgstr "hiên thị số thứ tự khối trong lưu trữ với mỗi thông báo"

#: src/tar.c:519
msgid "ask for confirmation for every action"
msgstr "hỏi xác nhận trước mỗi hành động"

#: src/tar.c:522
msgid "Show tar defaults"
msgstr "Hiển thị mặc định của tar"

#: src/tar.c:524
msgid "When listing or extracting, list each directory that does not match search criteria"
msgstr "Khi liệt kê hay giải phóng, liệt kê mỗi thư mục không tương ứng với tiêu chí tìm kiếm"

#: src/tar.c:527
msgid "Compatibility options:"
msgstr "Tùy chọn tương thích:"

#: src/tar.c:530
msgid "when creating, same as --old-archive. When extracting, same as --no-same-owner"
msgstr "khi tạo, giống như --old-archive. Khi giải phóng, giống như --no-same-owner"

#: src/tar.c:533
msgid "Other options:"
msgstr "Những tùy chọn khác:"

#: src/tar.c:535
msgid "Give this help list"
msgstr "Đưa ra danh sách trợ giúp này"

#: src/tar.c:536
msgid "Give a short usage message"
msgstr "Đưa ra cách sử dụng ngắn gọn"

#: src/tar.c:537
msgid "Print license and exit"
msgstr "In ra bản quyền và thoát"

#: src/tar.c:538
msgid "Print program version"
msgstr "In ra phiên bản chương trình"

#: src/tar.c:575
msgid "You may not specify more than one `-Acdtrux' option"
msgstr "Không nên chỉ ra hai tùy chọn hoặc nhiều hơn trong số `-Acdtrux'"

#: src/tar.c:585
msgid "Conflicting compression options"
msgstr "Mâu thuẫn giữa các tùy chọn nén"

