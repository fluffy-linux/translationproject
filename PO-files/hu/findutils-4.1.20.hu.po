#: find/parser.c:557
msgid ""
"default path is the current directory; default expression is -print\n"
"expression may consist of:\n"
"operators (decreasing precedence; -and is implicit where no others are given):\n"
"      ( EXPR ) ! EXPR -not EXPR EXPR1 -a EXPR2 EXPR1 -and EXPR2\n"
msgstr ""
"az alapértelmezett útvonal az aktuális könyvtár; az alapértelmezett \n"
"kifejezés -print\n"
"kifejezés lehet:\n"
"operátorok (csökkenõ precedencia; alapértelmezett -and, ha nincs más megadva):\n"
"      ( KIF )\n"
"      ! KIF \n"
"      -not KIF\n"
"      KIF1 -a KIF2 \n"
"      KIF1 -and KIF2\n"

#: find/parser.c:562
msgid ""
"      EXPR1 -o EXPR2 EXPR1 -or EXPR2 EXPR1 , EXPR2\n"
"options (always true): -daystart -depth -follow --help\n"
"      -maxdepth LEVELS -mindepth LEVELS -mount -noleaf --version -xdev\n"
"tests (N can be +N or -N or N): -amin N -anewer FILE -atime N -cmin N\n"
msgstr ""
"      KIF1 -o KIF2\n"
"      KIF1 -or KIF2\n"
"      KIF1 , KIF2\n"
"\n"
"kapcsolók (mindig igaz): -daystart -depth -follow --help\n"
"      -maxdepth SZINT -mindepth SZINT -mount -noleaf --version -xdev\n"
"\n"
"próbák (N lehet +N vagy -N vagy N): -amin N -anewer FÁJL -atime N -cmin N\n"

#: find/parser.c:567
msgid ""
"      -cnewer FILE -ctime N -empty -false -fstype TYPE -gid N -group NAME\n"
"      -ilname PATTERN -iname PATTERN -inum N -ipath PATTERN -iregex PATTERN\n"
"      -links N -lname PATTERN -mmin N -mtime N -name PATTERN -newer FILE\n"
msgstr ""
"      -cnewer FÁJL -ctime N -empty -false -fstype TÍPUS -gid N -group NÉV\n"
"      -ilname MINTA -iname MINTA -inum N -ipath MINTA -iregex MINTA\n"
"      -links N -lname MINTA -mmin N -mtime N -name MINTA -newer FÁJL\n"

#: find/parser.c:571
msgid ""
"      -nouser -nogroup -path PATTERN -perm [+-]MODE -regex PATTERN\n"
"      -size N[bckw] -true -type [bcdpfls] -uid N -used N -user NAME\n"
"      -xtype [bcdpfls]\n"
msgstr ""
"      -nouser -nogroup -path MINTA -perm [+-]MÓD -regex MINTA\n"
"      -size N[bckw] -true -type [bcdpfls] -uid N -used N -user NÉV\n"
"      -xtype [bcdpfls]\n"

#: find/parser.c:575
msgid ""
"actions: -exec COMMAND ; -fprint FILE -fprint0 FILE -fprintf FILE FORMAT\n"
"      -ok COMMAND ; -print -print0 -printf FORMAT -prune -ls\n"
msgstr ""
"mûveletek: -exec PARANCS ; -fprint FÁJL -fprint0 FÁJL -fprintf FÁJL FORMÁTUM\n"
"      -ok PARANCS ; -print -print0 -printf FORMÁTUM -prune -ls\n"

