msgstr "%s: ameterekero agali mu agumenti n'ebigalimu mbigyewo? "

#: src/rm.c:368
#, c-format
msgid "%s: remove all arguments? "
msgstr "%s: byonna ebimenyedwa mu agumenti mbigyewo? "

