msgstr "Lupapula %<PRIuMAX>"

#: src/pr.c:2776
msgid ""
"Paginate or columnate FILE(s) for printing.\n"
"\n"
msgstr ""
"Ekiragiro kino ebiri mu FAYIRO kibitegeka ng'empapula z'ekitabo oba ne mu kolumu\n"
"esobole okulabika obulungi na kikubisidwa ku kyapa (pulinta).\n"
"\n"

#: src/pr.c:2783
msgid ""
"  +FIRST_PAGE[:LAST_PAGE], --pages=FIRST_PAGE[:LAST_PAGE]\n"
"                    begin [stop] printing with page FIRST_[LAST_]PAGE\n"
"  -COLUMN, --columns=COLUMN\n"
"                    output COLUMN columns and print columns down,\n"
"                    unless -a is used. Balance number of lines in the\n"
"                    columns on each page.\n"
msgstr ""
" +OLUSOOKERWAKO[:OLW'OKUMALIRAKO], --pages=OLUSOOKERWAKO[:OLW'OKUMALIRAKO]\n"
"                      Kano akawayiro kaleetera ekiragiro okutandikira ku lupapula olw'omu FAYIRO\n"
"                      OLUSOOKERWAKO n'okumilira ku lupapula [OLW'OKUMALIRAKO]\n"
"  -KOLUMU, --columns=KOLUMU\n"
"                      Kano akawayiro kaleetera ekiragiro okutegeka bye kisanga mu FAYIRO mu kolumu\n"
"                      ebigoberera binnabyo nga bidda wansi wabyo, okugyako nga kuliko n'akawyiro '-a'.\n"

#: src/pr.c:2791
msgid ""
"  -a, --across      print columns across rather than down, used together\n"
"                    with -COLUMN\n"
"  -c, --show-control-chars\n"
"                    use hat notation (^G) and octal backslash notation\n"
"  -d, --double-space\n"
"                    double space the output\n"
msgstr ""
"  -a. --across        Kano akawayiro kaleetera ekiragiro ebyandibadde bidda wanis wa binnabyo mu\n"
"                      kolumu okubitegeka nga bidda kyabugazi. Akawayiro kano kakola nga okozesezza\n"
"                      ne '-KOLUMU'\n"
"  -c, --show-control-chars\n"
"                      Kano akawyiro kaleetera ekiragiro okuwandikawo n'obubonero obufuzi obutalagibwa\n"
"                      bulijjo (okugeza nga^G)\n"
"  -d, --double-space\n"
"                      Kano akawayiro kaleetera ekiragiro okuteekangawo olunyiriri olwereere wakati\n"
"                      w'ennyiriri ezidirinngana eziva mu FAYIRO\n"

#: src/pr.c:2799
msgid ""
"  -D, --date-format=FORMAT\n"
"                    use FORMAT for the header date\n"
"  -e[CHAR[WIDTH]], --expand-tabs[=CHAR[WIDTH]]\n"
"                    expand input CHARs (TABs) to tab WIDTH (8)\n"
"  -F, -f, --form-feed\n"
"                    use form feeds instead of newlines to separate pages\n"
"                    (by a 3-line page header with -F or a 5-line header\n"
"                    and trailer without -F)\n"
msgstr ""
" -D, --date-format=NTEREEZA\n"
"                      Kano akawayiro kafuga engeri ekiragiro gye kiwandikamu obudde mu mitwe\n"
"                      gy'empapula ze kikola mu biva mu FAYIRO. Obubonero bw'ossa awali ekigambo\n"
"                      NTEREEZA kibiwandikawo nga tekibikyusizzaako (okugyako obusookerwako '%')\n"
"                      Okugeza, bw'owandika --date-format=\"Balaza Lwaggulo\", mu mutwe gwa buli\n"
"                      lupapula 'pr' lwe kikola mu biva mu FAYIRO kiwandikamu nti Balaza Lwaggulo.\n"
"  -e[LUSEETUKA[BUNGI]], --expand-tabs[=LUSETUKA[BUNGI]]\n"
"                      Kano akawayiro kaleetera ekiragiro buli we kisanga obubonero obutegeeza nti\n"
"                      awo waliwo oluseetuka nga kikola ku FAYIRO, mu bye kifulumya kisseewo akabangirizi.\n"
"                      Singa mu FAYIRO tebaakozesa obubonero obulaga enseetuka obwa bulijjo, awali\n"
"                      ekikongozzi LUSEETUKA ossaawo obubonero bwebaakozesezza. Obubonero obwo bwe\n"
"                      bwe buba nga obungi bwabwo bwanjawulo ku obwa bulijjo, awali ekikongozzi BUNGI\n"
"                      w'owandikira obungi bw'obubonero bwebaakozesezza.\n"
"  -F, -f --form-feed\n"
"                      Kano akawayiro kaleetera ekiragiro, bwe kituuka ku nkomeroro ey'olupapula,\n"
"                      okussaawo obubonero obufuzi obuleetawo okukyusa lupapula mukifo eky'obulagira\n"
"                      kutandika lunyiriri lupya obw'emirundi esatu\n"

#: src/pr.c:2809
msgid ""
"  -h HEADER, --header=HEADER\n"
"                    use a centered HEADER instead of filename in page header,\n"
"                    -h \"\" prints a blank line, don't use -h\"\"\n"
"  -i[CHAR[WIDTH]], --output-tabs[=CHAR[WIDTH]]\n"
"                    replace spaces with CHARs (TABs) to tab WIDTH (8)\n"
"  -J, --join-lines  merge full lines, turns off -W line truncation, no column\n"
"                    alignment, --sep-string[=STRING] sets separators\n"
msgstr ""
"  -h MUTWE, --header=MUTWE\n"
"                      Kano akawayiro kaleetera ekiragiro, bwe kiba kiwandika emitwe ku mpapula ze kikolawo,\n"
"                      okussaawo ebigambo by'otadde awali ekikongozzi MUTWE mu kifo eky'ebya bulijjo.\n"
"                      Ebigambo by'oteekawo biteekwa okusookerawko ka ' era ne bikomekkerezebwako ka '.\n"
"                      Kulabula: bw'obanga oyagala omutwe gube nga temuli bigambo okuzesanga -h \"\"\n"
"                      tokozesa -h\"\"\n"
"  -i[KABONERO[BUNGI]], --output-tabs[=KABONERO[BUNGI]]\n"
"                      Kano akawayiro kaleetera ekiragiro okuteekawo oluseetuka buli awandibade akabanga aka\n"
"                      bulijjo. Ob'oyagala akabonero akatali ak'okoluseetuka aka bulijjo, kateeke awali ekikongozzi\n"
"                      KABONERO. Bw'oba oyagala enseetuka ezo zimalewo ebifo eby'obubonero ebisukka oba\n"
"                      ebitawera munaana ebya bulijjo, obungi obwo buteeke awali ekikongozzi BUNGI\n"
"  -j, --join-lines    Kano okukakozesa kateekwa okubaako ne kamu ku buwayiro -column, -a -column\n"
"                      oba -m. Kaleetera ekiragiro obutakutula mu nnyiriri ze kisanga mu FAYIRO ezisinga\n"
"                      kolumu emu obugazi. Bwe kiziwandika ezo, ziba ziyitamu mu kolumu nga zikozesezza\n"
"                      n'amabanga agandibadde g'awula kolumu zazo. Akawayiro kano kasobola\n"
"                      okukozesebwa n'aka '--sep-string'\n"

#: src/pr.c:2818
msgid ""
"  -l PAGE_LENGTH, --length=PAGE_LENGTH\n"
"                    set the page length to PAGE_LENGTH (66) lines\n"
"                    (default number of lines of text 56, and with -F 63)\n"
"  -m, --merge       print all files in parallel, one in each column,\n"
"                    truncate lines, but join lines of full length with -J\n"
msgstr ""
"  -l NNYIRIRI, --length=NNYIRIRI\n"
"                      Kano akawayiro kakyusa obungi bw'ennyiriri eziba ku buli lupapula olukolebwawa okuva\n"
"                      ku 66 eza bulijjo (okwo 56 ze zibeera ebivudde mu FAYIRO oba, bwe kubaako akawayiro\n"
"                      '-F', 63). Ekikongozzi NNYIRIRI z'ennyiriri z'oyagala ziwezenga olupapula. Bwe zitasukka\n"
"                      mu kkumi (oba 3 nga '-F' kwekali) ekiragiro empapula tekiziteekako mitwe era kirekayo\n"
"                      n'okuteekangamu obubonero obulagira kutandika lupya\n"
"  -m, --merge         Kano bwe kabeerako, buli FAYIRO ekiragiro kigiteeka mu kolumu ya yo. Ennyiriri\n"
"                      ezisinga kolumu obugazi zisalwako, ebitundu ebiyitamu ne bitawandikibwa. \n"
"                      Akawayiro kano kasobola kukolagana n'aka '-J'\n"

#: src/pr.c:2825
msgid ""
"  -n[SEP[DIGITS]], --number-lines[=SEP[DIGITS]]\n"
"                    number lines, use DIGITS (5) digits, then SEP (TAB),\n"
"                    default counting starts with 1st line of input file\n"
"  -N NUMBER, --first-line-number=NUMBER\n"
"                    start counting with NUMBER at 1st line of first\n"
"                    page printed (see +FIRST_PAGE)\n"
msgstr ""
"  -n[AK'AWULA[DIGITI], --number-lines[=AK'AWULA[DIGITI]]\n"
"                       Buno obuwayiro buleetera ekiragiro okuteekako ennamba ku ntandikwa\n"
"                       za buli lunyiriri lwe kiwandika. Ennamba ezo ziba za digiti DIGITI okugyako\n"
"                       nga ekifo eky'ekikongozi DIGITI okireka nga kyereere. Olwo ennamba ezo\n"
"                       ziba za digiti 5. Ennamba ezo zigobererwa obubonero bwossa mu kifo\n"
"                       eky'ekikongozi AKAWULA nga bwe buz'awula ku birala ebiri ku lunyiriri olwo.\n"
"                       singa ekifo eky'ekikongozi AKAWULA okireka nga kyereere zi-taabu za ziba\n"
"                       nga z'awula ennamba ezo ku birala ebiri ku lunyiriri.\n"
"  -N NAMBA, --first-line-number=NAMBA\n"
"                       Buno bwo buleetera ekiragiro okuwandika ennamba nga mu kifo eky'okabala\n"
"                       okuva ku 1, kitandikira ku NAMBA, ate ennamba kiziwandika ne ku nnyiriri\n"
"                       ezikulembera n'ezigoberera ezo eziriko ebiva mu FAYIRO ekolebwako\n"

#: src/pr.c:2833
msgid ""
"  -o MARGIN, --indent=MARGIN\n"
"                    offset each line with MARGIN (zero) spaces, do not\n"
"                    affect -w or -W, MARGIN will be added to PAGE_WIDTH\n"
"  -r, --no-file-warnings\n"
"                    omit warning when a file cannot be opened\n"
msgstr ""
"  -o BUNGI, --indent=BUNGI\n"
"                       Buno obuwayiro buleetera ekiragiro okuyisawo obubanga BUNGI\n"
"                       ne kiryoka kitandika kuwandikawo ebiri ku lunyiriri. Kino tekikyusa\n"
"                       obungi bw'obubonero obuwandikibwa mu lunyiriri obwateekedwa\n"
"                       nga weyambisa obuwayiro '-w' oba ';W'\n"
"  -r, --no-file-warnings\n"
"                       Buno obukozesa nga toyagala ekiragiro kikulabule nga kiremedwa\n"
"                       okuggula FAYIRO\n"

#: src/pr.c:2840
msgid ""
"  -s[CHAR],--separator[=CHAR]\n"
"                    separate columns by a single character, default for CHAR\n"
"                    is the <TAB> character without -w and 'no char' with -w\n"
"                    -s[CHAR] turns off line truncation of all 3 column\n"
"                    options (-COLUMN|-a -COLUMN|-m) except -w is set\n"
msgstr ""
"  -s[KABONERO],  --separator[=KABONERO]\n"
"                       Buno obuwayiro buleetera ekiragiro okuwandikawo KABONERO\n"
"                       okulaga kolumu emu gy'ekoma endala n'etandika. Obuwayiro\n"
"                       buno awali KABONERO bw'olekawo nga wereere ekiragiro kiwan-\n"
"                       dikawo akabonero ak'oluseetuka okulaga kolumu gy'ekoma endala\n"
"                       n'etandika. Sso bw'obukozesez'awamu n'aka '-w' n'oleka awali\n"
"                       KABONERO nga wereere olwo ekiragiro kolumu tekiz'awulamu,\n"
"                       olumala kuwandika ennukuta esembayo ku kolumu emu kizaako\n"
"                       etandika eddako.\n"
"                       Akawayiro -s bw'okakozesez'awmu ne kamu ku buno: -KOLUMU,\n"
"                       -a -KOLUMU oba -m, kaleetera ekiragiro butatemamu ennyiriri\n"
"                       ze kigye mu FAYIRO nga kigeza okuzigyisa mu zi-kolumu. Bwe\n"
"                       kubeerako n'aka -w ate ekiragiro kisigala ennyiriri kizitemamu\n"

#: src/pr.c:2847
msgid "  -SSTRING, --sep-string[=STRING]\n"
msgstr "  -SBUBONERO, --sep-string[=BUBONERO]\n"

#: src/pr.c:2850
msgid ""
"                    separate columns by STRING,\n"
"                    without -S: Default separator <TAB> with -J and <space>\n"
"                    otherwise (same as -S\" \"), no effect on column options\n"
"  -t, --omit-header  omit page headers and trailers\n"
msgstr ""
"  -SBUBONERO, --sep-string[=BUBONERO]\n"
"                    Obuwayiro buno buleetera ekiragiro okuwandikangawo\n"
"                    BUBONERO okulaga nti kolumu emu w'ekoma n'endala\n"
"                    w'etandikira Buno obuwayiro bwe bukozesebwa nga\n"
"                    kuliko n'akamu ku '-w' oba '-W', enkola ya '-W' ne\n"
"                   '-w' tekyukako, obutafaanana n'aka '-s'.\n"
"  -t, --omit-header   Kano ko kakireetera butawandikawo mitwe n'obugambo\n"
"                    obuba ku nkomerero ez'empapula\n"

#: src/pr.c:2856
msgid ""
"  -T, --omit-pagination\n"
"                    omit page headers and trailers, eliminate any pagination\n"
"                    by form feeds set in input files\n"
"  -v, --show-nonprinting\n"
"                    use octal backslash notation\n"
"  -w PAGE_WIDTH, --width=PAGE_WIDTH\n"
"                    set page width to PAGE_WIDTH (72) characters for\n"
"                    multiple text-column output only, -s[char] turns off (72)\n"
msgstr ""
"  -T, --omit-pagination\n"
"                       Bw'okozesa kamu ku buno obuwayiro kaleetera ekiragiro obutawandika\n"
"                       mitwe gy'empapula era ne kitateekamu obubonero obulagira kutandika\n"
"                       lupapula lupya mu bye kiwandika\n"
"  -v, --show-nonprinting\n"
"                       Bw'okozesa kamu ku buno obuwayiro kaleetera ekiragiro okulaga n'obubonero\n"
"                       obutalabika bulijjo. Kibuwandikira mu mpandika eya ki-okita\n"
"  -w BUNGI, --width=BUNGI\n"
"                       Buno obuwayiro tebukola okugyako nga okzesezza n'akaleetawo kolumu ezisoba\n"
"                       mu emu. bw'okozesa kamu ku buwayiro buno kaleetera ekiragiro okukomanga ku\n"
"                       bubonero BUNGI ku buli lunyiriri oluwandikibwa. Kolumu bw'eb'emu obuwayiro\n"
"                       buno tebulina kye bukolawo\n"

#: src/pr.c:2866
msgid ""
"  -W PAGE_WIDTH, --page-width=PAGE_WIDTH\n"
"                    set page width to PAGE_WIDTH (72) characters always,\n"
"                    truncate lines, except -J option is set, no interference\n"
"                    with -S or -s\n"
msgstr ""
" -W BUNGI, --page-width=BUNGI\n"
"                       Bw'okozesa kamu ku buno obuwayiro kaleetera ekiragiro okukomanga\n"
"                       ku bubonero BUNGI ku buli lunyiriri lwe kiwandika. Buno tebufaayo oba\n"
"                       waliwo obuwayiro obulagira kolumu ezisoba mu emu oba tebuliwo nga\n"
"                       kolumu ejjakuba emu yokka. Ekiragiro mu FAYIRO bwe kisangamu\n"
"                       ennyiriri esinga kolumu obugazi ezo kizitemamu, okujjako nga otaddewo\n"
"                       n'akawyiro '-J', Kolumu bw'eba eri emu yokka ekiragoro ennyiriri tekizite-\n"
"                       mamu. Bwo obuwayiro '-s' ne '-S' tebulina kye bukyusa ku nkola eya buno\n"

#: src/pr.c:2874
msgid ""
"\n"
"-t is implied if PAGE_LENGTH <= 10.  With no FILE, or when\n"
"FILE is -, read standard input.\n"
msgstr ""
"\n"
"singa BUNGI kiba 10 oba wansi ekiragiro tekiwandikawo mitwe\n"
"gy'empapula era kirekayo okuwandika obubonero obulagira\n"
"kutandika lupya bwe kisanga mu FAYIRO. kwe kugamba nti kyeyisa\n"
"nga eyakozesezza n'akawayiro '-t'. Agumenti eya FAYIRO\n"
"bw'otogiteeka ku kiragiro, kyo kirinda kukola ku by'owandika\n"
"awayingizibwa awa bulijjo.\n"

#: src/printenv.c:61
#, c-format
msgid ""
"Usage: %s [VARIABLE]...\n"
"  or:  %s OPTION\n"
"If no environment VARIABLE specified, print them all.\n"
"\n"
msgstr ""
"Enkozesa y'ekiragiro kino eri: %s [KIGAMBO]...\n"
"  oba:  %s KAWAYIRO\n"
"Kino kiwandikawo ekikongojjedwa mu kigambo ekifuga nzivvuunuzi KIGAMBO.\n"
"Bw'obanga totaddewo KIGAMBO, ekiragiro kiwandikawo ebikongojjedwa mu\n"
"buli kigambo ekifuzi ekikola enviromenti yo.\n"
"\n"

#: src/printf.c:79
#, c-format
msgid "warning: %s: character(s) following character constant have been ignored"
msgstr "kulabula: wayongedeko :%s ku bubonero obuvamu ennamba. Bwebityo tebikolebwako"

#: src/printf.c:92
#, c-format
msgid ""
"Usage: %s FORMAT [ARGUMENT]...\n"
"  or:  %s OPTION\n"
msgstr ""
"Enkozesa y'ekiragiro kino eri: %s EMPANDIKA [AGUMENTI]...\n"
"  oba:  %s KAWAYIRO\n"

#: src/printf.c:97
msgid ""
"Print ARGUMENT(s) according to FORMAT, or execute according to OPTION:\n"
"\n"
msgstr ""
"Ekiragiro kino kiwandikawo AGUMENTI nga kikozesa EMPANDIKA, oba kikola\n"
"omulimu nga gufugibwa KAWAYIRO:\n"
"\n"

#: src/printf.c:103
msgid ""
"\n"
"FORMAT controls the output as in C printf.  Interpreted sequences are:\n"
"\n"
"  \\\"      double quote\n"
"  \\NNN    character with octal value NNN (1 to 3 digits)\n"
"  \\\\      backslash\n"
msgstr ""
"\n"
"EMPANDIKA efuga ekiragiro bye kiwandika mu ngeri y'emu ne printf ey'omu lulimi C\n"
"Ekiragiro kitegeera EMPANDIKA zino:\n"
"\n"
"  \\\"     Bw'ossaawo kino ekiragiro kiwandikawo ak'ogeza, \" \n"
"  \\NNN    Obubonero 'NNN' ekiragiro kibutwala nga ennamba ey'omu\n"
"           okita (esobola okuba ne digiti 1, 2 oba 3) ne kiwandikawo\n"
"           akabonero akakwatagana nayo\n"
"  \\\\     Bw'ossaawo kino ekiragiro kiwandikawo ka \\ \n"

#: src/printf.c:111
msgid ""
"  \\a      alert (BEL)\n"
"  \\b      backspace\n"
"  \\c      produce no further output\n"
"  \\f      form feed\n"
msgstr ""
"  \\a      Bwe kisangawo kano kiwandikawo akabonero akalagira kompyuta\n"
"           ebeko kyekolawo okulaga we kituuse ku mulimu (BEL)\n"
"  \\b      Bwe kisangawo kano akabonero akakakulembera tekikawandikawo\n"
"  \\c      Bwe kisangawo kano ebikaddako tekibiwandikawo\n"
"  \\f      Bwe kisangawo kano kiwandikawo akabonero akalagira kompyuta\n"
"           kukolawo olupapula olupya\n"

#: src/printf.c:117
msgid ""
"  \\n      new line\n"
"  \\r      carriage return\n"
"  \\t      horizontal tab\n"
"  \\v      vertical tab\n"
msgstr ""
"  \\n      Kano akawayiro kakireetera okutandika olunyiriri olupya\n"
"  \\r      Akawayiro kano kakireetera okuwandikawo akabonero akalagira\n"
"           ekintu ekisoma bye kikoze, bwe kiba nga kibiwandika, okudda\n"
"           ku ntandikwa y'olunyiriri\n"
"  \\t      Kano kakireetera okuteekawo oluseetuka\n"
"  \\v      Kano ko kakireetera kugenda ku lunyiriri olupya kiryoke kiteekewo oluseetuka\n"

#: src/printf.c:123
msgid ""
"  \\xHH    byte with hexadecimal value HH (1 to 2 digits)\n"
"  \\uHHHH  Unicode (ISO/IEC 10646) character with hex value HHHH (4 digits)\n"
"  \\UHHHHHHHH  Unicode character with hex value HHHHHHHH (8 digits)\n"
msgstr ""
"  \\xHH    Ekiragiro bwe kisangawo kano, kikatwala nga bayiti emu eya ki-\n"
"           hekisi, era ne kiwandikawo obubonero obugendana n'ennamba\n"
"           ey'omu hekisi NN. Ennamba eyo esobola okubaamu digiti 1 oba 2\n"
"  \\uHHHH  Kano katwalibwa nga ekigamba ekiragiro okuwandikawo obubonero\n"
"           obugendana n'ennamba eya ki-hekisi NNNN. Ennamba eyo nga erimu\n"
"           digiti 4.\n"
"  \\UHHHHHHHH  Kano ate katwalibwa nga ekigamba ekiragiro okuwandikawo\n"
"           obubonero obugendana n'ennamba eya ki-hekisi HHHHHHHH. Ennamba\n"
"           eyo nga erimu digiti 8.\n"

#: src/printf.c:128
msgid ""
"  %%      a single %\n"
"  %b      ARGUMENT as a string with `\\' escapes interpreted,\n"
"          except that octal escapes are of the form \\0 or \\0NNN\n"
"\n"
"and all C format specifications ending with one of diouxXfeEgGcs, with\n"
"ARGUMENTs converted to proper type first.  Variable widths are handled.\n"
msgstr ""
"  %%      Kano kakireetera okuwandikawo ka % kamu\n"
"  %b      Akawayiro kano kategeeza ekiragiro nti bwe kisanga ka\n"
"          '\\' mu agumenti, kikabale nga akafuula en'eyisa ey'obubonero\n"
"          Olwo \\0NNN kitegeeza nti NNN namba ya ki-okita\n"
"\n"
"Ekiragiro kino kitegeera n'ebiragiro ebifuga empandika eby'ekika kya C\n"
"ebikomekkerezebwa emu ku nukuta d, i, o, u, x, X, f, e, E, g, G, c ne s.\n"
"Okugoberera ebiragiro ebyo kisooka okutegeka ebiri mu AGUMENTI. Obungi\n"
"bw'obubonero obuli mu AGUMENTI tebuliko bukwakkulizo.\n"

#: src/printf.c:153
#, c-format
msgid "%s: expected a numeric value"
msgstr "%s: wano wateekwa kubawo ennamba, So ssi nnukuta"

#: src/printf.c:155
#, c-format
msgid "%s: value not completely converted"
msgstr "%s: obubonero bumu bwokka bwe bukoledwako"

#: src/printf.c:249 src/printf.c:276
#, c-format
msgid "missing hexadecimal number in escape"
msgstr "ku kabonero akufuula bunnaako mu ki-hekisi totaddeko ennamba"

#: src/printf.c:288
#, c-format
msgid "invalid universal character name \\%c%0*x"
msgstr "\\%c%0*x tekikola ng'erinnya ly'akabonero ak'omuttuluba ttababyonna"

#: src/printf.c:549
#, c-format
msgid "invalid field width: %s"
msgstr "ekitundu tekikkirizibwa kwenkana awo: %s"

#: src/printf.c:584
#, c-format
msgid "invalid precision: %s"
msgstr "obwo obungi bwa digiti ezigoberera akatonyeze tebukkirizibwa: %s"

#: src/printf.c:611
#, c-format
msgid "%.*s: invalid conversion specification"
msgstr "empandika eya %.*s tekkirizibwa"

#: src/printf.c:682
#, c-format
msgid "warning: ignoring excess arguments, starting with %s"
msgstr "kulabula: agumenti ez'enfissi, okuva ku %s, tezigenda kukolerwako"

#. TRANSLATORS: Please translate "F. Pinard" to "François Pinard"
#. if "ç" (c-with-cedilla) is available in the translation's character
#. set and encoding.
#. This is a proper name. See the gettext manual, section Names.
#: src/ptx.c:40
msgid "F. Pinard"
msgstr "F. Pinard"

#: src/ptx.c:427
#, c-format
msgid "%s (for regexp %s)"
msgstr "%s (ku mboozi enoonya zinnewayo %s)"

#: src/ptx.c:1888
#, c-format
msgid ""
"Usage: %s [OPTION]... [INPUT]...   (without -G)\n"
"  or:  %s -G [OPTION]... [INPUT [OUTPUT]]\n"
msgstr ""
"Enkozesa entuufu eri: %s [KAWAYIRO]... [EBY'OKUKOLAKO]... (nga tokozesa -G)\n"
"  oba: %s -G [KAWAYIRO]... [EBY'OKUKOLAKO [EBIVAAMU]]\n"

#: src/ptx.c:1892
msgid ""
"Output a permuted index, including context, of the words in the input files.\n"
"\n"
msgstr ""
"Ekiragiro kino kisoma by'okiwadde okukolako ne kisengeka buli kigambo okukolamu\n"
"olukalala olulaga buli ekigambo ekyo we kirabikira. Ekigambo buli we kilabika, ekiragiro\n"
"kiraga n'ebyo ebikiri okumpi okugeza, bw'obera ne fayiro erimu ebigambo bino:\n"
"\n"
"    mese nsolima ssi nnungi naye mese ey'omosonso nnungi sso ndiga zonna nnungi  \n"
"\n"
"ekiragiro kino bwe kikola ku fayiro eyo ebivaamu bifaananamu bityi:\n"
"\n"
"       /nsolima ssi nnungi naye mese   ey'omosonso nnungi sso ndiga zonna/\n"
"   ey'omosonso nnungi sso/             mese nsolima ssi nnungi naye mese\n"
"        mese nsolima ssi nnungi naye   mese ey'omosonso nnungi sso ndiga/\n"
"             mese nsolima ssi nnungi   naye mese ey'omosonso nnungi sso/\n"
"         mese ey'omosonso nnungi sso   ndiga zonna nnungi      /nnungi naye\n"
"   nnungi sso/      mese nsolima ssi   nnungi naye mese ey'omosonso\n"
"       /nnungi naye mese ey'omosonso   nnungi sso ndiga zonna nnungi\n"
"     omosonso nnungi sso ndiga zonna   nnungi                     /mese ey'\n"
"   omosonso nnungi sso/         mese   nsolima ssi nnungi naye mese ey'\n"
"\n"

#: src/ptx.c:1899
msgid ""
"  -A, --auto-reference           output automatically generated references\n"
"  -G, --traditional              behave more like System V `ptx'\n"
"  -F, --flag-truncation=STRING   use STRING for flagging line truncations\n"
msgstr ""
"  -A, --auto-reference           bw'ossaako kamu ku buno, ekiragiro, ku ntandikwa\n"
"                                 ya buli lunyiriri mu ebivaamu, kiwandikawo erinnya\n"
"                                 lya fayiro ekolebwako ko n'olunyiriri olukolebwako\n"
"  -G, --traditional              Buno bukireetera okweyisa nga ptx ey'omu 'System V'\n"
"  -F, --flag-truncation=BUBONERO   Buno bwo bukireetera okussawo BUBONERO buli we\n"
"                                 kiba kitemyemu olunyiriri olw'ebikolebwako\n"

#: src/ptx.c:1904
msgid ""
"  -M, --macro-name=STRING        macro name to use instead of `xx'\n"
"  -O, --format=roff              generate output as roff directives\n"
"  -R, --right-side-refs          put references at right, not counted in -w\n"
"  -S, --sentence-regexp=REGEXP   for end of lines or end of sentences\n"
"  -T, --format=tex               generate output as TeX directives\n"
msgstr ""
"  -M, --macro-name=BUBONERO        Kano kaleetera ekiragiro okuwandikawo BUBONERO mu kifo ky `xx'\n"
"                                   ku ntandikwa z'ennyiriri ze kiwandika ezikola nga ebiragiro eby'omu\n"
"                                  'roff', 'nroff' oba 'TeX'\n"
"  -O, --format=roff                Kano ke kawayiro akakireetera okutegeka ebivaamu bisobole okukozesebwa\n"
"                                   mu puloguramu eya 'roff'\n"
"  -R, --right-side-refs            Bw'ob'otaddeko n'akawayiro akeleetera ekiragiro okulambanga buli\n"
"                                   lunyiriri olw'ebi- vaamu, kano ate kakireetera okuwandika okulamb'okwo\n"
"                                   ku ludda olwa ddyo - ku nkomerero z'ennyiriri mu kifo kya ku ntandikwa\n"
"  -S, --sentence-regexp=MBOOZI     Kano kategeeza nti ekiragiro mu bye kikolako buli lwe kituuka awali ebi-\n"
"                                   faanagana n'ebiri mu MBOOZI kijjanga kubala nti olunyiriri lukomye, \n"
"                                   ebiddako nga kibiyisa nga olunyiriri olupya\n"
"  -T, --format=tex                 Kano ko kakireetera okutegeka ebivaamu bisobole okukozesebwa mu\n"
"                                   puloguramu eya 'TeX'\n"

#: src/ptx.c:1911
msgid ""
"  -W, --word-regexp=REGEXP       use REGEXP to match each keyword\n"
"  -b, --break-file=FILE          word break characters in this FILE\n"
"  -f, --ignore-case              fold lower case to upper case for sorting\n"
"  -g, --gap-size=NUMBER          gap size in columns between output fields\n"
"  -i, --ignore-file=FILE         read ignore word list from FILE\n"
"  -o, --only-file=FILE           read only word list from this FILE\n"
msgstr ""
"  -W, --word-regexp=BUBONERO       Kano akawayiro kakyusa engeri ekiragiro gye kitegeeramu nti\n"
"                                   kisanze ekigambo ekyetaaga kukolebwako. Kasita kituuka ku bubonero obukwa-\n"
"                                   tagana ne BUBONERO olwo nga kimayi nti ekyo kigambo kyakukolebwako. Mu\n"
"                                   ebya bulijjo, nga kano akawayiro tekaliko era n'aka `-G' nako nga tekaliko,\n"
"                                   kasita kisanga ekirimu obubonero nga nnukuta ekyo kikibala ng'ekigamba\n"
"                                   ekiky'okukolako\n"
"  -b, --break-file=FAYIRO          Kano akawayiro okeyambisa okyusa engeri ekiragiro gye kitegeeramu nti\n"
"                                   ekigambo kikomye. FAYIRO ogiwandikamu obwo obubonero bwonna bw'osazewo\n"
"                                   nti tebusobola kuba mu kigambo eky'okukolako. Olwo ekiragiro buli lwe\n"
"                                   kituuka ku kabonero akali mu FAYIRO nga kimanyi nti kimazeko ekigambo\n"
"  -f, --ignore-case                Kano ate kakireetera obutayawula mu nnukuta nnene n'entono bwe kiba \n"
"                                   kisengeka bigambo\n"
"  -g, --gap-size=BIFO              Kano ate ke kafuga obungi bw'ebifo ebyereere ekiragiro bye kiteeka wakati\n"
"                                   w'ebitundu by'ennyiriri ez'omu bivaamu. Ennamba gy'oteeka awali BIFO bye\n"
"                                   ebifo ebyereere ebisinga obutono obukkirizibwa okubeerawo\n"
"  -i, --ignore-file=FAYIRO         Bw'okozesa akawayiro kano, buli kigambo ky'owandika mu FAYIRO ekiragiro\n"
"                                   tekikikolako era mu lukalala olukolebwawo tekibaamu\n"
"  -o, --only-file=FAYIRO           Kano ko bw'okakozesa olwo ekigambo ky'otatadde mu FAYIRO ekiragiro\n"
"                                   tekikikolako era mu lukalala olukolebwawo tekibaamu\n"

#: src/ptx.c:1919
msgid ""
"  -r, --references               first field of each line is a reference\n"
"  -t, --typeset-mode               - not implemented -\n"
"  -w, --width=NUMBER             output width in columns, reference excluded\n"
msgstr ""
"  -r, --references                 Kano kaleetera ekiragiro okulamba buli lunyiriri olw'ebivaamu nga\n"
"                                   kilusoosaako ekigambo kye kisoose okusoma ku lunyiriri olw'ebyo bye kikolako\n"
"  -t, --typeset-mode               - Kano tekalina kye kakolawo -\n"
"  -w, --width=BUNGI                Kano akawayiro kafuga obuwanvu bw'ennyiriri ez'omu bivaamu, ng'obubalidde \n"
"                                   mu bungi bw'ennukuta ezikkirizibwa okuwandikibwawo. Obungi obwo tebubaliramu\n"
"                                   ennukuta ezo ezikola ebigambo ebikozesebwa okulamba ennyiriri ezo\n"

#: src/ptx.c:1926
msgid ""
"\n"
"With no FILE or if FILE is -, read Standard Input.  `-F /' by default.\n"
msgstr ""
"\n"
"Ekiragiro kino bw'okiyisa nga tolaze FAYIRO oba bw'oteekawo ka - awali\n"
"FAYIRO kirinda kusoma ebiva awayingizibwa awa bulijjo. Ekiragiro kikola\n"
"nga eyataddewo akawayiro `-F /' okugyako ng'otaddewo ekirala.\n"

#: src/ptx.c:2020
#, c-format
msgid "invalid gap width: %s"
msgstr "obunene obw'ekibangirizi, %s, tebukkirizibwa"

#: src/pwd.c:54
msgid ""
"Print the full filename of the current working directory.\n"
"\n"
msgstr ""
"Ekiragiro kino kiwandika erinnya erijjuvu ery'etterekero mwe kiweeredwa.\n"
"\n"

#: src/pwd.c:159
#, c-format
msgid "failed to chdir to %s"
msgstr "nnemedwa kukyusa kudda mu tterekero %s"

#: src/pwd.c:163 src/pwd.c:270
#, c-format
msgid "failed to stat %s"
msgstr "nnemedwa okufuna ebifa ku %s"

#: src/pwd.c:228
#, c-format
msgid "couldn't find directory entry in %s with matching i-node"
msgstr "nnemedwa okuzuula ekiri mu tterekero %s ekikwatagana ne i-nodi"

#: src/pwd.c:305
#, c-format
msgid "ignoring non-option arguments"
msgstr "agumenti ezitafuula eneyisa ey'ebiragiro tezikoledwako"

#. This is a proper name. See the gettext manual, section Names.
#: src/readlink.c:33
msgid "Dmitry V. Levin"
msgstr "Dmitry V. Levin"

#: src/readlink.c:66
#, c-format
msgid "Usage: %s [OPTION]... FILE\n"
msgstr "Enkozesa entuufu eri: %s [KAWAYIRO]... FAYIRO\n"

#: src/readlink.c:67
msgid ""
"Display value of a symbolic link on standard output.\n"
"\n"
msgstr ""
"Ekiragiro kino kiwandikawo erinnya erya fayiro eyaddala gy'oggukako bw'obikkula ennyunzi.\n"
"Erinnya eryo kiriwandika awateekebwa ebivaamu awa bulijjo.\n"
"\n"

#: src/readlink.c:69
msgid ""
"  -f, --canonicalize            canonicalize by following every symlink in\n"
"                                every component of the given name recursively;\n"
"                                all but the last component must exist\n"
"  -e, --canonicalize-existing   canonicalize by following every symlink in\n"
"                                every component of the given name recursively,\n"
"                                all components must exist\n"
msgstr ""
" -f, --canonicalize             Kano akawayiro kaleetera ekiragiro okuwandika\n"
"                                erinnya mu bujjuvu nga ekkubo lyonna okuva ku\n"
"                                musingi kweriri; fayiro ekkubo kwe ligguka ne\n"
"                                bw'etabawo, kasita fayiro endala ez'ebitundu\n"
"                                b'ekkubo zibawo tewaba kiremya\n"
" -e, --canonicalize-existing    Kano akawayiro kaleetera ekiragiro okuwandika\n"
"                                erinnya mu bujjuvu nga ekkubo lyonna okuva ku\n"
"                                musingi kweriri; fayiro zonna ezikola ekkubo\n"
"                                ko n'eyo kwe ligguka zonna ziteekwa okubawo,\n"
"                                ekyo bwe kitatuukirira wabawo kiremya\n"

#: src/readlink.c:77
msgid ""
"  -m, --canonicalize-missing    canonicalize by following every symlink in\n"
"                                every component of the given name recursively,\n"
"                                without requirements on components existence\n"
"  -n, --no-newline              do not output the trailing newline\n"
"  -q, --quiet,\n"
"  -s, --silent                  suppress most error messages\n"
"  -v, --verbose                 report error messages\n"
msgstr ""
"  -m, --canonicalize-missing    Kano akawayiro kaleetera ekiragiro okuwandika\n"
"                                erinnya mu bujjuvu nga ekkubo lyonna okuva ku\n"
"                                musingi kweriri; fayiro ezimu ezikola ekkubo\n"
"                                ne bwe zitabawo tewaba kiremya\n"
"  -n, --no-newline              Kano bw'okassaako olwo ekiragiro bye kiwandika\n"
"                                biba ku lunyiriri lwe lumu ne n'obubonero obulaga\n"
"                                by'onoddako okuwandika we binaalabikira\n"
"  -q, --quiet,\n"
"  -s, --silent                  Kano ko bwe kabaako ekiragiro bwe kisanga kiremya\n"
"                                emirundi egising'obungi tekikubuulira. Eno y'enkola\n"
"                                yakyo eya bulijjo\n"
"  -v, --verbose                 Kano ate kakiwaliriza okukubuulira buli kiremya\n"
"                                aba azzewo\n"

