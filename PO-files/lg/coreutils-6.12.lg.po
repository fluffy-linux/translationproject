#: src/comm.c:74 src/join.c:160
#, c-format
msgid "Usage: %s [OPTION]... FILE1 FILE2\n"
msgstr "Enkozesa entuufu eri: %s [KAWAYIRO]... FAYIRO1 .FAYIRO2\n"

#: src/comm.c:78
msgid "Compare sorted files FILE1 and FILE2 line by line.\n"
msgstr ""
"Kino fayiro ensengeke FAYIRO1 ne FAYIRO2 kiziyitamu nga kizigeraageranya\n"
"lunyiriri ku lunyiriri.\n"

#: src/comm.c:81
msgid ""
"\n"
"With no options, produce three-column output.  Column one contains\n"
"lines unique to FILE1, column two contains lines unique to FILE2,\n"
"and column three contains lines common to both files.\n"
msgstr ""
"\n"
"Ekiragiro bwe kiba nga tekiweeredwako obuwayiro, ebivaamu kibiragira mu\n"
"kolumu ssatu. Kolumu esooka ebeera mu ennyiriri eziri mu FAYIRO1 yokka,\n"
"kolumu eyakubiri ebeera mu ennyiriri eziri mu FAYIRO2 yokka, ate kolumu\n"
"eyakusatu ebeera mu ennyiriri ezisangibwa mu fayiro zombi.\n"

#: src/comm.c:87
msgid ""
"\n"
"  -1              suppress lines unique to FILE1\n"
"  -2              suppress lines unique to FILE2\n"
"  -3              suppress lines that appear in both files\n"
msgstr ""
"\n"
"  -1              akawayiro kano bwe kabaako, ekiragiro ennyiriri ezisangibwa mu FAYIRO1 yokka tekiziwandika\n"
"  -2              kano ko bw kabaako, ekiragiro ennyiriri ezisangibwa mu FAYIRO2 yokka tekiziwandika\n"
"  -3              kano bw kabaako, ekiragiro ennyiriri ezisangibwa mu fayiro zombi tekiziwandika\n"

