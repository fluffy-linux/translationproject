#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Enkozesa entuufu eri: %s [KAWAYIRO]... [FAYIRO]...\n"

#: src/df.c:739
msgid ""
"Show information about the file system on which each FILE resides,\n"
"or all file systems by default.\n"
"\n"
msgstr ""
"Ekiragiro kino kiwandika ebifa ku sisiemu eya fayiro FAYIRO kweri,\n"
"oba ebifa ku sistemu eza fayiro zonna.\n"
"\n"

#: src/df.c:747
msgid ""
"  -a, --all             include dummy file systems\n"
"  -B, --block-size=SIZE  use SIZE-byte blocks\n"
"  -h, --human-readable  print sizes in human readable format (e.g., 1K 234M 2G)\n"
"  -H, --si              likewise, but use powers of 1000 not 1024\n"
msgstr ""
"  -a, --all               Buno bukireetera okukola ne ku sistemu eza fayiro\n"
"                          ezirimu buloka 0\n"
"  -B, --block-size=BUNENE Buno bwo bukireetera okukozesa buloka ezirimu bayiti\n"
"                          BUNENE BUNENE\n"
"  -h, --human-readable    Buni bukireetera okulaga obunene mu ngeri etegeereka\n"
"                          abantu (okugeza, 1K 234M 2G)\n"
"  -H, --si                Buno bukireetera okukola nga obwa -h ne --human-readable\n"
"                          naye nga kikolera mu birengo ebya 1000 mu kifo ekya 1024\n"

#: src/df.c:753
msgid ""
"  -i, --inodes          list inode information instead of block usage\n"
"  -k                    like --block-size=1K\n"
"  -l, --local           limit listing to local file systems\n"
"      --no-sync         do not invoke sync before getting usage info (default)\n"
msgstr ""
"  -i, --inodes            Kirage ebifa ku inoda mu kifo ekya eby'enkozesa\n"
"                          eya buloka\n"
"  -k                      Kino kye kimu ne --block-size=1K\n"
"  -l, --local             Kirage ebifa ku sisitemu eya fayiro eya ku\n"
"                          lusegere yokka\n"
"      --no-sync           Bwe kibeera kigenda okuwanuza ebifa ku nkozesa,\n"
"                          kireme okusooka\n"
"                          okutandika ogwa 'sync', (eno y'enkola eya bulijjo)\n"

#: src/df.c:759
msgid ""
"  -P, --portability     use the POSIX output format\n"
"      --sync            invoke sync before getting usage info\n"
"  -t, --type=TYPE       limit listing to file systems of type TYPE\n"
"  -T, --print-type      print file system type\n"
"  -x, --exclude-type=TYPE   limit listing to file systems not of type TYPE\n"
"  -v                    (ignored)\n"
msgstr ""
"  -P, --portability       Buno kaviiramu ebivaamu okutereezebwa mu\n"
"                          ngeri eya POSIX\n"
"        --sync            Kano kakireetera okusooka kutandika ogwa 'sync'\n"
"                          kiryoke kiwanuze ebifa ku nkozesa\n"
"  -t, --type=KIKA         Buno bukireetera okulaga ebifa ku sisitemu eza\n"
"                          fayiro ez'ekika ekya KIKA zokka\n"
"  -T, --print-type        Buno bukireetera okulaga ekika ekya sistemu eya fayiro\n"
"  -x, --exclude-type=KIKA Buno bwo bukireetera okulaga ebifa ku sistemu eza\n"
"                          fayiro ezitali za kika kya KIKA zokka\n"
"  -v                      (Kano tekakolebwako)\n"

#: src/df.c:769 src/du.c:337 src/ls.c:4468
msgid ""
"\n"
"SIZE may be (or may be an integer optionally followed by) one of following:\n"
"kB 1000, K 1024, MB 1000*1000, M 1024*1024, and so on for G, T, P, E, Z, Y.\n"
msgstr ""
"\n"
"BUNENE obuteeka mu bipimo bino:\n"
"kB (ebirengo ebya 1,000), K-(bya 1,024), MB (bya 1,000,000),\n"
"M (bya 1,048,576) ko n'ebyeyongera waggula G, T, P, E, Z ne Y.\n"
" Zino ennukuta zisobola okubeera zokka oba nga zikulemberwa\n"
"omuwendo ogutali mu butundutundu - okugeza 15kB oba 2M naye ssi\n"
"5.5M.\n"

#: src/df.c:903
#, c-format
msgid "file system type %s both selected and excluded"
msgstr ""
"sisitemu eya fayiro ey'ekika %s elondedwa nga\n"
"mu kiseera kye kikimu egyidwamu"

#: src/df.c:944
msgid "Warning: "
msgstr "Kulabula: "

#: src/df.c:946
msgid "cannot read table of mounted file systems"
msgstr "nnemedwa okusoma endagiriro eya sistemu eza fayiro eziwangidwa"

#: src/df.c:967
#, c-format
msgid "no file systems processed"
msgstr "tewali sisitemu eya fayiro ekoledwako"

#. This is a proper name. See the gettext manual, section Names.
#: src/dircolors.c:35
msgid "H. Peter Anvin"
msgstr "H. Peter Anvin"

#: src/dircolors.c:100
#, c-format
msgid "Usage: %s [OPTION]... [FILE]\n"
msgstr "Enkozesa entuufu eri: %s [KAWAYIRO]... [FAYIRO]\n"

#: src/dircolors.c:101
msgid ""
"Output commands to set the LS_COLORS environment variable.\n"
"\n"
"Determine format of output:\n"
"  -b, --sh, --bourne-shell    output Bourne shell code to set LS_COLORS\n"
"  -c, --csh, --c-shell        output C shell code to set LS_COLORS\n"
"  -p, --print-database        output defaults\n"
msgstr ""
"Ekiragiro kino kiraga ebiragiro ebitegeka ekikongozzi LS_COLORS.\n"
"\n"
"Ekiagiro kino kisalawo enfaanana ey'ebinavaamu.\n"
"  -b, --sh, --bourne-shell    Kirage ebiragiro ebitegeka LS_COLORS ebikolera\n"
"                              mu nzivvuunuzi eya Bourne\n"
"  -c, --csh, --c-shell        Kiage ebiragiro ebitegeka LS_COLORS ebikolera\n"
"                              mu nzivvunuzi eya C\n"
"  -p, --print-database        Kirage ebiragiro ebya bulijjo\n"

#: src/dircolors.c:111
msgid ""
"\n"
"If FILE is specified, read it to determine which colors to use for which\n"
"file types and extensions.  Otherwise, a precompiled database is used.\n"
"For details on the format of these files, run `dircolors --print-database'.\n"
msgstr ""
"\n"
"`dircolors' bw'ebeera elagidwa okukozesa FAYIRO, eyo gy'esoma okumanya langi\n"
"z'en'ekozesa okulaga buli kika ekya fayiro. FAYIRO bw'ebeera teyalagidwa,\n"
"'dircolors' ekozesa fayiro eyajjira mu muganda ogwa 'coreutils'.\n"
"\n"
"Bw'obeera oyagala okumanya entereeza eya fayiro zino, tandika ogwa\n"
"'dircolors --print-database'.\n"

#: src/dircolors.c:289
#, c-format
msgid "%s:%lu: invalid line;  missing second token"
msgstr "%s: %lu: lunyiri lusobi; lubulako tokeni eyakubiri"

#: src/dircolors.c:361
#, c-format
msgid "%s:%lu: unrecognized keyword %s"
msgstr "%s:%lu: kigambo ekyawule %s tekitegeerese"

#: src/dircolors.c:362
msgid "<internal>"
msgstr "<kya munda>"

#: src/dircolors.c:443
#, c-format
msgid ""
"the options to output dircolors' internal database and\n"
"to select a shell syntax are mutually exclusive"
msgstr ""
"'dircolors' bw'obeera ogiragidde okuzza ebiragiro ebya mu\n"
"fayiro eyajjiramu mu muganda ogwa 'coreutils' tejja ate\n"
"okukkiriza empandika ey'ebiragiro ekozesebwa enzivvuunuzi"

#: src/dircolors.c:453
msgid "File operands cannot be combined with --print-database (-p)."
msgstr ""
"Bw'obanga otaddeko akawayiro --print-database (-p) tosobola\n"
"okussaako ne fayiro ez'okukolebwako."

#: src/dircolors.c:476
#, c-format
msgid "no SHELL environment variable, and no shell type option given"
msgstr ""
"kubuzeeko ekikongozzi NZIVVUUNUZI, oba wakiri akawayiro akategeka\n"
"ekika kya nzivvuunuzi"

#: src/dirname.c:49
#, c-format
msgid ""
"Usage: %s NAME\n"
"  or:  %s OPTION\n"
msgstr ""
"Enkozesa entuufu eri: %s FAYIRO\n"
"  oba:  %s KAWAYIRO\n"

#: src/dirname.c:54
msgid ""
"Print NAME with its trailing /component removed; if NAME contains no /'s,\n"
"output `.' (meaning the current directory).\n"
"\n"
msgstr ""
"Lagako ekitundu ekya LINNYA ekirimu amannya ag'amatereko kyokka, nga ka \"/\" \n"
"akasembayo tekaliiko. LINNYA bwe kiba nga temuli zi \"/\", wandika `.' \n"
"(ekitegeeza nti ekisigaddewo lye tterekero eriweeredwaamu ekiragiro).\n"
"\n"

#: src/dirname.c:61
#, c-format
msgid ""
"\n"
"Examples:\n"
"  %s /usr/bin/sort  Output \"/usr/bin\".\n"
"  %s stdio.h        Output \".\".\n"
msgstr ""
"\n"
"Eby'okulabirako:\n"
"  %s /usr/bin/sort  kivaamu \"/usr/bin\".\n"
"  %s stdio.h        kivaamu \".\".\n"

#: src/du.c:272 src/wc.c:112
#, c-format
msgid ""
"Usage: %s [OPTION]... [FILE]...\n"
"  or:  %s [OPTION]... --files0-from=F\n"
msgstr ""
"Enkozesa entuufu eri: %s [KAWAYIRO]... [FAYIRO]...\n"
"                oba:  %s [KAWAYIRO]... --files0-from=F\n"

#: src/du.c:276
msgid ""
"Summarize disk usage of each FILE, recursively for directories.\n"
"\n"
msgstr ""
"Ekiragiro kino kiwandika, mu bufunze, ekitundu ekya disiki buli\n"
" FAYIRO ky'etwala. bw'ebeera ttereko kebera ne fayiro eziliri mu.\n"
"\n"

#: src/du.c:283
msgid ""
"  -a, --all             write counts for all files, not just directories\n"
"      --apparent-size   print apparent sizes, rather than disk usage; although\n"
"                          the apparent size is usually smaller, it may be\n"
"                          larger due to holes in (`sparse') files, internal\n"
"                          fragmentation, indirect blocks, and the like\n"
msgstr ""
" -a, --all                Kamu ku buno bw'okassaako, ekiragiro kiraga ebifunidwa\n"
"                          ku fayiro zonna, ssi materekero gokka\n"
"      --apparent-size     kano kakireetera okulaga obunene obwa fayiro okusinzira ku\n"
"                          bayiti ezigibalidwamu sso ssi ebbanga ly'ekozesa ku disiki;\n"
"                          Obunene buno butera okuba bwa wansi ku bbanga fayiro\n"
"                          ly'ekozesa. Wabula ku fayiro ez'empewo buyinza okuba nga bwe\n"
"                          businga.\n"

#: src/du.c:290
msgid ""
"  -B, --block-size=SIZE  use SIZE-byte blocks\n"
"  -b, --bytes           equivalent to `--apparent-size --block-size=1'\n"
"  -c, --total           produce a grand total\n"
"  -D, --dereference-args  dereference only symlinks that are listed on the\n"
"                          command line\n"
msgstr ""
"  -B, --block-size=BUNENE  Kamu ku buno bw'okassaako kikozesa buloka eziri\n"
"                           mu bayiti BUNENE\n"
"  -b, --bytes              Obunene kibulagira mu bayiti\n"
"  -c, --total              Kiraga omugatte\n"
"  -D, --dereference-args   Ku nyunzi ez'eyawudde, kizzawo makubo genyini\n"

#: src/du.c:297
msgid ""
"      --files0-from=F   summarize disk usage of the NUL-terminated file\n"
"                          names specified in file F\n"
"  -H                    like --si, but also evokes a warning; will soon\n"
"                          change to be equivalent to --dereference-args (-D)\n"
"  -h, --human-readable  print sizes in human readable format (e.g., 1K 234M 2G)\n"
"      --si              like -h, but use powers of 1000 not 1024\n"
msgstr ""
"      --files0-from=F   Kano kaleetera ekiragiro okukola ku fayiro eziri ku\n"
"                        lukalala mu fayiro F. Mu lukalala olwo, amannya ga\n"
"                        fayiro gawandikibwa nga gonna g'ongezedwako bayiti\n"
"                        eya zero (NUL) ku nkomerero zago. F bwe kiba '-' olwo\n"
"                        ekiragiro kikola ku mannya agawandikidwa bwegatyo\n"
"                        awayingizibwa awa bulijjo\n"
"  -H                    Ekiva mu kuteekawo kano kye kimu n'ekivaamu nga\n"
"                        otaddewo aka --dereference-args (-D)\n"
"  -h, --human-readable  Obunene kibulaga mu ngeri omuntu gy'ategeera (okugeza:\n"
"                        1K 234M 2G)\n"
"      --si              Kano kakola nga -h naye emirengo gib gya 1000 mu kifo\n"
"                        kya 1024\n"

#: src/du.c:305
msgid ""
"  -k                    like --block-size=1K\n"
"  -l, --count-links     count sizes many times if hard linked\n"
"  -m                    like --block-size=1M\n"
msgstr ""
"  -k                    Kye kimu ne --block-size=1K\n"
"  -l, --count-links     Bwe kisanga nyunzi et'eyawudde, kigibala\n"
"                        nga fayiro ezisoba mu emu\n"
"  -m                    Kye kimu ne --block-size=1M\n"

#: src/du.c:310
msgid ""
"  -L, --dereference     dereference all symbolic links\n"
"  -P, --no-dereference  don't follow any symbolic links (this is the default)\n"
"  -0, --null            end each output line with 0 byte rather than newline\n"
"  -S, --separate-dirs   do not include size of subdirectories\n"
"  -s, --summarize       display only a total for each argument\n"
msgstr ""
"  -L, --dereference        Enyunzi ez'eyawudde kizirondoole kikole ku fayiro kwe zigguka\n"
"  -P, --no-dereference     Buli lwe kisanga enyunzi ey'eyawudde egguka ku\n"
"                           tterekero, kigitwaale nga fayiro eya bulijjo\n"
"  -0, --null               Buli lunyiriri ekiragiro lwe kiwandika kirukomekkereze ne bayiti\n"
"                           eya 0 mu kifo eky'ennukuta elagira okukolawo olunyiriri olupya\n"
"  -S, --separate-dirs      Kireme okulaga bunene bwa materekero agali munda mwa gannago\n"
"  -s, --summarize          Agumenti kirage emigatte gyazo gyokka\n"

#: src/du.c:317
msgid ""
"  -x, --one-file-system  skip directories on different file systems\n"
"  -X FILE, --exclude-from=FILE  Exclude files that match any pattern in FILE.\n"
"      --exclude=PATTERN  Exclude files that match PATTERN.\n"
"      --max-depth=N     print the total for a directory (or file, with --all)\n"
"                          only if it is N or fewer levels below the command\n"
"                          line argument;  --max-depth=0 is the same as\n"
"                          --summarize\n"
msgstr ""
"  -x, --one-file-system   Ssaawo kamu ku buno okukireetera okubuuka amaterekero\n"
"                          agali ku sisitemu eza fayiro endala\n"
"  -X FAYIRO, --exclude-from=FAYIRO  Fayiro erinnya lya yo bwe libeera nga\n"
"                          liri ku lukalala oluli mu FAYIRO, kigibuuka.\n"
"      --exclude=KIGAMBO   Kano kakireetera okubuuka oba okugyamu fayiro ezirina\n"
"                          KIGAMBO mu mannya ga zo\n"
"      --max-depth=N       Kano kakireetera okulaga emigatte egifunidwa ku materekero\n"
"                         (agumenti  --all  nayo bw'ebeerako kikola ne ku fayiro\n"
"                          ezitali materekero). Kikoma ku ezo fayiro n'amaterekero\n"
"                          ezitasukka emitendera N wansi w'eryo ekiragiro kwe\n"
"                          kiweredwa; --max-depth=0 kye kimu ne --summarize\n"

#: src/du.c:326
msgid ""
"      --time            show time of the last modification of any file in the\n"
"                          directory, or any of its subdirectories\n"
"      --time=WORD       show time as WORD instead of modification time:\n"
"                          atime, access, use, ctime or status\n"
"      --time-style=STYLE  show times using style STYLE:\n"
"                          full-iso, long-iso, iso, +FORMAT\n"
"                          FORMAT is interpreted like `date'\n"
msgstr ""
"      --time                 Kano kakireetera okulaga obudde lwe waasemba\n"
"                             okubawo fayiro ekyusibwako mu tterekero n'ago\n"
"                             agaliri munda\n"
"      --time=KIGAMBO         Mu kifo eky'okulaga obudde fayiro kwe yasembera\n"
"                             okukyusibwako, kiraga obudde obwa KIGAMBO, nga\n"
"                             KIGAMBO kiri kimu ku:\n"
"                             atime, access, use, ctime ne status\n"
"     --time-style=MUSONO     Obudde kibulaga mu musono MUSONO, nga MUSONO\n"
"                             kimu ku:\n"
"                             full-iso, long-iso, iso, locale, +EMPANDIKA\n"
"                             EMPANDIKA kikitegeera nga ekiragiro 'date' bwe\n"
"                             kikitegeera\n"

#: src/du.c:659 src/ls.c:2455 src/wc.c:727
msgid "total"
msgstr "omugatte"

#: src/du.c:745
#, c-format
msgid ""
"WARNING: use --si, not -H; the meaning of the -H option will soon\n"
"change to be the same as that of --dereference-args (-D)"
msgstr ""
"KULABULA: kozesa --si, so ssi -H, kubanga akawayiro -H kagenda\n"
"okukyusakyusibwa kakole ekimu n'aka --dereference-args (-D)"

#: src/du.c:769
#, c-format
msgid "invalid maximum depth %s"
msgstr "tekikkirizibwa okukka ku mutendera %s gw'oyagala"

#: src/du.c:778
#, c-format
msgid "the --megabytes option is deprecated; use -m instead"
msgstr "akawayiro --megabytes kadiizidwa; kozesaamu aka -m"

#: src/du.c:865
#, c-format
msgid "cannot both summarize and show all entries"
msgstr "tekisoboka okulaga mu bufunze ate mu kiseera kye kimu okulaga mu bujjuvu"

#: src/du.c:872
#, c-format
msgid "warning: summarizing is the same as using --max-depth=0"
msgstr "Kulabula: okufunza kye kimu n'okukozesa --max-depth=0"

#: src/du.c:878
#, c-format
msgid "warning: summarizing conflicts with --max-depth=%lu"
msgstr "Kulabula: okulagira kuwandika mu bufunze kikontana ne --max-depth=%lu"

#: src/du.c:943 src/wc.c:652
msgid "File operands cannot be combined with --files0-from."
msgstr "Tosobola okussawo aka --files0-from ate n'oteekawo ne fayiro ez'okukolako."

#: src/du.c:954 src/wc.c:669
#, c-format
msgid "cannot read file names from %s"
msgstr "sisbola okusoma amannya aga fayiro okuva mu %s"

#: src/du.c:987 src/wc.c:696
#, c-format
msgid "when reading file names from stdin, no file name of %s allowed"
msgstr ""
"ekiragiro bwe kiba nga kya kusoma amannya aga fayiro akova ku stdin,\n"
"erinnya %s terikkirizibwamu"

#: src/du.c:1006 src/du.c:1009 src/wc.c:714 src/wc.c:717
