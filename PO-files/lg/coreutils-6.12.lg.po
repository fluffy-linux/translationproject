msgstr "%s erimu ennamba eyitiridde obunene"

#: src/tail.c:1514
#, c-format
msgid "%s: invalid maximum number of unchanged stats between opens"
msgstr "%s: tekikkirizibwa kukebera fayiro emirundi gino"

#: src/tail.c:1526
