msgstr "Michael Stone"

#: src/link.c:49
#, c-format
msgid ""
"Usage: %s FILE1 FILE2\n"
"  or:  %s OPTION\n"
msgstr ""
"Enkozesa entuufu eri: %s FAYIRO1 FAYIRO2\n"
"  oba:  %s KAWAYIRO\n"

#: src/link.c:52
msgid ""
"Call the link function to create a link named FILE2 to an existing FILE1.\n"
"\n"
msgstr ""
"Kino kitandika omukolo ogwa link gukolewo nyunzi etuumidwa\n"
"erinnya FAYIRO2, eno nga egguka ku FAYIRO1 (esangidwawo).\n"
"\n"

#: src/link.c:94
#, c-format
msgid "cannot create link %s to %s"
msgstr "sisobola okukolawo nyunzi %s egguke ate ku %s"

#: src/ln.c:168
#, c-format
msgid "%s: warning: making a hard link to a symbolic link is not portable"
msgstr ""
"%s: kulabula: bw'okolawo nyunzi et'eyawudde nga eggukira ku nyunzi\n"
"ey'eyawudde by'okoze biyinza obutakola nga obitadde ku kompyuta\n"
"ekolera ku sisitemu endala"

#: src/ln.c:178
#, c-format
msgid "%s: hard link not allowed for directory"
msgstr "%s:tekikkirizibwa okukolawo nyunzi et'eyawudde nga egguka ku tterekero"

#: src/ln.c:243
#, c-format
msgid "%s: cannot overwrite directory"
msgstr "%s: sisobola okuwandika ku tterekero elisangidwawo"

#: src/ln.c:248
#, c-format
msgid "%s: replace %s? "
msgstr "%s: %s ngigyewo nteekewo ekipya? "

#: src/ln.c:324
#, c-format
msgid "creating symbolic link %s"
msgstr "nkolawo nnyunzi ey'eyawudde %s"

#: src/ln.c:325
#, c-format
msgid "creating symbolic link %s -> %s"
msgstr "nkolawo nnyunzi ey'eyawudde %s -> %s"

#: src/ln.c:327
#, c-format
msgid "creating hard link to %.0s%s"
msgstr "nkolawo nnyunzi et'eyawudde egguka ku %.0s%s"

#: src/ln.c:330
#, c-format
msgid "creating hard link %s"
msgstr "nkolawo nnyunzi et'eyawudde %s"

#: src/ln.c:331
#, c-format
msgid "creating hard link %s => %s"
msgstr "nkolawo nnyunzi et'eyawudde %s => %s"

#: src/ln.c:353
#, c-format
msgid ""
"Usage: %s [OPTION]... [-T] TARGET LINK_NAME   (1st form)\n"
"  or:  %s [OPTION]... TARGET                  (2nd form)\n"
"  or:  %s [OPTION]... TARGET... DIRECTORY     (3rd form)\n"
"  or:  %s [OPTION]... -t DIRECTORY TARGET...  (4th form)\n"
msgstr ""
"Enkozesa entuufu eri: %s [KAWAYIRO]... [-T] KIGENDERWA LINNYA   (empandika 1)\n"
"                oba:  %s [KAWAYIRO]... KIGENDERWA               (empandika 2)\n"
"                oba:  %s [KAWAYIRO]... KIGENDERWA... TTEREKERO  (empandika 3)\n"
"                oba:  %s [KAWAYIRO]... -t TTEREKERO KIGENDERWA  (empandika 4)\n"

#: src/ln.c:360
msgid ""
"In the 1st form, create a link to TARGET with the name LINK_NAME.\n"
"In the 2nd form, create a link to TARGET in the current directory.\n"
"In the 3rd and 4th forms, create links to each TARGET in DIRECTORY.\n"
"Create hard links by default, symbolic links with --symbolic.\n"
"When creating hard links, each TARGET must exist.\n"
"\n"
msgstr ""
"Mu mpandika 1, ekiragiro kino kikolawo ennyunzi egguka\n"
"ku KIGENDERWA nga ennyunzi eyo etuumidwa LINNYA.\n"
"Mu mpandika 2, ekiragiro kino kikolawo ennyunzi mu\n"
"tterekero mwe kiweeredwa nga egguka ku KIGENDERWA.\n"
"Mu mpandika 3 ne 4, ekiragiro kino kikolawo ennyunzi\n"
"ezigguka ku buli KIGENDERWA mu TTEREKERO.\n"
"Ekiragiro kino kikolawo ennyunzi ezit'eyawudde okuyako\n"
"nga oyongeddeko akawayiro --symbolic.\n"
"Okukolawo ennyunzi et'eyawudde, KIGENDERWA kiteekwa okuba\n"
"nga wekiri. Ennyunzi ey'eyawudde yo esobola okukolebwawo\n"
"KIGENDERWA ne bwe kiba nga tekinnabawo; ennyunzi etandika\n"
"kukola kasita fayiro eyo emala n'ekolebwawo.\n"
"\n"

#: src/ln.c:371
msgid ""
"      --backup[=CONTROL]      make a backup of each existing destination file\n"
"  -b                          like --backup but does not accept an argument\n"
"  -d, -F, --directory         allow the superuser to attempt to hard link\n"
"                                directories (note: will probably fail due to\n"
"                                system restrictions, even for the superuser)\n"
"  -f, --force                 remove existing destination files\n"
msgstr ""
" --backup[=CONTROL]           Kano kakireetera okukolawo ne koppi ey'okwerinda\n"
"                              eya buli fayiro ey'ekigenderwa esangibwawo\n"
"  -b                          Kye kimu ne --backup naye tokkirizibwa\n"
"                              kwongerako agumenti\n"
"  -d, -F, --directory         Kano kasobozesa omuteesiteesi okugeza okukola\n"
"                              nyunzi ezit'eyawudde ku materekero (genderera:\n"
"                              sisitemu ezimu kino tezikikkiriza yadde muteesiteesi)\n"
"  -f, --force                 Bwe kubaako kamu ku buno ne kisangawo fayiro ku\n"
"                              kigenderwa, kisooka kuzigyawo empya zidde mu kifo\n"
"                              kyazo\n"

#: src/ln.c:379
msgid ""
"  -n, --no-dereference        treat destination that is a symlink to a\n"
"                                directory as if it were a normal file\n"
"  -i, --interactive           prompt whether to remove destinations\n"
"  -s, --symbolic              make symbolic links instead of hard links\n"
msgstr ""
"  -n, --no-dereference        Ekigenderwa bwe kibeera enyunzi ey'eyawudde\n"
"                              egguka ku tterekero, kigiyisa nga fayiro\n"
"                              eya bulijjo\n"
"  -i, --interactive           Kisooka kubuuza akiyisizza oba ayagala\n"
"                              okuggyawo fayilo ezisangidwawo\n"
"  -s, --symbolic              Kikolawo nnyunzi ez'eyawudde mu kifo ekya\n"
"                              ezit'eyawudde\n"

#: src/ln.c:385
msgid ""
"  -S, --suffix=SUFFIX         override the usual backup suffix\n"
"  -t, --target-directory=DIRECTORY  specify the DIRECTORY in which to create\n"
"                                the links\n"
"  -T, --no-target-directory   treat LINK_NAME as a normal file\n"
"  -v, --verbose               print name of each linked file\n"
msgstr ""
"  -S, --suffix=KASEMBEKKEREZA Bw'oteekako kamu ku buno, ekiragiro\n"
"                              bwe kibeera kiggya kkopi ez'okwerinda,\n"
"                              kikozesa KASEMBEKKEREZA mu kifo kya\n"
"                              akasembekkereza aka bulijjo\n"
"  -t, --target-directory=TTEREKERO  Kano kakireetera enyunzi okuzikolera\n"
"                              mu TTEREKERO\n"
"  -T, --no-target-directory   Buno bukireetera okubala nti LINNYA fayiro\n"
"                              bufayiro, so ssi tterekero\n"
"  -v, --verbose               Bwe kubaako kamu ku buno, buli lwe kikolawo\n"
"                              enyunzi, kisooka kuwandika linnya lya fayiro\n"
"                              kw'egguka\n"

#: src/ln.c:513
#, c-format
msgid "Cannot combine --target-directory and --no-target-directory"
msgstr "Tekisoboka kugatta --target-director ne --no-target-directoy"

