"Kino tekikkirizibwa nga okozesezza akawayiro -%c"

#: src/split.c:106
#, c-format
msgid "Usage: %s [OPTION] [INPUT [PREFIX]]\n"
msgstr "Enkozesa entuufu eri: %s [KAWAYIRO] [EBIKOLEBWAKO [KAKULEMEKKEREZA]]\n"

#: src/split.c:110
msgid ""
"Output fixed-size pieces of INPUT to PREFIXaa, PREFIXab, ...; default\n"
"size is 1000 lines, and default PREFIX is `x'.  With no INPUT, or when INPUT\n"
"is -, read standard input.\n"
"\n"
msgstr ""
"Ekiragiro ekya `split' kimenya mu EBIKOLEBWAKO ebitundu ne\n"
"kibikolamu zi-fayiro ezituumidwa amanya nga KAKULEMBEKKEREZAaa,\n"
"KAKULEMBEKKEREZAab, ...; bw'oba nga towaddeyo akako, ekiragiro\n"
"bulijjo KAKULEMBEKKEREZA kikozesaamu'x'. Olwo zi-fayiro ne ziba\n"
"nga zituumidwa xaa, xab, .... Ate bw'oba nga tewawaddeyo\n"
"EBIKOLEBWAKO oba bw'oba nga EBIKOLEBWAKO kiri -, ekiragiro\n"
"kikola ku by'owandika awayingizibwa awa bulijjo.\n"
"\n"

#: src/split.c:119
#, c-format
msgid ""
"  -a, --suffix-length=N   use suffixes of length N (default %d)\n"
"  -b, --bytes=SIZE        put SIZE bytes per output file\n"
"  -C, --line-bytes=SIZE   put at most SIZE bytes of lines per output file\n"
"  -d, --numeric-suffixes  use numeric suffixes instead of alphabetic\n"
"  -l, --lines=NUMBER      put NUMBER lines per output file\n"
msgstr ""
"  -a, --suffix-length=N   Bw'osaawo akawayiro kano, ekiragiro\n"
"                          obukulembekkereza kikolawo\n"
"                          obulimu ennukuta N (mu bya bulijjo ziba %d)\n"
"  -b, --bytes=BUNGI       Kano ko kaleetera ekiragiro okukola zi-fayiro\n"
"                          nga tekuli zisukka bayiti BUNGI obunene\n"
"  -C, --line-bytes=BUWANVU Kano kaleetera ekiragiro okukola zi-fayiro nga\n"
"                          enyiriri zaamu temuli esukka mu bayiti\n"
"                          BUWANVU obuwanvu\n"
"  -d, --numeric-suffixes  Akawayiro kano kaleetera ekiragiro okukozesa\n"
"                          namba mu kifo kya nukuta mu bukomekkereza\n"
"                          obw'oku zi-fayiro ze kikolawo\n"
"  -l, --lines=BUNGI       Kano ate ke kaleetera ekiragiro buli fayiro gye\n"
"                          kikolawo butasukka mu nnyiriri BUNGI obuwanvu\n"

#: src/split.c:126
msgid ""
"      --verbose           print a diagnostic just before each\n"
"                            output file is opened\n"
msgstr ""
"      --verbose           Kano kaleetera ekiragiro okusooka kuwandikawo\n"
"                          ebikwata ku mulimu buli lwe kiba kigenda\n"
"                          kutandika fayiro ey'ekikoledwa empya\n"

#: src/split.c:132
msgid ""
"\n"
"SIZE may have a multiplier suffix:\n"
"b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n"
"GB 1000*1000*1000, G 1024*1024*1024, and so on for T, P, E, Z, Y.\n"
msgstr ""
"\n"
"BUNGI osobola okugiteekako akasembekkereza akufuga ebirengo ebya\n"
"bayiti ekiragiro bye kiba kikozesa:\n"
" 'b' bye birengo ebya bayiti 512,\n"
" 'kB' birengo bya bayiti 1000\n"
" 'K' by'ebya kilobayiti (bayiti 1024),\n"
" 'MB' bya bayiti 1,000,000\n"
" 'M' by'ebya megabayiti (bayiti 1024*1024)\n"
" 'GB' bya 1000,000,000, 'G' gigabayiti (bayiti 1024*1024*1024).\n"
"Obusembekkereza obulala obweyongera waggulu buli T, P, E, Z ne Y.\n"

#: src/split.c:195
#, c-format
msgid "Output file suffixes exhausted"
msgstr "Obukomekkereza bwakuteeka ku zi-fayiro ze nkolawo buweddeyo"

#: src/split.c:213
#, c-format
msgid "creating file %s\n"
msgstr "nkolawo fayiro %s\n"

#: src/split.c:376
#, c-format
msgid "cannot split in more than one way"
msgstr "tekisoboka okumenyamu mu ngeri esukka mu emu"

#: src/split.c:427
#, c-format
msgid "%s: invalid suffix length"
msgstr "%s: akakomekkereza tekakkirizibwa kwenkan'awo"

#: src/split.c:441 src/split.c:465
#, c-format
msgid "%s: invalid number of bytes"
msgstr "%s: obwo obungi bwa bayiti tebusoboka"

#: src/split.c:453
