msgstr "akawayiro -%s%c... kateeka nyiriri eziyitiridde obungi"

#: src/split.c:525
#, c-format
msgid "invalid number of lines: 0"
msgstr "buno obungi bw'ennyiriri tebukkirizibwa: 0"

