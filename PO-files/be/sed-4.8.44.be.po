msgid_plural "couldn't write %llu items to %s: %s"
msgstr[0] "не ўдалося запісаць %llu элемэнт да %s: %s"
msgstr[1] "не ўдалося запісаць %llu элемэнта да %s: %s"
msgstr[2] "не ўдалося запісаць %llu элемэнтаў да %s: %s"

#: sed/utils.c:240 sed/utils.c:259
#, c-format
msgid "read error on %s: %s"
msgstr "памылка чытаньня %s: %s"

#: sed/utils.c:358
#, c-format
msgid "couldn't readlink %s: %s"
msgstr "не ўдалося выканаць readlink %s: %s"

#: sed/utils.c:361
#, c-format
msgid "couldn't follow symlink %s: %s"
msgstr "не ўдалося перайсьці па сымбалічнай спасылцы %s: %s"

#: sed/utils.c:408
#, c-format
msgid "cannot rename %s: %s"
msgstr "немагчыма пераназваць %s: %s"
