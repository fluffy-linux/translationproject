#: src/grep.c:1974 src/grep.c:1981
#, c-format
msgid "Usage: %s [OPTION]... PATTERNS [FILE]...\n"
msgstr "Aseqdec: %s [OPTION]... IZENZAƔEN [FILE]...\n"

#: src/grep.c:1976
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Ɛreḍ '%s --help' i wugar n telɣut.\n"

#: src/grep.c:1982
#, c-format
msgid "Search for PATTERNS in each FILE.\n"
msgstr "Nadi IZENZAƔEN deg yal AFAYLU.\n"

#: src/grep.c:1983
#, c-format
msgid ""
"Example: %s -i 'hello world' menu.h main.c\n"
"PATTERNS can contain multiple patterns separated by newlines.\n"
"\n"
"Pattern selection and interpretation:\n"
msgstr ""
"Amedya: %s -i 'azul ay amaḍal' menu.h main.c\n"
"IZENZAƔEN zemrent ad gebrent aṭas n yizenzaɣen yebḍan s uneggez n yizirig.\n"
"\n"
"Tafrant d usuɣel n uzenzaɣ:\n"

#: src/grep.c:1988
#, c-format
msgid ""
"  -E, --extended-regexp     PATTERNS are extended regular expressions\n"
"  -F, --fixed-strings       PATTERNS are strings\n"
"  -G, --basic-regexp        PATTERNS are basic regular expressions\n"
"  -P, --perl-regexp         PATTERNS are Perl regular expressions\n"
msgstr ""
"  -E, --extended-regexp     IZENZAƔEN d tinfaliyin tiluganin ɣezzifen\n"
"  -F, --fixed-strings       IZENZAƔEN d izriren\n"
"  -G, --basic-regexp        IZENZAƔEN d tinfaliyin tiluganin tisadurin\n"
"  -P, --perl-regexp         IZENZAƔEN d tinfaliyin tiluganin Perl\n"

#: src/grep.c:1994
#, c-format
msgid ""
"  -e, --regexp=PATTERNS     use PATTERNS for matching\n"
"  -f, --file=FILE           take PATTERNS from FILE\n"
"  -i, --ignore-case         ignore case distinctions in patterns and data\n"
"      --no-ignore-case      do not ignore case distinctions (default)\n"
"  -w, --word-regexp         match only whole words\n"
"  -x, --line-regexp         match only whole lines\n"
"  -z, --null-data           a data line ends in 0 byte, not newline\n"
msgstr ""
"  -e, --regexp=IZENZAƔEN     seqdec IZENZAƔEN i usemṣada\n"
"  -f, --file=AFAYLU           sali IZENZAƔEN seg UFAYLU\n"
"  -i, --ignore-case         anef i umgired n truẓi deg izenzaɣen d yisefka\n"
"      --no-ignore-case      ur ttanef ara i umgired n truẓi (s wudem amezwar)\n"
"  -w, --word-regexp         semṣadi kan awalen ummiden\n"
"  -x, --line-regexp         semṣadi kan izirigen yemmden\n"
"  -z, --null-data           izirig n yisefka yettfakk s 0 yibit, mačči d izirig amaynut\n"

#: src/grep.c:2002
#, c-format
msgid ""
"\n"
"Miscellaneous:\n"
"  -s, --no-messages         suppress error messages\n"
"  -v, --invert-match        select non-matching lines\n"
"  -V, --version             display version information and exit\n"
"      --help                display this help text and exit\n"
msgstr ""
"\n"
"Ayen niḍen:\n"
"  -s, --no-messages         kkes iznan n tuccḍiwin\n"
"  -v, --invert-match        fren izirigen ur yemṣadan ara\n"
"  -V, --version             sken talɣut n lqem syen ffeɣ\n"
"      --help                sken aḍris n tallalt syen ffeɣ\n"

#: src/grep.c:2009
#, c-format
msgid ""
"\n"
"Output control:\n"
"  -m, --max-count=NUM       stop after NUM selected lines\n"
"  -b, --byte-offset         print the byte offset with output lines\n"
"  -n, --line-number         print line number with output lines\n"
"      --line-buffered       flush output on every line\n"
"  -H, --with-filename       print file name with output lines\n"
"  -h, --no-filename         suppress the file name prefix on output\n"
"      --label=LABEL         use LABEL as the standard input file name prefix\n"
msgstr ""
"\n"
"Asenqed n tuffɣa :\n"
"  -m, --max-count=NOMBRE    ḥbes seld AMḌAN n yizizrigen i yettwafernen\n"
"  -b, --byte-offset         sken tarusi s yibiten s yizirig n tuffɣa\n"
"  -n, --line-number         sken amḍan n yizirigen s yizirigen n tuffɣa\n"
"      --line-buffered       silem tuffɣa deg yal izirig\n"
"  -H, --with-filename       sken isem n ufaylu s yizirigen n tuffɣa\n"
"  -h, --no-filename         kkes azwir n yisem n ufaylu deg tuffɣa\n"
"      --label=ÉTIQUETTE     seqdec TABZIMT d azwir n yisem n ufaylu n tuffɣa alugan\n"

#: src/grep.c:2020
#, c-format
msgid ""
"  -o, --only-matching       show only nonempty parts of lines that match\n"
"  -q, --quiet, --silent     suppress all normal output\n"
"      --binary-files=TYPE   assume that binary files are TYPE;\n"
"                            TYPE is 'binary', 'text', or 'without-match'\n"
"  -a, --text                equivalent to --binary-files=text\n"
msgstr ""
"  -o, --only-matching       sken kan iḥricen n yizirigen yemṣadan\n"
"  -q, --quiet, --silent     kkes akk tuffɣiwin timugna\n"
"      --binary-files=TYPE   dmu ifuyla imisinen seg WANAW;\n"
"                            ANAW d 'binary', 'text', neɣ 'without-match'\n"
"  -a, --text                d agdazal akked --binary-files=text\n"

#: src/grep.c:2027
#, c-format
msgid ""
"  -I                        equivalent to --binary-files=without-match\n"
"  -d, --directories=ACTION  how to handle directories;\n"
"                            ACTION is 'read', 'recurse', or 'skip'\n"
"  -D, --devices=ACTION      how to handle devices, FIFOs and sockets;\n"
"                            ACTION is 'read' or 'skip'\n"
"  -r, --recursive           like --directories=recurse\n"
"  -R, --dereference-recursive  likewise, but follow all symlinks\n"
msgstr ""
"  -I                        d agdazal akked --binary-files=without-match\n"
"  -d, --directories=ACTION  amek i ttwasesfaren yikaramen;\n"
"                            TIGAWT d 'read', 'recurse', neɣ 'skip'\n"
"  -D, --devices=ACTION      amek ttwasesfaren yibenkan, FIFOs akked sockets;\n"
"                            TIGAWT d 'read' neɣ 'skip'\n"
"  -r, --recursive           like --directories=recurse\n"
"  -R, --dereference-recursive  kifkif-iten, maca ḍfer iseɣwan izamalen\n"

#: src/grep.c:2036
#, c-format
msgid ""
"      --include=GLOB        search only files that match GLOB (a file pattern)\n"
"      --exclude=GLOB        skip files that match GLOB\n"
"      --exclude-from=FILE   skip files that match any file pattern from FILE\n"
"      --exclude-dir=GLOB    skip directories that match GLOB\n"
msgstr ""
"      --include=GLOB        nadi kan ifuyla i yemṣadan akked GLOB (azenzaɣ n ufaylu)\n"
"      --exclude=GLOB        zgel ifuyla i yemṣadan akked GLOB\n"
"      --exclude-from=FILE   zgel ifuyla i yemṣadan d yizenzaɣen n yifuyla seg UFAYLU\n"
"      --exclude-dir=GLOB    zgel ikaramen i yemṣadan akked GLOB\n"

#: src/grep.c:2043
#, c-format
msgid ""
"  -L, --files-without-match  print only names of FILEs with no selected lines\n"
"  -l, --files-with-matches  print only names of FILEs with selected lines\n"
"  -c, --count               print only a count of selected lines per FILE\n"
"  -T, --initial-tab         make tabs line up (if needed)\n"
"  -Z, --null                print 0 byte after FILE name\n"
msgstr ""
"  -L, --files-without-match  sken kan ismawen n YIFUYLA s yizirigen ur yettusefraken ara\n"
"  -l, --files-with-matches  sken kan ismawen n YIFUYLA s yizirigen i yettusefraken\n"
"  -c, --count               sken kan amḍan n yizirigen i yettwafernen almend UFAYLU\n"
"  -T, --initial-tab         err tirigliwin (ma yettwasra)\n"
"  -Z, --null                sken 0 yibit seld isem n UFAYLU\n"

#: src/grep.c:2049
#, c-format
msgid ""
"\n"
"Context control:\n"
"  -B, --before-context=NUM  print NUM lines of leading context\n"
"  -A, --after-context=NUM   print NUM lines of trailing context\n"
"  -C, --context=NUM         print NUM lines of output context\n"
msgstr ""
"\n"
"Asenqed n usatal:\n"
"  -B, --before-context=NUM  sken MḌN n yizirigen n usatal n uqerru \n"
"  -A, --after-context=NUM   sken MḌN n yizirigen n usatal n taggara\n"
"  -C, --context=NUM         sken MḌN n yizirigen n usatal n tuffɣa\n"

#: src/grep.c:2056
#, c-format
msgid ""
"  -NUM                      same as --context=NUM\n"
"      --group-separator=SEP  print SEP on line between matches with context\n"
"      --no-group-separator  do not print separator for matches with context\n"
"      --color[=WHEN],\n"
"      --colour[=WHEN]       use markers to highlight the matching strings;\n"
"                            WHEN is 'always', 'never', or 'auto'\n"
"  -U, --binary              do not strip CR characters at EOL (MSDOS/Windows)\n"
"\n"
msgstr ""
"  -NUM                      kifkif akked --context=NUM\n"
"      --group-separator=SEP  sken SEP ɣef yizirig gar yimṣadiyen akked usatal\n"
"      --no-group-separator  ur skanay ara anabraz i yimṣadiyen akked usatal\n"
"      --color[=WHEN],\n"
"      --colour[=WHEN]       seqdec ticraḍ i usebruraq n yizirigen i yemṣadan;\n"
"                            MI ARA 'always', 'never', neɣ 'auto'\n"
"  -U, --binary              ur ittekkes ara isekkilen CR deg EOL (MSDOS/Windows)\n"
"\n"

#: src/grep.c:2065
#, c-format
msgid ""
"When FILE is '-', read standard input.  If no FILE is given, read standard\n"
"input, but with -r, recursively search the working directory instead.  With\n"
"fewer than two FILEs, assume -h.  Exit status is 0 if any line is selected,\n"
"1 otherwise; if any error occurs and -q is not given, the exit status is 2.\n"
msgstr ""
"Ma yella AFAYLU d '-', ɣeṛ anekcum alugan.  Ma yella ulac AFAYLU i d-yettwamudden, ɣeṛ anekcum\n"
"alugan, maca s -r, anadi asnalas deg ukaram n umahil.  S\n"
"udun n sin YIFUYLA, seqdec -h.  Addad n tuffɣa d 0 ma yella izirig yettwafren,\n"
"1 neɣ; ma tella-d kra n tuccḍa, -q ur d-yettwamudd ara, addad n tuffɣa d 2.\n"

