msgstr "      --no-location           brez vrstic »#: datoteka:vrstica« v izpisu\n"

#: src/msgconv.c:363 src/msgen.c:367 src/msgfilter.c:490 src/msggrep.c:620
#: src/msgmerge.c:584 src/msgpre.c:528
