msgstr "      --package-name=ПАКЕТ    задава име на пакет в резултата\n"

#: src/xgettext.c:1352
#, c-format
msgid "      --package-version=VERSION  set package version in output\n"
msgstr "      --package-version=ВЕРСИЯ   задава версия на пакета в резултата\n"

#: src/xgettext.c:1354
