#: sed/compile.c:144
msgid "multiple `!'s"
msgstr "множество „!“"

#: sed/compile.c:145
msgid "unexpected `,'"
msgstr "неочаквана „,“"

#: sed/compile.c:146
msgid "invalid usage of +N or ~N as first address"
msgstr "неправилна употреба на „+`ЧИСЛО“ или „~ЧИСЛО“ като първи адрес"

#: sed/compile.c:147
msgid "unmatched `{'"
msgstr "„{“ без еш"

#: sed/compile.c:148
msgid "unexpected `}'"
msgstr "„}“ без еш"

#: sed/compile.c:149
msgid "extra characters after command"
msgstr "излишни знаци след командата"

#: sed/compile.c:150
msgid "expected \\ after `a', `c' or `i'"
msgstr "след „a“, „c“ и „i“ трябва да има „\\“"

#: sed/compile.c:151
msgid "`}' doesn't want any addresses"
msgstr "„}“ не приема адреси"

#: sed/compile.c:152
msgid ": doesn't want any addresses"
msgstr "„:“ не приема адреси"

#: sed/compile.c:153
msgid "comments don't accept any addresses"
msgstr "коментарите не приемат адреси"

#: sed/compile.c:154
msgid "missing command"
msgstr "липсва команда"

#: sed/compile.c:155
msgid "command only uses one address"
msgstr "командата приема само един адрес"

#: sed/compile.c:156
msgid "unterminated address regex"
msgstr "незавършен регулярен израз за адрес"

#: sed/compile.c:157
msgid "unterminated `s' command"
msgstr "незавършена команда „s“"

#: sed/compile.c:158
msgid "unterminated `y' command"
msgstr "незавършена команда „y“"

#: sed/compile.c:159
msgid "unknown option to `s'"
msgstr "непозната опция за командата „s“"

#: sed/compile.c:160
msgid "multiple `p' options to `s' command"
msgstr "множество опции „p“ за командата „s“"

#: sed/compile.c:161
msgid "multiple `g' options to `s' command"
msgstr "множество опции „g“ за командата „s“"

#: sed/compile.c:162
msgid "multiple number options to `s' command"
msgstr "множество числови опции за командата „s“"

#: sed/compile.c:163
msgid "number option to `s' command may not be zero"
msgstr "числовата опция за командата „s“ не може да е 0"

#: sed/compile.c:164
msgid "strings for `y' command are different lengths"
msgstr "низовете за командата „y“ не трябва да са с различни дължини"

#: sed/compile.c:165
msgid "delimiter character is not a single-byte character"
msgstr "знакът за разделител трябва да е еднобайтов"

#: sed/compile.c:166
msgid "expected newer version of sed"
msgstr "нужна е по-нова версия на sed"

#: sed/compile.c:167
msgid "invalid usage of line address 0"
msgstr "адресът 0 е употребен неправилно"

#: sed/compile.c:168
#, c-format
msgid "unknown command: `%c'"
msgstr "непозната команда: „%c“"

#: sed/compile.c:169
msgid "incomplete command"
msgstr "непълна команда"

#: sed/compile.c:192
#, c-format
msgid "%s: file %s line %lu: %s\n"
msgstr "%s: файл „%s“, ред %lu: %s\n"

#: sed/compile.c:195
#, c-format
msgid "%s: -e expression #%lu, char %lu: %s\n"
msgstr "%s: -e израз №%lu, знак %lu: %s\n"

#: sed/compile.c:1657
#, c-format
msgid "can't find label for jump to `%s'"
msgstr "етикетът „%s“, към който трябва да се премине, липсва"

#: sed/execute.c:595
#, c-format
msgid "%s: can't read %s: %s\n"
msgstr "%s: не може да се чете от „%s“: %s\n"

#: sed/execute.c:624
#, c-format
msgid "couldn't edit %s: is a terminal"
msgstr "„%s“ не може да се редактира, защото е терминал"

#: sed/execute.c:629
#, c-format
msgid "couldn't edit %s: not a regular file"
msgstr "„%s“ не може да се редактира, защото не е нормален файл"

#: sed/execute.c:640
#, c-format
msgid "%s: warning: failed to set default file creation context to %s: %s"
msgstr "%s: ПРЕДУПРЕЖДЕНИЕ: на „%s“ не може да се зададе стандартният контекст при създаване на файлове: %s"

#: sed/execute.c:647
#, c-format
msgid "%s: warning: failed to get security context of %s: %s"
msgstr "%s: ПРЕДУПРЕЖДЕНИЕ: контекстът за сигурност на „%s“ не може да се получи: %s"

#: sed/execute.c:664 sed/utils.c:211
#, c-format
msgid "couldn't open temporary file %s: %s"
msgstr "временният файл „%s“ не може да се отвори: %s"

#: sed/execute.c:1193 sed/execute.c:1373
msgid "error in subprocess"
msgstr "грешка в подпроцеса"

#: sed/execute.c:1195
msgid "option `e' not supported"
msgstr "опцията „e“ не се поддържа"

#: sed/execute.c:1375
msgid "`e' command not supported"
msgstr "командата „e“ не се поддържа"

#: sed/execute.c:1725
msgid "no input files"
msgstr "не са зададени входни файлове"

#: sed/regexp.c:39
msgid "no previous regular expression"
msgstr "няма предишен регулярен израз"

#: sed/regexp.c:40
msgid "cannot specify modifiers on empty regexp"
msgstr "на празен регулярен израз не може да се задават модификатори"

#: sed/regexp.c:129
#, c-format
msgid "invalid reference \\%d on `s' command's RHS"
msgstr "неправилен указател „\\%d“ в дясната страна на командата „s“"

#: sed/sed.c:32
msgid "Jay Fenlason"
msgstr "Jay Fenlason"

#: sed/sed.c:33
msgid "Tom Lord"
msgstr "Tom Lord"

#: sed/sed.c:34
msgid "Ken Pizzini"
msgstr "Ken Pizzini"

#: sed/sed.c:35
msgid "Paolo Bonzini"
msgstr "Paolo Bonzini"

#: sed/sed.c:79
#, c-format
msgid ""
"GNU sed home page: <http://www.gnu.org/software/sed/>.\n"
"General help using GNU software: <http://www.gnu.org/gethelp/>.\n"
msgstr ""
"Уеб страница на GNU sed: <http://www.gnu.org/software/sed/>.\n"
"Обща помощ за използването на софтуера от GNU: <http://www.gnu.org/gethelp/>.\n"

#: sed/sed.c:86
#, c-format
msgid ""
"E-mail bug reports to: <%s>.\n"
"Be sure to include the word ``%s'' somewhere in the ``Subject:'' field.\n"
msgstr ""
"Молим, изпращайте докладите за грешка на адрес: <%s>.\n"
"Включете думата „%s“ в темата на писмото.\n"

#: sed/sed.c:99
msgid ""
"  -R, --regexp-perl\n"
"                 use Perl 5's regular expressions syntax in the script.\n"
msgstr ""
"  -R, --regexp-perl\n"
"                 използване на синтаксиса на Perl 5 за регулярни изрази\n"

#: sed/sed.c:104
#, c-format
msgid ""
"Usage: %s [OPTION]... {script-only-if-no-other-script} [input-file]...\n"
"\n"
msgstr ""
"Употреба: %s [ОПЦИЯ]… {СКРИПТ_АКО_НЕ_E_ЗАДАДЕН_ИНАЧЕ} [ВХОДЕН_ФАЙЛ]…\n"
"\n"

#: sed/sed.c:108
#, c-format
msgid ""
"  -n, --quiet, --silent\n"
"                 suppress automatic printing of pattern space\n"
msgstr ""
"  -n, --quiet, --silent\n"
"                 без автоматичното отпечатване на буфера за напасване на шаблони\n"

#: sed/sed.c:110
#, c-format
msgid ""
"  -e script, --expression=script\n"
"                 add the script to the commands to be executed\n"
msgstr ""
"  -e СКРИПТ, --expression=СКРИПТ\n"
"                 добавяне на СКРИПТа към командите за изпълнение\n"

#: sed/sed.c:112
#, c-format
msgid ""
"  -f script-file, --file=script-file\n"
"                 add the contents of script-file to the commands to be executed\n"
msgstr ""
"  -f ФАЙЛ_СЪС_СКРИПТОВЕ, --file=ФАЙЛ_СЪС_СКРИПТОВЕ\n"
"                 добавяне на съдържанието на ФАЙЛа_СЪС_СКРИПТОВЕ към командите\n"
"                 за изпълнение\n"

#: sed/sed.c:115
#, c-format
msgid ""
"  --follow-symlinks\n"
"                 follow symlinks when processing in place\n"
msgstr ""
"  --follow-symlinks\n"
"                 следване на символните връзки при обработката на място\n"

#: sed/sed.c:118
#, c-format
msgid ""
"  -i[SUFFIX], --in-place[=SUFFIX]\n"
"                 edit files in place (makes backup if SUFFIX supplied)\n"
msgstr ""
"  -i[РАЗШИРЕНИЕ], --in-place[=РАЗШИРЕНИЕ]\n"
"                 редактиране на файловете на място (като се прави резервно копие\n"
"                 с това РАЗШИРЕНИЕ, ако е зададено)\n"

#: sed/sed.c:121
#, c-format
msgid ""
"  -b, --binary\n"
"                 open files in binary mode (CR+LFs are not processed specially)\n"
msgstr ""
"  -b, --binary\n"
"                 отваряне на файловете в двоичен режим (CR+LF няма специално\n"
"                 значение)\n"

#: sed/sed.c:124
#, c-format
msgid ""
"  -l N, --line-length=N\n"
"                 specify the desired line-wrap length for the `l' command\n"
msgstr ""
"  -l N, --line-length=N\n"
"                 желана дължина на реда, след която командата „l“ го пренася\n"

#: sed/sed.c:126
#, c-format
msgid ""
"  --posix\n"
"                 disable all GNU extensions.\n"
msgstr ""
"  --posix\n"
"                 изключване на всички разширения на GNU\n"

#: sed/sed.c:128
#, c-format
msgid ""
"  -r, --regexp-extended\n"
"                 use extended regular expressions in the script.\n"
msgstr ""
"  -r, --regexp-extended\n"
"                 използване на разширени регулярни изрази в скриптовете\n"

#: sed/sed.c:133
#, c-format
msgid ""
"  -s, --separate\n"
"                 consider files as separate rather than as a single continuous\n"
"                 long stream.\n"
msgstr ""
"  -s, --separate\n"
"                 обработка на файловете поотделно, а не като един обединен поток\n"

#: sed/sed.c:136
#, c-format
msgid ""
"  -u, --unbuffered\n"
"                 load minimal amounts of data from the input files and flush\n"
"                 the output buffers more often\n"
msgstr ""
"  -u, --unbuffered\n"
"                 зареждане на минимално количество входни данни и често\n"
"                 изчистване на буферите\n"

#: sed/sed.c:139
#, c-format
msgid ""
"  -z, --null-data\n"
"                 separate lines by NUL characters\n"
msgstr ""
"  -z, --null-data\n"
"                 отделяне на редовете със знака NUL\n"

#: sed/sed.c:141
#, c-format
msgid "      --help     display this help and exit\n"
msgstr "      --help     извеждане на тази помощ и изход\n"

#: sed/sed.c:142
#, c-format
msgid "      --version  output version information and exit\n"
msgstr "      --version  извеждане на версията на GNU sed и изход\n"

#: sed/sed.c:143
#, c-format
msgid ""
"\n"
"If no -e, --expression, -f, or --file option is given, then the first\n"
"non-option argument is taken as the sed script to interpret.  All\n"
"remaining arguments are names of input files; if no input files are\n"
"specified, then the standard input is read.\n"
"\n"
msgstr ""
"\n"
"Ако никоя от опциите „-e“, „--expression“, „-f“ и „--file“ не е зададена,\n"
"първият аргумент, който не е опция, се използва като скрипт за sed.  Всички\n"
"останали аргументи се третират като имена на входни файлове.  Ако не са\n"
"зададени такива, се чете от стандартния вход.\n"

#: sed/utils.c:74 sed/utils.c:432
#, c-format
msgid "cannot remove %s: %s"
msgstr "„%s“ не може да се изтрие: %s"

#: sed/utils.c:144
#, c-format
msgid "couldn't open file %s: %s"
msgstr "файлът „%s“ не може да се отвори: %s"

#: sed/utils.c:167
#, c-format
msgid "couldn't attach to %s: %s"
msgstr "неуспешно свързване към „%s“: %s"

#: sed/utils.c:229
#, c-format
msgid "couldn't write %d item to %s: %s"
msgid_plural "couldn't write %d items to %s: %s"
msgstr[0] "%d елемент не може да се запише в „%s“: %s"
msgstr[1] "%d елемента не може да се запишат в „%s“: %s"

#: sed/utils.c:244 sed/utils.c:267
#, c-format
msgid "read error on %s: %s"
msgstr "грешка при четене на „%s“: %s"

#: sed/utils.c:372
#, c-format
msgid "couldn't follow symlink %s: %s"
msgstr "символната връзка „%s“ не може да се проследи: %s"

#: sed/utils.c:406
#, c-format
msgid "cannot stat %s: %s"
msgstr "не може да се получи информация за „%s“ чрез „stat“: %s"

#: sed/utils.c:437
#, c-format
msgid "cannot rename %s: %s"
msgstr "„%s“ не може да се преименува: %s"

#: lib/regcomp.c:132
msgid "Success"
msgstr "Успех"

#: lib/regcomp.c:135
msgid "No match"
msgstr "Без съвпадение"

#: lib/regcomp.c:138
msgid "Invalid regular expression"
msgstr "Неправилен регулярен израз"

#: lib/regcomp.c:141
msgid "Invalid collation character"
msgstr "Неправилен знак за подредба"

#: lib/regcomp.c:144
msgid "Invalid character class name"
msgstr "Неправилно име на клас знаци"

#: lib/regcomp.c:147
msgid "Trailing backslash"
msgstr "Самотна „\\“ накрая"

#: lib/regcomp.c:150
msgid "Invalid back reference"
msgstr "Неправилен указател към група"

#: lib/regcomp.c:153
msgid "Unmatched [ or [^"
msgstr "„[“ или „[^“ без еш"

#: lib/regcomp.c:156
msgid "Unmatched ( or \\("
msgstr "„(“ или „\\(“ без еш"

#: lib/regcomp.c:159
msgid "Unmatched \\{"
msgstr "„\\{“ без еш"

#: lib/regcomp.c:162
msgid "Invalid content of \\{\\}"
msgstr "Неправилно съдържание в „\\{\\}“"

#: lib/regcomp.c:165
msgid "Invalid range end"
msgstr "Неправилен край на диапазон"

#: lib/regcomp.c:168
msgid "Memory exhausted"
msgstr "Паметта свърши"

#: lib/regcomp.c:171
msgid "Invalid preceding regular expression"
msgstr "Предхождащият регулярен израз е неправилен"

#: lib/regcomp.c:174
msgid "Premature end of regular expression"
msgstr "Ранен край на регулярен израз"

#: lib/regcomp.c:177
msgid "Regular expression too big"
msgstr "Прекалено голям регулярен израз"

#: lib/regcomp.c:180
msgid "Unmatched ) or \\)"
msgstr "„)“ или „\\)“ без еш"

#: lib/regcomp.c:705
msgid "No previous regular expression"
msgstr "Няма предхождащ регулярен израз"
