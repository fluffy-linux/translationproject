#~ msgid ""
#~ "Usage: %s [-0prtx] [--interactive] [--null] [-d|--delimiter=delim]\n"
#~ "       [-E eof-str] [-e[eof-str]]  [--eof[=eof-str]]\n"
#~ "       [-L max-lines] [-l[max-lines]] [--max-lines[=max-lines]]\n"
