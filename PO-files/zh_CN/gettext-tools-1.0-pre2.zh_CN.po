msgstr "  -C, --compendium=文件       消息翻译的额外库，可指定多个\n"

#: src/msgmerge.c:512
#, c-format
msgid ""
"  -U, --update                update def.po,\n"
"                              do nothing if def.po already up to date\n"
msgstr ""
"  -U, --update                更新 def.po,\n"
"                              如果 def.po 已经是最新则不作任何事\n"

