"                 -imaxbel -opost -isig -icanon -xcase min 1 time 0\n"
"   -raw\t等于cooked\n"

#: src/stty.c:697
#, fuzzy
msgid ""
"   sane          same as cread -ignbrk brkint -inlcr -igncr icrnl -iutf8\n"
