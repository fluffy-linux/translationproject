#: data/glr.c:917 data/yacc.c:584
msgid "syntax error: cannot back up"
msgstr "erreur de syntaxe: ne peut reculer"

#: data/glr.c:1795
msgid "syntax is ambiguous"
msgstr "syntaxe ambiguë"

#: data/glr.c:2087 data/glr.c:2093 data/glr.c:2374 data/lalr1.cc:872
#: data/yacc.c:1307 data/yacc.c:1335
msgid "syntax error"
msgstr "erreur de syntaxe"

#: data/glr.c:2408 data/yacc.c:1117 data/yacc.c:1459
msgid "memory exhausted"
msgstr "mémoire épuisée"

#: data/yacc.c:869
#, c-format
msgid "syntax error, unexpected %s"
msgstr "erreur de syntaxe, %s inattendu"

#: data/yacc.c:870
