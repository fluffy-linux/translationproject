#: data/glr.c:920 data/yacc.c:585
msgid "syntax error: cannot back up"
msgstr "erreur de syntaxe: ne peut reculer"

#: data/glr.c:1803
msgid "syntax is ambiguous"
msgstr "syntaxe ambiguë"

#: data/glr.c:2170 data/glr.c:2176 data/glr.c:2428 data/lalr1.cc:875
#: data/yacc.c:1305 data/yacc.c:1333
msgid "syntax error"
msgstr "erreur de syntaxe"

#: data/glr.c:2488 data/yacc.c:1118 data/yacc.c:1454
msgid "memory exhausted"
msgstr "mémoire épuisée"

#: data/yacc.c:873
#, c-format
msgid "syntax error, unexpected %s"
msgstr "erreur de syntaxe, %s inattendu"

#: data/yacc.c:874
#, c-format
msgid "syntax error, unexpected %s, expecting %s"
msgstr "erreur de syntaxe, %s inattendu, attendait %s"

#: data/yacc.c:875
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s"
msgstr "erreur de syntaxe, %s inattendu, attendait %s ou %s"

#: data/yacc.c:876
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s"
msgstr "erreur de syntaxe, %s inattendu, attendait %s ou %s ou %s"

#: data/yacc.c:877
#, c-format
msgid "syntax error, unexpected %s, expecting %s or %s or %s or %s"
msgstr "erreur de syntaxe, %s inattendu, attendait %s ou %s ou %s ou %s"
